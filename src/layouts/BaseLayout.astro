---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CookieBanner from '../components/CookieBanner.astro';
import StickyMobileCTA from '../components/StickyMobileCTA.astro';
import SchemaJsonLd from '../components/SchemaJsonLd.astro';
import NetworkStatus from '../components/NetworkStatus.astro';
import WhatsAppQuickConnect from '../components/WhatsAppQuickConnect.astro';
import ExitIntentModal from '../components/ExitIntentModal.astro';
import { ANALYTICS_CONFIG } from '../config/analytics';

interface Props {
  title: string;
  description: string;
  keywords?: string;
  canonical?: string;
  ogImage?: string;
  ogImageAlt?: string;
  ogType?: 'website' | 'article';
  schemaType?: 'home' | 'services' | 'service-detail' | 'pricing' | 'company' | 'blogs' | 'blog-category' | 'blog-post' | 'contact' | 'legal' | 'portfolio';
  serviceData?: any;
  postData?: any;
  showMobileCTA?: boolean;
  noindex?: boolean;
  noCanonical?: boolean;
}

const {
  title,
  description,
  keywords,
  canonical,
  ogImage,
  ogImageAlt,
  ogType = 'website',
  schemaType = 'home',
  serviceData,
  postData,
  showMobileCTA = true,
  noindex = false,
  noCanonical = false
} = Astro.props;

// Canonical URL: per-page compute using Astro.site with guaranteed trailing slash and query stripped
const rawPathname = Astro.url.pathname.replace(/\/+$/, '');
const normalizedPathname = rawPathname === '' ? '/' : `${rawPathname}/`;
const autoCanonicalURL = new URL(normalizedPathname, Astro.site || 'https://infohq.in');
const canonicalURL = canonical ? new URL(canonical) : autoCanonicalURL;
const currentPath = Astro.url.pathname;

// Dynamic Per-Page OG Image resolution (razor-sharp 1200x630 WebP cards)
let defaultOgPath = '/og/default.webp';
const cleanPath = currentPath.replace(/\/$/, '');

if (cleanPath === '' || cleanPath === '/') {
  defaultOgPath = '/og/home.webp';
} else if (serviceData?.slug) {
  defaultOgPath = `/og/services/${serviceData.slug}.webp`;
} else if (cleanPath.startsWith('/services/')) {
  const parts = cleanPath.split('/').filter(Boolean);
  defaultOgPath = parts.length >= 2 ? `/og/services/${parts[1]}.webp` : '/og/services.webp';
} else if (cleanPath === '/services') {
  defaultOgPath = '/og/services.webp';
} else if (cleanPath === '/pricing') {
  defaultOgPath = '/og/pricing.webp';
} else if (cleanPath === '/company') {
  defaultOgPath = '/og/company.webp';
} else if (cleanPath === '/contact') {
  defaultOgPath = '/og/contact.webp';
} else if (cleanPath === '/portfolio') {
  defaultOgPath = '/og/portfolio.webp';
} else if (cleanPath.startsWith('/blogs/')) {
  const parts = cleanPath.split('/').filter(Boolean);
  if (parts.length === 2 && ['ai', 'web', 'automation', 'cloud', 'startups', 'design'].includes(parts[1])) {
    defaultOgPath = `/og/blogs/${parts[1]}.webp`;
  } else if (postData?.image) {
    defaultOgPath = postData.image;
  } else {
    defaultOgPath = '/og/blogs.webp';
  }
} else if (cleanPath === '/blogs') {
  defaultOgPath = '/og/blogs.webp';
} else if (cleanPath.startsWith('/privacy')) {
  defaultOgPath = '/og/privacy.webp';
} else if (cleanPath.startsWith('/terms')) {
  defaultOgPath = '/og/terms.webp';
}

const resolvedOgImage = ogImage || defaultOgPath;
const absoluteOgImage = new URL(resolvedOgImage, 'https://infohq.in').toString();
const resolvedOgAlt = ogImageAlt || `${title} — InfoHQ`;
const ogImageType = 'image/webp';

const gaMeasurementId = ANALYTICS_CONFIG.gaMeasurementId;
const metaPixelId = ANALYTICS_CONFIG.metaPixelId;
const linkedInPartnerId = ANALYTICS_CONFIG.linkedInPartnerId;
---

<!doctype html>
<html lang="en-IN">
  <head>
    <ClientRouter fallback="swap" />
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {keywords && <meta name="keywords" content={keywords} />}

    <!-- Google Search Central, AI Overviews & Generative Engine (GEO/AEO) Directives -->
    <meta name="robots" content={noindex ? "noindex, nofollow" : "index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1"} />
    <meta name="googlebot" content={noindex ? "noindex, nofollow" : "index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1"} />
    <meta name="bingbot" content={noindex ? "noindex, nofollow" : "index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1"} />

    <!-- Canonical URL -->
    {!noCanonical && <link rel="canonical" href={canonicalURL} />}

    <!-- E-E-A-T & Geographic / Entity Metadata -->
    <meta name="author" content="Shivam Tiwari, InfoHQ" />
    <meta name="publisher" content="InfoHQ" />
    <meta name="geo.region" content="IN" />
    <meta name="geo.placename" content="Pune, Maharashtra; Prayagraj, Uttar Pradesh, India" />
    <meta name="format-detection" content="telephone=no" />

    <!-- Favicon & Brand Icons -->
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/webp" href="/favicon.webp" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#7C5CE8" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={absoluteOgImage} />
    <meta property="og:image:secure_url" content={absoluteOgImage} />
    <meta property="og:image:type" content={ogImageType} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={resolvedOgAlt} />
    <meta property="og:site_name" content="InfoHQ" />
    <meta property="og:locale" content="en_IN" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@CodeWithTiwari" />
    <meta name="twitter:creator" content="@CodeWithTiwari" />
    <meta name="twitter:url" content={canonicalURL} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={absoluteOgImage} />
    <meta name="twitter:image:src" content={absoluteOgImage} />
    <meta property="twitter:image" content={absoluteOgImage} />
    <meta name="twitter:image:alt" content={resolvedOgAlt} />
    <!-- Telegram & Messenger Previews -->
    <meta name="telegram:channel" content="@infohq" />
    <meta property="telegram:title" content={title} />
    <meta property="telegram:description" content={description} />
    <meta property="telegram:image" content={absoluteOgImage} />

    <!-- Structured Data (JSON-LD) -->
    <SchemaJsonLd type={schemaType} serviceData={serviceData} postData={postData} />

    <!-- Meta Pixel Code -->
    <script is:inline>
      !function(f,b,e,v,n,t,s)
      {if(f.fbq)return;n=f.fbq=function(){n.callMethod?
      n.callMethod.apply(n,arguments):n.queue.push(arguments)};
      if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';
      n.queue=[];t=b.createElement(e);t.async=!0;
      t.src=v;s=b.getElementsByTagName(e)[0];
      s.parentNode.insertBefore(t,s)}(window, document,'script',
      'https://connect.facebook.net/en_US/fbevents.js');
      fbq('init', '1786810120113651');
      fbq('track', 'PageView');
    </script>
    <noscript><img height="1" width="1" style="display:none"
      src="https://www.facebook.com/tr?id=1786810120113651&ev=PageView&noscript=1"
    /></noscript>
    <!-- End Meta Pixel Code -->

    {/* Analytics & ViewTransitions helpers */}
    <script is:inline define:vars={{ gaMeasurementId, linkedInPartnerId }}>
      window.GA_MEASUREMENT_ID = window.GA_MEASUREMENT_ID || gaMeasurementId || '';
      window.LINKEDIN_PARTNER_ID = window.LINKEDIN_PARTNER_ID || linkedInPartnerId || '';

      function initAnalyticsTracking() {
        if (!window._gaLoaded && window.GA_MEASUREMENT_ID) {
          window._gaLoaded = true;
          var script = document.createElement('script');
          script.async = true;
          script.src = 'https://www.googletagmanager.com/gtag/js?id=' + window.GA_MEASUREMENT_ID;
          document.head.appendChild(script);
          window.dataLayer = window.dataLayer || [];
          function gtag(){dataLayer.push(arguments);}
          window.gtag = gtag;
          gtag('js', new Date());
          gtag('config', window.GA_MEASUREMENT_ID, { send_page_view: false });
          gtag('event', 'page_view', {
            page_path: window.location.pathname + window.location.search,
            page_title: document.title
          });
        }
      }

      function initLinkedInTag() {
        if (!window._linkedinLoaded && window.LINKEDIN_PARTNER_ID) {
          window._linkedinLoaded = true;
          window._linkedin_data_partner_ids = window._linkedin_data_partner_ids || [];
          window._linkedin_data_partner_ids.push(window.LINKEDIN_PARTNER_ID);
          (function(l) {
            if (!l){window.lintrk = function(a,b){window.lintrk.q.push([a,b])};
            window.lintrk.q=[]}
            var s = document.getElementsByTagName("script")[0];
            var b = document.createElement("script");
            b.type = "text/javascript";b.async = true;
            b.src = "https://snap.licdn.com/li.lms-analytics/insight.min.js";
            s.parentNode.insertBefore(b, s);
          })(window.lintrk);
        }
      }

      try {
        var rawConsent = localStorage.getItem('infohq_cookie_consent_v1');
        var consent = rawConsent ? JSON.parse(rawConsent) : null;
        if (!consent || consent.analytics !== false) initAnalyticsTracking();
        if (!consent || consent.marketing !== false) initLinkedInTag();
      } catch (err) {}

      window.addEventListener('infohq_consent_changed', function(e) {
        var consent = e.detail;
        if (consent && consent.analytics) initAnalyticsTracking();
        if (consent && consent.marketing) initLinkedInTag();
      });

      // Track ViewTransitions client-side navigation for Meta Pixel & Google Analytics
      document.addEventListener('astro:page-load', function() {
        if (typeof window.fbq === 'function') {
          window.fbq('track', 'PageView');
        }
        if (window._gaLoaded && typeof window.gtag === 'function' && window.GA_MEASUREMENT_ID) {
          window.gtag('event', 'page_view', {
            page_path: window.location.pathname + window.location.search,
            page_title: document.title
          });
        }
      });

      // Global Retargeting Conversion Helpers (e.g. Form Submits / Consultation Leads)
      window.infohqTrackLead = function(serviceName) {
        try {
          if (typeof window.fbq === 'function') {
            window.fbq('track', 'Lead', {
              content_name: serviceName || 'General Consultation',
              currency: 'INR',
              value: 0
            });
          }
          if (window._gaLoaded && typeof window.gtag === 'function') {
            window.gtag('event', 'generate_lead', {
              event_category: 'Consultation',
              event_label: serviceName || 'General Consultation'
            });
          }
          if (window._linkedinLoaded && typeof window.lintrk === 'function') {
            window.lintrk('track', { conversion_id: 'lead' });
          }
        } catch (err) {}
      };

      window.infohqTrackEvent = function(eventName, params) {
        try {
          if (typeof window.fbq === 'function') {
            window.fbq('trackCustom', eventName, params || {});
          }
          if (window._gaLoaded && typeof window.gtag === 'function') {
            window.gtag('event', eventName, params || {});
          }
        } catch (err) {}
      };
    </script>
  </head>
  <body class={schemaType === 'home' ? 'page-home' : schemaType === 'contact' ? 'page-contact' : ''}>
    <!-- Skip to main content for accessibility -->
    <a href="#main-content" class="sr-only-focusable">Skip to main content</a>

    <slot name="top-wash" />

    <Header currentPath={currentPath} />

    <main id="main-content">
      <slot />
    </main>

    <Footer />

    <StickyMobileCTA show={showMobileCTA && currentPath !== '/contact'} />
    <WhatsAppQuickConnect />
    <ExitIntentModal />
    <CookieBanner />
    <NetworkStatus />

    {/* Motion Engine & Smooth Scroll */}
    <script>
      import Lenis from 'lenis';
      import { initMotion } from '../scripts/motion';

      let lenisInstance: any = null;
      let isHistoryNavigation = false;

      window.addEventListener('popstate', () => {
        isHistoryNavigation = true;
      });

      document.addEventListener('astro:before-preparation', (e: any) => {
        if (e.navigationType === 'traverse') {
          isHistoryNavigation = true;
        }
      });

      function setupScrollAndMotion() {
        initMotion();

        const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (!prefersReducedMotion) {
          if (!lenisInstance) {
            lenisInstance = new Lenis({
              duration: 1.05,
              easing: (t: number) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
              orientation: 'vertical',
              smoothWheel: true,
              touchMultiplier: 1.3,
            });

            (window as any).lenis = lenisInstance;
            (window as any).Lenis = Lenis;

            function raf(time: number) {
              lenisInstance?.raf(time);
              requestAnimationFrame(raf);
            }
            requestAnimationFrame(raf);
          } else {
            lenisInstance.resize();
            setTimeout(() => lenisInstance?.resize(), 100);
          }
        }
      }

      document.addEventListener('astro:page-load', () => {
        setupScrollAndMotion();
      });

      document.addEventListener('astro:after-swap', () => {
        if (isHistoryNavigation) {
          // On back/forward navigation, preserve browser restored position without scroll collision
          isHistoryNavigation = false;
          lenisInstance?.resize();
          requestAnimationFrame(() => {
            lenisInstance?.scrollTo(window.scrollY, { immediate: true });
          });
        } else if (!window.location.hash) {
          window.scrollTo(0, 0);
          lenisInstance?.scrollTo(0, { immediate: true });
        }
      });
    </script>
  </body>
</html>

<style>
  .sr-only-focusable {
    position: absolute;
    top: -9999px;
    left: 1rem;
    z-index: 99999;
    background: var(--color-primary);
    color: #FFFFFF;
    padding: 0.75rem 1.5rem;
    border-radius: var(--radius-md);
    font-weight: 600;
  }
  .sr-only-focusable:focus {
    top: 1rem;
  }

  :global(body.page-home),
  :global(body.page-contact) {
    background-color: var(--color-bg-section);
  }
</style>
