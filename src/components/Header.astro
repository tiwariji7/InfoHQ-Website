<script>
  function setupMobileMenu() {
    const hamburgerBtn = document.getElementById('hamburger-btn');
    const closeBtn = document.getElementById('close-menu-btn');
    const backdrop = document.getElementById('mobile-menu-backdrop');
    const menu = document.getElementById('mobile-menu');
    const stickyCTA = document.getElementById('sticky-mobile-cta');

    if (!hamburgerBtn || !menu) return;

    // Prevent duplicate event listener binding on client transitions
    if (hamburgerBtn.dataset.menuBound === 'true') {
      return;
    }
    hamburgerBtn.dataset.menuBound = 'true';

    let initialScrollY = 0;
    const scrollCloseThreshold = 18;

    function handleScrollClose() {
      if (!menu.classList.contains('open')) return;
      if (Math.abs(window.scrollY - initialScrollY) > scrollCloseThreshold) {
        closeMenu();
      }
    }

    function openMenu() {
      if (!menu) return;
      initialScrollY = window.scrollY;
      menu.removeAttribute('inert');
      menu.classList.add('open');
      menu.setAttribute('aria-hidden', 'false');
      hamburgerBtn.setAttribute('aria-expanded', 'true');
      hamburgerBtn.classList.add('is-active');
      stickyCTA?.classList.add('hidden-by-final-cta');

      // Auto close smoothly on scroll
      window.addEventListener('scroll', handleScrollClose, { passive: true });
    }

    function closeMenu() {
      if (!menu) return;
      window.removeEventListener('scroll', handleScrollClose);

      if (document.activeElement && menu.contains(document.activeElement) && document.activeElement instanceof HTMLElement) {
        document.activeElement.blur();
      }
      menu.classList.remove('open');
      menu.setAttribute('aria-hidden', 'true');
      menu.setAttribute('inert', '');
      hamburgerBtn.setAttribute('aria-expanded', 'false');
      hamburgerBtn.classList.remove('is-active');
      stickyCTA?.classList.remove('hidden-by-final-cta');
    }

    function toggleMenu(e) {
      e?.preventDefault();
      e?.stopPropagation();
      if (menu.classList.contains('open')) {
        closeMenu();
      } else {
        openMenu();
      }
    }

    hamburgerBtn.addEventListener('click', toggleMenu);

    closeBtn?.addEventListener('click', (e) => {
      e.preventDefault();
      closeMenu();
    });

    backdrop?.addEventListener('click', (e) => {
      e.preventDefault();
      closeMenu();
    });

    // Close on escape key
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && menu.classList.contains('open')) {
        closeMenu();
      }
    });

    // Close menu when clicking any nav link
    const mobileLinks = menu.querySelectorAll('.mobile-nav-link');
    mobileLinks.forEach(link => {
      link.addEventListener('click', () => {
        closeMenu();
      });
    });
  }

  // Run on initial load and view transitions
  setupMobileMenu();
  document.addEventListener('astro:page-load', setupMobileMenu);

  document.addEventListener('astro:before-swap', () => {
    const menu = document.getElementById('mobile-menu');
    const hamburgerBtn = document.getElementById('hamburger-btn');
    if (menu?.classList.contains('open')) {
      menu.classList.remove('open');
      menu.setAttribute('aria-hidden', 'true');
      menu.setAttribute('inert', '');
      hamburgerBtn?.setAttribute('aria-expanded', 'false');
      hamburgerBtn?.classList.remove('is-active');
    }
  });
</script>