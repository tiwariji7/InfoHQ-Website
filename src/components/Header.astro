---
import Button from './Button.astro';

interface Props {
  currentPath?: string;
}

const { currentPath = '/' } = Astro.props;

const navItems = [
  { label: 'Home', href: '/' },
  { label: 'Services', href: '/services/' },
  { label: 'Pricing', href: '/pricing/' },
  { label: 'Portfolio', href: '/portfolio/' },
  { label: 'Company', href: '/company/' },
  { label: 'Blogs', href: '/blogs/' },
  { label: 'Contact', href: '/contact/' }
];

const isActive = (href: string) => {
  if (href === '/') return currentPath === '/' || currentPath === '';
  const cleanHref = href.replace(/\/$/, '');
  const cleanCurrent = currentPath.replace(/\/$/, '');
  return cleanCurrent === cleanHref || cleanCurrent.startsWith(cleanHref + '/');
};
---

<header class="site-header" id="site-header">
  <div class="floating-nav-wrapper">
    <div class="header-container">
      <!-- Brand Logo -->
      <a href="/" class="brand-link" aria-label="InfoHQ Home">
        <img 
          src="/images/infohq-brandlogo.webp" 
          alt="InfoHQ Logo - AI & Software Engineering Studio" 
          width="160" 
          height="80" 
          class="brand-logo"
          loading="eager"
          decoding="async"
        />
      </a>

      <!-- Desktop Navigation (>= 1024px) -->
      <nav class="desktop-nav" aria-label="Main Navigation">
        <ul class="nav-list">
          {navItems.map((item) => (
            <li>
              <a 
                href={item.href} 
                class={`nav-link ${isActive(item.href) ? 'active' : ''}`}
                aria-current={isActive(item.href) ? 'page' : undefined}
              >
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <!-- Header Actions (Desktop, Tablet, and Mobile navbar) -->
      <div class="header-actions">
        <Button
          variant="primary"
          size="md"
          href="/contact"
          icon="none"
          id="nav-header-cta"
        >
          <span class="nav-cta-full">Free Consultation</span>
          <span class="nav-cta-short">Let's Talk</span>
        </Button>

        <!-- Mobile/Tablet Hamburger Toggle (< 1024px) -->
        <button 
          type="button" 
          class="hamburger-btn" 
          id="hamburger-btn" 
          aria-label="Toggle navigation menu"
          aria-expanded="false"
          aria-controls="mobile-menu"
        >
          <span class="hamburger-bar bar-1"></span>
          <span class="hamburger-bar bar-2"></span>
          <span class="hamburger-bar bar-3"></span>
        </button>
      </div>
    </div>
  </div>
</header>

<!-- Mobile Drawer / Overlay Navigation (Rendered outside header to escape backdrop-filter containing block) -->
<div class="mobile-menu" id="mobile-menu" aria-hidden="true" inert>
  <div class="mobile-menu-backdrop" id="mobile-menu-backdrop"></div>
  <div class="mobile-menu-drawer">
    <div class="mobile-menu-header">
      <div class="drawer-brand-wrap">
        <a href="/" class="drawer-logo-link" aria-label="InfoHQ Home">
          <img 
            src="/images/infohq-brandlogo.webp" 
            alt="InfoHQ" 
            width="116" 
            height="58" 
            class="drawer-logo"
          />
        </a>
        <span class="drawer-badge">Engineering Studio</span>
      </div>
      <button 
        type="button" 
        class="close-menu-btn" 
        id="close-menu-btn" 
        aria-label="Close menu"
      >
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>

    <nav class="mobile-nav" aria-label="Mobile Navigation">
      <ul class="mobile-nav-list">
        {navItems.map((item, index) => (
          <li style={`--item-index: ${index};`}>
            <a 
              href={item.href} 
              class={`mobile-nav-link ${isActive(item.href) ? 'active' : ''}`}
              aria-current={isActive(item.href) ? 'page' : undefined}
            >
              <span class="mobile-nav-indicator" aria-hidden="true"></span>
              <span class="mobile-nav-text">{item.label}</span>
              <span class="mobile-nav-arrow" aria-hidden="true">&rarr;</span>
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="mobile-menu-footer">
      <Button
        variant="primary"
        size="lg"
        href="/contact"
        label="Free Consultation"
        icon="none"
        class="mobile-drawer-cta"
      />
      
      <!-- Studio Official Social Channels in Drawer -->
      <div class="mobile-drawer-socials">
        <a href="https://www.linkedin.com/company/infohq/" target="_blank" rel="noopener noreferrer" class="drawer-social-icon linkedin" aria-label="InfoHQ on LinkedIn">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.46 10.9v8.37H9.2V10.9H6.46M7.83 6.25c-.95 0-1.72.78-1.72 1.73s.77 1.73 1.72 1.73 1.73-.78 1.73-1.73-.78-1.73-1.73z"/></svg>
        </a>
        <a href="https://www.instagram.com/infohq.in/" target="_blank" rel="noopener noreferrer" class="drawer-social-icon instagram" aria-label="InfoHQ on Instagram">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
        </a>
        <a href="https://www.youtube.com/@infohq28" target="_blank" rel="noopener noreferrer" class="drawer-social-icon youtube" aria-label="InfoHQ on YouTube">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>
        </a>
      </div>

      <div class="mobile-menu-contact">
        <p class="contact-email">contact@infohq.in</p>
        <p class="contact-loc">Pune &bull; Prayagraj &bull; Pan-India</p>
      </div>
    </div>
  </div>
</div>

<style>
  /* Sticky Outer Shell with Zero Background */
  .site-header {
    position: sticky;
    top: 0;
    z-index: 1000;
    width: 100%;
    pointer-events: none;
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  /* Floating Outer Spacing Container */
  .floating-nav-wrapper {
    width: 100%;
    max-width: 1240px;
    margin: 0 auto;
    padding: clamp(12px, 1.8vw, 18px) var(--container-pad, 20px) 0;
  }

  /* The Floating Pill Bar */
  .header-container {
    pointer-events: auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 60px;
    padding: 0 14px 0 22px;
    background: rgba(255, 255, 255, 0.84);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border-radius: 26px; /* 24-28px rounded corners */
    border: 1px solid rgba(120, 110, 220, 0.16);
    box-shadow: 
      0 12px 32px -4px rgba(20, 10, 60, 0.08),
      0 4px 12px -2px rgba(20, 10, 60, 0.03),
      inset 0 1px 1px rgba(255, 255, 255, 0.95);
    transition: box-shadow 0.25s ease, border-color 0.25s ease, background 0.25s ease;
  }

  .header-container:hover {
    border-color: rgba(120, 110, 220, 0.24);
    box-shadow: 
      0 16px 36px -4px rgba(20, 10, 60, 0.1),
      0 6px 16px -2px rgba(20, 10, 60, 0.04),
      inset 0 1px 1px rgba(255, 255, 255, 1);
  }

  /* Brand Logo - Crisp Modern Dimensions */
  .brand-link {
    display: flex;
    align-items: center;
    text-decoration: none;
    line-height: 1;
    transition: opacity 0.2s ease, transform 0.2s ease;
  }

  .brand-link:hover {
    opacity: 0.92;
    transform: scale(0.99);
  }

  .brand-logo {
    height: 29px;
    width: auto;
    object-fit: contain;
    display: block;
    transition: transform 0.25s ease;
  }

  /* Desktop Navigation Links */
  .desktop-nav {
    display: flex;
    align-items: center;
  }

  .nav-list {
    display: flex;
    align-items: center;
    gap: clamp(0.35rem, 0.9vw, 1.25rem);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .nav-link {
    font-size: 14px;
    font-weight: 500;
    color: var(--nav-link-color, #14143C);
    padding: 6px clamp(8px, 0.85vw, 13px);
    border-radius: var(--radius-full);
    text-decoration: none;
    position: relative;
    transition: color 0.2s ease, background-color 0.2s ease;
    white-space: nowrap;
  }

  .nav-link:hover {
    color: var(--nav-link-hover, #5B4BF0);
    background-color: rgba(91, 75, 240, 0.06);
  }

  .nav-link.active {
    color: var(--nav-link-active, #5B4BF0);
    font-weight: 600;
    background-color: rgba(91, 75, 240, 0.09);
  }

  @media (min-width: 1024px) and (max-width: 1180px) {
    .nav-list {
      gap: 0.25rem;
    }
    .nav-link {
      font-size: 13px;
      padding: 5px 8px;
    }
  }

  /* Header Actions */
  .header-actions {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  /* CTA Text Switching */
  .nav-cta-full {
    display: inline;
  }

  .nav-cta-short {
    display: none;
  }

  :global(#nav-header-cta),
  :global(.mobile-drawer-cta) {
    background: linear-gradient(90deg, #5B4CF5 0%, #E85AA0 100%) !important;
    background-color: #5B4CF5 !important;
    color: #FFFFFF !important;
    font-size: 13.5px !important;
    font-weight: 600 !important;
    height: 38px !important;
    min-height: 38px !important;
    padding: 0 18px !important;
    border-radius: var(--radius-full) !important;
    box-shadow: 0 4px 14px rgba(99, 88, 240, 0.3) !important;
    white-space: nowrap !important;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  :global(#nav-header-cta:hover),
  :global(.mobile-drawer-cta:hover) {
    transform: translateY(-1.5px) !important;
    box-shadow: 0 6px 18px rgba(99, 88, 240, 0.42) !important;
    filter: brightness(1.06) !important;
  }

  :global(#nav-header-cta .btn-label),
  :global(.mobile-drawer-cta .btn-label) {
    color: #FFFFFF !important;
    font-size: 13.5px !important;
    font-weight: 600 !important;
  }

  :global(#nav-header-cta svg),
  :global(.mobile-drawer-cta svg) {
    color: #FFFFFF !important;
    stroke: #FFFFFF !important;
  }

  /* Hamburger Button - Modern Morphing 3 Lines */
  .hamburger-btn {
    display: none;
    position: relative;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 4.5px;
    width: 38px;
    height: 38px;
    padding: 0;
    background: rgba(91, 75, 240, 0.06);
    border: 1px solid rgba(120, 110, 220, 0.2);
    border-radius: 11px;
    cursor: pointer;
    touch-action: manipulation;
    -webkit-tap-highlight-color: transparent;
    z-index: 1001;
    transition: background-color 0.2s ease, border-color 0.2s ease, transform 0.15s ease;
    box-shadow: 0 1px 3px rgba(20, 10, 60, 0.03);
  }

  .hamburger-btn:active {
    transform: scale(0.94);
  }

  .hamburger-btn:hover {
    background: rgba(91, 75, 240, 0.12);
    border-color: rgba(91, 75, 240, 0.35);
  }

  .hamburger-bar {
    display: block;
    width: 18px;
    height: 2px;
    background-color: #1A085C;
    border-radius: 9999px;
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.2s ease, background-color 0.2s ease;
    transform-origin: center;
  }

  /* Morph into X when active */
  .hamburger-btn.is-active {
    background: rgba(91, 75, 240, 0.12);
    border-color: rgba(91, 75, 240, 0.35);
  }

  .hamburger-btn.is-active .bar-1 {
    transform: translateY(6.5px) rotate(45deg);
    background-color: #5B4CF5;
  }

  .hamburger-btn.is-active .bar-2 {
    opacity: 0;
    transform: scaleX(0);
  }

  .hamburger-btn.is-active .bar-3 {
    transform: translateY(-6.5px) rotate(-45deg);
    background-color: #5B4CF5;
  }

  /* Mobile Drawer Menu */
  .mobile-menu {
    position: fixed;
    inset: 0;
    z-index: 1200;
    visibility: hidden;
    pointer-events: none;
    transition: visibility 0.38s ease;
  }

  .mobile-menu.open {
    visibility: visible;
    pointer-events: auto;
  }

  .mobile-menu-backdrop {
    position: fixed;
    inset: 0;
    background: rgba(10, 6, 32, 0.58);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    opacity: 0;
    transition: opacity 0.35s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .mobile-menu.open .mobile-menu-backdrop {
    opacity: 1;
  }

  .mobile-menu-drawer {
    position: fixed;
    top: 0;
    right: 0;
    bottom: 0;
    width: 86%;
    max-width: 340px;
    height: 100vh;
    height: 100dvh;
    background: #FFFFFF;
    border-left: 1px solid rgba(120, 110, 220, 0.16);
    box-shadow: -12px 0 44px rgba(12, 6, 42, 0.18), -2px 0 6px rgba(12, 6, 42, 0.04);
    padding: 1.4rem 1.35rem 1.5rem;
    display: flex;
    flex-direction: column;
    z-index: 1201;
    transform: translateX(100%);
    transition: transform 0.38s cubic-bezier(0.16, 1, 0.3, 1);
    overflow-y: auto;
    -webkit-overflow-scrolling: touch;
  }

  .mobile-menu.open .mobile-menu-drawer {
    transform: translateX(0);
  }

  /* Drawer Header */
  .mobile-menu-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-bottom: 1.15rem;
    border-bottom: 1px solid rgba(120, 110, 220, 0.12);
    flex-shrink: 0;
  }

  .drawer-brand-wrap {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .drawer-logo-link {
    display: inline-flex;
    align-items: center;
    text-decoration: none;
    line-height: 1;
  }

  .drawer-logo {
    height: 25px;
    width: auto;
    object-fit: contain;
    display: block;
  }

  .drawer-badge {
    font-size: 0.68rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-primary, #7C5CE8);
  }

  .close-menu-btn {
    width: 38px;
    height: 38px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(91, 75, 240, 0.06);
    border: 1px solid rgba(120, 110, 220, 0.14);
    border-radius: 11px;
    color: #14143C;
    cursor: pointer;
    touch-action: manipulation;
    -webkit-tap-highlight-color: transparent;
    transition: background-color 0.2s ease, transform 0.25s cubic-bezier(0.16, 1, 0.3, 1), color 0.2s ease;
  }

  .close-menu-btn:hover {
    background: rgba(91, 75, 240, 0.12);
    color: #5B4CF5;
    transform: rotate(90deg);
  }

  .close-menu-btn:active {
    transform: scale(0.92) rotate(90deg);
  }

  /* Nav Links in Drawer with Smooth Staggered Motion */
  .mobile-nav {
    flex: 1;
    padding: 1.25rem 0;
    overflow-y: auto;
  }

  .mobile-nav-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    margin: 0;
    padding: 0;
  }

  .mobile-nav-list li {
    opacity: 0;
    transform: translateX(16px);
    transition: opacity 0.35s cubic-bezier(0.16, 1, 0.3, 1), transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
    transition-delay: calc(0.05s + var(--item-index, 0) * 0.035s);
  }

  .mobile-menu.open .mobile-nav-list li {
    opacity: 1;
    transform: translateX(0);
  }

  .mobile-nav-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 44px;
    padding: 0 0.9rem;
    font-size: 0.95rem;
    font-weight: 600;
    color: #14143C;
    border-radius: 12px;
    text-decoration: none;
    transition: background-color 0.2s ease, color 0.2s ease, transform 0.2s cubic-bezier(0.16, 1, 0.3, 1);
    position: relative;
  }

  .mobile-nav-indicator {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background-color: transparent;
    margin-right: 0.65rem;
    transition: background-color 0.2s ease, transform 0.2s ease;
    flex-shrink: 0;
  }

  .mobile-nav-text {
    flex: 1;
    letter-spacing: -0.01em;
  }

  .mobile-nav-arrow {
    font-size: 0.95rem;
    color: rgba(20, 20, 60, 0.25);
    transition: transform 0.2s ease, color 0.2s ease;
    line-height: 1;
  }

  .mobile-nav-link:hover {
    background-color: rgba(91, 75, 240, 0.06);
    color: #5B4CF5;
    transform: translateX(3px);
  }

  .mobile-nav-link:hover .mobile-nav-indicator {
    background-color: #5B4CF5;
    transform: scale(1.3);
  }

  .mobile-nav-link:hover .mobile-nav-arrow {
    color: #5B4CF5;
    transform: translateX(3px);
  }

  .mobile-nav-link.active {
    background: linear-gradient(90deg, rgba(91, 75, 240, 0.09) 0%, rgba(232, 90, 160, 0.05) 100%);
    color: #5B4CF5;
    font-weight: 700;
  }

  .mobile-nav-link.active .mobile-nav-indicator {
    background: linear-gradient(135deg, #5B4CF5, #E85AA0);
    box-shadow: 0 0 6px rgba(91, 75, 240, 0.5);
  }

  .mobile-nav-link.active .mobile-nav-arrow {
    color: #5B4CF5;
  }

  /* Drawer Footer */
  .mobile-menu-footer {
    padding-top: 1.15rem;
    margin-top: auto;
    border-top: 1px solid rgba(120, 110, 220, 0.12);
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
    flex-shrink: 0;
  }

  .mobile-drawer-cta {
    width: 100%;
    min-height: 44px;
    font-size: 14px !important;
    display: flex !important;
    align-items: center;
    justify-content: center;
  }

  /* Social Icons Row */
  .mobile-drawer-socials {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    padding-top: 0.2rem;
  }

  .drawer-social-icon {
    width: 36px;
    height: 36px;
    border-radius: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(91, 75, 240, 0.05);
    border: 1px solid rgba(120, 110, 220, 0.12);
    color: #4A4A68;
    text-decoration: none;
    transition: background-color 0.2s ease, transform 0.2s ease, color 0.2s ease, border-color 0.2s ease;
  }

  .drawer-social-icon.linkedin:hover {
    background: #EBF4FC;
    color: #0A66C2;
    border-color: rgba(10, 102, 194, 0.3);
    transform: translateY(-2px);
  }

  .drawer-social-icon.instagram:hover {
    background: #FDF0F6;
    color: #E1306C;
    border-color: rgba(225, 48, 108, 0.3);
    transform: translateY(-2px);
  }

  .drawer-social-icon.youtube:hover {
    background: #FEF0F0;
    color: #FF0000;
    border-color: rgba(255, 0, 0, 0.3);
    transform: translateY(-2px);
  }

  .mobile-menu-contact {
    text-align: center;
    font-size: 0.76rem;
    color: var(--color-text-muted);
    line-height: 1.5;
  }

  .contact-email {
    margin: 0;
