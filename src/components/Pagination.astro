---
import { ChevronLeft, ChevronRight } from 'lucide-astro';

interface Props {
  currentPage: number;
  totalPages: number;
  baseUrl: string;
}

const { currentPage, totalPages, baseUrl } = Astro.props;

if (totalPages <= 1) {
  // Do not render pagination controls if there is only one page of results
}

const getPageUrl = (pageNumber: number) => {
  if (pageNumber === 1) {
    return baseUrl;
  }
  return `${baseUrl}/${pageNumber}`;
};

const prevUrl = currentPage > 1 ? getPageUrl(currentPage - 1) : null;
const nextUrl = currentPage < totalPages ? getPageUrl(currentPage + 1) : null;

// Generate page numbers
const pages = Array.from({ length: totalPages }, (_, i) => i + 1);
---

{totalPages > 1 && (
  <nav class="pagination-nav" aria-label="Pagination navigation">
    <div class="pagination-controls">
      {prevUrl ? (
        <a href={prevUrl} class="page-btn page-arrow" aria-label="Previous page">
          <ChevronLeft size={18} />
          <span class="btn-text">Prev</span>
        </a>
      ) : (
        <span class="page-btn page-arrow disabled" aria-disabled="true">
          <ChevronLeft size={18} />
          <span class="btn-text">Prev</span>
        </span>
      )}

      <div class="page-numbers">
        {pages.map((p) => {
          const isActive = p === currentPage;
          return (
            <a
              href={getPageUrl(p)}
              class={`page-btn page-num ${isActive ? 'active' : ''}`}
              aria-current={isActive ? 'page' : undefined}
            >
              {p}
            </a>
          );
        })}
      </div>

      {nextUrl ? (
        <a href={nextUrl} class="page-btn page-arrow" aria-label="Next page">
          <span class="btn-text">Next</span>
          <ChevronRight size={18} />
        </a>
      ) : (
        <span class="page-btn page-arrow disabled" aria-disabled="true">
          <span class="btn-text">Next</span>
          <ChevronRight size={18} />
        </span>
      )}
    </div>
  </nav>
)}

<style>
  .pagination-nav {
    display: flex;
    justify-content: center;
    margin-top: 2.5rem;
    margin-bottom: 2rem;
  }

  .pagination-controls {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    background: #FFFFFF;
    border: 1px solid rgba(15, 23, 42, 0.1);
    border-radius: 10px;
    padding: 0.3rem;
    box-shadow: 0 1px 3px rgba(15, 23, 42, 0.05);
  }

  .page-numbers {
    display: flex;
    align-items: center;
    gap: 0.25rem;
  }

  .page-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 2.1rem;
    height: 2.1rem;
    padding: 0 0.65rem;
    border-radius: 6px;
    font-size: var(--text-sm);
    font-weight: 500;
    text-decoration: none;
    color: #475569;
    transition: all 0.15s ease;
  }

  .page-btn:hover:not(.disabled):not(.active) {
    color: #1A085C;
    background: rgba(26, 8, 92, 0.05);
  }

  .page-btn.active {
    color: #FFFFFF;
    background: #1A085C;
    box-shadow: 0 1px 2px rgba(15, 23, 42, 0.1);
    cursor: default;
  }

  .page-arrow {
    gap: 0.25rem;
    padding: 0 0.75rem;
  }

  .page-btn.disabled {
    opacity: 0.35;
    cursor: not-allowed;
    pointer-events: none;
  }

  @media (max-width: 500px) {
    .btn-text {
      display: none;
    }
    .page-arrow {
      padding: 0 0.5rem;
      min-width: 2.1rem;
    }
  }
</style>
