---
import { ChevronLeft, ChevronRight } from 'lucide-astro';

interface Props {
  currentPage: number;
  totalPages: number;
  baseUrl: string;
}

const { currentPage, totalPages, baseUrl } = Astro.props;

if (totalPages <= 1) {
  // Do not render pagination controls if there is only one page of results
}

const getPageUrl = (pageNumber: number) => {
  if (pageNumber === 1) {
    return baseUrl;
  }
  return `${baseUrl}/${pageNumber}`;
};

const prevUrl = currentPage > 1 ? getPageUrl(currentPage - 1) : null;
const nextUrl = currentPage < totalPages ? getPageUrl(currentPage + 1) : null;

// Generate page numbers
const pages = Array.from({ length: totalPages }, (_, i) => i + 1);
---

{totalPages > 1 && (
  <nav class="pagination-nav" aria-label="Pagination navigation">
    <div class="pagination-controls">
      {prevUrl ? (
        <a href={prevUrl} class="page-btn page-arrow" aria-label="Previous page">
          <ChevronLeft size={18} />
          <span class="btn-text">Prev</span>
        </a>
      ) : (
        <span class="page-btn page-arrow disabled" aria-disabled="true">
          <ChevronLeft size={18} />
          <span class="btn-text">Prev</span>
        </span>
      )}

      <div class="page-numbers">
        {pages.map((p) => {
          const isActive = p === currentPage;
          return (
            <a
              href={getPageUrl(p)}
              class={`page-btn page-num ${isActive ? 'active' : ''}`}
              aria-current={isActive ? 'page' : undefined}
            >
              {p}
            </a>
          );
        })}
      </div>

      {nextUrl ? (
        <a href={nextUrl} class="page-btn page-arrow" aria-label="Next page">
          <span class="btn-text">Next</span>
          <ChevronRight size={18} />
        </a>
      ) : (
        <span class="page-btn page-arrow disabled" aria-disabled="true">
          <span class="btn-text">Next</span>
          <ChevronRight size={18} />
        </span>
      )}
    </div>
  </nav>
)}

<style>
  .pagination-nav {
    display: flex;
    justify-content: center;
    margin-top: 3.5rem;
    margin-bottom: 2rem;
  }

  .pagination-controls {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: var(--color-bg-card);
    border: 1px solid var(--color-border-card);
    border-radius: 9999px;
    padding: 0.375rem;
    box-shadow: 0 8px 24px -6px rgba(0, 0, 0, 0.3);
  }

  .page-numbers {
    display: flex;
    align-items: center;
    gap: 0.25rem;
  }

  .page-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 2.25rem;
    height: 2.25rem;
    padding: 0 0.75rem;
    border-radius: 9999px;
    font-size: var(--text-sm);
    font-weight: 600;
    text-decoration: none;
    color: var(--color-text-body);
    transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .page-btn:hover:not(.disabled):not(.active) {
    color: var(--color-text-heading);
    background: rgba(124, 92, 232, 0.1);
  }

  .page-btn.active {
    color: #FFFFFF;
    background: var(--brand-gradient);
    box-shadow: 0 4px 12px -2px rgba(124, 92, 232, 0.4);
    cursor: default;
  }

  .page-arrow {
    gap: 0.25rem;
    padding: 0 0.85rem;
  }

  .page-btn.disabled {
    opacity: 0.35;
    cursor: not-allowed;
    pointer-events: none;
  }

  @media (max-width: 500px) {
    .btn-text {
      display: none;
    }
    .page-arrow {
      padding: 0 0.5rem;
      min-width: 2.25rem;
    }
  }
</style>
