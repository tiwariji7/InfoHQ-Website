---
import type { CollectionEntry } from 'astro:content';
import { Brain, Globe, Workflow, Cloud, PenTool, LayoutGrid, ArrowRight, Rocket } from 'lucide-astro';
import { BLOG_CATEGORIES, calculateReadingTime, formatDate, getPostUrl, type BlogCategory } from '../utils/blog';

interface Props {
  post: CollectionEntry<'blog'>;
  featured?: boolean;
}

const { post, featured = false } = Astro.props;
const categoryKey = post.data.category as BlogCategory;
const categoryInfo = BLOG_CATEGORIES[categoryKey] || {
  id: categoryKey,
  name: categoryKey,
  tagline: '',
  title: '',
  description: '',
  icon: 'LayoutGrid'
};

const postUrl = getPostUrl(post.data.category, post.id);
const readingTime = calculateReadingTime(post.body || '');
const formattedDate = formatDate(post.data.pubDate);
const authorName = post.data.author || 'InfoHQ Team';
---

<article class={`blog-card ${featured ? 'featured' : ''}`}>
  <a href={postUrl} class="card-link-overlay" aria-label={`Read article: ${post.data.title}`}></a>
  
  <!-- 1. Image with rounded corners (16-20px) & equal height -->
  <div class="card-cover-wrap">
    {post.data.heroImage ? (
      <img 
        src={post.data.heroImage} 
        alt={post.data.title} 
        class="card-cover-image" 
        loading="lazy" 
        decoding="async"
      />
    ) : (
      <div class={`card-cover-fallback cat-${categoryKey}`}>
        <div class="fallback-glow" aria-hidden="true"></div>
        <div class="fallback-icon-wrap" aria-hidden="true">
          {categoryKey === 'ai' && <Brain size={44} class="cover-icon" />}
          {categoryKey === 'web' && <Globe size={44} class="cover-icon" />}
          {categoryKey === 'automation' && <Workflow size={44} class="cover-icon" />}
          {categoryKey === 'cloud' && <Cloud size={44} class="cover-icon" />}
          {categoryKey === 'startups' && <Rocket size={44} class="cover-icon" />}
          {categoryKey === 'design' && <PenTool size={44} class="cover-icon" />}
          {!['ai', 'web', 'automation', 'cloud', 'design'].includes(categoryKey) && <LayoutGrid size={44} class="cover-icon" />}
        </div>
      </div>
    )}
  </div>

  <div class="card-content">
    <div class="card-header-meta">
      <span class="card-date-badge">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="date-icon" aria-hidden="true">
          <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
          <line x1="16" y1="2" x2="16" y2="6"></line>
          <line x1="8" y1="2" x2="8" y2="6"></line>
          <line x1="3" y1="10" x2="21" y2="10"></line>
        </svg>
        <time datetime={new Date(post.data.pubDate).toISOString()}>{formattedDate}</time>
      </span>
    </div>

    <h3 class="card-title">
      <a href={postUrl}>{post.data.title}</a>
    </h3>

    <p class="card-description">{post.data.description}</p>

    <!-- 2. Premium footer: Author, reading time aligned + Read Article action -->
    <div class="card-footer">
      <div class="card-footer-meta">
        <img 
          src="/images/favicon.webp" 
          alt="InfoHQ" 
          class="meta-author-avatar" 
          width="20" 
          height="20" 
          loading="lazy" 
        />
        <span class="meta-author">{authorName}</span>
        <span class="meta-sep" aria-hidden="true">•</span>
        <span class="meta-read-time">{readingTime}</span>
      </div>

      <div class="card-read-action" aria-hidden="true">
        <span class="read-article-text">Read Article</span>
        <span class="read-arrow-badge">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="read-svg-arrow">
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </span>
      </div>
    </div>
  </div>
</article>

<style>
  .blog-card {
    position: relative;
    display: flex;
    flex-direction: column;
    background-color: var(--color-surface-white, #FFFFFF);
    border-radius: 14px;
    border: 1px solid rgba(15, 23, 42, 0.08);
    box-shadow: 0 1px 3px rgba(15, 23, 42, 0.04), 0 1px 2px rgba(15, 23, 42, 0.02);
    padding: 14px 14px 16px 14px;
    overflow: hidden;
    transition: transform 0.2s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.2s ease, border-color 0.2s ease;
    height: 100%;
  }

  .blog-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 4px 14px rgba(15, 23, 42, 0.08);
    border-color: rgba(26, 8, 92, 0.22);
  }

  .card-link-overlay {
    position: absolute;
    inset: 0;
    z-index: 1;
  }

  /* 1. Image with rounded corners & equal height */
  .card-cover-wrap {
    position: relative;
    width: 100%;
    height: 220px;
    border-radius: 10px;
    overflow: hidden;
    background: #F8FAFC;
    border: 1px solid rgba(15, 23, 42, 0.06);
    flex-shrink: 0;
  }

  .card-cover-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
    border-radius: 9px;
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .blog-card:hover .card-cover-image {
    transform: scale(1.02);
  }

  .card-cover-fallback {
    position: relative;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 9px;
    overflow: hidden;
  }

  .cat-ai { background: #F1F5F9; }
  .cat-web { background: #F8FAFC; }
  .cat-automation { background: #F1F5F9; }
  .cat-cloud { background: #F8FAFC; }
  .cat-startups { background: #F1F5F9; }
  .cat-design { background: #F8FAFC; }

  .fallback-glow {
    display: none;
  }

  .fallback-icon-wrap {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #1A085C;
    opacity: 0.75;
    transition: transform 0.2s ease;
  }

  .blog-card:hover .fallback-icon-wrap {
    transform: scale(1.04);
  }

  /* Card Content & Consistent Spacing */
  .card-content {
    display: flex;
    flex-direction: column;
    flex: 1;
    padding-top: 14px;
  }

  .card-header-meta {
    display: flex;
    align-items: center;
    margin-bottom: 10px;
  }

  .card-date-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 3px 8px;
    border-radius: 6px;
    font-size: 0.75rem;
    font-weight: 500;
    line-height: 1;
    background: #F8FAFC;
    color: #475569;
    border: 1px solid #E2E8F0;
  }

  .date-icon {
    flex-shrink: 0;
    color: #64748B;
  }

  .card-title {
    margin: 0 0 8px 0;
    font-size: 1.15rem;
    font-weight: 700;
    line-height: 1.35;
    color: #0F172A;
    letter-spacing: -0.015em;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    transition: color 0.15s ease;
  }

  .card-title a {
    color: inherit;
    text-decoration: none;
  }

  .blog-card:hover .card-title {
    color: #1A085C;
  }

  .card-description {
    margin: 0 0 14px 0;
    font-size: 0.9rem;
    line-height: 1.55;
    color: #64748B;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* 2. Premium Footer */
  .card-footer {
    margin-top: auto;
    padding-top: 12px;
    border-top: 1px solid rgba(15, 23, 42, 0.06);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }

  .card-footer-meta {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 0.8125rem;
    color: #64748B;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .meta-author-avatar {
    width: 18px;
    height: 18px;
    border-radius: 4px;
    object-fit: contain;
    flex-shrink: 0;
  }

  .meta-author {
    font-weight: 600;
    color: #0F172A;
  }

  .meta-sep {
    color: #CBD5E1;
    font-weight: 400;
  }

  .meta-date,
  .meta-read-time {
    color: #64748B;
  }

  /* Read Article Action */
  .card-read-action {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    white-space: nowrap;
    flex-shrink: 0;
  }

  .read-article-text {
    font-size: 0.8125rem;
    font-weight: 600;
    color: #1A085C;
    transition: opacity 0.15s ease;
  }

  .read-arrow-badge {
    width: 22px;
    height: 22px;
    border-radius: 6px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: rgba(26, 8, 92, 0.05);
    border: 1px solid rgba(26, 8, 92, 0.12);
    color: #1A085C;
    transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .read-svg-arrow {
    transition: transform 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .blog-card:hover .read-arrow-badge {
    background: #1A085C;
    border-color: #1A085C;
    color: #FFFFFF;
    transform: translateX(2px);
    box-shadow: 0 1px 3px rgba(15, 23, 42, 0.12);
  }

  /* Featured Card Variant */
  .blog-card.featured {
    display: grid;
    grid-template-columns: 1.15fr 1fr;
    height: auto;
    gap: 20px;
    padding: 18px;
    border-radius: 14px;
  }

  .blog-card.featured .card-cover-wrap {
    height: 100%;
    min-height: 260px;
  }

  .blog-card.featured .card-content {
    padding-top: 0;
    justify-content: center;
  }

  .blog-card.featured .card-title {
    font-size: clamp(1.25rem, 1.8vw, 1.6rem);
    line-height: 1.25;
  }

  .blog-card.featured .card-description {
    font-size: 0.95rem;
    line-height: 1.55;
    -webkit-line-clamp: 3;
  }

  @media (max-width: 900px) {
    .blog-card.featured {
      grid-template-columns: 1fr;
      padding: 14px 14px 16px 14px;
    }

    .blog-card.featured .card-cover-wrap {
      height: 200px;
      min-height: unset;
    }

    .blog-card.featured .card-content {
      padding-top: 14px;
    }
  }

  @media (max-width: 640px) {
    .blog-card {
      padding: 12px 12px 14px 12px;
      border-radius: 12px;
    }

    .card-cover-wrap {
      height: 180px;
      border-radius: 8px;
    }

    .card-cover-image {
      border-radius: 8px;
    }

    .card-title {
      font-size: 1.05rem;
    }

    .card-footer-meta {
      font-size: 0.75rem;
      gap: 4px;
    }
  }
</style>
