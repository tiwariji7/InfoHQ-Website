---
import { ArrowRight, Calendar, User } from 'lucide-astro';
import { BLOG_CATEGORIES_DATA } from '../data/blogCategories';

interface Props {
  post: any;
}

const { post } = Astro.props;
const data = post.data;
const categoryInfo = BLOG_CATEGORIES_DATA[data.category] || { label: data.category };
const postSlug = post.id ? post.id.replace(/\.[^/.]+$/, '') : (post.slug || '');
const postUrl = `/blog/${data.category}/${postSlug}`;

const formattedDate = new Intl.DateTimeFormat('en-US', {
  month: 'short',
  day: 'numeric',
  year: 'numeric'
}).format(new Date(data.pubDate));

const heroSrc = typeof data.heroImage === 'string' ? data.heroImage : data.heroImage?.src;
const heroAlt = (typeof data.heroImage === 'object' && data.heroImage?.alt) ? data.heroImage.alt : (data.heroImageAlt || data.title);
---

<article class="card blog-card">
  <a href={postUrl} class="card-media-link" tabindex="-1" aria-hidden="true">
    {heroSrc ? (
      <div class="card-media">
        <img
          src={heroSrc}
          alt={heroAlt}
          loading="lazy"
          decoding="async"
          class="card-img"
        />
        <span class="cat-chip">{categoryInfo.label}</span>
      </div>
    ) : (
      <div class="card-media-placeholder">
        <div class="placeholder-pattern" aria-hidden="true"></div>
        <span class="cat-chip">{categoryInfo.label}</span>
      </div>
    )}
  </a>

  <div class="card-content">
    <div class="card-meta">
      <span class="meta-item">
        <Calendar size={14} class="meta-icon" />
        <time datetime={new Date(data.pubDate).toISOString()}>{formattedDate}</time>
      </span>
      <span class="meta-dot">&bull;</span>
      <span class="meta-item">
        <User size={14} class="meta-icon" />
        <span>{data.author || 'InfoHQ Team'}</span>
      </span>
    </div>

    <h3 class="card-title">
      <a href={postUrl} class="title-link">{data.title}</a>
    </h3>

    <p class="card-summary">{data.description}</p>

    <div class="card-footer">
      <a href={postUrl} class="read-more-link">
        <span>Read Article</span>
        <ArrowRight size={16} class="arrow-icon" />
      </a>
    </div>
  </div>
</article>

<style>
  .blog-card {
    display: flex;
    flex-direction: column;
    padding: 0;
    overflow: hidden;
    height: 100%;
    transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.25s ease, border-color 0.25s ease;
  }

  .blog-card:hover {
    transform: translateY(-4px);
    border-color: rgba(124, 92, 232, 0.4);
    box-shadow: 0 16px 36px -12px rgba(124, 92, 232, 0.2);
  }

  .card-media-link {
    display: block;
    text-decoration: none;
    position: relative;
    overflow: hidden;
  }

  .card-media {
    position: relative;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: var(--color-bg-base);
  }

  .card-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .blog-card:hover .card-img {
    transform: scale(1.04);
  }

  .card-media-placeholder {
    position: relative;
    aspect-ratio: 16 / 9;
    background: linear-gradient(135deg, rgba(124, 92, 232, 0.15) 0%, rgba(243, 84, 151, 0.1) 100%), var(--color-bg-card);
    border-bottom: 1px solid var(--color-border-card);
    overflow: hidden;
  }

  .placeholder-pattern {
    position: absolute;
    inset: 0;
    opacity: 0.15;
    background-image: radial-gradient(circle at 2px 2px, var(--color-primary) 1px, transparent 0);
    background-size: 16px 16px;
  }

  .cat-chip {
    position: absolute;
    bottom: 1rem;
    left: 1rem;
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    padding: 3px 10px;
    border-radius: var(--radius-sm);
    background: rgba(14, 12, 21, 0.85);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    color: #FFFFFF;
    border: 1px solid rgba(255, 255, 255, 0.15);
  }

  .card-content {
    display: flex;
    flex-direction: column;
    flex: 1;
    padding: clamp(1.25rem, 2.5vw, 1.75rem);
  }

  .card-meta {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    margin-bottom: 0.75rem;
  }

  .meta-item {
    display: inline-flex;
    align-items: center;
    gap: 4px;
  }

  .meta-icon {
    color: var(--color-primary);
  }

  .meta-dot {
    color: var(--color-border-card);
  }

  .card-title {
    font-size: var(--text-xl);
    line-height: 1.35;
    margin-bottom: 0.75rem;
  }

  .title-link {
    color: var(--color-text-heading);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .title-link:hover {
    color: var(--color-primary);
  }

  .card-summary {
    font-size: var(--text-sm);
    color: var(--color-text-body);
    line-height: 1.6;
    margin-bottom: 1.5rem;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .card-footer {
    margin-top: auto;
    padding-top: 1rem;
    border-top: 1px solid var(--color-border-card);
  }

  .read-more-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-primary);
    text-decoration: none;
    transition: gap 0.2s ease, color 0.2s ease;
  }

  .read-more-link:hover {
    gap: 10px;
    color: var(--color-grad-pink);
  }

  .arrow-icon {
    transition: transform 0.2s ease;
  }

  .read-more-link:hover .arrow-icon {
    transform: translateX(2px);
  }
</style>
