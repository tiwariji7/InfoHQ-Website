---
import { BLOG_CATEGORY_LIST } from '../data/blogCategories';

interface Props {
  activeCategory?: string | null;
}

const { activeCategory = null } = Astro.props;

const items = [
  { slug: null, label: 'All', href: '/blogs/' },
  ...BLOG_CATEGORY_LIST.map((cat) => ({
    slug: cat.slug,
    label: cat.label,
    href: `/blogs/${cat.slug}/`
  }))
];
---

<nav class="category-pills-nav" aria-label="Blog categories">
  <div class="category-pills-scroll">
    {items.map((item) => {
      const isActive = item.slug === activeCategory || (!item.slug && !activeCategory);
      return (
        <a
          href={item.href}
          class={`cat-pill ${isActive ? 'active' : ''}`}
          aria-current={isActive ? 'page' : undefined}
        >
          <span class="pill-label">{item.label}</span>
        </a>
      );
    })}
  </div>
</nav>

<style>
  .category-pills-nav {
    width: 100%;
    margin: 1.5rem 0 2.5rem;
  }

  .category-pills-scroll {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    overflow-x: auto;
    padding: 0.25rem;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
  }

  .category-pills-scroll::-webkit-scrollbar {
    display: none;
  }

  .cat-pill {
    display: inline-flex;
    align-items: center;
    padding: 0.45rem 1rem;
    border-radius: 8px;
    font-size: 0.875rem;
    font-weight: 500;
    text-decoration: none;
    color: #475569;
    background: #FFFFFF;
    border: 1px solid rgba(15, 23, 42, 0.1);
    transition: all 0.15s ease;
    white-space: nowrap;
    flex-shrink: 0;
  }

  .cat-pill:hover {
    color: #0F172A;
    border-color: rgba(26, 8, 92, 0.25);
    background: rgba(26, 8, 92, 0.03);
  }

  .cat-pill.active {
    color: #FFFFFF;
    background: #1A085C;
    border-color: #1A085C;
    box-shadow: 0 1px 2px rgba(15, 23, 42, 0.1);
  }

  .cat-pill:focus-visible {
    outline: 2px solid #1A085C;
    outline-offset: 2px;
  }

  @media (max-width: 767px) {
    .category-pills-scroll {
      justify-content: flex-start;
      padding-left: 0.25rem;
      padding-right: 0.25rem;
    }
  }
</style>
