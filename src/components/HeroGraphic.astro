    font-weight: 700;
    margin-bottom: 6px;
    padding-left: 2px;
    font-size: 0.68rem;
  }

  .file-tree {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .tree-item {
    display: flex;
    align-items: center;
    gap: 5px;
    padding: 1.5px 4px;
    border-radius: 3px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .tree-arrow {
    font-size: 0.72rem;
    line-height: 1;
    color: #475569;
  }

  .tree-file-active {
    background: rgba(56, 189, 248, 0.12);
    color: #38BDF8;
    font-weight: 600;
  }

  .file-icon {
    font-size: 0.58rem;
    font-weight: 800;
    color: #38BDF8;
    background: rgba(56, 189, 248, 0.2);
