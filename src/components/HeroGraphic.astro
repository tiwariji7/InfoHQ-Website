---
// InfoHQ Hero Interactive UI Composition
// Design specifications:
// - Generous, well-proportioned code editor window (comfortable font & height for desktop)
// - Floating "Automation Active" status badge (~60% protruding outside top-right)
// - Floating "Workflow performance +68%" chart card (~60% protruding outside right edge)
// - Floating "Automated Workflow" checklist card (~60% protruding outside bottom-left)
// - Floating "Integrates with your tools" card (~80% protruding outside bottom-right)
// - Connecting dashed curved arrows pointing in correct directions:
//   1. Top arrow: curves down from Automation Active, pointing DOWN (↓) into Performance chart
//   2. Bottom arrow: curves from checklist, pointing RIGHT (→) towards Integrates with your tools
// - Seamless proportional scaling on all mobile, tablet, and desktop screens
---

<div class="hero-composition" id="heroComposition" aria-label="InfoHQ Code & Automation Showcase">
  <div class="composition-canvas" id="compositionCanvas">
    
    <!-- 1. Floating Badge: Automation Active (Top Right - ~60% outside) -->
    <div class="floating-badge badge-automation" aria-hidden="true">
      <div class="badge-icon-box">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor">
          <path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"></path>
        </svg>
      </div>
      <div class="badge-text-group">
        <span class="badge-main-title">Automation Active</span>
        <span class="badge-sub-status">
          <span class="status-pulse-dot"></span>
          Running smoothly
        </span>
      </div>
    </div>

    <!-- Curved connecting arrow: Automation -> Performance Chart (Pointing DOWN into chart) -->
    <svg class="curved-arrow arrow-top-right" width="44" height="40" viewBox="0 0 44 40" fill="none" aria-hidden="true">
      <path d="M 6 2 C 28 6, 34 16, 24 28" stroke="#818CF8" stroke-width="1.6" stroke-dasharray="3.5 3.5" stroke-linecap="round"></path>
      <polygon points="19,25 24,33 29,25" fill="#818CF8"></polygon>
    </svg>

    <!-- 2. Main Dark Code Editor Window (Wide & Well Proportioned) -->
    <div class="code-editor-window">
      <!-- Editor Top Bar -->
      <div class="editor-header">
        <div class="window-controls" aria-hidden="true">
          <span class="ctrl-dot dot-close"></span>
          <span class="ctrl-dot dot-min"></span>
          <span class="ctrl-dot dot-expand"></span>
        </div>

        <div class="editor-tabs">
          <div class="editor-tab tab-active">
            <span class="tab-indicator-dot"></span>
            <span class="tab-name">api.ts</span>
          </div>
          <div class="editor-tab tab-inactive">
            <span class="tab-name">dashboard.tsx</span>
          </div>
          <div class="editor-tab tab-inactive">
            <span class="tab-name">routes.ts</span>
          </div>
        </div>
      </div>

      <!-- Editor Main Layout: Sidebar Tree + Code Content -->
      <div class="editor-body">
        <!-- Sidebar Tree -->
        <div class="editor-sidebar" aria-hidden="true">
          <div class="sidebar-project-name">infohq</div>
          <div class="file-tree">
            <div class="tree-item"><span class="tree-arrow">&#8250;</span> apps</div>
            <div class="tree-item"><span class="tree-arrow">&#8250;</span> web</div>
            <div class="tree-item"><span class="tree-arrow">&#8250;</span> components</div>
            <div class="tree-item"><span class="tree-arrow">&#8250;</span> lib</div>
            <div class="tree-item"><span class="tree-arrow">&#8250;</span> services</div>
            <div class="tree-item tree-file-active">
              <span class="file-icon">TS</span>
              api.ts
            </div>
            <div class="tree-item"><span class="tree-arrow">&#8250;</span> utils</div>
          </div>
        </div>

        <!-- Code Area with Line Numbers & Syntax Colors -->
        <div class="editor-code-area">
          <pre class="code-pre"><code><span class="code-line"><span class="ln">1</span><span class="tok-comment">// AI Automation Pipeline</span></span>
<span class="code-line"><span class="ln">2</span><span class="tok-kw">export async function</span> <span class="tok-fn">processInquiry</span>(<span class="tok-param">lead</span>: <span class="tok-type">Lead</span>) &#123;</span>
<span class="code-line"><span class="ln">3</span>  <span class="tok-kw">const</span> <span class="tok-var">enriched</span> = <span class="tok-kw">await</span> <span class="tok-builtin">ai</span>.<span class="tok-fn">qualify</span>(<span class="tok-var">lead</span>);</span>
<span class="code-line"><span class="ln">4</span>  <span class="tok-kw">await</span> <span class="tok-builtin">crm</span>.<span class="tok-fn">sync</span>(&#123; ...<span class="tok-var">lead</span>, <span class="tok-prop">score</span>: <span class="tok-var">enriched</span>.<span class="tok-prop">score</span> &#125;);</span>
<span class="code-line"><span class="ln">5</span>  <span class="tok-kw">await</span> <span class="tok-builtin">notify</span>.<span class="tok-fn">slack</span>(&#123; <span class="tok-prop">channel</span>: <span class="tok-str">'#leads'</span>, <span class="tok-prop">lead</span> &#125;);</span>
<span class="code-line"><span class="ln">6</span>  <span class="tok-kw">return</span> &#123; <span class="tok-prop">status</span>: <span class="tok-str">'synced'</span>, <span class="tok-prop">success</span>: <span class="tok-builtin">true</span> &#125;;</span>
<span class="code-line"><span class="ln">7</span>&#125;</span></code></pre>
        </div>
      </div>
    </div>

    <!-- 3. Floating Card: Workflow Performance Chart (~60% outside code window) -->
    <div class="floating-card card-performance">
      <div class="perf-header">
        <span class="perf-title">Workflow performance</span>
        <div class="perf-dropdown">
          <span>Last 30 days</span>
          <svg width="9" height="9" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <polyline points="6 9 12 15 18 9"></polyline>
          </svg>
        </div>
      </div>

      <div class="perf-metric-group">
        <div class="perf-metric-val">+ 68%</div>
        <div class="perf-metric-desc">More inquiries processed</div>
      </div>

      <!-- Area Chart SVG -->
      <div class="perf-chart-wrap" aria-hidden="true">
        <svg class="chart-svg" viewBox="0 0 200 40" preserveAspectRatio="none">
          <defs>
            <linearGradient id="chartGradient" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0%" stop-color="#6366F1" stop-opacity="0.3" />
              <stop offset="100%" stop-color="#6366F1" stop-opacity="0.0" />
            </linearGradient>
          </defs>
          <path 
            d="M 0 35 C 20 35, 35 30, 50 28 C 70 24, 85 27, 105 20 C 125 15, 140 18, 160 10 C 180 5, 190 7, 200 2 L 200 40 L 0 40 Z" 
            fill="url(#chartGradient)"
          />
          <path 
            d="M 0 35 C 20 35, 35 30, 50 28 C 70 24, 85 27, 105 20 C 125 15, 140 18, 160 10 C 180 5, 190 7, 200 2" 
            fill="none" 
            stroke="#6366F1" 
            stroke-width="2.2" 
            stroke-linecap="round"
          />
        </svg>
      </div>

      <div class="perf-timeline-labels" aria-hidden="true">
        <span>1 Oct</span>
        <span>8 Oct</span>
        <span>16 Oct</span>
        <span>24 Oct</span>
        <span>31 Oct</span>
      </div>
    </div>

    <!-- 4. Floating Card: Automated Workflow Checklist (~60% outside code window) -->
    <div class="floating-card card-workflow">
      <div class="workflow-header">Automated Workflow</div>
      <div class="workflow-checklist">
        <!-- Item 1 -->
        <div class="wf-item">
          <div class="wf-check-badge">
            <svg width="9" height="9" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
          </div>
          <span class="wf-item-label">Lead captured</span>
          <span class="wf-item-time">2s ago</span>
        </div>

        <!-- Item 2 -->
        <div class="wf-item">
          <div class="wf-check-badge">
            <svg width="9" height="9" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
          </div>
          <span class="wf-item-label">Data synced</span>
          <span class="wf-item-time">2s ago</span>
        </div>

        <!-- Item 3 -->
        <div class="wf-item">
          <div class="wf-check-badge">
            <svg width="9" height="9" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
          </div>
          <span class="wf-item-label">Follow-up sent</span>
          <span class="wf-item-time">3s ago</span>
        </div>
      </div>
    </div>

    <!-- Curved connecting arrow: Workflow Checklist -> Integrations Bar (Pointing RIGHT towards tools) -->
    <svg class="curved-arrow arrow-bottom-middle" width="200" height="32" viewBox="0 0 200 32" fill="none" aria-hidden="true">
      <path d="M 6 8 C 70 24, 130 24, 188 14" stroke="#818CF8" stroke-width="1.6" stroke-dasharray="3.5 3.5" stroke-linecap="round"></path>
      <polygon points="185,9 194,14 185,19" fill="#818CF8"></polygon>
    </svg>

    <!-- 5. Floating Card: Integrates With Your Tools (Bottom Right - ~80% outside) -->
    <div class="floating-card card-integrations">
      <div class="integrations-label">Integrates with your tools</div>
      <div class="tools-icon-row">
        <!-- Database -->
        <div class="tool-icon-pill" title="Database Sync">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#334155" stroke-width="2">
            <ellipse cx="12" cy="5" rx="9" ry="3"></ellipse>
            <path d="M3 5V19A9 3 0 0 0 21 19V5"></path>
            <path d="M3 12A9 3 0 0 0 21 12"></path>
          </svg>
        </div>

        <!-- Google Drive -->
        <div class="tool-icon-pill" title="Google Drive">
          <svg width="15" height="15" viewBox="0 0 24 24">
            <path d="M8.5 2h7l6 10.5h-7z" fill="#FFC107"/>
            <path d="M14.5 12.5l-6 10.5H1.5l6-10.5z" fill="#0066DA"/>
            <path d="M8.5 22.5h7l6-10h-7z" fill="#00AC47"/>
          </svg>
        </div>

        <!-- Slack -->
        <div class="tool-icon-pill" title="Slack">
          <svg width="15" height="15" viewBox="0 0 24 24">
            <path d="M6 15a2 2 0 1 1-2-2h2v2zM7 15a2 2 0 0 1 4 0v5a2 2 0 1 1-4 0v-5z" fill="#E01E5A"/>
            <path d="M9 6a2 2 0 1 1 2-2v2H9zM9 7a2 2 0 0 1 0 4H4a2 2 0 1 1 0-4h5z" fill="#36C5F0"/>
            <path d="M18 9a2 2 0 1 1 2 2h-2V9zM17 9a2 2 0 0 1-4 0V4a2 2 0 1 1 4 0v5z" fill="#2EB67D"/>
            <path d="M15 18a2 2 0 1 1-2 2v-2h2zM15 17a2 2 0 0 1 0-4h5a2 2 0 1 1 0 4h-5z" fill="#ECB22E"/>
          </svg>
        </div>

        <!-- Notion -->
        <div class="tool-icon-pill" title="Notion">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="#1E293B">
            <path d="M4.4 3.7c.6.5.9.6 1.8.6h12c.7 0 1-.2 1.5-.6.5-.4.8-.4 1.2-.4.4 0 .9.3 1.1.6.3.3.4.7.4 1.2v13.8c0 .8-.3 1.3-.9 1.7-.5.4-1.2.6-2 .6H5.2c-.8 0-1.4-.2-1.9-.6-.5-.4-.8-1-.8-1.7V5.5c0-.6.2-1.1.6-1.4.3-.3.8-.4 1.3-.4zm2.1 3.5v11.6h11V7.2H6.5zm2.2 2.2h1.8l3.6 5.5V9.4h1.7v7.2h-1.6l-3.8-5.7v5.7H8.7V9.4z"/>
          </svg>
        </div>

        <!-- HubSpot -->
        <div class="tool-icon-pill" title="HubSpot CRM">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="#FF7A59">
            <circle cx="16.5" cy="5.5" r="2.5"></circle>
            <circle cx="12" cy="12" r="3"></circle>
            <circle cx="6" cy="14" r="2"></circle>
            <circle cx="18" cy="18" r="2"></circle>
            <path d="M15 7.5L13.5 9.5M10.5 13.5L7.5 13.5M13.5 14L16.5 16.5" stroke="#FF7A59" stroke-width="1.8" stroke-linecap="round"></path>
          </svg>
        </div>

        <!-- Plus indicator -->
        <div class="tool-icon-pill tool-more-badge" title="More integrations">
          +
        </div>
      </div>
    </div>

  </div>
</div>

<script is:inline>
  (function () {
    function setupHeroScale() {
      const comp = document.getElementById('heroComposition');
      const canvas = document.getElementById('compositionCanvas');
      if (!comp || !canvas) return;

      const BASE_W = 710;
      const BASE_H = 395;

      function applyScale() {
        const parentW = comp.parentElement ? comp.parentElement.clientWidth : 0;
        const screenW = window.innerWidth - 32;
        const availableW = parentW > 0 ? Math.min(parentW, screenW, BASE_W) : Math.min(screenW, BASE_W);
        const scale = Math.min(1, Math.max(0.35, availableW / BASE_W));
        canvas.style.transform = `scale(${scale})`;
        comp.style.width = `${BASE_W * scale}px`;
        comp.style.height = `${BASE_H * scale}px`;
      }

      applyScale();

      if (window.ResizeObserver && comp.parentElement) {
        new ResizeObserver(applyScale).observe(comp.parentElement);
      } else {
        window.addEventListener('resize', applyScale);
      }
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', setupHeroScale);
    } else {
      setupHeroScale();
    }
  })();
</script>

<style>
  .hero-composition {
    position: relative;
    width: 100%;
    max-width: 710px;
    height: 395px;
    margin: 0 auto;
    padding: 0;
    user-select: none;
    overflow: visible;
    display: flex;
    justify-content: center;
  }

  .composition-canvas {
    position: relative;
    width: 710px;
    height: 395px;
    flex-shrink: 0;
    transform-origin: top left;
    transition: transform 0.15s ease-out;
  }

  /* -------------------------------------------
     1. Main Dark Code Editor Window (Wide & Well Proportioned)
     ------------------------------------------- */
  .code-editor-window {
    background: #0B0F19;
    border-radius: 14px;
    border: 1px solid rgba(255, 255, 255, 0.1);
    box-shadow: 
      0 20px 50px -12px rgba(15, 9, 38, 0.38),
      0 0 0 1px rgba(255, 255, 255, 0.05);
    overflow: hidden;
    position: absolute;
    top: 24px;
    left: 35px;
    width: 540px;
    height: 326px;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .editor-header {
    display: flex;
    align-items: center;
    padding: 8px 14px;
    background: #080C14;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
    gap: 12px;
  }

  .window-controls {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .ctrl-dot {
    width: 9px;
    height: 9px;
    border-radius: 50%;
  }

  .dot-close { background-color: #EF4444; }
  .dot-min { background-color: #F59E0B; }
  .dot-expand { background-color: #10B981; }

  .editor-tabs {
    display: flex;
    align-items: center;
    gap: 4px;
  }

  .editor-tab {
    font-size: 0.72rem;
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    padding: 3px 10px;
    border-radius: 5px;
    display: flex;
    align-items: center;
    gap: 6px;
    transition: background 0.2s ease, color 0.2s ease;
  }

  .tab-active {
    background: #171E2E;
    color: #F8FAFC;
    font-weight: 500;
  }

  .tab-indicator-dot {
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: #38BDF8;
  }

  .tab-inactive {
    color: #64748B;
  }

  /* Editor Body */
  .editor-body {
    display: grid;
    grid-template-columns: 88px 1fr;
    height: calc(100% - 37px);
  }

  .editor-sidebar {
    background: #080C14;
    border-right: 1px solid rgba(255, 255, 255, 0.06);
    padding: 10px 6px;
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.67rem;
