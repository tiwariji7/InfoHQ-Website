---
// Hero Dashboard Graphic matching design-brand-reference.md tokens
---

<div class="hero-visual-card" aria-label="InfoHQ AI & Software Architecture Overview">
  <div class="card-inner-frame">
    <!-- Window Bar -->
    <div class="mockup-window-bar">
      <div class="window-dots">
        <span class="dot dot-coral"></span>
        <span class="dot dot-pink"></span>
        <span class="dot dot-purple"></span>
      </div>
      <div class="window-search-pill">
        <span class="pill-dot"></span>
        <span class="pill-text">infohq.in &bull; AI Agent & Cloud Orchestration</span>
      </div>
      <div class="window-status-badge">
        <span class="live-dot"></span>
        <span class="status-label">Engine Online</span>
      </div>
    </div>

    <!-- Main Mockup Grid -->
    <div class="mockup-grid">
      <!-- Left Metric / Balance Card (sampled from reference #7775FA -> #7060F4) -->
      <div class="metric-card-balance">
        <div class="balance-header">
          <span class="balance-tag">ACTIVE REPOSITORY</span>
          <span class="balance-uptime">99.99% Uptime</span>
        </div>
        <div class="balance-value">v2.4.0 Production</div>
        <p class="balance-sub">Multi-tenant Cloudflare Edge &bull; Postgres vector</p>
        
        <div class="balance-stats-row">
          <div class="b-stat">
            <span class="b-val">&lt; 42ms</span>
            <span class="b-lbl">Avg Response</span>
          </div>
          <div class="b-stat">
            <span class="b-val">100%</span>
            <span class="b-lbl">IP Ownership</span>
          </div>
        </div>
      </div>

      <!-- Center Telemetry & Integrations Hub -->
      <div class="telemetry-hub-card">
        <div class="hub-header">
          <span class="hub-title">Unified Stack Integrations</span>
          <span class="hub-badge">Automated Sync</span>
        </div>

        <div class="integrations-pill-grid">
          <!-- WhatsApp style tile (#E3FFFF) -->
          <div class="int-tile tile-cyan" title="WhatsApp Business API">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#009688" stroke-width="2"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/></svg>
            <span class="tile-name">WhatsApp API</span>
          </div>

          <!-- Messenger style tile (#F5E8FF) -->
          <div class="int-tile tile-lavender" title="LLM Agent & RAG">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#7C5CE8" stroke-width="2"><path d="m18 16 4-4-4-4"/><path d="m6 8-4 4 4 4"/><path d="m14.5 4-5 16"/></svg>
            <span class="tile-name">Claude / OpenAI</span>
          </div>

          <!-- Green style tile (#C8F7C3) -->
          <div class="int-tile tile-green" title="Payment Gateway">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#1B5E20" stroke-width="2"><rect width="20" height="14" x="2" y="5" rx="2"/><line x1="2" x2="22" y1="10" y2="10"/></svg>
            <span class="tile-name">Stripe / Razorpay</span>
          </div>

          <!-- Figma style tile (#8B64F3) -->
          <div class="int-tile tile-figma" title="Figma Design Systems">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#FFFFFF" stroke-width="2"><path d="M5 5.5A3.5 3.5 0 0 1 8.5 2H12v7H8.5A3.5 3.5 0 0 1 5 5.5z"/><path d="M12 2h3.5a3.5 3.5 0 1 1 0 7H12V2z"/><path d="M12 12.5a3.5 3.5 0 1 1 7 0 3.5 3.5 0 1 1-7 0z"/><path d="M5 19.5A3.5 3.5 0 0 1 8.5 16H12v3.5a3.5 3.5 0 1 1-7 0z"/><path d="M5 12.5A3.5 3.5 0 0 1 8.5 9H12v7H8.5A3.5 3.5 0 0 1 5 12.5z"/></svg>
            <span class="tile-name">Figma Systems</span>
          </div>

          <!-- Voice tile (#DACCF0) -->
          <div class="int-tile tile-voice" title="Cloud Infrastructure">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#4A148C" stroke-width="2"><path d="M17.5 19H9a7 7 0 1 1 6.71-9h1.79a4.5 4.5 0 1 1 0 9Z"/></svg>
            <span class="tile-name">Cloudflare / AWS</span>
          </div>

          <!-- Dark Indigo Center (#081E71) -->
          <div class="int-tile tile-indigo" title="PostgreSQL Vector DB">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#FFFFFF" stroke-width="2"><ellipse cx="12" cy="5" rx="9" ry="3"/><path d="M3 5V19A9 3 0 0 0 21 19V5"/><path d="M3 12A9 3 0 0 0 21 12"/></svg>
            <span class="tile-name">Postgres pgvector</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Active Pipeline Bar -->
    <div class="pipeline-bar">
      <div class="pipe-node active">
        <span class="node-indicator"></span>
        <span class="node-title">Discovery</span>
      </div>
      <div class="pipe-connector"></div>
      <div class="pipe-node active">
        <span class="node-indicator"></span>
        <span class="node-title">Design System</span>
      </div>
      <div class="pipe-connector"></div>
      <div class="pipe-node active">
        <span class="node-indicator"></span>
        <span class="node-title">Full-Stack Build</span>
      </div>
      <div class="pipe-connector"></div>
      <div class="pipe-node active">
        <span class="node-indicator"></span>
        <span class="node-title">Deploy & Scale</span>
      </div>
    </div>
  </div>
</div>

<style>
  .hero-visual-card {
    position: relative;
    border-radius: var(--radius-2xl);
    padding: 2px;
    background: var(--brand-gradient);
    box-shadow: 0 24px 60px rgba(26, 8, 92, 0.16), 0 0 40px rgba(124, 92, 232, 0.15);
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.4s ease;
  }

  .hero-visual-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 30px 70px rgba(26, 8, 92, 0.22), 0 0 50px rgba(124, 92, 232, 0.25);
  }

  .card-inner-frame {
    background: #FFFFFF;
    border-radius: calc(var(--radius-2xl) - 2px);
    padding: clamp(1rem, 2.5vw, 1.75rem);
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .mockup-window-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--color-border-card);
  }

  .window-dots {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
  }

  .dot-coral { background-color: var(--color-grad-coral); }
  .dot-pink { background-color: var(--color-grad-pink); }
  .dot-purple { background-color: var(--color-grad-purple); }

  .window-search-pill {
    display: flex;
    align-items: center;
    gap: 6px;
    background: #F4F3F9;
    padding: 4px 12px;
    border-radius: var(--radius-full);
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }

  .pill-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background-color: var(--color-primary);
  }

  .window-status-badge {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: var(--text-xs);
    font-weight: 600;
    color: #15803D;
    background: #DCFCE7;
    padding: 3px 8px;
    border-radius: var(--radius-full);
  }

  .live-dot {
    width: 6px;
    height: 6px;
    background-color: #22C55E;
    border-radius: 50%;
    animation: pulse 2s infinite;
  }

  @keyframes pulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.4; transform: scale(0.85); }
  }

  .mockup-grid {
    display: grid;
    grid-template-columns: 1fr 1.35fr;
    gap: 1.25rem;
  }

  /* Balance Card (#7775FA to #7060F4) */
  .metric-card-balance {
    background: linear-gradient(135deg, var(--color-balance-top) 0%, var(--color-balance-bottom) 100%);
    border-radius: var(--radius-xl);
    padding: 1.5rem;
    color: #FFFFFF;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    box-shadow: 0 10px 24px rgba(119, 117, 250, 0.35);
  }

  .balance-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.05em;
  }

  .balance-tag {
    opacity: 0.85;
  }

  .balance-uptime {
    background: rgba(255, 255, 255, 0.2);
    padding: 2px 8px;
    border-radius: var(--radius-full);
  }

  .balance-value {
    font-size: clamp(1.2rem, 2vw, 1.5rem);
    font-weight: 800;
    margin: 1rem 0 0.25rem;
  }

  .balance-sub {
    font-size: var(--text-xs);
    color: rgba(255, 255, 255, 0.85);
    margin-bottom: 1.25rem;
  }

  .balance-stats-row {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    padding-top: 1rem;
    border-top: 1px solid rgba(255, 255, 255, 0.15);
  }

  .b-stat {
    display: flex;
    flex-direction: column;
  }

  .b-val {
    font-size: var(--text-base);
    font-weight: 700;
  }

  .b-lbl {
    font-size: 0.7rem;
    opacity: 0.8;
  }

  /* Telemetry Hub */
  .telemetry-hub-card {
    background: #FAF9FE;
    border: 1px solid var(--color-border-card);
    border-radius: var(--radius-xl);
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .hub-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .hub-title {
    font-size: var(--text-sm);
    font-weight: 700;
    color: var(--color-text-heading);
  }

  .hub-badge {
    font-size: 0.7rem;
    font-weight: 600;
    color: var(--color-primary);
    background: var(--color-primary-light);
    padding: 2px 8px;
    border-radius: var(--radius-full);
  }

  .integrations-pill-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.75rem;
  }

  .int-tile {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.6rem 0.75rem;
    border-radius: var(--radius-md);
    font-size: 0.75rem;
    font-weight: 600;
    transition: transform 0.2s ease;
  }

  .int-tile:hover {
    transform: translateY(-2px);
  }

  .tile-cyan { background-color: var(--color-tint-cyan); color: #00695C; }
  .tile-lavender { background-color: var(--color-tint-lavender); color: #5B21B6; }
  .tile-green { background-color: var(--color-tint-green); color: #1B5E20; }
  .tile-figma { background-color: var(--color-tint-figma); color: #FFFFFF; }
  .tile-voice { background-color: var(--color-tint-voice); color: #4A148C; }
  .tile-indigo { background-color: var(--color-indigo-dark); color: #FFFFFF; }

  /* Pipeline Bar */
  .pipeline-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    background: #F4F3F9;
    padding: 0.75rem 1.25rem;
    border-radius: var(--radius-lg);
  }

  .pipe-node {
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }

  .node-indicator {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background-color: var(--color-primary);
  }

  .node-title {
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--color-text-heading);
  }

  .pipe-connector {
    flex: 1;
    height: 2px;
    background: rgba(124, 92, 232, 0.2);
    margin: 0 0.5rem;
  }

  @media (max-width: 640px) {
    .card-inner-frame {
      padding: 1rem 0.85rem;
    }
    .mockup-grid {
      grid-template-columns: 1fr;
    }
    .pipeline-bar {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.6rem;
    }
    .pipe-connector {
      display: none;
    }
  }

  @media (max-width: 480px) {
    .mockup-window-bar {
      flex-wrap: wrap;
      gap: 0.5rem;
      justify-content: space-between;
    }
    .window-search-pill {
      order: 3;
      width: 100%;
      justify-content: center;
    }
    .window-search-pill .pill-text {
      max-width: 220px;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }
    .integrations-pill-grid {
      grid-template-columns: 1fr;
    }
    .int-tile {
      padding: 0.55rem 0.75rem;
    }
  }
</style>
