---
import { Sparkles } from 'lucide-astro';
import Button from './Button.astro';

interface Props {
  page?: 'home' | 'services' | 'pricing' | 'portfolio' | 'company' | 'blogs' | 'contact' | 'service-detail' | 'blog-post';
  id?: string;
}

const { page = 'home', id = 'final-cta-section' } = Astro.props;

interface CTAConfig {
  headlinePrefix: string;
  headlineGradient: string;
  headlineSuffix?: string;
  body: string;
  primary: {
    label: string;
    href: string;
    icon?: 'arrow' | 'mail' | 'none';
  };
  secondary?: {
    label: string;
    href: string;
    icon?: 'arrow' | 'mail' | 'none';
  } | null;
}

const ctaConfigs: Record<string, CTAConfig> = {
  home: {
    headlinePrefix: 'Ready to Build Something That ',
    headlineGradient: 'Actually Scales?',
    body: "Tell us what you're working on — we'll get back within 1 business day with a clear plan from a senior engineer.",
    primary: {
      label: 'Get Free Consultation',
      href: '/contact',
      icon: 'arrow'
    },
    secondary: {
      label: 'Email Us Directly',
      href: 'mailto:contact@infohq.in',
      icon: 'mail'
    }
  },
  services: {
    headlinePrefix: 'Not Sure Which ',
    headlineGradient: 'Service You Need?',
    body: "Tell us your problem, not the solution — we'll figure out the right service mix for you.",
    primary: {
      label: 'Talk to Our Team',
      href: '/contact',
      icon: 'arrow'
    },
    secondary: {
      label: 'Email Us Directly',
      href: 'mailto:services@infohq.in',
      icon: 'mail'
    }
  },
  pricing: {
    headlinePrefix: 'Not Sure ',
    headlineGradient: 'Which Plan Fits?',
    body: "Tell us what you're running today — we'll tell you exactly which plan (or one-time project) makes sense.",
    primary: {
      label: 'Talk to Our Team',
      href: '/contact',
      icon: 'arrow'
    },
    secondary: {
      label: 'Email Us Directly',
      href: 'mailto:services@infohq.in',
      icon: 'mail'
    }
  },
  company: {
    headlinePrefix: 'Want to ',
    headlineGradient: 'Work With Us?',
    body: '',
    primary: {
      label: 'Get in Touch',
      href: '/contact',
      icon: 'arrow'
    },
    secondary: {
      label: 'Email Us Directly',
      href: 'mailto:contact@infohq.in',
      icon: 'mail'
    }
  },
  blogs: {
    headlinePrefix: 'Have a ',
    headlineGradient: 'Topic You Want Us to Cover?',
    body: '',
    primary: {
      label: 'Suggest a Topic',
      href: 'mailto:contact@infohq.in?subject=Blog%20topic%20suggestion',
      icon: 'mail'
    },
    secondary: null
  },
  portfolio: {
    headlinePrefix: 'Have a Project in Mind That Needs ',
    headlineGradient: 'Real Engineering?',
    body: "From fast MVPs to enterprise AI systems and continuous retainers — let's build your next success story.",
    primary: {
      label: 'Start Your Project',
      href: '/contact',
      icon: 'arrow'
    },
    secondary: {
      label: 'Email Us Directly',
      href: 'mailto:contact@infohq.in',
      icon: 'mail'
    }
  },
  contact: {
    headlinePrefix: 'Prefer to ',
    headlineGradient: 'Just Talk It Through?',
    body: 'Email us directly at contact@infohq.in — a real engineer will respond, not a bot.',
    primary: {
      label: 'Email Us Directly',
      href: 'mailto:contact@infohq.in',
      icon: 'mail'
    },
    secondary: null
  }
};

const activeConfig = ctaConfigs[page] || ctaConfigs['home'];
---

<section class="final-cta-section" id={id} aria-labelledby="final-cta-title">
  <div class="container cta-container-wrap">
    <div class="cta-banner">
      <!-- Subtle ambient background glow -->
      <div class="cta-ambient-glow" aria-hidden="true"></div>

      <!-- Main Banner Content -->
      <div class="cta-inner-content">
        <!-- Eyebrow Badge -->
        <div class="cta-badge">
          <Sparkles size={13} class="badge-sparkle" aria-hidden="true" />
          <span>LET'S BUILD TOGETHER</span>
        </div>

        <!-- Headline with Gradient text -->
        <h2 id="final-cta-title" class="cta-headline">
          {activeConfig.headlinePrefix}
          <span class="cta-gradient-text">{activeConfig.headlineGradient}</span>
          {activeConfig.headlineSuffix || ''}
        </h2>

        <!-- Body text -->
        <div class="cta-body-wrapper">
          {activeConfig.body ? (
            <p class="cta-body">{activeConfig.body}</p>
          ) : (
            <div class="cta-body-spacer" aria-hidden="true"></div>
          )}
        </div>

        <!-- Buttons Row -->
        <div class="cta-buttons-row">
          <Button
            variant="primary"
            size="lg"
            href={activeConfig.primary.href}
            label={activeConfig.primary.label}
            icon={activeConfig.primary.icon || 'arrow'}
          />

          {activeConfig.secondary && (
            <Button
              variant="secondary"
              tone="light"
              size="lg"
              href={activeConfig.secondary.href}
              label={activeConfig.secondary.label}
              icon={activeConfig.secondary.icon || 'mail'}
            />
          )}
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  // Hide sticky mobile CTA while any FinalCTA is in viewport
  function initFinalCTAObserver() {
    const finalCTAs = document.querySelectorAll('.final-cta-section');
    const stickyCTA = document.getElementById('sticky-mobile-cta');
    
    if (!finalCTAs.length || !stickyCTA) return;

    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          stickyCTA.classList.add('hidden-by-final-cta');
        } else {
          stickyCTA.classList.remove('hidden-by-final-cta');
        }
      });
    }, { threshold: 0.15 });

    finalCTAs.forEach(cta => observer.observe(cta));
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initFinalCTAObserver);
  } else {
    initFinalCTAObserver();
  }
</script>

<style>
  .final-cta-section {
    padding-top: clamp(3rem, 5vw, 4.5rem);
    padding-bottom: clamp(3.5rem, 6vw, 5rem);
    position: relative;
    background: transparent;
  }

  .cta-container-wrap {
    width: 100%;
  }

  /* Banner Card - Light, clean, refined */
  .cta-banner {
    position: relative;
    min-height: 280px;
    padding: clamp(36px, 5vw, 54px) clamp(20px, 4vw, 40px);
    border-radius: var(--radius-2xl);
    background: linear-gradient(135deg, #FFFFFF 0%, #FAF8FE 60%, #F3EFFE 100%);
    border: 1px solid var(--color-border-card);
    box-shadow: 0 20px 48px rgba(124, 92, 232, 0.08), 0 2px 10px rgba(20, 20, 60, 0.03);
    overflow: hidden;
    isolation: isolate;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  /* Subtle ambient background glow */
  .cta-ambient-glow {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: radial-gradient(circle at 12% 20%, rgba(221, 73, 133, 0.07) 0%, transparent 45%),
                radial-gradient(circle at 88% 80%, rgba(124, 92, 232, 0.09) 0%, transparent 50%);
    z-index: 1;
  }

  /* Inner Main Content */
  .cta-inner-content {
    position: relative;
    z-index: 2;
    text-align: center;
    max-width: 680px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
    margin: 0 auto;
  }

  /* Eyebrow badge */
  .cta-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 5px 14px;
    background: var(--color-primary-light);
    border: 1px solid rgba(124, 92, 232, 0.22);
    border-radius: var(--radius-full);
    color: var(--color-primary);
    font-size: 11.5px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .badge-sparkle {
    color: var(--color-grad-pink);
  }

  /* Headline - High contrast dark text */
  .cta-headline {
    color: var(--color-text-heading);
    font-weight: 800;
    font-size: clamp(26px, 3.2vw, 40px);
    line-height: 1.18;
    letter-spacing: -0.02em;
    margin: 0;
  }

  .cta-gradient-text {
    background: var(--brand-gradient);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    display: inline;
  }

  /* Body wrapper */
  .cta-body-wrapper {
    min-height: 24px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .cta-body {
    font-size: 16px;
    line-height: 1.6;
    color: var(--color-text-body);
    max-width: 580px;
    margin: 0;
  }

  .cta-body-spacer {
    height: 8px;
  }

  /* Buttons Row */
  .cta-buttons-row {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 14px;
    margin-top: 6px;
    flex-wrap: wrap;
  }

  /* Tablet Responsive (768 - 1023px) */
  @media (min-width: 768px) and (max-width: 1023px) {
    .cta-banner {
      border-radius: var(--radius-xl);
      padding: 38px 24px;
    }
  }

  /* Mobile Responsive (< 768px) */
  @media (max-width: 767px) {
    .final-cta-section {
      padding-top: 2.25rem;
      padding-bottom: 2.75rem;
    }

    .cta-banner {
      border-radius: var(--radius-xl);
      padding: 30px 18px;
      min-height: auto;
    }

    .cta-inner-content {
      width: 100%;
      max-width: 100%;
      gap: 14px;
    }

    .cta-headline {
      font-size: 24px;
      line-height: 1.25;
    }

    .cta-body {
      font-size: 14.5px;
      line-height: 1.5;
    }

    .cta-buttons-row {
      flex-direction: column;
      width: 100%;
      gap: 10px;
    }

    .cta-buttons-row :global(.infohq-btn) {
      width: 100%;
      justify-content: center;
    }
  }
</style>
