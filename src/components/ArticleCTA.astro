---
interface Props {
  href: string;
  label: string;
}

const { href = '/contact/', label } = Astro.props;
---

<div class="article-cta-wrapper">
  <a href={href} class="article-cta-btn">
    <span class="cta-label">{label}</span>
    <span class="cta-arrow" aria-hidden="true">&rarr;</span>
  </a>
</div>

<style>
  .article-cta-wrapper {
    margin: 2.25rem 0;
    display: flex;
  }

  .article-cta-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    padding: 0.8rem 1.6rem;
    background: #4F46E5;
    color: #FFFFFF !important;
    font-weight: 600;
    font-size: 0.95rem;
    border-radius: 8px;
    text-decoration: none !important;
    box-shadow: 0 1px 3px rgba(15, 23, 42, 0.1), inset 0 1px 0 rgba(255, 255, 255, 0.18);
    transition: background 0.15s ease, transform 0.15s ease;
  }

  .article-cta-btn:hover {
    background: #4338CA;
    transform: translateY(-1px);
    box-shadow: 0 2px 6px rgba(15, 23, 42, 0.14);
    color: #FFFFFF !important;
    text-decoration: none !important;
  }

  .cta-arrow {
    font-size: 1.15rem;
    transition: transform 0.2s ease;
  }

  .article-cta-btn:hover .cta-arrow {
    transform: translateX(3px);
  }

  @media (max-width: 640px) {
    .article-cta-btn {
      width: 100%;
      justify-content: center;
      text-align: center;
    }
  }
</style>

