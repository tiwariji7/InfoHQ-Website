---
import Button from './Button.astro';
import { Sparkles } from 'lucide-astro';

interface Props {
  text: string;
}

const { text } = Astro.props;
---

<aside class="blog-mid-cta" aria-label="Call to action">
  <div class="mid-cta-left">
    <div class="mid-cta-icon-box" aria-hidden="true">
      <Sparkles size={20} class="mid-cta-icon" />
    </div>
    <p class="mid-cta-text">{text}</p>
  </div>
  <div class="mid-cta-right">
    <Button
      variant="primary"
      size="md"
      href="/contact"
      label="Talk to Our Team"
      icon="arrow"
    />
  </div>
</aside>

<style>
  .blog-mid-cta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    margin: 2.5rem 0;
    padding: 24px 28px;
    background: #FAF8FD;
    border: 1px solid var(--color-border-card);
    border-radius: var(--radius-xl);
    box-shadow: var(--shadow-sm);
  }

  .mid-cta-left {
    display: flex;
    align-items: center;
    gap: 16px;
    flex: 1;
    min-width: 0;
  }

  .mid-cta-icon-box {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: var(--radius-md);
    background: rgba(124, 92, 232, 0.1);
    color: var(--color-primary);
    flex-shrink: 0;
  }

  .mid-cta-text {
    margin: 0;
    font-size: 1.0625rem;
    font-weight: 600;
    line-height: 1.4;
    color: var(--color-text-heading);
  }

  .mid-cta-right {
    flex-shrink: 0;
  }

  .mid-cta-right :global(.infohq-btn) {
    color: #FFFFFF !important;
    text-decoration: none !important;
  }

  .mid-cta-right :global(.infohq-btn .btn-label) {
    color: #FFFFFF !important;
  }

  .mid-cta-right :global(.infohq-btn:hover) {
    color: #FFFFFF !important;
    text-decoration: none !important;
  }

  @media (max-width: 640px) {
    .blog-mid-cta {
      flex-direction: column;
      align-items: flex-start;
      padding: 20px;
      gap: 16px;
    }

    .mid-cta-left {
      width: 100%;
    }

    .mid-cta-right {
      width: 100%;
    }

    .mid-cta-right :global(.infohq-btn) {
      width: 100%;
      justify-content: center;
    }
  }
</style>
