---
import { serviceSchemasRecord } from '../data/serviceSchemas';
import { contactConfig } from '../data/contactConfig';

interface Props {
  type?: 'home' | 'services' | 'service-detail' | 'pricing' | 'company' | 'blogs' | 'blog-category' | 'blog-post' | 'contact' | 'legal' | 'portfolio';
  serviceData?: {
    slug?: string;
    name: string;
    description: string;
    techStack?: string[];
    url: string;
  };
  postData?: any;
  customSchema?: Record<string, any>;
}

const { type = 'home', serviceData, postData, customSchema } = Astro.props;

// Confirmed Organization Schema (Steps 7 & 8)
// Social URLs confirmed from codebase: Instagram, YouTube, WhatsApp.
// Telephone field omitted until dedicated voice line is configured.
const organizationBase = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': 'https://infohq.in/#organization',
  name: 'InfoHQ',
  alternateName: 'Info HQ',
  url: 'https://infohq.in',
  logo: 'https://infohq.in/images/infohq-brandlogo.webp',
  description: 'InfoHQ is a Pune & Prayagraj-based AI and software engineering studio helping startups and enterprises across India build, automate, and grow — from custom AI systems to full-scale digital products.',
  email: 'contact@infohq.in',
  sameAs: [
    'https://linkedin.com/company/infohq',
    'https://www.instagram.com/infohq.in/',
    'https://www.youtube.com/@infohq28'
  ],
  contactPoint: [
    {
      '@type': 'ContactPoint',
      email: contactConfig.businessEmail,
      contactType: 'customer support',
      areaServed: 'IN'
    },
    {
      '@type': 'ContactPoint',
      email: contactConfig.servicesEmail,
      contactType: 'sales',
      areaServed: 'IN'
    },
    {
      '@type': 'ContactPoint',
      telephone: contactConfig.telephone,
      contactType: 'customer support',
      areaServed: 'IN'
    }
  ],
  areaServed: {
    '@type': 'Country',
    name: 'India'
  }
};

let schemas: any[] = [];

if (customSchema) {
  schemas.push(customSchema);
} else if (type === 'home') {
  // 1. Top-Level Organization Schema
  schemas.push(organizationBase);

  // 2. WebSite Schema (Homepage)
  schemas.push({
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    '@id': 'https://infohq.in/#website',
    name: 'InfoHQ',
    alternateName: 'Info HQ',
    url: 'https://infohq.in',
    publisher: {
      '@id': 'https://infohq.in/#organization'
    },
    inLanguage: 'en-IN'
  });

  // 3. FAQPage Schema (Home Page)
  schemas.push({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: [
      {
        '@type': 'Question',
        name: 'Do you only work with startups, or enterprises too?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'Both. Our One-Time Project model suits startups and new builds, while our Monthly Retainer plans (especially Technology Partner) are built for growing and enterprise-scale operations.'
        }
      },
      {
        '@type': 'Question',
        name: 'Do I own the code and IP?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'Yes — 100% client ownership on all code, design, and database schemas, always.'
        }
      },
      {
        '@type': 'Question',
        name: 'Do you work with businesses outside Pune/Prayagraj?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'Yes, we deliver pan-India — our physical presence is in Pune and Prayagraj, but our team works with clients anywhere in the country.'
        }
      }
    ]
  });
} else if (type === 'service-detail' && serviceData) {
  // Individual Service Page Schema (Steps 5 & 6)
  const slug = serviceData.slug || '';
  const schemaConfig = serviceSchemasRecord[slug];
  const serviceUrl = `https://infohq.in/services/${slug}/`;

  if (schemaConfig) {
    const offerPayload: Record<string, any> = {
      '@type': 'Offer',
      priceCurrency: 'INR',
      description: schemaConfig.priceDescription
    };

    // Only include price if not a Custom Quote
    if (schemaConfig.price) {
      offerPayload.price = schemaConfig.price;
    }

    schemas.push({
      '@context': 'https://schema.org',
      '@type': 'Service',
      '@id': `${serviceUrl}#service`,
      url: serviceUrl,
      serviceType: schemaConfig.serviceType,
      provider: {
        '@type': 'Organization',
        '@id': 'https://infohq.in/#organization',
        name: 'InfoHQ'
      },
      areaServed: 'IN',
      description: schemaConfig.description,
      hasOfferCatalog: {
        '@type': 'OfferCatalog',
        name: schemaConfig.category,
        itemListElement: schemaConfig.subFeatures.map((subFeature) => ({
          '@type': 'Offer',
          itemOffered: {
            '@type': 'Service',
            name: subFeature
          }
        }))
      },
      offers: offerPayload
    });
  } else {
    // Fallback if slug mapping not found
    schemas.push({
      '@context': 'https://schema.org',
      '@type': 'Service',
      '@id': `${serviceUrl}#service`,
      url: serviceUrl,
      serviceType: serviceData.name,
      provider: {
        '@type': 'Organization',
        '@id': 'https://infohq.in/#organization',
        name: 'InfoHQ'
      },
      areaServed: 'IN',
      description: serviceData.description
    });
  }

  // BreadcrumbList: Home > Services > [Service name]
  schemas.push({
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      {
        '@type': 'ListItem',
        position: 1,
        name: 'Home',
        item: 'https://infohq.in/'
      },
      {
        '@type': 'ListItem',
        position: 2,
        name: 'Services',
        item: 'https://infohq.in/services/'
      },
      {
        '@type': 'ListItem',
        position: 3,
        name: serviceData.name,
        item: serviceUrl
      }
    ]
  });
} else if (type === 'pricing') {
  schemas.push(organizationBase);

  // Retainers & One-Time Projects Offer Catalog
  schemas.push({
    '@context': 'https://schema.org',
    '@type': 'Service',
    serviceType: 'Engineering Retainers & Projects',
    name: 'InfoHQ Engineering Retainer & Project Plans',
    url: 'https://infohq.in/pricing/',
    provider: {
      '@type': 'Organization',
      '@id': 'https://infohq.in/#organization',
      name: 'InfoHQ',
      url: 'https://infohq.in'
    },
    areaServed: 'IN',
    hasOfferCatalog: {
      '@type': 'OfferCatalog',
      name: 'Engineering Retainers & One-Time Projects',
      itemListElement: [
        {
          '@type': 'Offer',
          itemOffered: {
            '@type': 'Service',
            name: 'Digital Starter Retainer'
          },
          price: '9999',
          priceCurrency: 'INR',
          description: 'Essential digital care and reliable routine maintenance for small businesses (₹9,999/month).'
        },
        {
          '@type': 'Offer',
          itemOffered: {
            '@type': 'Service',
            name: 'Business Growth Retainer'
          },
          price: '24999',
          priceCurrency: 'INR',
          description: '1 Dedicated Senior Engineer for continuous improvements, features, and fast problem solving (₹24,999/month).'
        },
        {
          '@type': 'Offer',
          itemOffered: {
            '@type': 'Service',
            name: 'Technology Partner Retainer'
          },
          price: '49999',
          priceCurrency: 'INR',
          description: '3-Person Dedicated Engineering Team for multi-system digital operations (₹49,999/month).'
        },
        {
          '@type': 'Offer',
          itemOffered: {
            '@type': 'Service',
            name: 'Business Website'
          },
          price: '14999',
          priceCurrency: 'INR',
          description: 'Custom responsive design, SEO optimization & meta setup, fast loading, mobile-ready, easy CMS content updates.'
        },
        {
          '@type': 'Offer',
          itemOffered: {
            '@type': 'Service',
            name: 'E-Commerce Website'
          },
          price: '29999',
          priceCurrency: 'INR',
          description: 'Full online store, payment gateway, product catalog & inventory sync, cart & checkout, automated notifications.'
        },
        {
          '@type': 'Offer',
          itemOffered: {
            '@type': 'Service',
            name: 'Web Application'
          },
          price: '24999',
          priceCurrency: 'INR',
          description: 'Dynamic database, user auth & roles, custom dashboard & admin views, REST/GraphQL API integrations.'
        },
        {
          '@type': 'Offer',
          itemOffered: {
            '@type': 'Service',
            name: 'Mobile Application'
          },
          price: '39999',
          priceCurrency: 'INR',
          description: 'iOS & Android app, push notification pipeline, offline caching, App Store & Play Store submission setup.'
        },
        {
          '@type': 'Offer',
          itemOffered: {
            '@type': 'Service',
            name: 'AI Solution'
          },
          price: '19999',
          priceCurrency: 'INR',
          description: 'Custom LLM integration, domain-specific RAG knowledge bot, automated workflow triggers, telemetry & logs.'
        },
        {
          '@type': 'Offer',
          itemOffered: {
            '@type': 'Service',
            name: 'SaaS Platform MVP'
          },
          price: '49999',
          priceCurrency: 'INR',
          description: 'Multi-tenant schema, Stripe/Razorpay automated subscription billing, user & team dashboard, admin telemetry.'
        },
        {
          '@type': 'Offer',
          itemOffered: {
            '@type': 'Service',
            name: 'Custom Software / ERP'
          },
          priceCurrency: 'INR',
          description: 'Bespoke enterprise system architecture, multi-role permissions, legacy migration, dedicated SLA & warranty.'
        }
      ]
    }
  });

  // FAQPage Schema (Pricing Page - Step 9)
  schemas.push({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: [
      {
        '@type': 'Question',
        name: 'What do I get with a monthly plan?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'Predictable monthly cost for continuous engineering capacity across your digital assets — maintenance, bug fixing, and feature additions.'
        }
      },
      {
        '@type': 'Question',
        name: 'Can you manage a website another developer built?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'Yes — we run a code and architecture audit first, then onboard it into our system.'
        }
      },
      {
        '@type': 'Question',
        name: 'Will a monthly plan build me a new website or app from scratch?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'No — monthly retainers are for maintaining and scaling existing systems. New projects are built under the fixed-scope milestone model.'
        }
      },
      {
        '@type': 'Question',
        name: 'Are hosting and API charges included?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'Technical setup and management are included. Third-party bills (AWS, Google Cloud, OpenAI API credits, domain) are paid directly from the client\'s own account, so ownership stays with the client.'
        }
      },
      {
        '@type': 'Question',
        name: 'Who owns the code and IP?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: '100% Client Ownership. All code, design, database schemas, and assets are handed over into the client\'s own repositories.'
        }
      }
    ]
  });

  // BreadcrumbList: Home > Pricing
  schemas.push({
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      {
        '@type': 'ListItem',
        position: 1,
        name: 'Home',
        item: 'https://infohq.in/'
      },
      {
        '@type': 'ListItem',
        position: 2,
        name: 'Pricing',
        item: 'https://infohq.in/pricing/'
      }
    ]
  });
} else if (type === 'contact') {
  schemas.push(organizationBase);
  schemas.push({
    '@context': 'https://schema.org',
    '@type': 'ContactPage',
    url: 'https://infohq.in/contact/',
    name: 'Contact InfoHQ — Get a Free Consultation',
    about: {
      '@id': 'https://infohq.in/#organization'
    },
    publisher: {
      '@id': 'https://infohq.in/#organization'
    }
  });
  schemas.push({
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      {
        '@type': 'ListItem',
        position: 1,
        name: 'Home',
        item: 'https://infohq.in/'
      },
      {
        '@type': 'ListItem',
        position: 2,
        name: 'Contact',
        item: 'https://infohq.in/contact/'
      }
    ]
  });
} else if (type === 'company') {
  schemas.push(organizationBase);
  schemas.push({
    '@context': 'https://schema.org',
    '@type': 'AboutPage',
    name: 'About InfoHQ — AI & Software Engineering Studio',
    url: 'https://infohq.in/company/',
    description: 'InfoHQ is an AI and software engineering studio based in Pune and Prayagraj, building and running digital products for businesses across India.',
    publisher: {
      '@type': 'Organization',
      '@id': 'https://infohq.in/#organization',
      name: 'InfoHQ',
      url: 'https://infohq.in'
    }
  });
  schemas.push({
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      {
        '@type': 'ListItem',
        position: 1,
        name: 'Home',
        item: 'https://infohq.in/'
      },
      {
        '@type': 'ListItem',
        position: 2,
        name: 'Company',
        item: 'https://infohq.in/company/'
      }
    ]
  });
} else if (type === 'services') {
  schemas.push(organizationBase);
  schemas.push({
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: 'Our Services — AI, Software, Web & Mobile Development | InfoHQ',
    url: 'https://infohq.in/services/',
    description: 'Explore InfoHQ\'s full range of services: AI & intelligent systems, custom software, web & mobile app development, cloud & DevOps, automation, and digital marketing.',
    publisher: {
      '@type': 'Organization',
      '@id': 'https://infohq.in/#organization',
      name: 'InfoHQ',
      url: 'https://infohq.in'
    }
  });
  schemas.push({
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      {
        '@type': 'ListItem',
        position: 1,
        name: 'Home',
        item: 'https://infohq.in/'
      },
      {
        '@type': 'ListItem',
        position: 2,
        name: 'Services',
        item: 'https://infohq.in/services/'
      }
    ]
  });
} else if (type === 'blogs') {
  schemas.push(organizationBase);
  schemas.push({
    '@context': 'https://schema.org',
    '@type': 'Blog',
    '@id': 'https://infohq.in/blogs/#blog',
    name: 'InfoHQ Blog',
    url: 'https://infohq.in/blogs/',
    description: 'Practical writing on AI, automation, web development and cloud, from the InfoHQ team.',
    publisher: {
      '@id': 'https://infohq.in/#organization'
    }
  });
  if (postData?.items && Array.isArray(postData.items) && postData.items.length > 0) {
    schemas.push({
      '@context': 'https://schema.org',
      '@type': 'ItemList',
      name: 'Latest Articles',
      url: 'https://infohq.in/blogs/',
      numberOfItems: postData.items.length,
      itemListElement: postData.items.map((item: any, idx: number) => ({
        '@type': 'ListItem',
        position: idx + 1,
        name: item.title,
        url: item.url
      }))
    });
  }
  schemas.push({
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      {
        '@type': 'ListItem',
        position: 1,
        name: 'Home',
        item: 'https://infohq.in/'
      },
      {
        '@type': 'ListItem',
        position: 2,
        name: 'Blogs',
        item: 'https://infohq.in/blogs/'
      }
    ]
  });
} else if (type === 'blog-category' && postData) {
  schemas.push(organizationBase);
  schemas.push({
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: postData.title || `${postData.categoryName} Articles | InfoHQ`,
    url: postData.url || `https://infohq.in/blogs/${postData.category}/`,
    description: postData.description || `Practical articles on ${postData.categoryName} from InfoHQ.`,
    publisher: {
      '@id': 'https://infohq.in/#organization'
    }
  });
  if (postData.items && Array.isArray(postData.items) && postData.items.length > 0) {
    schemas.push({
      '@context': 'https://schema.org',
      '@type': 'ItemList',
      name: `${postData.categoryName} Articles`,
      url: postData.url || `https://infohq.in/blogs/${postData.category}/`,
      numberOfItems: postData.items.length,
      itemListElement: postData.items.map((item: any, idx: number) => ({
        '@type': 'ListItem',
        position: idx + 1,
        name: item.title,
        url: item.url
      }))
    });
  }
  schemas.push({
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      {
        '@type': 'ListItem',
        position: 1,
        name: 'Home',
        item: 'https://infohq.in/'
      },
      {
        '@type': 'ListItem',
        position: 2,
        name: 'Blogs',
        item: 'https://infohq.in/blogs/'
      },
      {
        '@type': 'ListItem',
        position: 3,
        name: postData.categoryName,
        item: `https://infohq.in/blogs/${postData.category}/`
      }
    ]
  });
} else if (type === 'blog-post' && postData) {
  schemas.push(organizationBase);
  schemas.push({
    '@context': 'https://schema.org',
    '@type': 'BlogPosting',
    headline: postData.headline,
    description: postData.description,
    inLanguage: 'en-IN',
    datePublished: postData.datePublished,
    dateModified: postData.dateModified || postData.datePublished,
    author: {
      '@type': 'Organization',
      '@id': 'https://infohq.in/#organization'
    },
    publisher: {
      '@id': 'https://infohq.in/#organization'
    },
    mainEntityOfPage: {
      '@type': 'WebPage',
      '@id': postData.url
    },
    image: postData.image || 'https://infohq.in/og/default.jpg'
  });
  schemas.push({
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      {
        '@type': 'ListItem',
        position: 1,
        name: 'Home',
        item: 'https://infohq.in/'
      },
      {
        '@type': 'ListItem',
        position: 2,
        name: 'Blogs',
        item: 'https://infohq.in/blogs/'
      },
      {
        '@type': 'ListItem',
        position: 3,
        name: postData.categoryName,
        item: `https://infohq.in/blogs/${postData.category}/`
      },
      {
        '@type': 'ListItem',
        position: 4,
        name: postData.headline,
        item: postData.url
      }
    ]
  });
  if (postData.faqs && Array.isArray(postData.faqs) && postData.faqs.length > 0) {
    schemas.push({
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: postData.faqs.map((faq: any) => ({
        '@type': 'Question',
        name: faq.q,
        acceptedAnswer: {
          '@type': 'Answer',
          text: faq.a
        }
      }))
    });
  }
} else if (type === 'portfolio') {
  schemas.push(organizationBase);
  schemas.push({
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: 'Portfolio & Case Studies | InfoHQ',
    url: 'https://infohq.in/portfolio/',
    description: 'Projects built by InfoHQ: an AI healthcare app, SeHAT SmartCare, and a client website, Alpha Studio Tech.',
    publisher: {
      '@type': 'Organization',
      '@id': 'https://infohq.in/#organization',
      name: 'InfoHQ',
      url: 'https://infohq.in'
    },
    mainEntity: {
      '@type': 'ItemList',
      itemListElement: [
        {
          '@type': 'ListItem',
          position: 1,
          item: {
            '@type': 'CreativeWork',
            name: 'Alpha Studio Tech — High-Speed Digital Agency Web Platform',
            url: 'https://alphastudiotech.online',
            description: 'High-performance responsive web platform with sub-second page loads and zero layout shift.',
            genre: 'Web Platform Development',
            keywords: 'Astro, TypeScript, Cloudflare Pages, Vanilla CSS, Modern SVG',
            creator: {
              '@type': 'Organization',
              name: 'InfoHQ'
            }
          }
        },
        {
          '@type': 'ListItem',
          position: 2,
          item: {
            '@type': 'CreativeWork',
            name: 'SeHAT SmartCare AI — AI-Powered Health Assistance Platform',
            url: 'https://infohq.in/portfolio#sehat',
            description: 'Cross-platform Android healthcare platform with trilingual RAG chatbot, lab report OCR, and emergency SOS.',
            genre: 'Mobile & Healthcare AI',
            keywords: 'Android, Kotlin, Python, FastAPI, RAG, FAISS, SentenceTransformers, OCR, Firebase',
            creator: {
              '@type': 'Organization',
              name: 'InfoHQ'
            }
          }
        }
      ]
    }
  });
  schemas.push({
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      {
        '@type': 'ListItem',
        position: 1,
        name: 'Home',
        item: 'https://infohq.in/'
      },
      {
        '@type': 'ListItem',
        position: 2,
        name: 'Portfolio',
        item: 'https://infohq.in/portfolio/'
      }
    ]
  });
} else {
  schemas.push(organizationBase);
}
---

{schemas.map((schema) => (
  <script type="application/ld+json" set:html={JSON.stringify(schema, null, 2)} />
))}
