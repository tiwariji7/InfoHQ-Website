---
import { serviceSchemasRecord } from '../data/serviceSchemas';

interface Props {
  type?: 'home' | 'services' | 'service-detail' | 'pricing' | 'company' | 'blogs' | 'contact' | 'legal' | 'portfolio' | 'blog-post';
  serviceData?: {
    slug?: string;
    name: string;
    description: string;
    techStack?: string[];
    url: string;
  };
  blogPostData?: {
    title: string;
    description: string;
    url: string;
    pubDate: string | Date;
    updatedDate?: string | Date;
    image?: string;
    author?: string;
    category?: string;
    categoryLabel?: string;
    keywords?: string[];
    faqs?: Array<{ question: string; answer: string }>;
    wordCount?: number;
  };
  blogPosts?: any[];
  categoryData?: {
    slug: string;
    label: string;
    title: string;
    description: string;
    url?: string;
  };
  customSchema?: Record<string, any>;
}

const { type = 'home', serviceData, blogPostData, blogPosts, categoryData, customSchema } = Astro.props;

// Confirmed Organization Schema (Steps 7 & 8)
// Social URLs confirmed from codebase: Instagram, YouTube, WhatsApp.
// Telephone field omitted as calling number is currently placeholder in docs.
const organizationBase = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'InfoHQ',
  url: 'https://infohq.in',
  logo: 'https://infohq.in/images/infohq-logo.webp',
  description: 'InfoHQ is a Pune & Prayagraj-based AI and software engineering studio helping startups and enterprises across India build, automate, and grow — from custom AI systems to full-scale digital products.',
  email: 'contact@infohq.in',
  sameAs: [
    'https://www.instagram.com/infohq.in/?hl=en',
    'https://www.youtube.com/@infohq28',
    'https://wa.me/918381835420'
  ],
  areaServed: {
    '@type': 'Country',
    name: 'India'
  }
};

let schemas: any[] = [];

if (customSchema) {
  schemas.push(customSchema);
} else if (type === 'home') {
  // 1. Top-Level Organization Schema
  schemas.push(organizationBase);

  // 2. LocalBusiness Block 1: Pune
  schemas.push({
    '@context': 'https://schema.org',
    '@type': 'LocalBusiness',
    name: 'InfoHQ — Pune',
    url: 'https://infohq.in',
    image: 'https://infohq.in/images/infohq-logo.webp',
    email: 'contact@infohq.in',
    address: {
      '@type': 'PostalAddress',
      addressLocality: 'Pune',
      addressRegion: 'Maharashtra',
      addressCountry: 'IN'
    },
    parentOrganization: {
      '@type': 'Organization',
      name: 'InfoHQ',
      url: 'https://infohq.in'
    }
  });

  // 3. LocalBusiness Block 2: Prayagraj
  schemas.push({
    '@context': 'https://schema.org',
    '@type': 'LocalBusiness',
    name: 'InfoHQ — Prayagraj',
    url: 'https://infohq.in',
    image: 'https://infohq.in/images/infohq-logo.webp',
    email: 'contact@infohq.in',
    address: {
      '@type': 'PostalAddress',
      addressLocality: 'Prayagraj',
      addressRegion: 'Uttar Pradesh',
      addressCountry: 'IN'
    },
    parentOrganization: {
      '@type': 'Organization',
      name: 'InfoHQ',
      url: 'https://infohq.in'
    }
  });

  // 4. FAQPage Schema (Home Page - Step 9)
  schemas.push({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: [
      {
        '@type': 'Question',
        name: 'Do you only work with startups, or enterprises too?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'Both. Our One-Time Project model suits startups and new builds, while our Monthly Retainer plans (especially Technology Partner) are built for growing and enterprise-scale operations.'
        }
      },
      {
        '@type': 'Question',
        name: 'Do I own the code and IP?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'Yes — 100% client ownership on all code, design, and database schemas, always.'
        }
      },
      {
        '@type': 'Question',
        name: 'Do you work with businesses outside Pune/Prayagraj?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'Yes, we deliver pan-India — our physical presence is in Pune and Prayagraj, but our team works with clients anywhere in the country.'
        }
      }
    ]
  });
} else if (type === 'service-detail' && serviceData) {
  // Individual Service Page Schema (Steps 5 & 6)
  const slug = serviceData.slug || '';
  const schemaConfig = serviceSchemasRecord[slug];

  if (schemaConfig) {
    const offerPayload: Record<string, any> = {
      '@type': 'Offer',
      priceCurrency: 'INR',
      description: schemaConfig.priceDescription
    };

    // Only include price if not a Custom Quote
    if (schemaConfig.price) {
      offerPayload.price = schemaConfig.price;
    }

    schemas.push({
      '@context': 'https://schema.org',
      '@type': 'Service',
      serviceType: schemaConfig.serviceType,
      provider: {
        '@type': 'Organization',
        name: 'InfoHQ',
        url: 'https://infohq.in'
      },
      areaServed: 'IN',
      description: schemaConfig.description,
      hasOfferCatalog: {
        '@type': 'OfferCatalog',
        name: schemaConfig.category,
        itemListElement: schemaConfig.subFeatures.map((subFeature) => ({
          '@type': 'Offer',
          itemOffered: {
            '@type': 'Service',
            name: subFeature
          }
        }))
      },
      offers: offerPayload
    });
  } else {
    // Fallback if slug mapping not found
    schemas.push({
      '@context': 'https://schema.org',
      '@type': 'Service',
      serviceType: serviceData.name,
      provider: {
        '@type': 'Organization',
        name: 'InfoHQ',
        url: 'https://infohq.in'
      },
      areaServed: 'IN',
      description: serviceData.description
    });
  }
} else if (type === 'pricing') {
  schemas.push(organizationBase);

  // Retainers & One-Time Projects Offer Catalog
  schemas.push({
    '@context': 'https://schema.org',
    '@type': 'Service',
    serviceType: 'Engineering Retainers & Projects',
    name: 'InfoHQ Engineering Retainer & Project Plans',
    provider: {
      '@type': 'Organization',
      name: 'InfoHQ',
      url: 'https://infohq.in'
    },
    areaServed: 'IN',
    hasOfferCatalog: {
      '@type': 'OfferCatalog',
      name: 'Engineering Retainers & One-Time Projects',
      itemListElement: [
        {
          '@type': 'Offer',
          itemOffered: {
            '@type': 'Service',
            name: 'Digital Starter Retainer'
          },
          price: '9999',
          priceCurrency: 'INR',
          description: 'Essential digital care and reliable routine maintenance for small businesses (₹9,999/month).'
        },
        {
          '@type': 'Offer',
          itemOffered: {
            '@type': 'Service',
            name: 'Business Growth Retainer'
          },
          price: '24999',
          priceCurrency: 'INR',
          description: '1 Dedicated Senior Engineer for continuous improvements, features, and fast problem solving (₹24,999/month).'
        },
        {
          '@type': 'Offer',
          itemOffered: {
            '@type': 'Service',
            name: 'Technology Partner Retainer'
          },
          price: '49999',
          priceCurrency: 'INR',
          description: '3-Person Dedicated Engineering Team for multi-system digital operations (₹49,999/month).'
        }
      ]
    }
  });

  // FAQPage Schema (Pricing Page - Step 9)
  schemas.push({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: [
      {
        '@type': 'Question',
        name: 'What do I get with a monthly plan?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'Predictable monthly cost for continuous engineering capacity across your digital assets — maintenance, bug fixing, and feature additions.'
        }
      },
      {
        '@type': 'Question',
        name: 'Can you manage a website another developer built?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'Yes — we run a code and architecture audit first, then onboard it into our system.'
        }
      },
      {
        '@type': 'Question',
        name: 'Will a monthly plan build me a new website or app from scratch?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'No — monthly retainers are for maintaining and scaling existing systems. New projects are built under the fixed-scope milestone model.'
        }
      },
      {
        '@type': 'Question',
        name: 'Are hosting and API charges included?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'Technical setup and management are included. Third-party bills (AWS, Google Cloud, OpenAI API credits, domain) are paid directly from the client\'s own account, so ownership stays with the client.'
        }
      },
      {
        '@type': 'Question',
        name: 'Who owns the code and IP?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: '100% Client Ownership. All code, design, database schemas, and assets are handed over into the client\'s own repositories.'
        }
      }
    ]
  });
} else if (type === 'contact') {
  schemas.push({
    ...organizationBase,
    contactPoint: [
      {
        '@type': 'ContactPoint',
        email: 'contact@infohq.in',
        contactType: 'customer support',
        areaServed: 'IN'
      },
      {
        '@type': 'ContactPoint',
        email: 'services@infohq.in',
        contactType: 'sales',
        areaServed: 'IN'
      }
    ]
  });
} else if (type === 'company') {
  schemas.push(organizationBase);
  schemas.push({
    '@context': 'https://schema.org',
    '@type': 'AboutPage',
    name: 'About InfoHQ — AI & Software Engineering Studio',
    url: 'https://infohq.in/company',
    description: 'InfoHQ is an AI and software engineering studio based in Pune and Prayagraj, building and running digital products for businesses across India.',
    publisher: {
      '@type': 'Organization',
      name: 'InfoHQ',
      url: 'https://infohq.in'
    }
  });
} else if (type === 'services') {
  schemas.push(organizationBase);
  schemas.push({
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: 'Our Services — AI, Software, Web & Mobile Development | InfoHQ',
    url: 'https://infohq.in/services',
    description: 'Explore InfoHQ\'s full range of services: AI & intelligent systems, custom software, web & mobile app development, cloud & DevOps, automation, and digital marketing.',
    publisher: {
      '@type': 'Organization',
      name: 'InfoHQ',
      url: 'https://infohq.in'
    }
  });
} else if (type === 'blogs') {
  schemas.push(organizationBase);

  if (categoryData) {
    // 1. Category Hub CollectionPage Schema
    const categoryUrl = categoryData.url || `https://infohq.in/blog/${categoryData.slug}`;
    schemas.push({
      '@context': 'https://schema.org',
      '@type': 'CollectionPage',
      name: categoryData.title,
      description: categoryData.description,
      url: categoryUrl,
      publisher: {
        '@type': 'Organization',
        name: 'InfoHQ',
        url: 'https://infohq.in'
      }
    });

    // 2. Category BreadcrumbList Schema (Google Rich Results)
    schemas.push({
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: [
        {
          '@type': 'ListItem',
          position: 1,
          name: 'Home',
          item: 'https://infohq.in'
        },
        {
          '@type': 'ListItem',
          position: 2,
          name: 'Blog',
          item: 'https://infohq.in/blog'
        },
        {
          '@type': 'ListItem',
          position: 3,
          name: categoryData.label,
          item: categoryUrl
        }
      ]
    });
  } else {
    // Main Blog Hub Schema
    const blogSchema: Record<string, any> = {
      '@context': 'https://schema.org',
      '@type': 'Blog',
      name: 'InfoHQ Engineering Blog',
      url: 'https://infohq.in/blog',
      description: 'Practical insights on AI, software engineering, and digital product development from the InfoHQ team.',
      publisher: {
        '@type': 'Organization',
        name: 'InfoHQ',
        url: 'https://infohq.in',
        logo: {
          '@type': 'ImageObject',
          url: 'https://infohq.in/images/infohq-logo.webp'
        }
      }
    };

    if (blogPosts && blogPosts.length > 0) {
      blogSchema.blogPost = blogPosts.map((post: any) => ({
        '@type': 'BlogPosting',
        headline: post.data.title,
        description: post.data.description,
        url: `https://infohq.in/blog/${post.data.category}/${post.id ? post.id.replace(/\.[^/.]+$/, '') : (post.slug || '')}`,
        datePublished: new Date(post.data.pubDate).toISOString(),
        author: {
          '@type': 'Organization',
          name: post.data.author || 'InfoHQ Team'
        }
      }));
    }

    schemas.push(blogSchema);

    // Blog Hub BreadcrumbList Schema
    schemas.push({
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: [
        {
          '@type': 'ListItem',
          position: 1,
          name: 'Home',
          item: 'https://infohq.in'
        },
        {
          '@type': 'ListItem',
          position: 2,
          name: 'Blog',
          item: 'https://infohq.in/blog'
        }
      ]
    });
  }

  // ItemList of posts if present
  if (blogPosts && blogPosts.length > 0) {
    schemas.push({
      '@context': 'https://schema.org',
      '@type': 'ItemList',
      itemListElement: blogPosts.map((post: any, idx: number) => ({
        '@type': 'ListItem',
        position: idx + 1,
        name: post.data.title,
        url: `https://infohq.in/blog/${post.data.category}/${post.id ? post.id.replace(/\.[^/.]+$/, '') : (post.slug || '')}`
      }))
    });
  }
} else if (type === 'blog-post' && blogPostData) {
  schemas.push(organizationBase);

  const postDate = new Date(blogPostData.pubDate).toISOString();
  const modifiedDate = blogPostData.updatedDate
    ? new Date(blogPostData.updatedDate).toISOString()
    : postDate;

  const rawImage = blogPostData.image || '/images/blog/what-is-rag-hero.webp';
  const fullImageUrl = rawImage.startsWith('http')
    ? rawImage
    : `https://infohq.in${rawImage.startsWith('/') ? '' : '/'}${rawImage}`;

  // 1. Comprehensive BlogPosting Schema with AEO Speakable & InLanguage
  const blogPostingSchema: Record<string, any> = {
    '@context': 'https://schema.org',
    '@type': 'BlogPosting',
    headline: blogPostData.title,
    description: blogPostData.description,
    mainEntityOfPage: {
      '@type': 'WebPage',
      '@id': blogPostData.url
    },
    url: blogPostData.url,
    inLanguage: 'en-IN',
    articleSection: blogPostData.categoryLabel || (blogPostData.category ? blogPostData.category.toUpperCase() : 'AI & Intelligent Systems'),
    author: {
      '@type': 'Organization',
      name: blogPostData.author || 'InfoHQ Team',
      url: 'https://infohq.in'
    },
    publisher: {
      '@type': 'Organization',
      name: 'InfoHQ',
      url: 'https://infohq.in',
      logo: {
        '@type': 'ImageObject',
        url: 'https://infohq.in/images/infohq-logo.webp'
      }
    },
    datePublished: postDate,
    dateModified: modifiedDate,
    image: {
      '@type': 'ImageObject',
      url: fullImageUrl,
      width: 1376,
      height: 768
    },
    speakable: {
      '@type': 'SpeakableSpecification',
      cssSelector: ['.post-headline', '.post-hero-caption', '.post-prose > p:first-of-type']
    }
  };

  if (blogPostData.keywords && blogPostData.keywords.length > 0) {
    blogPostingSchema.keywords = blogPostData.keywords.join(', ');
  }

  if (blogPostData.wordCount) {
    blogPostingSchema.wordCount = blogPostData.wordCount;
  }

  schemas.push(blogPostingSchema);

  // 2. Article BreadcrumbList Schema (Rich Snippets)
  const categorySlug = blogPostData.category || 'ai';
  const categoryLabel = blogPostData.categoryLabel || categorySlug.toUpperCase();
  schemas.push({
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      {
        '@type': 'ListItem',
        position: 1,
        name: 'Home',
        item: 'https://infohq.in'
      },
      {
        '@type': 'ListItem',
        position: 2,
        name: 'Blog',
        item: 'https://infohq.in/blog'
      },
      {
        '@type': 'ListItem',
        position: 3,
        name: categoryLabel,
        item: `https://infohq.in/blog/${categorySlug}`
      },
      {
        '@type': 'ListItem',
        position: 4,
        name: blogPostData.title,
        item: blogPostData.url
      }
    ]
  });

  // 3. FAQPage Schema for SERP Dropdown & AEO Answer Engines
  if (blogPostData.faqs && blogPostData.faqs.length > 0) {
    schemas.push({
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: blogPostData.faqs.map((faq) => ({
        '@type': 'Question',
        name: faq.question,
        acceptedAnswer: {
          '@type': 'Answer',
          text: faq.answer
        }
      }))
    });
  }
} else if (type === 'portfolio') {
  schemas.push(organizationBase);
  schemas.push({
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: 'Portfolio & Case Studies — InfoHQ',
    url: 'https://infohq.in/portfolio',
    description: 'Explore InfoHQ\'s portfolio of shipped projects, engineering case studies, enterprise AI systems, web platforms, and mobile apps.',
    publisher: {
      '@type': 'Organization',
      name: 'InfoHQ',
      url: 'https://infohq.in'
    },
    mainEntity: {
      '@type': 'ItemList',
      itemListElement: [
        {
          '@type': 'ListItem',
          position: 1,
          item: {
            '@type': 'CreativeWork',
            name: 'Alpha Studio Tech — High-Speed Digital Agency Web Platform',
            url: 'https://alphastudiotech.online',
            description: 'High-performance responsive web platform with sub-second page loads and zero layout shift.',
            genre: 'Web Platform Development',
            keywords: 'Astro, TypeScript, Cloudflare Pages, Vanilla CSS, Modern SVG',
            creator: {
              '@type': 'Organization',
              name: 'InfoHQ'
            }
          }
        },
        {
          '@type': 'ListItem',
          position: 2,
          item: {
            '@type': 'CreativeWork',
            name: 'SeHAT SmartCare AI — AI-Powered Health Assistance Platform',
            url: 'https://infohq.in/portfolio#sehat',
            description: 'Cross-platform Android healthcare platform with trilingual RAG chatbot, lab report OCR, and emergency SOS.',
            genre: 'Mobile & Healthcare AI',
            keywords: 'Android, Kotlin, Python, FastAPI, RAG, FAISS, SentenceTransformers, OCR, Firebase',
            creator: {
              '@type': 'Organization',
              name: 'InfoHQ'
            }
          }
        },
        {
          '@type': 'ListItem',
          position: 3,
          item: {
            '@type': 'CreativeWork',
            name: 'CogniFlow AI — Autonomous Enterprise RAG & Knowledge Agent',
            url: 'https://infohq.in/portfolio#cogniflow-ai',
            description: 'Enterprise document intelligence system with pgvector semantic vector search and sub-second contextual responses.',
            genre: 'Enterprise AI & Automation',
            keywords: 'Python, FastAPI, LangChain, Claude, pgvector, Docker',
            creator: {
              '@type': 'Organization',
              name: 'InfoHQ'
            }
          }
        },
        {
          '@type': 'ListItem',
          position: 4,
          item: {
            '@type': 'CreativeWork',
            name: 'OmniFlow B2B — Automated Multi-Channel Order & WhatsApp Dispatch Pipeline',
            url: 'https://infohq.in/portfolio#omniflow-b2b',
            description: 'Event-driven order and invoicing automation connecting ERP, Razorpay, and WhatsApp Business API.',
            genre: 'Business Automation & SaaS',
            keywords: 'Next.js, Node.js, PostgreSQL, Redis, Razorpay API, WhatsApp Business API',
            creator: {
              '@type': 'Organization',
              name: 'InfoHQ'
            }
          }
        }
      ]
    }
  });
} else {
  schemas.push(organizationBase);
}
---

{schemas.map((schema) => (
  <script type="application/ld+json" set:html={JSON.stringify(schema, null, 2)} />
))}
