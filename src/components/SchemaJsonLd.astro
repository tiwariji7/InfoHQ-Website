---
import { serviceSchemasRecord } from '../data/serviceSchemas';
import { contactConfig } from '../data/contactConfig';

interface Props {
  type?: 'home' | 'services' | 'service-detail' | 'pricing' | 'company' | 'blogs' | 'blog-category' | 'blog-post' | 'contact' | 'legal' | 'portfolio';
  serviceData?: {
    slug?: string;
    name: string;
    description: string;
    techStack?: string[];
    url: string;
    faqs?: Array<{ q: string; a: string }>;
  };
  postData?: any;
  customSchema?: Record<string, any>;
}

const { type = 'home', serviceData, postData, customSchema } = Astro.props;

// Confirmed Organization Schema (Steps 7 & 8)
// Social URLs confirmed from codebase: Instagram, YouTube, WhatsApp.
// Telephone field omitted until dedicated voice line is configured.
const organizationBase = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': 'https://infohq.in/#organization',
  name: 'InfoHQ',
  legalName: 'InfoHQ Pvt Ltd',
  alternateName: ['InfoHQ Pvt Ltd', 'Info HQ'],
  url: 'https://infohq.in/',
  logo: 'https://infohq.in/images/infohq-brandlogo.webp',
  description: 'InfoHQ is an AI and software engineering studio helping businesses build, automate, and grow through AI solutions, custom software, web and mobile applications.',
  email: 'contact@infohq.in',
  foundingDate: '2025',
  founder: {
    '@type': 'Person',
    name: 'Shivam Tiwari',
    jobTitle: 'Founder & Lead Engineer',
    url: 'https://infohq.in/company/'
  },
  sameAs: [
    'https://www.linkedin.com/company/infohq/',
    'https://www.instagram.com/infohq.in/',
    'https://www.youtube.com/@infohq28'
  ],
  contactPoint: [
    {
      '@type': 'ContactPoint',
      email: contactConfig.businessEmail,
      contactType: 'customer support',
      areaServed: 'IN'
    },
    {
      '@type': 'ContactPoint',
      email: contactConfig.servicesEmail,
      contactType: 'sales',
      areaServed: 'IN'
    },
    {
      '@type': 'ContactPoint',
      telephone: contactConfig.telephone,
      contactType: 'customer support',
      areaServed: 'IN'
    }
  ],
  areaServed: {
    '@type': 'Country',
    name: 'India'
  }
};

let schemas: any[] = [];

if (customSchema) {
  schemas.push(customSchema);
} else if (type === 'home') {
  // 1. Top-Level Organization Schema
  schemas.push(organizationBase);

  // 2. WebSite Schema (Homepage - Google Search Site Name)
  schemas.push({
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    '@id': 'https://infohq.in/#website',
    name: 'InfoHQ',
    alternateName: ['InfoHQ Pvt Ltd'],
    url: 'https://infohq.in/',
    publisher: {
      '@id': 'https://infohq.in/#organization'
    },
    inLanguage: 'en-IN'
  });

  // 3. FAQPage Schema (Home Page)
  schemas.push({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: [
      {
        '@type': 'Question',
        name: 'Do you only work with startups, or enterprises too?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'Both. Our One-Time Project model suits startups and new builds, while our Monthly Retainer plans (especially Technology Partner) are built for growing and enterprise-scale operations.'
        }
      },
      {
        '@type': 'Question',
        name: 'Do I own the code and IP?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'Yes — 100% client ownership on all code, design, and database schemas, always.'
        }
      },
      {
        '@type': 'Question',
        name: 'Do you work with businesses outside Pune/Prayagraj?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'Yes, we deliver pan-India — our physical presence is in Pune and Prayagraj, but our team works with clients anywhere in the country.'
        }
      }
    ]
  });
} else if (type === 'service-detail' && serviceData) {
  // Individual Service Page Schema (Steps 5 & 6)
  const slug = serviceData.slug || '';
  const schemaConfig = serviceSchemasRecord[slug];
  const serviceUrl = `https://infohq.in/services/${slug}/`;

  if (schemaConfig) {
    const offerPayload: Record<string, any> = {
      '@type': 'Offer',
      priceCurrency: 'INR',
      description: schemaConfig.priceDescription
    };

    // Only include price if not a Custom Quote
    if (schemaConfig.price) {
      offerPayload.price = schemaConfig.price;
    }

    schemas.push({
      '@context': 'https://schema.org',
      '@type': 'Service',
      '@id': `${serviceUrl}#service`,
      url: serviceUrl,
      serviceType: schemaConfig.serviceType,
      provider: {
        '@type': 'Organization',
        '@id': 'https://infohq.in/#organization',
        name: 'InfoHQ'
      },
      areaServed: 'IN',
      description: schemaConfig.description,
      hasOfferCatalog: {
        '@type': 'OfferCatalog',
        name: schemaConfig.category,
        itemListElement: schemaConfig.subFeatures.map((subFeature) => ({
          '@type': 'Offer',
          itemOffered: {
            '@type': 'Service',
            name: subFeature
          }
        }))
      },
      offers: offerPayload
    });
  } else {
    // Fallback if slug mapping not found
    schemas.push({
      '@context': 'https://schema.org',
      '@type': 'Service',
      '@id': `${serviceUrl}#service`,
      url: serviceUrl,
      serviceType: serviceData.name,
      provider: {
        '@type': 'Organization',
        '@id': 'https://infohq.in/#organization',
        name: 'InfoHQ'
      },
      areaServed: 'IN',
      description: serviceData.description
    });
  }

  // BreadcrumbList: Home > Services > [Service name]
  schemas.push({
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      {
        '@type': 'ListItem',
        position: 1,
        name: 'Home',
        item: 'https://infohq.in/'
      },
      {
        '@type': 'ListItem',
        position: 2,
        name: 'Services',
        item: 'https://infohq.in/services/'
      },
      {
        '@type': 'ListItem',
        position: 3,
        name: serviceData.name,
        item: serviceUrl
      }
    ]
  });
  if (serviceData.faqs && serviceData.faqs.length > 0) {
    schemas.push({
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: serviceData.faqs.map((faq) => ({
        '@type': 'Question',
        name: faq.q,
        acceptedAnswer: {
          '@type': 'Answer',
          text: faq.a
        }
      }))
    });
  }
} else if (type === 'pricing') {
  schemas.push(organizationBase);

  // Retainers & One-Time Projects Offer Catalog
  schemas.push({
    '@context': 'https://schema.org',
    '@type': 'Service',
    serviceType: 'Engineering Retainers & Projects',
    name: 'InfoHQ Engineering Retainer & Project Plans',
    url: 'https://infohq.in/pricing/',
    provider: {
      '@type': 'Organization',
      '@id': 'https://infohq.in/#organization',
      name: 'InfoHQ',
      url: 'https://infohq.in'
    },
    areaServed: 'IN',
    hasOfferCatalog: {
      '@type': 'OfferCatalog',
      name: 'Engineering Retainers & One-Time Projects',
      itemListElement: [
        {
          '@type': 'Offer',
          itemOffered: {
            '@type': 'Service',
            name: 'Digital Starter Retainer'
          },
          price: '9999',
          priceCurrency: 'INR',
          description: 'Essential digital care and reliable routine maintenance for small businesses (₹9,999/month).'
        },
        {
          '@type': 'Offer',
          itemOffered: {
            '@type': 'Service',
            name: 'Business Growth Retainer'
          },
          price: '24999',
          priceCurrency: 'INR',
          description: '1 Dedicated Senior Engineer for continuous improvements, features, and fast problem solving (₹24,999/month).'
        },
        {
          '@type': 'Offer',
          itemOffered: {
            '@type': 'Service',
            name: 'Technology Partner Retainer'
          },
          price: '49999',
          priceCurrency: 'INR',
          description: '3-Person Dedicated Engineering Team for multi-system digital operations (₹49,999/month).'
        },
        {
          '@type': 'Offer',
          itemOffered: {
            '@type': 'Service',
            name: 'Business Website'
          },
          price: '14999',
          priceCurrency: 'INR',
          description: 'Custom responsive design, SEO optimization & meta setup, fast loading, mobile-ready, easy CMS content updates.'
        },
        {
          '@type': 'Offer',
          itemOffered: {
            '@type': 'Service',
            name: 'E-Commerce Website'
          },
          price: '29999',
          priceCurrency: 'INR',
          description: 'Full online store, payment gateway, product catalog & inventory sync, cart & checkout, automated notifications.'
        },
        {
          '@type': 'Offer',
          itemOffered: {
            '@type': 'Service',
            name: 'Web Application'
          },
          price: '24999',
          priceCurrency: 'INR',
          description: 'Dynamic database, user auth & roles, custom dashboard & admin views, REST/GraphQL API integrations.'
        },
        {
          '@type': 'Offer',
          itemOffered: {
            '@type': 'Service',
            name: 'Mobile Application'
          },
          price: '39999',
          priceCurrency: 'INR',
          description: 'iOS & Android app, push notification pipeline, offline caching, App Store & Play Store submission setup.'
        },
        {
          '@type': 'Offer',
          itemOffered: {
            '@type': 'Service',
            name: 'AI Solution'
          },
          price: '19999',
          priceCurrency: 'INR',
          description: 'Custom LLM integration, domain-specific RAG knowledge bot, automated workflow triggers, telemetry & logs.'
        },
        {
          '@type': 'Offer',
          itemOffered: {
            '@type': 'Service',
            name: 'SaaS Platform MVP'
          },
          price: '49999',
          priceCurrency: 'INR',
          description: 'Multi-tenant schema, Stripe/Razorpay automated subscription billing, user & team dashboard, admin telemetry.'
        },
        {
          '@type': 'Offer',
          itemOffered: {
            '@type': 'Service',
            name: 'Custom Software / ERP'
          },
          priceCurrency: 'INR',
          description: 'Bespoke enterprise system architecture, multi-role permissions, legacy migration, dedicated SLA & warranty.'
        }
      ]
    }
  });

  // FAQPage Schema (Pricing Page - Step 9)
  schemas.push({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: [
      {
        '@type': 'Question',
        name: 'What do I get with a monthly plan?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'Predictable monthly cost for continuous engineering capacity across your digital assets — maintenance, bug fixing, and feature additions.'
        }
      },
      {
        '@type': 'Question',
        name: 'Can you manage a website another developer built?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'Yes — we run a code and architecture audit first, then onboard it into our system.'
        }
      },
      {
        '@type': 'Question',
        name: 'Will a monthly plan build me a new website or app from scratch?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'No — monthly retainers are for maintaining and scaling existing systems. New projects are built under the fixed-scope milestone model.'
        }
      },
      {
        '@type': 'Question',
        name: 'Are hosting and API charges included?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'Technical setup and management are included. Third-party bills (AWS, Google Cloud, OpenAI API credits, domain) are paid directly from the client\'s own account, so ownership stays with the client.'
        }
      },
      {
        '@type': 'Question',
        name: 'Who owns the code and IP?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: '100% Client Ownership. All code, design, database schemas, and assets are handed over into the client\'s own repositories.'
        }
      }
    ]
  });

  // BreadcrumbList: Home > Pricing
  schemas.push({
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      {
        '@type': 'ListItem',
        position: 1,
        name: 'Home',
        item: 'https://infohq.in/'
      },
      {
        '@type': 'ListItem',
        position: 2,
        name: 'Pricing',
        item: 'https://infohq.in/pricing/'
      }
    ]
  });
} else if (type === 'contact') {
  schemas.push(organizationBase);
  schemas.push({
    '@context': 'https://schema.org',
    '@type': 'ContactPage',
    url: 'https://infohq.in/contact/',
    name: 'Contact InfoHQ — Get a Free Consultation',
    about: {
      '@id': 'https://infohq.in/#organization'
    },
    publisher: {
      '@id': 'https://infohq.in/#organization'
    }
  });
  schemas.push({
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      {
        '@type': 'ListItem',
        position: 1,
        name: 'Home',
        item: 'https://infohq.in/'
      },
      {
        '@type': 'ListItem',
        position: 2,
        name: 'Contact',
        item: 'https://infohq.in/contact/'
      }
    ]
  });
} else if (type === 'company') {
  schemas.push(organizationBase);
  schemas.push({
    '@context': 'https://schema.org',
    '@type': 'AboutPage',
    name: 'About InfoHQ | AI & Software Engineering Studio, India',
    url: 'https://infohq.in/company/',
    description: 'InfoHQ is an AI and software engineering studio in Pune and Prayagraj, building digital products for businesses across India.',
    mainEntity: {
      '@id': 'https://infohq.in/#organization'
    }
  });
  schemas.push({
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      {
        '@type': 'ListItem',
        position: 1,
        name: 'Home',
        item: 'https://infohq.in/'
      },
      {
        '@type': 'ListItem',
        position: 2,
        name: 'Company',
        item: 'https://infohq.in/company/'
      }
    ]
  });
  schemas.push({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: [
      {
        '@type': 'Question',
        name: 'What is InfoHQ?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'InfoHQ is an Indian AI and software engineering studio founded in 2025 by Shivam Tiwari. Operating from Pune, Maharashtra and Prayagraj, Uttar Pradesh, InfoHQ designs, engineers, and operates production-grade AI systems, custom SaaS platforms, modern web and mobile applications, and enterprise automations for businesses across India.'
        }
      },
      {
        '@type': 'Question',
        name: 'Who founded InfoHQ and who leads engineering?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'InfoHQ was founded in 2025 by Shivam Tiwari, who acts as Founder and Lead Engineer. Shivam oversees every layer of product architecture — frontend, backend, databases, security, and AI integrations — working hands-on with the InfoHQ engineering team.'
        }
      },
      {
        '@type': 'Question',
        name: 'What services does InfoHQ provide?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'InfoHQ provides end-to-end technology solutions: Autonomous AI Agents & RAG Knowledge Systems, Custom Software & SaaS Platforms, Web & Mobile App Development (Next.js, Astro, React Native), Business Process Automation (n8n, Make, Custom APIs), Cloud DevOps & Cybersecurity, and SEO/AEO/GEO optimization.'
        }
      },
      {
        '@type': 'Question',
        name: 'Does InfoHQ develop AI agents and business automations?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'Yes. InfoHQ develops conversational AI voice agents, autonomous lead qualification bots, RAG document search pipelines, and multi-step CRM/ERP workflow automations built for real-world enterprise operations.'
        }
      },
      {
        '@type': 'Question',
        name: 'Does InfoHQ build custom CRM and internal software?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'Yes. InfoHQ engineers bespoke CRM software, client portals, billing platforms, inventory management tools, and internal dashboards tailored specifically to each business workflow, without template limitations.'
        }
      },
      {
        '@type': 'Question',
        name: 'Where is InfoHQ located?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'InfoHQ is dual-headquartered in Pune, Maharashtra and Prayagraj, Uttar Pradesh, delivering remote-first engineering and on-ground technical support to startups and enterprises pan-India.'
        }
      },
      {
        '@type': 'Question',
        name: 'Who owns the code, design, and intellectual property?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'You do. 100% of all source code, Figma design systems, database architectures, and API keys are handed over directly to your own repositories and cloud accounts — zero lock-in.'
        }
      },
      {
        '@type': 'Question',
        name: 'How does InfoHQ optimize for SEO, AEO, and GEO?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'Every digital product built by InfoHQ incorporates technical SEO, Answer Engine Optimization (AEO for Google AI Overviews and Perplexity), and Generative Engine Optimization (GEO for ChatGPT, Claude, and Gemini) with clean JSON-LD structured data and verified Google Business Profile setup.'
        }
      },
      {
        '@type': 'Question',
        name: 'How can I work with InfoHQ?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'Businesses can engage InfoHQ via fixed-scope project sprints (built from scratch to launch) or ongoing monthly engineering retainers with dedicated engineers who know your codebase.'
        }
      },
      {
        '@type': 'Question',
        name: 'How do I contact InfoHQ?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: `You can email contact@infohq.in, message on WhatsApp at +91 8381835420, or submit a request directly via the contact form on https://infohq.in/contact/.`
        }
      }
    ]
  });
} else if (type === 'services') {
  schemas.push(organizationBase);
  schemas.push({
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: 'Our Services — AI, Software, Web & Mobile Development | InfoHQ',
    url: 'https://infohq.in/services/',
    description: 'Explore InfoHQ\'s full range of services: AI & intelligent systems, custom software, web & mobile app development, cloud & DevOps, automation, and digital marketing.',
    publisher: {
      '@type': 'Organization',
      '@id': 'https://infohq.in/#organization',
      name: 'InfoHQ',
      url: 'https://infohq.in'
    }
  });
  schemas.push({
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      {
        '@type': 'ListItem',
        position: 1,
        name: 'Home',
        item: 'https://infohq.in/'
      },
      {
        '@type': 'ListItem',
        position: 2,
        name: 'Services',
        item: 'https://infohq.in/services/'
      }
    ]
  });
} else if (type === 'blogs') {
  schemas.push(organizationBase);
  schemas.push({
    '@context': 'https://schema.org',
    '@type': 'Blog',
    '@id': 'https://infohq.in/blogs/#blog',
    name: 'InfoHQ Blog',
    url: 'https://infohq.in/blogs/',
    description: 'Practical writing on AI, automation, web development and cloud, from the InfoHQ team.',
    publisher: {
      '@id': 'https://infohq.in/#organization'
    }
  });
  if (postData?.items && Array.isArray(postData.items) && postData.items.length > 0) {
    schemas.push({
      '@context': 'https://schema.org',
      '@type': 'ItemList',
      name: 'Latest Articles',
      url: 'https://infohq.in/blogs/',
      numberOfItems: postData.items.length,
      itemListElement: postData.items.map((item: any, idx: number) => ({
        '@type': 'ListItem',
        position: idx + 1,
        name: item.title,
        url: item.url
      }))
    });
  }
  schemas.push({
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      {
        '@type': 'ListItem',
        position: 1,
        name: 'Home',
        item: 'https://infohq.in/'
      },
      {
        '@type': 'ListItem',
        position: 2,
        name: 'Blogs',
        item: 'https://infohq.in/blogs/'
      }
    ]
  });
} else if (type === 'blog-category' && postData) {
  schemas.push(organizationBase);
  schemas.push({
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: postData.title || `${postData.categoryName} Articles | InfoHQ`,
    url: postData.url || `https://infohq.in/blogs/${postData.category}/`,
    description: postData.description || `Practical articles on ${postData.categoryName} from InfoHQ.`,
    publisher: {
      '@id': 'https://infohq.in/#organization'
    }
  });
  if (postData.items && Array.isArray(postData.items) && postData.items.length > 0) {
    schemas.push({
      '@context': 'https://schema.org',
      '@type': 'ItemList',
      name: `${postData.categoryName} Articles`,
      url: postData.url || `https://infohq.in/blogs/${postData.category}/`,
      numberOfItems: postData.items.length,
      itemListElement: postData.items.map((item: any, idx: number) => ({
        '@type': 'ListItem',
        position: idx + 1,
        name: item.title,
        url: item.url
      }))
    });
  }
  schemas.push({
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      {
        '@type': 'ListItem',
        position: 1,
        name: 'Home',
        item: 'https://infohq.in/'
      },
      {
        '@type': 'ListItem',
        position: 2,
        name: 'Blogs',
        item: 'https://infohq.in/blogs/'
      },
      {
        '@type': 'ListItem',
        position: 3,
        name: postData.categoryName,
        item: `https://infohq.in/blogs/${postData.category}/`
      }
    ]
  });
} else if (type === 'blog-post' && postData) {
  schemas.push(organizationBase);
  schemas.push({
    '@context': 'https://schema.org',
    '@type': 'BlogPosting',
    headline: postData.headline,
    description: postData.description,
    inLanguage: 'en-IN',
    datePublished: postData.datePublished,
    dateModified: postData.dateModified || postData.datePublished,
    author: {
      '@type': 'Organization',
      '@id': 'https://infohq.in/#organization'
    },
    publisher: {
      '@id': 'https://infohq.in/#organization'
    },
    mainEntityOfPage: {
      '@type': 'WebPage',
      '@id': postData.url
    },
    image: postData.image || 'https://infohq.in/og/default.jpg'
  });
  schemas.push({
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      {
        '@type': 'ListItem',
        position: 1,
        name: 'Home',
        item: 'https://infohq.in/'
      },
      {
        '@type': 'ListItem',
        position: 2,
        name: 'Blogs',
        item: 'https://infohq.in/blogs/'
      },
      {
        '@type': 'ListItem',
        position: 3,
        name: postData.categoryName,
        item: `https://infohq.in/blogs/${postData.category}/`
      },
      {
        '@type': 'ListItem',
        position: 4,
        name: postData.headline,
        item: postData.url
      }
    ]
  });
  if (postData.faqs && Array.isArray(postData.faqs) && postData.faqs.length > 0) {
    schemas.push({
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: postData.faqs.map((faq: any) => ({
        '@type': 'Question',
        name: faq.q,
        acceptedAnswer: {
          '@type': 'Answer',
          text: faq.a
        }
      }))
    });
  }
} else if (type === 'portfolio') {
  schemas.push(organizationBase);
  schemas.push({
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: 'Portfolio & Case Studies | InfoHQ',
    url: 'https://infohq.in/portfolio/',
    description: 'Projects built by InfoHQ: an AI healthcare app, SeHAT SmartCare, and a client website, Alpha Studio Tech.',
    publisher: {
      '@type': 'Organization',
      '@id': 'https://infohq.in/#organization',
      name: 'InfoHQ',
