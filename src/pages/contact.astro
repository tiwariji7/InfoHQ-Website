---
import BaseLayout from '../layouts/BaseLayout.astro';
import { contactConfig } from '../data/contactConfig';
import {
  Mail,
  Phone,
  MapPin,
  Clock,
  ShieldCheck,
  CheckCircle2,
  Code2,
  Sparkles,
  ArrowRight,
  Calendar,
  FileCheck,
  Lock,
  Cpu
} from 'lucide-astro';

const meta = {
  title: 'Contact InfoHQ — Start Your Software or AI Project',
  description: 'Consult InfoHQ for custom AI systems, enterprise RAG, SaaS platforms, or mobile apps. Headquartered in Prayagraj with operations in Pune, serving clients pan-India.',
  keywords: 'contact software development company India, hire AI developers India, AI development consultation, software engineering studio India, hire software engineers Pune, hire developers Prayagraj'
};

const consultationFaqs = [
  {
    q: 'How quickly will I hear back from InfoHQ?',
    a: 'Every inquiry submitted through our consultation form or email is reviewed by a senior engineer within 24 hours (Monday to Saturday, excluding national holidays). We do not use automated sales queues — you receive direct technical feedback and next steps.'
  },
  {
    q: 'Can we sign an NDA before sharing confidential project details?',
    a: 'Yes, absolutely. We regularly execute standard bilateral Non-Disclosure Agreements (NDAs) with founders and enterprise clients before reviewing proprietary code, internal documents, or product architectures.'
  },
  {
    q: 'Do you work with early-stage startups and MVP builds?',
    a: 'Yes. We specialize in taking concepts from zero to production-grade launch. Our startup MVP sprints begin at ₹14,999 for web apps and ₹39,999 for mobile apps, engineered with clean code and zero technical debt.'
  },
  {
    q: 'How are project payments and milestones structured?',
    a: 'We operate on milestone-based billing tied to verified deliverables (e.g., Sprint Planning, Architecture, Development, Staging Review, and Final Production Launch). You only pay as milestones are demonstrated and accepted.'
  },
  {
    q: 'Can we hire engineers on a monthly retainer plan?',
    a: 'Yes. For ongoing feature development, performance tuning, and technical operations, we offer predictable monthly engineering retainers starting at ₹9,999/month with direct Slack/WhatsApp collaboration.'
  },
  {
    q: 'Can we arrange an in-person meeting in Pune or Prayagraj?',
    a: 'Yes. While we operate remote-first across India and global time zones, in-person technical workshops and discovery sessions can be scheduled at our headquarters in Prayagraj or our tech operations hub in Pune.'
  }
];

const contactFaqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: consultationFaqs.map((faq) => ({
    '@type': 'Question',
    name: faq.q,
    acceptedAnswer: {
      '@type': 'Answer',
      text: faq.a
    }
  }))
};
---

<BaseLayout
  title={meta.title}
  description={meta.description}
  keywords={meta.keywords}
  schemaType="contact"
  ogImage="/og/contact.webp"
  showMobileCTA={false}
>
  <!-- Dedicated FAQPage JSON-LD Schema (Appended alongside ContactPage Schema) -->
  <script type="application/ld+json" set:html={JSON.stringify(contactFaqSchema)} />
  <!-- Ambient Edge Glows -->
  <div class="contact-ambient-glow glow-left" aria-hidden="true"></div>
  <div class="contact-ambient-glow glow-right" aria-hidden="true"></div>

  <!-- Main Section: Two-Column Consultation Desk -->
  <section class="section contact-section" aria-labelledby="contact-heading">
    <div class="container contact-container">
      
      <!-- Top Breadcrumb & Live SLA Pill -->
      <div class="contact-header-meta">
        <nav class="breadcrumb-nav" aria-label="Breadcrumb">
          <a href="/" class="crumb-link">Home</a>
          <span class="crumb-sep" aria-hidden="true">&gt;</span>
          <span class="crumb-current" aria-current="page">Contact &amp; Architecture Desk</span>
        </nav>
        
        <div class="live-sla-badge" title="Response time for submitted technical inquiries">
          <span class="sla-pulse" aria-hidden="true"></span>
          <span class="sla-text">24-Hour Review SLA (Mon–Sat)</span>
        </div>
      </div>

      <div class="contact-split-grid">
        
        <!-- LEFT COLUMN: Studio Authority, Direct Channels & Trust -->
        <div class="contact-info-column">
          <!-- Eyebrow -->
          <p class="contact-eyebrow">HEADQUARTERS: PRAYAGRAJ &middot; PUNE HUB &middot; PAN-INDIA &amp; GLOBAL</p>

          <!-- Main H1 Headline -->
          <h1 id="contact-heading" class="contact-hero-title">
            <span class="title-line-solid">Let's Architect Your</span>
            <span class="text-gradient">Next Digital System.</span>
          </h1>

          <!-- Subtext -->
          <p class="contact-hero-subtext">
            Skip the aggressive sales pitches. Speak directly with software architects and AI engineers who evaluate your technical requirements, scope practical milestones, and build production systems.
          </p>

          <!-- Direct Communication Channels Cards -->
          <div class="direct-channels-grid" role="region" aria-label="Direct Communication Channels">
            
            <!-- Channel 1: Direct Email -->
            <div class="channel-card">
              <div class="channel-icon-box" aria-hidden="true">
                <Mail size={18} stroke-width={2.2} />
              </div>
              <div class="channel-details">
                <span class="channel-label">Direct Engineering Inquiries</span>
                <a href={`mailto:${contactConfig.businessEmail}`} class="channel-value channel-link" title="Send email to InfoHQ engineering">
                  {contactConfig.businessEmail}
                </a>
                <span class="channel-sub">General &amp; Architecture Inquiries</span>
              </div>
            </div>

            <!-- Channel 2: WhatsApp & Direct Phone -->
            <div class="channel-card">
              <div class="channel-icon-box whatsapp-box" aria-hidden="true">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z" />
                </svg>
              </div>
              <div class="channel-details">
                <span class="channel-label">Direct WhatsApp &amp; Voice</span>
                <div class="channel-actions-row">
                  <a href={`tel:${contactConfig.telephone}`} class="channel-value channel-link">
                    {contactConfig.displayPhone}
                  </a>
                  <a
                    href={`https://wa.me/${contactConfig.whatsappNumber}?text=Hi%20InfoHQ%2C%20I%20would%20like%20to%20discuss%20a%20software%20or%20AI%20project.`}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="quick-wa-btn"
                    title="Open chat on WhatsApp"
                  >
                    Chat on WhatsApp
                  </a>
                </div>
                <span class="channel-sub">Mon &ndash; Sat, 9:30 AM &ndash; 7:30 PM IST</span>
              </div>
            </div>

            <!-- Channel 3: Engineering Locations & Hubs -->
            <div class="channel-card">
              <div class="channel-icon-box" aria-hidden="true">
                <MapPin size={18} stroke-width={2.2} />
              </div>
              <div class="channel-details">
                <span class="channel-label">Locations &amp; Hubs</span>
                <p class="channel-value channel-text">
                  <strong>Headquarters:</strong> Prayagraj, UP, India<br />
                  <strong>Active Operations Hub:</strong> Pune, MH, India
                </p>
                <span class="channel-sub">Remote-first delivery across India, US, UK &amp; APAC</span>
              </div>
            </div>

          </div>

          <!-- Enterprise Trust Assurances Bar -->
          <div class="trust-guarantees-card">
            <h2 class="guarantees-title">The InfoHQ Engineering Standard</h2>
            <ul class="guarantees-list">
              <li class="guarantee-item">
                <CheckCircle2 size={16} class="check-icon" aria-hidden="true" />
                <span><strong>100% Code &amp; IP Ownership:</strong> Complete source code, schemas, and Git repos transferred to your control.</span>
              </li>
              <li class="guarantee-item">
                <ShieldCheck size={16} class="check-icon" aria-hidden="true" />
                <span><strong>Mutual NDA Protection:</strong> Bilateral confidentiality agreements executed before reviewing proprietary workflows.</span>
              </li>
              <li class="guarantee-item">
                <Code2 size={16} class="check-icon" aria-hidden="true" />
                <span><strong>Direct Engineer Access:</strong> Collaborate directly with the engineers authoring your codebase via Slack or WhatsApp.</span>
              </li>
            </ul>
          </div>

        </div>


        <!-- RIGHT COLUMN: Interactive Consultation Form Card -->
        <div class="contact-form-column">
          <div class="card consultation-form-card" id="consultation-desk">
            
            <!-- Card Header -->
            <div class="form-card-header">
              <div class="form-card-badge">
                <Sparkles size={13} aria-hidden="true" />
                <span>Free Technical Scoping</span>
              </div>
              <h2 class="form-card-title">Book an <span class="text-gradient">Architecture Consultation</span></h2>
              <p class="form-card-subtext">
                Fill in your project requirements. A senior engineer will review your specifications and follow up within 24 hours (Mon–Sat, excluding national holidays).
              </p>
            </div>

            <!-- Form -->
            <form id="consultation-form" class="consultation-form" novalidate>

              <!-- Anti-spam honeypot: hidden from visitors -->
              <div
                style="position:absolute;left:-9999px;width:1px;height:1px;overflow:hidden;"
                aria-hidden="true"
              >
                <label for="website">Website</label>
                <input
                  type="text"
                  id="website"
                  name="website"
                  tabindex="-1"
                  autocomplete="off"
                />
              </div>
              
              <!-- 1. Row: Full Name * | Work Email * -->
              <div class="form-fields-row-2">
                <div class="form-field-group">
                  <label for="contact-name" class="field-label">Full Name <span class="req" aria-hidden="true">*</span></label>
                  <input 
                    type="text" 
                    id="contact-name" 
                    name="fullName" 
                    required 
                    class="field-input" 
                    placeholder="e.g. Rahul Sharma"
                    autocomplete="name"
                  />
                  <span class="field-error-message" id="name-error" role="alert"></span>
                </div>

                <div class="form-field-group">
                  <label for="contact-email" class="field-label">Work Email <span class="req" aria-hidden="true">*</span></label>
                  <input 
                    type="email" 
                    id="contact-email" 
                    name="email" 
                    required 
                    class="field-input" 
                    placeholder="e.g. rahul@company.com"
                    autocomplete="email"
                  />
                  <span class="field-error-message" id="email-error" role="alert"></span>
                </div>
              </div>

              <!-- 2. Row: Phone / WhatsApp * | Company Name (Optional) -->
              <div class="form-fields-row-2">
                <div class="form-field-group">
                  <label for="contact-phone" class="field-label">Phone / WhatsApp <span class="req" aria-hidden="true">*</span></label>
                  <input 
                    type="tel" 
                    id="contact-phone" 
                    name="phone" 
                    required
                    class="field-input" 
                    placeholder="+91 98765 01234 or +1 (555) 012-3456"
                    autocomplete="tel"
                    aria-describedby="phone-hint"
                  />
                  <span id="phone-hint" class="field-hint-text">India mobile or international with country code</span>
                  <span class="field-error-message" id="phone-error" role="alert"></span>
                </div>

                <div class="form-field-group">
                  <label for="contact-company" class="field-label">Company / Project Name <span class="optional-tag">(Optional)</span></label>
                  <input 
                    type="text" 
                    id="contact-company" 
                    name="company" 
                    class="field-input" 
                    placeholder="e.g. Acme Tech Innovations"
                    autocomplete="organization"
                  />
                </div>
              </div>

              <!-- 3. What do you need engineered? * (Pills Wrap) -->
              <div class="form-field-group">
                <fieldset class="selectable-fieldset">
                  <legend class="field-label">What do you need engineered? <span class="req" aria-hidden="true">*</span></legend>
                  
                  <div class="service-pills-wrap" role="radiogroup">
                    
                    <label class="pill-chip-label" for="service-ai">
                      <input type="radio" id="service-ai" name="serviceType" value="AI / Automation" class="sr-only-radio" required />
                      <span class="pill-chip-box">
                        <Cpu size={13} class="chip-icon" aria-hidden="true" />
                        <span>Autonomous AI &amp; RAG</span>
                      </span>
                    </label>

                    <label class="pill-chip-label" for="service-software">
                      <input type="radio" id="service-software" name="serviceType" value="Custom Software" class="sr-only-radio" />
                      <span class="pill-chip-box">
                        <Code2 size={13} class="chip-icon" aria-hidden="true" />
                        <span>Custom Software / SaaS</span>
                      </span>
                    </label>

                    <label class="pill-chip-label" for="service-web">
                      <input type="radio" id="service-web" name="serviceType" value="Website / Web App" class="sr-only-radio" />
                      <span class="pill-chip-box">
                        <span>Web Platform</span>
                      </span>
                    </label>

                    <label class="pill-chip-label" for="service-mobile">
                      <input type="radio" id="service-mobile" name="serviceType" value="Mobile App" class="sr-only-radio" />
                      <span class="pill-chip-box">
                        <span>Mobile App (iOS/Android)</span>
                      </span>
                    </label>

                    <label class="pill-chip-label" for="service-automation">
                      <input type="radio" id="service-automation" name="serviceType" value="Business Process / CRM" class="sr-only-radio" />
                      <span class="pill-chip-box">
                        <span>Workflow &amp; CRM Automation</span>
                      </span>
                    </label>

                    <label class="pill-chip-label" for="service-cloud">
                      <input type="radio" id="service-cloud" name="serviceType" value="Cloud / DevOps" class="sr-only-radio" />
                      <span class="pill-chip-box">
                        <span>Cloud, DevOps &amp; Security</span>
                      </span>
                    </label>

                    <label class="pill-chip-label" for="service-guidance">
                      <input type="radio" id="service-guidance" name="serviceType" value="Not Sure Yet" class="sr-only-radio" />
                      <span class="pill-chip-box">
                        <span>Not Sure Yet / Guidance</span>
                      </span>
                    </label>

                  </div>
                </fieldset>
                <span class="field-error-message" id="service-error" role="alert"></span>
              </div>

              <!-- 4. Project Brief / Problem Statement (Optional) -->
              <div class="form-field-group">
                <label for="contact-brief" class="field-label">
                  Project Brief or Problem Statement <span class="optional-tag">(Optional)</span>
                </label>
                <div class="textarea-wrapper">
                  <textarea 
                    id="contact-brief" 
                    name="projectBrief" 
                    rows="3" 
                    maxlength="1000" 
                    class="field-textarea" 
                    placeholder="Briefly describe what you're looking to build, existing bottlenecks, or target milestones..."
                  ></textarea>
                  <div class="textarea-bottom-row">
                    <span class="field-error-message" id="brief-error" role="alert"></span>
                    <span id="char-counter" class="char-counter" aria-live="polite">0/1000</span>
                  </div>
                </div>
              </div>

              <!-- 5. Row: Estimated Budget (Optional) | Preferred Timeline (Optional) -->
              <div class="form-fields-row-2">
                <div class="form-field-group">
                  <label for="contact-budget" class="field-label">Estimated Budget <span class="optional-tag">(Optional)</span></label>
                  <div class="select-wrapper">
                    <select id="contact-budget" name="budget" class="field-select">
                      <option value="" selected>Select budget bracket</option>
                      <option value="Starter MVP (₹14,999 - ₹49,999)">Starter MVP (₹14,999 &ndash; ₹49,999)</option>
                      <option value="Growth Platform (₹50,000 - ₹1,49,999)">Growth Platform (₹50,000 &ndash; ₹1,49,999)</option>
                      <option value="Enterprise System (₹1,50,000+)">Enterprise System (₹1,50,000+)</option>
                      <option value="Monthly Retainer (from ₹9,999/mo)">Monthly Retainer (from ₹9,999/mo)</option>
                      <option value="Undecided / Need Guidance">Undecided / Need Guidance</option>
                    </select>
                    <span class="select-chevron" aria-hidden="true">
                      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                        <polyline points="6 9 12 15 18 9"></polyline>
                      </svg>
                    </span>
                  </div>
                </div>

                <div class="form-field-group">
                  <label for="contact-timeline" class="field-label">Target Launch Timeline <span class="optional-tag">(Optional)</span></label>
                  <div class="select-wrapper">
                    <select id="contact-timeline" name="timeline" class="field-select">
                      <option value="" selected>Select timeline</option>
                      <option value="Immediately (within 2 weeks)">Immediately (within 2 weeks)</option>
                      <option value="Within 1 month">Within 1 month</option>
                      <option value="1-3 months">1 &ndash; 3 months</option>
                      <option value="Flexible / Just exploring">Flexible / Just exploring</option>
                    </select>
                    <span class="select-chevron" aria-hidden="true">
                      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                        <polyline points="6 9 12 15 18 9"></polyline>
                      </svg>
                    </span>
                  </div>
                </div>
              </div>

              <!-- 6. Preferred way to connect * -->
              <div class="form-field-group">
                <fieldset class="selectable-fieldset">
                  <legend class="field-label">Preferred way to connect <span class="req" aria-hidden="true">*</span></legend>
                  
                  <div class="preferred-pills-wrap" role="radiogroup">
                    
                    <label class="pill-chip-label" for="pref-email">
                      <input type="radio" id="pref-email" name="preferredContact" value="Email" class="sr-only-radio" required />
                      <span class="pill-chip-box">
                        <Mail size={14} stroke-width={2} class="pill-icon" aria-hidden="true" />
                        <span>Email</span>
                      </span>
                    </label>

                    <label class="pill-chip-label" for="pref-whatsapp">
                      <input type="radio" id="pref-whatsapp" name="preferredContact" value="WhatsApp" class="sr-only-radio" />
                      <span class="pill-chip-box">
                        <svg class="pill-icon whatsapp-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                          <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z" />
                        </svg>
                        <span>WhatsApp</span>
                      </span>
                    </label>

                    <label class="pill-chip-label" for="pref-phone">
                      <input type="radio" id="pref-phone" name="preferredContact" value="Phone Call" class="sr-only-radio" />
                      <span class="pill-chip-box">
                        <Phone size={14} stroke-width={2} class="pill-icon" aria-hidden="true" />
                        <span>Phone Call</span>
                      </span>
                    </label>

                  </div>
                </fieldset>
                <span class="field-error-message" id="preferred-error" role="alert"></span>
              </div>

              <!-- 7. Submit button -->
              <div class="form-submit-wrapper">
                <button
                  type="submit"
                  id="contact-submit-btn"
                  class="contact-submit-btn"
                >
                  <span>Book Free Consultation</span>
                  <ArrowRight size={16} aria-hidden="true" />
                </button>
              </div>

              <!-- 8. Microcopy -->
              <p class="form-microcopy">
                <Lock size={12} class="lock-icon" aria-hidden="true" />
                <span>Zero spam. Share a high-level summary; mutual NDA executed on request before technical deep-dives.</span>
              </p>

              <!-- Feedback Banner -->
              <div id="form-feedback-message" class="feedback-banner" style="display: none;" role="status" aria-live="polite"></div>

            </form>

          </div>
        </div>

      </div>
    </div>
  </section>


  <!-- SECTION 2: "What Happens Next?" (The 3-Step Tech Consultation Roadmap) -->
  <section class="section section-alt process-roadmap-section" aria-labelledby="roadmap-heading">
    <div class="container">
      <div class="section-header text-center">
        <span class="text-eyebrow">OUR ENGAGEMENT PROTOCOL</span>
        <h2 id="roadmap-heading" class="section-title">
          What Happens After You <span class="text-gradient">Submit Your Brief?</span>
        </h2>
        <p class="section-lead">
          We treat every inquiry as a serious technical problem, not an aggressive sales conversion. Here is our step-by-step engagement process.
        </p>
      </div>

      <div class="roadmap-cards-grid">
        
        <!-- Step 1 -->
        <div class="card roadmap-card">
          <div class="roadmap-card-top">
            <span class="step-number">01</span>
            <div class="step-icon-wrap" aria-hidden="true">
              <Clock size={20} />
            </div>
          </div>
          <h3 class="roadmap-step-title">Technical Review (Within 24 Hours, Mon–Sat)</h3>
          <p class="roadmap-step-desc">
            An engineering lead analyzes your requirements, assesses system feasibility, and checks architectural trade-offs against your timeline.
          </p>
          <ul class="step-features">
            <li>Review of technical stack &amp; data models</li>
            <li>Feasibility &amp; complexity estimation</li>
            <li>Mutual NDA execution on request</li>
          </ul>
        </div>

        <!-- Step 2 -->
        <div class="card roadmap-card">
          <div class="roadmap-card-top">
            <span class="step-number">02</span>
            <div class="step-icon-wrap" aria-hidden="true">
              <Calendar size={20} />
            </div>
          </div>
          <h3 class="roadmap-step-title">Architecture Discovery Call</h3>
          <p class="roadmap-step-desc">
            A focused 30-minute video or phone consultation with the developers who will architect your platform. No slides, no sales pressure.
          </p>
          <ul class="step-features">
            <li>Clarify core system user journeys</li>
            <li>Determine API &amp; cloud infrastructure</li>
            <li>Define MVP vs long-term scope</li>
          </ul>
        </div>

        <!-- Step 3 -->
        <div class="card roadmap-card">
          <div class="roadmap-card-top">
            <span class="step-number">03</span>
            <div class="step-icon-wrap" aria-hidden="true">
              <FileCheck size={20} />
            </div>
          </div>
          <h3 class="roadmap-step-title">Fixed Scope &amp; Milestone Roadmap</h3>
          <p class="roadmap-step-desc">
            You receive a transparent, itemized proposal detailing sprint milestones, transparent costs, delivery timelines, and 100% IP ownership.
          </p>
          <ul class="step-features">
            <li>Itemized deliverables &amp; milestone schedule</li>
            <li>Fixed pricing or dedicated retainer scope</li>
            <li>Direct Slack/WhatsApp onboarding</li>
          </ul>
        </div>

      </div>
    </div>
  </section>


  <!-- SECTION 3: Consultation FAQs -->
  <section class="section faq-section" aria-labelledby="contact-faq-heading">
    <div class="container faq-container">
      <div class="section-header text-center">
        <span class="text-eyebrow">CLEAR ANSWERS</span>
        <h2 id="contact-faq-heading" class="section-title">
          Frequently Asked <span class="text-gradient">Questions</span>
        </h2>
        <p class="section-lead">
          Everything you need to know about initiating a project, NDA terms, and engineering collaboration with InfoHQ.
        </p>
      </div>

      <div class="faq-accordion">
        {consultationFaqs.map((faq) => (
          <details class="faq-item">
            <summary class="faq-question">
              <strong>{faq.q}</strong>
              <span class="faq-icon" aria-hidden="true">+</span>
            </summary>
            <div class="faq-answer">
              <p>{faq.a}</p>
            </div>
          </details>
        ))}
      </div>

      <!-- Bottom Direct Contact Reassurance -->
      <div class="faq-bottom-cta">
        <p class="faq-bottom-text">
          Have a specialized question or need immediate architecture feedback?
        </p>
        <div class="faq-bottom-actions">
          <a href={`mailto:${contactConfig.businessEmail}`} class="btn btn-secondary btn-sm">
            Email Us Directly
          </a>
          <a
            href={`https://wa.me/${contactConfig.whatsappNumber}?text=Hi%20InfoHQ%2C%20I%20have%20a%20question%20regarding%20an%20engineering%20project.`}
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-primary btn-sm"
          >
            Chat on WhatsApp ({contactConfig.displayPhone})
          </a>
        </div>
      </div>

    </div>
  </section>

