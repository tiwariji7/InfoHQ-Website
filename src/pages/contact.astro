---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import FinalCTA from '../components/FinalCTA.astro';
import { 
  Users, 
  Lightbulb, 
  Settings, 
  Award, 
  Code, 
  Clock, 
  MessageSquare, 
  User, 
  Mail, 
  Building2, 
  Globe, 
  Smartphone, 
  Sparkles, 
  Code2, 
  Database, 
  Cloud, 
  Palette, 
  HelpCircle, 
  FileText, 
  IndianRupee, 
  Calendar, 
  Phone, 
  Lock, 
  Check 
} from 'lucide-astro';

const meta = {
  title: 'Contact InfoHQ — Get a Free Consultation',
  description: 'Reach InfoHQ for your AI, software, or digital project. Based in Pune & Prayagraj, serving clients pan-India. Get a response within 1 business day.',
  keywords: 'contact software development company India, hire AI developers India, software company contact Pune'
};
---

<BaseLayout
  title={meta.title}
  description={meta.description}
  keywords={meta.keywords}
  schemaType="contact"
  showMobileCTA={false}
>
  <!-- Main Two-Column Contact Section -->
  <section class="section contact-section" aria-labelledby="contact-heading">
    <!-- Subtle Background Dot-Grid & Corner Blob -->
    <div class="contact-bg-pattern" aria-hidden="true"></div>
    <div class="contact-bg-blob" aria-hidden="true"></div>

    <div class="container contact-container">
      <div class="contact-split-grid">
        
        <!-- LEFT COLUMN: Studio Info & Assurance -->
        <div class="contact-info-column">
          <!-- Top Pill Badge -->
          <div class="studio-pill-badge">
            <span class="badge-dot" aria-hidden="true"></span>
            <span class="badge-text">Pune • Prayagraj • Pan-India Engineering Studio</span>
          </div>

          <!-- Main H1 Headline -->
          <h1 id="contact-heading" class="contact-hero-title">
            <span class="title-line-solid">Let's Talk About</span>
            <span class="title-line-gradient">Your Idea.</span>
          </h1>

          <!-- Subtext -->
          <p class="contact-hero-subtext">
            Not sure where to start? Tell us what you're trying to build or solve. We'll help you figure out the right approach, suggest the best solution, and guide you with a clear plan.
          </p>

          <!-- 3 Feature Rows -->
          <div class="feature-rows-list">
            <!-- Row 1: Free Consultation -->
            <div class="feature-row-item">
              <div class="feature-icon-tile tile-purple" aria-hidden="true">
                <Users size={26} stroke-width={2} />
              </div>
              <div class="feature-row-content">
                <h2 class="feature-row-title">Free Consultation</h2>
                <p class="feature-row-desc">
                  Discuss your idea with our senior engineers. Get honest guidance, not a sales pitch.
                </p>
              </div>
            </div>

            <!-- Row 2: Right Solution -->
            <div class="feature-row-item">
              <div class="feature-icon-tile tile-coral" aria-hidden="true">
                <Lightbulb size={26} stroke-width={2} />
              </div>
              <div class="feature-row-content">
                <h2 class="feature-row-title">Right Solution</h2>
                <p class="feature-row-desc">
                  We'll suggest the best approach, technology and roadmap for your goals.
                </p>
              </div>
            </div>

            <!-- Row 3: Practical Plan -->
            <div class="feature-row-item">
              <div class="feature-icon-tile tile-blue" aria-hidden="true">
                <Settings size={26} stroke-width={2} />
              </div>
              <div class="feature-row-content">
                <h2 class="feature-row-title">Practical Plan</h2>
                <p class="feature-row-desc">
                  Clear scope, timeline and cost estimate based on your requirements.
                </p>
              </div>
            </div>
          </div>

          <!-- Horizontal Divider -->
          <hr class="contact-divider" />

          <!-- Bottom Row: 3-Item Stats & Handwritten Accent Line -->
          <div class="stats-and-accent-row">
            <!-- 3-Item Stats Row -->
            <div class="stats-items-grid">
              <div class="stat-box">
                <div class="stat-icon-wrapper" aria-hidden="true">
                  <Award size={20} stroke-width={2.2} />
                </div>
                <div class="stat-text-group">
                  <span class="stat-number">100%</span>
                  <span class="stat-label">Client Focused</span>
                </div>
              </div>

              <div class="stat-box">
                <div class="stat-icon-wrapper" aria-hidden="true">
                  <Code size={20} stroke-width={2.2} />
                </div>
                <div class="stat-text-group">
                  <span class="stat-number">Dedicated</span>
                  <span class="stat-label">Engineers</span>
                </div>
              </div>

              <div class="stat-box">
                <div class="stat-icon-wrapper" aria-hidden="true">
                  <Clock size={20} stroke-width={2.2} />
                </div>
                <div class="stat-text-group">
                  <span class="stat-number">Response</span>
                  <span class="stat-label">within 1 business day</span>
                </div>
              </div>
            </div>

            <!-- Handwritten Accent Line (Real Text, Caveat Font) -->
            <div class="handwritten-accent" aria-label="Ideas, Discussions, Solutions, Growth">
              <div class="handwritten-text">
                <span>Ideas</span>
                <span>Discussions</span>
                <span>Solutions</span>
                <span>Growth</span>
              </div>
              <svg class="handwritten-arrow" width="34" height="34" viewBox="0 0 40 40" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M6 32 C 14 26, 22 19, 32 10" />
                <path d="M21 8 L33 9 L31 21" />
              </svg>
            </div>
          </div>

        </div>


        <!-- RIGHT COLUMN: Consultation Form Card -->
        <div class="contact-form-column">
          <div class="card consultation-form-card">
            
            <!-- Card Header Row -->
            <div class="form-card-header">
              <div class="form-header-icon" aria-hidden="true">
                <MessageSquare size={22} stroke-width={2.2} />
              </div>
              <div class="form-header-text">
                <h2 class="form-card-title">Book a Free Consultation</h2>
                <p class="form-card-subtext">
                  Tell us a little about yourself and your idea. We'll get back to you soon.
                </p>
              </div>
            </div>

            <!-- Form -->
            <form id="consultation-form" class="consultation-form" novalidate>
              
              <!-- 1. Row: Full Name * | Work Email * -->
              <div class="form-fields-row-2">
                <div class="form-field-group">
                  <label for="contact-name" class="field-label">Full Name <span class="req" aria-hidden="true">*</span></label>
                  <div class="field-input-wrapper">
                    <span class="input-leading-icon" aria-hidden="true">
                      <User size={18} stroke-width={2} />
                    </span>
                    <input 
                      type="text" 
                      id="contact-name" 
                      name="fullName" 
                      required 
                      class="field-input" 
                      placeholder="e.g. Rahul Sharma"
                      autocomplete="name"
                    />
                  </div>
                  <span class="field-error-message" id="name-error" role="alert"></span>
                </div>

                <div class="form-field-group">
                  <label for="contact-email" class="field-label">Work Email <span class="req" aria-hidden="true">*</span></label>
                  <div class="field-input-wrapper">
                    <span class="input-leading-icon" aria-hidden="true">
                      <Mail size={18} stroke-width={2} />
                    </span>
                    <input 
                      type="email" 
                      id="contact-email" 
                      name="email" 
                      required 
                      class="field-input" 
                      placeholder="e.g. rahul@company.com"
                      autocomplete="email"
                    />
                  </div>
                  <span class="field-error-message" id="email-error" role="alert"></span>
                </div>
              </div>

              <!-- 2. Row: Phone / WhatsApp (Optional) | Company Name (Optional) -->
              <div class="form-fields-row-2">
                <div class="form-field-group">
                  <label for="contact-phone" class="field-label">Phone / WhatsApp <span class="optional-tag">(Optional)</span></label>
                  <div class="field-input-wrapper">
                    <span class="input-leading-icon" aria-hidden="true">
                      <!-- WhatsApp/Phone Icon -->
                      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z" />
                      </svg>
                    </span>
                    <input 
                      type="tel" 
                      id="contact-phone" 
                      name="phone" 
                      class="field-input" 
                      placeholder="+91 98765 43210"
                      autocomplete="tel"
                    />
                  </div>
                </div>

                <div class="form-field-group">
                  <label for="contact-company" class="field-label">Company Name <span class="optional-tag">(Optional)</span></label>
                  <div class="field-input-wrapper">
                    <span class="input-leading-icon" aria-hidden="true">
                      <Building2 size={18} stroke-width={2} />
                    </span>
                    <input 
                      type="text" 
                      id="contact-company" 
                      name="company" 
                      class="field-input" 
                      placeholder="e.g. Acme Tech Solutions"
                      autocomplete="organization"
                    />
                  </div>
                </div>
              </div>

              <!-- 3. What do you need help with? * (Selectable cards grid) -->
              <div class="form-field-group">
                <fieldset class="selectable-fieldset">
                  <legend class="field-label">What do you need help with? <span class="req" aria-hidden="true">*</span></legend>
                  
                  <div class="service-cards-grid" role="radiogroup" aria-labelledby="service-grid-label">
                    
                    <!-- 1. Website / Web App -->
                    <label class="service-chip-label" for="service-web">
                      <input type="radio" id="service-web" name="serviceType" value="Website / Web App" class="sr-only-radio" required />
                      <div class="service-chip-box">
                        <span class="chip-icon" aria-hidden="true"><Globe size={18} stroke-width={2} /></span>
                        <span class="chip-text">Website / Web App</span>
                        <span class="chip-check-badge" aria-hidden="true"><Check size={11} stroke-width={3} /></span>
                      </div>
                    </label>

                    <!-- 2. Mobile App -->
                    <label class="service-chip-label" for="service-mobile">
                      <input type="radio" id="service-mobile" name="serviceType" value="Mobile App" class="sr-only-radio" />
                      <div class="service-chip-box">
                        <span class="chip-icon" aria-hidden="true"><Smartphone size={18} stroke-width={2} /></span>
                        <span class="chip-text">Mobile App</span>
                        <span class="chip-check-badge" aria-hidden="true"><Check size={11} stroke-width={3} /></span>
                      </div>
                    </label>

                    <!-- 3. AI / Automation -->
                    <label class="service-chip-label" for="service-ai">
                      <input type="radio" id="service-ai" name="serviceType" value="AI / Automation" class="sr-only-radio" />
                      <div class="service-chip-box">
                        <span class="chip-icon" aria-hidden="true"><Sparkles size={18} stroke-width={2} /></span>
                        <span class="chip-text">AI / Automation</span>
                        <span class="chip-check-badge" aria-hidden="true"><Check size={11} stroke-width={3} /></span>
                      </div>
                    </label>

                    <!-- 4. Custom Software -->
                    <label class="service-chip-label" for="service-software">
                      <input type="radio" id="service-software" name="serviceType" value="Custom Software" class="sr-only-radio" />
                      <div class="service-chip-box">
                        <span class="chip-icon" aria-hidden="true"><Code2 size={18} stroke-width={2} /></span>
                        <span class="chip-text">Custom Software</span>
                        <span class="chip-check-badge" aria-hidden="true"><Check size={11} stroke-width={3} /></span>
                      </div>
                    </label>

                    <!-- 5. Business Process / CRM -->
                    <label class="service-chip-label" for="service-crm">
                      <input type="radio" id="service-crm" name="serviceType" value="Business Process / CRM" class="sr-only-radio" />
                      <div class="service-chip-box">
                        <span class="chip-icon" aria-hidden="true"><Database size={18} stroke-width={2} /></span>
                        <span class="chip-text">Business Process / CRM</span>
                        <span class="chip-check-badge" aria-hidden="true"><Check size={11} stroke-width={3} /></span>
                      </div>
                    </label>

                    <!-- 6. Cloud / DevOps & Infrastructure -->
                    <label class="service-chip-label" for="service-cloud">
                      <input type="radio" id="service-cloud" name="serviceType" value="Cloud / DevOps & Infrastructure" class="sr-only-radio" />
                      <div class="service-chip-box">
                        <span class="chip-icon" aria-hidden="true"><Cloud size={18} stroke-width={2} /></span>
                        <span class="chip-text">Cloud / DevOps &amp; Infrastructure</span>
                        <span class="chip-check-badge" aria-hidden="true"><Check size={11} stroke-width={3} /></span>
                      </div>
                    </label>

                    <!-- 7. Design & Marketing (Added per Flag #2) -->
                    <label class="service-chip-label" for="service-design">
                      <input type="radio" id="service-design" name="serviceType" value="Design & Marketing" class="sr-only-radio" />
                      <div class="service-chip-box">
                        <span class="chip-icon" aria-hidden="true"><Palette size={18} stroke-width={2} /></span>
                        <span class="chip-text">Design &amp; Marketing</span>
                        <span class="chip-check-badge" aria-hidden="true"><Check size={11} stroke-width={3} /></span>
                      </div>
                    </label>

                    <!-- 8. Not Sure / Need Guidance -->
                    <label class="service-chip-label" for="service-guidance">
                      <input type="radio" id="service-guidance" name="serviceType" value="Not Sure / Need Guidance" class="sr-only-radio" />
                      <div class="service-chip-box">
                        <span class="chip-icon" aria-hidden="true"><HelpCircle size={18} stroke-width={2} /></span>
                        <span class="chip-text">Not Sure / Need Guidance</span>
                        <span class="chip-check-badge" aria-hidden="true"><Check size={11} stroke-width={3} /></span>
                      </div>
                    </label>

                  </div>
                </fieldset>
                <span class="field-error-message" id="service-error" role="alert"></span>
              </div>

              <!-- 4. Tell us about your idea or requirement * -->
              <div class="form-field-group">
                <label for="contact-brief" class="field-label field-label-with-icon">
                  <FileText size={16} stroke-width={2} aria-hidden="true" />
                  <span>Tell us about your idea or requirement <span class="req" aria-hidden="true">*</span></span>
                </label>
                <div class="textarea-wrapper">
                  <textarea 
                    id="contact-brief" 
                    name="projectBrief" 
                    rows="4" 
                    maxlength="1000" 
                    required 
                    class="field-textarea" 
                    placeholder="What are you trying to build, improve, or solve? Feel free to share any details."
                  ></textarea>
                  <div class="textarea-bottom-row">
                    <span class="field-error-message" id="brief-error" role="alert"></span>
                    <span id="char-counter" class="char-counter" aria-live="polite">0/1000</span>
                  </div>
                </div>
              </div>

              <!-- 5. Row: Estimated Budget (Optional) | When would you like to start? (Optional) -->
              <div class="form-fields-row-2">
                <div class="form-field-group">
                  <label for="contact-budget" class="field-label">Estimated Budget <span class="optional-tag">(Optional)</span></label>
                  <div class="field-input-wrapper select-wrapper">
                    <span class="input-leading-icon" aria-hidden="true">
                      <IndianRupee size={18} stroke-width={2} />
                    </span>
                    <select id="contact-budget" name="budget" class="field-select">
                      <option value="" selected>Select budget range</option>
                      <option value="Under ₹15,000">Under ₹15,000</option>
                      <option value="₹15,000 - ₹30,000">₹15,000 - ₹30,000</option>
                      <option value="₹30,000 - ₹50,000">₹30,000 - ₹50,000</option>
                      <option value="₹50,000+">₹50,000+</option>
                      <option value="Not sure yet">Not sure yet</option>
                    </select>
                    <span class="select-chevron" aria-hidden="true">
                      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                        <polyline points="6 9 12 15 18 9"></polyline>
                      </svg>
                    </span>
                  </div>
                </div>

                <div class="form-field-group">
                  <label for="contact-timeline" class="field-label">When would you like to start? <span class="optional-tag">(Optional)</span></label>
                  <div class="field-input-wrapper select-wrapper">
                    <span class="input-leading-icon" aria-hidden="true">
                      <Calendar size={18} stroke-width={2} />
                    </span>
                    <select id="contact-timeline" name="timeline" class="field-select">
                      <option value="" selected>Select timeline</option>
                      <option value="Immediately">Immediately</option>
                      <option value="Within 1 month">Within 1 month</option>
                      <option value="1-3 months">1-3 months</option>
                      <option value="Just exploring">Just exploring</option>
                    </select>
                    <span class="select-chevron" aria-hidden="true">
                      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                        <polyline points="6 9 12 15 18 9"></polyline>
                      </svg>
                    </span>
                  </div>
                </div>
              </div>

              <!-- 6. Preferred way to connect (Optional) -->
              <div class="form-field-group">
                <fieldset class="selectable-fieldset">
                  <legend class="field-label">Preferred way to connect <span class="optional-tag">(Optional)</span></legend>
                  
                  <div class="preferred-chips-grid" role="radiogroup">
                    
                    <!-- Email (default checked) -->
                    <label class="preferred-chip-label" for="pref-email">
                      <input type="radio" id="pref-email" name="preferredContact" value="Email" class="sr-only-radio" checked />
                      <div class="preferred-chip-box">
                        <span class="chip-icon" aria-hidden="true"><Mail size={16} stroke-width={2} /></span>
                        <span class="chip-text">Email</span>
                        <span class="chip-check-badge" aria-hidden="true"><Check size={10} stroke-width={3} /></span>
                      </div>
                    </label>

                    <!-- WhatsApp -->
                    <label class="preferred-chip-label" for="pref-whatsapp">
                      <input type="radio" id="pref-whatsapp" name="preferredContact" value="WhatsApp" class="sr-only-radio" />
                      <div class="preferred-chip-box">
                        <span class="chip-icon" aria-hidden="true">
                          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z" />
                          </svg>
                        </span>
                        <span class="chip-text">WhatsApp</span>
                        <span class="chip-check-badge" aria-hidden="true"><Check size={10} stroke-width={3} /></span>
                      </div>
                    </label>

                    <!-- Phone Call -->
                    <label class="preferred-chip-label" for="pref-phone">
                      <input type="radio" id="pref-phone" name="preferredContact" value="Phone Call" class="sr-only-radio" />
                      <div class="preferred-chip-box">
                        <span class="chip-icon" aria-hidden="true"><Phone size={16} stroke-width={2} /></span>
                        <span class="chip-text">Phone Call</span>
                        <span class="chip-check-badge" aria-hidden="true"><Check size={10} stroke-width={3} /></span>
                      </div>
                    </label>

                  </div>
                </fieldset>
              </div>

              <!-- 7. Submit button: Full Width, Brand Gradient, Trailing Arrow -->
              <div class="form-submit-wrapper">
                <Button
                  type="submit"
                  variant="gradient"
                  size="lg"
                  label="Book Free Consultation"
                  icon="arrow-inline"
                  fullWidth={true}
                  id="contact-submit-btn"
                  class="submit-gradient-btn"
                />
              </div>

              <!-- 8. Trust Microcopy -->
              <div class="form-trust-copy">
                <span class="trust-icon" aria-hidden="true"><Lock size={14} stroke-width={2.2} /></span>
                <span class="trust-text">No commitment. Just a conversation about your idea. Your information is safe with us.</span>
              </div>

              <!-- Feedback Banner (aria-live) -->
              <div id="form-feedback-message" class="feedback-banner" style="display: none;" role="status" aria-live="polite"></div>

            </form>

          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- Final CTA: Prefer to Just Talk It Through? -->
  <FinalCTA page="contact" />
</BaseLayout>

<style>
  /* Import Caveat cursive font for the handwritten accent line only */
  @import url('https://fonts.googleapis.com/css2?family=Caveat:wght@600;700&display=swap');

  /* Contact Page Base Section */
  .contact-section {
    position: relative;
    padding-top: clamp(2.5rem, 5vw, 4.5rem);
    padding-bottom: clamp(3.5rem, 6vw, 5.5rem);
    background: var(--color-bg-page);
    overflow: hidden;
  }

  /* Decorative CSS-only dot grid in top-left */
  .contact-bg-pattern {
    position: absolute;
    top: 0;
    left: 0;
    width: 55%;
    height: 60%;
    background-image: radial-gradient(circle, rgba(124, 92, 232, 0.14) 1.2px, transparent 1.2px);
    background-size: 24px 24px;
    pointer-events: none;
    z-index: 0;
    opacity: 0.85;
    mask-image: radial-gradient(ellipse at 20% 20%, black 30%, transparent 75%);
    -webkit-mask-image: radial-gradient(ellipse at 20% 20%, black 30%, transparent 75%);
  }

  /* Decorative soft gradient blob in bottom-right */
  .contact-bg-blob {
    position: absolute;
    bottom: -10%;
    right: -10%;
    width: 600px;
    height: 600px;
    background: radial-gradient(circle, rgba(221, 73, 133, 0.09) 0%, rgba(124, 92, 232, 0.08) 40%, rgba(87, 130, 224, 0.04) 70%, transparent 80%);
    filter: blur(50px);
    pointer-events: none;
    z-index: 0;
  }

  .contact-container {
    position: relative;
    z-index: 1;
  }

  /* Two Column Split Grid */
  .contact-split-grid {
    display: grid;
    grid-template-columns: 0.85fr 1.15fr;
    gap: clamp(1.5rem, 3vw, 3rem);
    align-items: start;
  }

  /* ==========================================================================
     LEFT COLUMN STYLES
     ========================================================================== */
  .contact-info-column {
    display: flex;
    flex-direction: column;
    padding-top: 0.5rem;
  }

  /* Top Pill Badge */
  .studio-pill-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    align-self: flex-start;
    padding: 6px 14px;
    border-radius: var(--radius-full);
    background: rgba(255, 255, 255, 0.85);
    border: 1px solid var(--color-border-card);
    box-shadow: 0 2px 8px rgba(26, 8, 92, 0.04);
    margin-bottom: 1.5rem;
  }

  .badge-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background-color: var(--color-primary);
    flex-shrink: 0;
  }

  .badge-text {
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--color-text-heading);
    letter-spacing: 0.02em;
  }

  /* H1 Headline */
  .contact-hero-title {
    display: flex;
    flex-direction: column;
    font-size: clamp(2.35rem, 4.4vw, 3.75rem);
    font-weight: 800;
    line-height: 1.08;
    letter-spacing: -0.03em;
    margin-bottom: 1.25rem;
  }

  .title-line-solid {
    color: var(--color-text-heading); /* Solid Navy #1A085C */
  }

  .title-line-gradient {
    background: var(--brand-gradient);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    color: var(--color-text-heading); /* Fallback */
    display: inline-block;
  }

  /* Subtext */
  .contact-hero-subtext {
    font-size: clamp(0.95rem, 1.15vw, 1.125rem);
    color: var(--color-text-muted);
    line-height: 1.65;
    margin-bottom: 2.25rem;
