<script>
  function setupConsultationForm() {
    const form = document.getElementById('consultation-form') as HTMLFormElement | null;
    if (!form) return;

    const textarea = document.getElementById('contact-brief') as HTMLTextAreaElement | null;
    const charCounter = document.getElementById('char-counter');
    const submitBtn = document.getElementById('contact-submit-btn') as HTMLButtonElement | null;
    const feedbackBanner = document.getElementById('form-feedback-message');

    // Live Character Counter
    if (textarea && charCounter) {
      const updateCounter = () => {
        const len = textarea.value.length;
        charCounter.textContent = `${len}/1000`;
        if (len >= 900) {
          charCounter.classList.add('warning');
        } else {
          charCounter.classList.remove('warning');
        }
      };

      textarea.addEventListener('input', updateCounter);
      updateCounter();
    }

    // Form Submission Handling
    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      const nameInput = document.getElementById('contact-name') as HTMLInputElement | null;
      const emailInput = document.getElementById('contact-email') as HTMLInputElement | null;
      const phoneInput = document.getElementById('contact-phone') as HTMLInputElement | null;
      const companyInput = document.getElementById('contact-company') as HTMLInputElement | null;
      const budgetSelect = document.getElementById('contact-budget') as HTMLSelectElement | null;
      const timelineSelect = document.getElementById('contact-timeline') as HTMLSelectElement | null;

      const nameError = document.getElementById('name-error');
      const emailError = document.getElementById('email-error');
      const serviceError = document.getElementById('service-error');
      const briefError = document.getElementById('brief-error');

      // Clear errors
      if (nameError) nameError.textContent = '';
      if (emailError) emailError.textContent = '';
      if (serviceError) serviceError.textContent = '';
      if (briefError) briefError.textContent = '';
      if (feedbackBanner) feedbackBanner.style.display = 'none';

      nameInput?.classList.remove('has-error');
      emailInput?.classList.remove('has-error');
      textarea?.classList.remove('has-error');

      let hasError = false;

      // 1. Validate Full Name
      const fullName = nameInput?.value.trim() || '';
      if (!fullName) {
        if (nameError) nameError.textContent = 'Please enter your full name.';
        nameInput?.classList.add('has-error');
        hasError = true;
      }

      // 2. Validate Work Email
      const email = emailInput?.value.trim() || '';
      const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
      if (!email || !emailRegex.test(email)) {
        if (emailError) emailError.textContent = 'Please enter a valid work email address.';
        emailInput?.classList.add('has-error');
        hasError = true;
      }

      // 3. Validate Service Selection
      const selectedServiceRadio = form.querySelector('input[name="serviceType"]:checked') as HTMLInputElement | null;
      const serviceType = selectedServiceRadio ? selectedServiceRadio.value : '';
      if (!serviceType) {
        if (serviceError) serviceError.textContent = 'Please select what you need help with.';
        hasError = true;
      }

      // 4. Validate Project Brief / Requirement text
      const projectBrief = textarea?.value.trim() || '';
      if (!projectBrief || projectBrief.length < 10) {
        if (briefError) briefError.textContent = 'Please provide details about your idea (at least 10 characters).';
        textarea?.classList.add('has-error');
        hasError = true;
      }

      if (hasError) {
        // Focus first field with error
        if (!fullName) nameInput?.focus();
        else if (!email || !emailRegex.test(email)) emailInput?.focus();
        else if (!serviceType) form.querySelector('input[name="serviceType"]')?.scrollIntoView({ behavior: 'smooth', block: 'center' });
        else if (!projectBrief || projectBrief.length < 10) textarea?.focus();
        return;
      }

      // Retrieve optional fields
      const phone = phoneInput?.value.trim() || '';
      const company = companyInput?.value.trim() || '';
      const budget = budgetSelect?.value || '';
      const timeline = timelineSelect?.value || '';
      const selectedContactRadio = form.querySelector('input[name="preferredContact"]:checked') as HTMLInputElement | null;
      const preferredContact = selectedContactRadio ? selectedContactRadio.value : 'Email';

      // Submit state
      const originalBtnText = submitBtn ? submitBtn.innerHTML : 'Book Free Consultation';
      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.setAttribute('aria-disabled', 'true');
        submitBtn.textContent = 'Booking Consultation...';
      }

      const payload = {
        fullName,
        email,
        phone,
        company,
        serviceType,
        projectBrief,
        budget,
        timeline,
        preferredContact
      };

      try {
        const response = await fetch('https://api.infohq.in/contact', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload)
        });

        const data = await response.json().catch(() => ({}));

        if (response.ok) {
          if (feedbackBanner) {
            feedbackBanner.className = 'feedback-banner success';
            feedbackBanner.style.display = 'block';
            feedbackBanner.innerHTML = `
              <strong>✓ Free Consultation Booked!</strong><br />
              Thank you, <strong>${fullName}</strong>. Your consultation details have been sent to our engineering leadership at <code>${data.targetEmail || 'contact@infohq.in'}</code>. We will review your idea and get back to you within 1 business day.
            `;
            feedbackBanner.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
          }
          form.reset();
          // Reset default radios & counter
          const defaultContactRadio = document.getElementById('pref-email') as HTMLInputElement | null;
          if (defaultContactRadio) defaultContactRadio.checked = true;
          if (charCounter) charCounter.textContent = '0/1000';
        } else {
          if (feedbackBanner) {
            feedbackBanner.className = 'feedback-banner error';
            feedbackBanner.style.display = 'block';
            feedbackBanner.textContent = data.error || 'Submission failed. Please email us directly at contact@infohq.in.';
          }
        }
      } catch (err) {
        if (feedbackBanner) {
          feedbackBanner.className = 'feedback-banner error';
          feedbackBanner.style.display = 'block';
          feedbackBanner.textContent = 'Network transmission error. Please check your connection or email contact@infohq.in directly.';
        }
      } finally {
        if (submitBtn) {
          submitBtn.disabled = false;
          submitBtn.removeAttribute('aria-disabled');
          submitBtn.innerHTML = originalBtnText;
        }
      }
    });
  }

  setupConsultationForm();
  document.addEventListener('astro:page-load', setupConsultationForm);
</script>
