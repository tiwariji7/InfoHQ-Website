---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ServiceIcon from '../../components/ServiceIcon.astro';
import Button from '../../components/Button.astro';
import FinalCTA from '../../components/FinalCTA.astro';
import { servicesData } from '../../data/servicesData';

const meta = {
  title: 'Our Services — AI, Software, Web & Mobile Development | InfoHQ',
  description: 'Explore InfoHQ\'s full range of services: AI & intelligent systems, custom software, web & mobile app development, cloud & DevOps, automation, and digital marketing.',
  keywords: 'AI development services India, custom software development services, web development services Pune, mobile app development company India, business automation services'
};

const categories = [
  {
    id: 'ai-software',
    name: '1. AI & Software Engineering',
    desc: 'Intelligent automation, autonomous LLM agents, and mission-critical business platforms.',
    slugs: ['ai-intelligent-systems', 'custom-software']
  },
  {
    id: 'web-mobile',
    name: '2. Web & Mobile App Development',
    desc: 'Performant web platforms and native iOS/Android mobile applications built to launch.',
    slugs: ['web-development', 'mobile-app-development']
  },
  {
    id: 'automation',
    name: '3. Automation & System Integrations',
    desc: 'Automate manual bottlenecks, sync your enterprise tools, and orchestrate data flows.',
    slugs: ['business-automation']
  },
  {
    id: 'cloud-security',
    name: '4. Cloud, DevOps & Security',
    desc: 'Resilient cloud infrastructure, continuous deployment, and proactive security auditing.',
    slugs: ['cloud-devops', 'cybersecurity', 'website-maintenance']
  },
  {
    id: 'design-marketing',
    name: '5. Design & Digital Marketing',
    desc: 'High-fidelity Figma prototypes, modern brand identity systems, and high-intent growth.',
    slugs: ['ui-ux-design', 'brand-design', 'social-media-management', 'digital-marketing']
  }
];
---

<BaseLayout 
  title={meta.title}
  description={meta.description}
  keywords={meta.keywords}
  schemaType="services"
>
  <!-- Hero Section -->
  <section class="section services-hero" aria-labelledby="services-hub-heading">
    <div class="container services-hero-container">
      <div class="services-hero-content">
        <span class="text-eyebrow">Engineering Capabilities</span>
        <h1 id="services-hub-heading" class="services-headline">
          Every Service You Need to <span class="text-gradient">Build, Run, and Grow</span> Your Digital Business
        </h1>
        <p class="services-subheadline">
          From AI systems to social media &mdash; pick one service or let us run your entire digital stack. Dedicated engineers, full code ownership, and zero agency fluff.
        </p>

        <!-- Quick Jump Links -->
        <div class="jump-links">
          <span class="jump-label">Jump to:</span>
          <a href="#ai-software" class="jump-btn">AI &amp; Software</a>
          <a href="#web-mobile" class="jump-btn">Web &amp; Mobile</a>
          <a href="#automation" class="jump-btn">Automation</a>
          <a href="#cloud-security" class="jump-btn">Cloud &amp; Security</a>
          <a href="#design-marketing" class="jump-btn">Design &amp; Marketing</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Service Categories -->
  {categories.map((cat) => (
    <section class="section category-section" id={cat.id} aria-labelledby={`cat-heading-${cat.id}`}>
      <div class="container">
        <div class="category-header">
          <h2 id={`cat-heading-${cat.id}`} class="category-title">{cat.name}</h2>
          <p class="category-desc">{cat.desc}</p>
        </div>

        <div class="grid-2 service-items-grid">
          {cat.slugs.map((slug) => {
            const svc = servicesData.find(s => s.slug === slug);
            if (!svc) return null;
            return (
              <article class="card service-detail-card">
                <div class="service-card-top">
                  <div class="icon-box" style="background-color: var(--color-primary-light);">
                    <ServiceIcon name={svc.icon} size={24} />
                  </div>
                  <span class="service-pill">Dedicated Engineers</span>
                </div>

                <h3 class="service-title">
                  <a href={`/services/${svc.slug}`}>{svc.title}</a>
                </h3>
                
                <p class="service-full-desc">{svc.fullDesc}</p>

                <div class="service-tech-wrap">
                  <span class="tech-label">Tech Stack:</span>
                  <div class="tech-chips">
                    {svc.techStack.map(t => (
                      <span class="chip">{t}</span>
                    ))}
                  </div>
                </div>

                <div class="service-card-actions card-cta-pin">
                  <Button
                    variant="secondary"
                    tone="light"
                    size="md"
                    href={`/services/${svc.slug}`}
                    label="View Service Details"
                    icon="arrow"
                  />
                  <Button
                    variant="primary"
                    size="md"
                    href="/contact"
                    label="Inquire Now"
                    icon="none"
                  />
                </div>
              </article>
            );
          })}
        </div>
      </div>
    </section>
  ))}

  <!-- How We Engage Section -->
  <section class="section section-alt engage-section" aria-labelledby="engage-heading">
    <div class="container">
      <div class="section-header">
        <span class="text-eyebrow">Engagement Models</span>
        <h2 id="engage-heading">Every Service, Delivered Two Ways</h2>
        <p>
          Need it built from scratch? Choose a <strong>One-Time Project</strong>. Already live and need ongoing engineering? Choose a <strong>Monthly Retainer</strong>.
        </p>
      </div>

      <div class="grid-2 engage-grid">
        <article class="card engage-card">
          <h3>One-Time Fixed-Scope Projects</h3>
          <p>
            Build your website, mobile app, custom AI agent, or full SaaS MVP from scratch. Fixed milestone pricing, predictable timelines, and 100% code ownership handed over at launch.
          </p>
          <div class="engage-footer card-cta-pin">
            <Button
              variant="secondary"
              tone="light"
              size="md"
              href="/pricing#one-time"
              label="See One-Time Project Pricing"
              icon="arrow"
            />
          </div>
        </article>

        <article class="card engage-card engage-card-featured">
          <h3>Monthly Engineering Retainers</h3>
          <p>
            Need continuous support, new features, and instant bug fixes? Dedicated engineers embedded with your team starting at ₹9,999/month. No ticket queues &mdash; direct senior engineer access.
          </p>
          <div class="engage-footer card-cta-pin">
            <Button
              variant="primary"
              size="md"
              href="/pricing#retainers"
              label="See Retainer Plans"
              icon="arrow"
            />
          </div>
        </article>
      </div>
    </div>
  </section>

  <!-- Final CTA Section -->
  <FinalCTA page="services" />
</BaseLayout>

<style>
  .services-hero {
    background: radial-gradient(circle at 80% 20%, rgba(221, 73, 133, 0.08) 0%, transparent 50%),
                radial-gradient(circle at 20% 50%, rgba(124, 92, 232, 0.08) 0%, transparent 50%);
    padding-top: clamp(3rem, 5vw, 4.5rem);
    padding-bottom: clamp(2.5rem, 4vw, 3.5rem);
    text-align: center;
  }

  .services-hero-content {
    max-width: 840px;
    margin: 0 auto;
  }

  .services-headline {
    margin: 0.75rem 0 1.25rem;
    font-size: var(--text-5xl);
  }

  .services-subheadline {
    font-size: var(--text-lg);
    color: var(--color-text-body);
    line-height: 1.6;
    margin-bottom: 2rem;
  }

  .jump-links {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    flex-wrap: wrap;
    font-size: var(--text-xs);
  }

  .jump-label {
    font-weight: 600;
    color: var(--color-text-muted);
  }

  .jump-btn {
    padding: 4px 12px;
    background: #FFFFFF;
    border: 1px solid var(--color-border-card);
    border-radius: var(--radius-full);
    color: var(--color-text-heading);
    font-weight: 500;
    transition: all 0.2s ease;
  }

  .jump-btn:hover {
    background: var(--color-primary-light);
    color: var(--color-primary);
    border-color: var(--color-primary);
  }

  /* Category Section */
  .category-section {
    padding-top: clamp(2.5rem, 4vw, 3.5rem);
    padding-bottom: clamp(2.5rem, 4vw, 3.5rem);
    border-top: 1px solid var(--color-border-card);
  }

  .category-header {
    margin-bottom: 2rem;
  }

  .category-title {
    font-size: var(--text-3xl);
    margin-bottom: 0.5rem;
  }

  .category-desc {
    font-size: var(--text-base);
    color: var(--color-text-muted);
  }

  .service-items-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: clamp(1.25rem, 2vw, 1.75rem);
  }

  .service-detail-card {
    display: flex;
    flex-direction: column;
    padding: clamp(1.75rem, 3vw, 2.25rem);
  }

  .service-card-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1rem;
  }

  .service-pill {
    font-size: 0.7rem;
    font-weight: 600;
    background: #FAF9FE;
    color: var(--color-primary);
    padding: 3px 8px;
    border-radius: var(--radius-sm);
    border: 1px solid var(--color-border-card);
  }

  .service-title {
    font-size: var(--text-2xl);
    margin-bottom: 0.75rem;
  }

  .service-title a {
    color: var(--color-text-heading);
    transition: color 0.2s ease;
  }

  .service-title a:hover {
    color: var(--color-primary);
  }

  .service-full-desc {
    font-size: var(--text-sm);
    color: var(--color-text-body);
    line-height: 1.6;
    margin-bottom: 1.5rem;
  }

  .service-tech-wrap {
    margin-top: auto;
    margin-bottom: 1.5rem;
    padding-top: 1rem;
    border-top: 1px solid var(--color-border-card);
  }

  .tech-label {
    display: block;
    font-size: var(--text-xs);
    font-weight: 700;
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 0.5rem;
  }

  .tech-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .service-card-actions {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .engage-card {
    display: flex;
    flex-direction: column;
    padding: clamp(2rem, 3vw, 2.5rem);
  }

  .engage-card h3 {
    margin-bottom: 0.75rem;
    font-size: var(--text-2xl);
  }

  .engage-card-featured h3 {
    background: var(--brand-gradient);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    color: var(--color-text-heading);
    display: inline-block;
  }

  .engage-card p {
    font-size: var(--text-base);
    line-height: 1.6;
    margin-bottom: 1.5rem;
  }

  .engage-footer {
    margin-top: auto;
  }

  @media (max-width: 1023px) {
    .service-items-grid {
      grid-template-columns: 1fr;
    }
    .engage-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
