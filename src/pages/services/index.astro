---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Button from '../../components/Button.astro';
import FinalCTA from '../../components/FinalCTA.astro';
import { servicesData } from '../../data/servicesData';

const meta = {
  title: 'Our Services — AI, Software, Web & Mobile Development | InfoHQ',
  description: 'Explore InfoHQ\'s full range of services: AI & intelligent systems, custom software, web & mobile app development, cloud & DevOps, automation, and digital marketing.',
  keywords: 'AI development services India, custom software development services, web development services Pune, mobile app development company India, business automation services'
};

const categories = [
  {
    id: 'ai-software',
    number: '01',
    eyebrow: 'AI & SOFTWARE ENGINEERING',
    namePrefix: 'AI & Software',
    nameGradient: 'Engineering',
    desc: 'Intelligent automation, autonomous LLM agents, and mission-critical business platforms.',
    slugs: ['ai-intelligent-systems', 'custom-software']
  },
  {
    id: 'web-mobile',
    number: '02',
    eyebrow: 'WEB & MOBILE APP DEVELOPMENT',
    namePrefix: 'Web & Mobile',
    nameGradient: 'App Development',
    desc: 'Performant web platforms and native iOS/Android mobile applications built to launch.',
    slugs: ['web-development', 'mobile-app-development']
  },
  {
    id: 'automation',
    number: '03',
    eyebrow: 'AUTOMATION & SYSTEM INTEGRATIONS',
    namePrefix: 'Automation & System',
    nameGradient: 'Integrations',
    desc: 'Automate manual bottlenecks, sync your enterprise tools, and orchestrate data flows.',
    slugs: ['business-automation']
  },
  {
    id: 'cloud-security',
    number: '04',
    eyebrow: 'CLOUD, DEVOPS & SECURITY',
    namePrefix: 'Cloud, DevOps &',
    nameGradient: 'Security',
    desc: 'Resilient cloud infrastructure, continuous deployment, and proactive security auditing.',
    slugs: ['cloud-devops', 'cybersecurity', 'website-maintenance']
  },
  {
    id: 'design-marketing',
    number: '05',
    eyebrow: 'DESIGN & DIGITAL MARKETING',
    namePrefix: 'Design & Digital',
    nameGradient: 'Marketing',
    desc: 'High-fidelity Figma prototypes, modern brand identity systems, and high-intent growth.',
    slugs: ['ui-ux-design', 'brand-design', 'social-media-management', 'digital-marketing']
  }
];
---

<BaseLayout 
  title={meta.title}
  description={meta.description}
  keywords={meta.keywords}
  schemaType="services"
>
  <!-- Hero Section -->
  <section class="section services-hero" aria-labelledby="services-hub-heading">
    <div class="container services-hero-container">
      <div class="services-hero-content">
        <h1 id="services-hub-heading" class="services-headline">
          Every Service You Need to <span class="text-gradient">Build, Run, and Grow</span> Your Digital Business
        </h1>
        <p class="services-subheadline">
          From AI systems to social media &mdash; pick one service or let us run your entire digital stack. Dedicated engineers, full code ownership, and zero agency fluff.
        </p>

        <!-- Quick Jump Links -->
        <div class="jump-links">
          <span class="jump-label">Jump to:</span>
          <a href="#ai-software" class="jump-btn">AI &amp; Software</a>
          <a href="#web-mobile" class="jump-btn">Web &amp; Mobile</a>
          <a href="#automation" class="jump-btn">Automation</a>
          <a href="#cloud-security" class="jump-btn">Cloud &amp; Security</a>
          <a href="#design-marketing" class="jump-btn">Design &amp; Marketing</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Service Categories -->
  {categories.map((cat) => (
    <section class="section category-section" id={cat.id} aria-labelledby={`cat-heading-${cat.id}`}>
      <div class="container">
        <div class="category-header">
          <div class="category-eyebrow">
            <span class="category-number">{cat.number}</span>
            <span class="category-eyebrow-line" aria-hidden="true"></span>
            <span class="category-eyebrow-text">{cat.eyebrow}</span>
          </div>
          <h2 id={`cat-heading-${cat.id}`} class="category-title">
            {cat.namePrefix} <span class="category-heading-gradient">{cat.nameGradient}</span>
          </h2>
          <p class="category-desc">{cat.desc}</p>
        </div>

        <div class="service-items-grid">
          {cat.slugs.map((slug) => {
            const svc = servicesData.find(s => s.slug === slug);
            if (!svc) return null;
            return (
              <article class="card service-detail-card">
                <div class="service-card-top">
                  <span class="service-pill">Dedicated Engineers</span>
                </div>

                <h3 class="service-title">
                  <a href={`/services/${svc.slug}`}>{svc.title}</a>
                </h3>
                
                <p class="service-full-desc">{svc.fullDesc}</p>

                <div class="service-tech-wrap">
                  <div class="tech-header">
                    <span class="tech-label">TECH STACK</span>
                    <div class="tech-divider-line" aria-hidden="true"></div>
                  </div>
                  <div class="tech-chips">
                    {svc.techStack.map(t => (
                      <span class="chip-tag">{t}</span>
                    ))}
                  </div>
                </div>

                <div class="service-card-actions">
                  <a href={`/services/${svc.slug}`} class="service-btn-outline">
                    <span>View Service Details</span>
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="btn-arrow" aria-hidden="true">
                      <line x1="5" y1="12" x2="19" y2="12"></line>
                      <polyline points="12 5 19 12 12 19"></polyline>
                    </svg>
                  </a>
                  <a href="/contact" class="service-btn-gradient">
                    <span>Inquire Now</span>
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="btn-arrow" aria-hidden="true">
                      <line x1="5" y1="12" x2="19" y2="12"></line>
                      <polyline points="12 5 19 12 12 19"></polyline>
                    </svg>
                  </a>
                </div>
              </article>
            );
          })}
        </div>
      </div>
    </section>
  ))}

  <!-- How We Engage Section -->
  <section class="section section-alt engage-section" aria-labelledby="engage-heading">
    <div class="container">
      <div class="section-header">
        <h2 id="engage-heading">Every Service, Delivered Two Ways</h2>
        <p>
          Need it built from scratch? Choose a <strong>One-Time Project</strong>. Already live and need ongoing engineering? Choose a <strong>Monthly Retainer</strong>.
        </p>
      </div>

      <div class="grid-2 engage-grid">
        <article class="card engage-card">
          <h3>One-Time Fixed-Scope Projects</h3>
          <p>
            Build your website, mobile app, custom AI agent, or full SaaS MVP from scratch. Fixed milestone pricing, predictable timelines, and 100% code ownership handed over at launch.
          </p>
          <div class="engage-footer card-cta-pin">
            <Button
              variant="secondary"
              tone="light"
              size="md"
              href="/pricing#one-time"
              label="See One-Time Project Pricing"
              icon="arrow"
            />
          </div>
        </article>

        <article class="card engage-card engage-card-featured">
          <h3>Monthly Engineering Retainers</h3>
          <p>
            Need continuous support, new features, and instant bug fixes? Dedicated engineers embedded with your team starting at ₹9,999/month. No ticket queues &mdash; direct senior engineer access.
          </p>
          <div class="engage-footer card-cta-pin">
            <Button
              variant="primary"
              size="md"
              href="/pricing#retainers"
              label="See Retainer Plans"
              icon="arrow"
            />
          </div>
        </article>
      </div>
    </div>
  </section>

  <!-- Final CTA Section -->
  <FinalCTA page="services" />
</BaseLayout>

<style>
  .services-hero {
    background: radial-gradient(circle at 80% 20%, rgba(221, 73, 133, 0.08) 0%, transparent 50%),
                radial-gradient(circle at 20% 50%, rgba(124, 92, 232, 0.08) 0%, transparent 50%);
    margin-top: calc(-1 * clamp(72px, 7vw, 84px));
    padding-top: calc(clamp(3rem, 5vw, 4.5rem) + clamp(72px, 7vw, 84px));
    padding-bottom: clamp(2.5rem, 4vw, 3.5rem);
    text-align: center;
  }

  @media (max-width: 1023px) {
    .services-hero {
      margin-top: calc(-1 * clamp(68px, 8vw, 76px));
      padding-top: calc(clamp(2.5rem, 4.5vw, 3.5rem) + clamp(68px, 8vw, 76px));
    }
  }

  @media (max-width: 640px) {
    .services-hero {
      margin-top: -68px;
      padding-top: calc(2rem + 68px);
    }
  }

  .services-hero-content {
    max-width: 840px;
    margin: 0 auto;
  }

  .services-headline {
    margin: 0.75rem 0 1.25rem;
    font-size: var(--text-5xl);
  }

  .services-subheadline {
    font-size: var(--text-lg);
    color: var(--color-text-body);
    line-height: 1.6;
    margin-bottom: 2rem;
  }

  .jump-links {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    flex-wrap: wrap;
    font-size: var(--text-xs);
  }

  .jump-label {
    font-weight: 600;
    color: var(--color-text-muted);
  }

  .jump-btn {
    padding: 4px 12px;
    background: #FFFFFF;
    border: 1px solid var(--color-border-card);
    border-radius: var(--radius-full);
    color: var(--color-text-heading);
    font-weight: 500;
    transition: all 0.2s ease;
  }

  .jump-btn:hover {
    background: var(--color-primary-light);
    color: var(--color-primary);
    border-color: var(--color-primary);
  }

  /* Category Section */
  .category-section {
    padding-top: clamp(1.75rem, 3vw, 2.5rem);
    padding-bottom: clamp(1.75rem, 3vw, 2.5rem);
    border-top: 1px solid var(--color-border-card);
  }

  .category-header {
    margin-bottom: clamp(1.25rem, 2vw, 1.75rem);
  }

  .category-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 0.65rem;
  }

  .category-number {
    font-size: 0.8125rem;
    font-weight: 800;
    color: #4F46E5;
    letter-spacing: 0.05em;
  }

  .category-eyebrow-line {
    width: 24px;
    height: 1.5px;
    background: #C7D2FE;
    display: inline-block;
  }

  .category-eyebrow-text {
    font-size: 0.72rem;
    font-weight: 700;
    color: #4F46E5;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .category-title {
    font-size: clamp(1.75rem, 2.6vw, 2.25rem);
    font-weight: 800;
    color: #0F172A;
    line-height: 1.25;
    letter-spacing: -0.02em;
    margin-bottom: 0.45rem;
  }

  .category-heading-gradient {
    background: linear-gradient(90deg, #E11D48 0%, #7C3AED 50%, #2563EB 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .category-desc {
    font-size: 0.9375rem;
    color: #64748B;
    line-height: 1.55;
    max-width: 720px;
  }

  .service-items-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
    align-items: stretch;
  }

  .service-detail-card {
    background: #FFFFFF;
    border: 1px solid #E2E8F0;
    border-radius: 20px;
    padding: 1.5rem 1.5rem 1.6rem;
    display: flex;
    flex-direction: column;
    gap: 0;
    box-shadow: 0 4px 20px -2px rgba(15, 23, 42, 0.04);
    transition: transform 0.25s ease, box-shadow 0.25s ease, border-color 0.25s ease;
  }

  .service-detail-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 12px 30px -4px rgba(15, 23, 42, 0.08);
    border-color: #CBD5E1;
  }

  .service-card-top {
    display: flex;
    align-items: center;
    margin-bottom: 0.75rem;
    min-height: 28px;
  }

  .service-pill {
    display: inline-flex;
    align-items: center;
    font-size: 0.72rem;
    font-weight: 600;
    background: #EEF2FF;
    color: #4F46E5;
    padding: 4px 10px;
    border-radius: 9999px;
    line-height: 1.2;
    letter-spacing: 0.01em;
  }

  .service-title {
    font-size: 1.25rem;
    font-weight: 800;
    color: #0F172A;
    line-height: 1.3;
    letter-spacing: -0.015em;
    margin-bottom: 0.5rem;
  }

  .service-title a {
    color: inherit;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .service-title a:hover {
    color: #4F46E5;
  }

  .service-full-desc {
    font-size: 0.85rem;
    color: #64748B;
    line-height: 1.55;
    margin-bottom: 1.15rem;
  }

  .service-tech-wrap {
    margin-top: auto;
    margin-bottom: 1.25rem;
  }

  .tech-header {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 0.6rem;
  }

  .tech-label {
    display: block;
    font-size: 0.68rem;
    font-weight: 700;
    color: #94A3B8;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    white-space: nowrap;
    margin: 0;
  }

  .tech-divider-line {
    flex: 1;
    height: 1px;
    background: #E2E8F0;
  }

  .tech-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .chip-tag {
    display: inline-block;
    font-size: 0.72rem;
    font-weight: 500;
    color: #334155;
    background: #F1F5F9;
    padding: 3px 9px;
    border-radius: 6px;
    line-height: 1.3;
  }

  .service-card-actions {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
  }

  .service-btn-outline {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 0.55rem 1.15rem;
    border-radius: 9999px;
    border: 1px solid #0F172A;
    color: #0F172A;
    background: transparent;
    font-size: 0.8125rem;
    font-weight: 600;
    text-decoration: none;
    transition: all 0.2s ease;
    cursor: pointer;
    user-select: none;
    white-space: nowrap;
  }

  .service-btn-outline:hover {
    background: #0F172A;
    color: #FFFFFF;
    transform: translateY(-1px);
    box-shadow: 0 4px 12px rgba(15, 23, 42, 0.12);
  }

  .service-btn-gradient {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 0.55rem 1.35rem;
    border-radius: 9999px;
    border: none;
    color: #FFFFFF;
    background: linear-gradient(90deg, #4F46E5 0%, #7C3AED 50%, #E11D48 100%);
    font-size: 0.8125rem;
    font-weight: 600;
    text-decoration: none;
    box-shadow: 0 4px 14px rgba(79, 70, 229, 0.28);
    transition: all 0.2s ease;
    cursor: pointer;
    user-select: none;
    white-space: nowrap;
  }

  .service-btn-gradient:hover {
    transform: translateY(-1px);
    box-shadow: 0 6px 18px rgba(225, 29, 72, 0.35);
  }

  .btn-arrow {
    display: inline-block;
    flex-shrink: 0;
    transition: transform 0.2s ease;
  }

  .service-btn-outline:hover .btn-arrow,
  .service-btn-gradient:hover .btn-arrow {
    transform: translateX(3px);
  }

  .engage-card {
    display: flex;
    flex-direction: column;
    padding: clamp(1.5rem, 2.5vw, 2rem);
    border-radius: 20px;
  }

  .engage-card h3 {
    margin-bottom: 0.75rem;
    font-size: var(--text-2xl);
  }

  .engage-card-featured h3 {
    background: var(--brand-gradient);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    color: var(--color-text-heading);
    display: inline-block;
  }

  .engage-card p {
    font-size: var(--text-base);
    line-height: 1.6;
    margin-bottom: 1.5rem;
  }

  .engage-footer {
    margin-top: auto;
  }

  /* Tablet Responsive (641px - 1023px) */
  @media (min-width: 641px) and (max-width: 1023px) {
    .service-items-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 1.15rem;
    }

    .service-detail-card {
      padding: 1.35rem 1.25rem 1.45rem;
      border-radius: 18px;
    }

    .service-title {
      font-size: 1.15rem;
    }

    .service-full-desc {
      font-size: 0.8125rem;
      margin-bottom: 1rem;
    }

    .service-card-actions {
      gap: 8px;
    }

    .service-btn-outline,
    .service-btn-gradient {
      padding: 0.5rem 0.95rem;
      font-size: 0.775rem;
    }

    .engage-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 1.15rem;
    }
  }

  /* Mobile Responsive (<= 640px) */
  @media (max-width: 640px) {
    .service-items-grid {
      grid-template-columns: 1fr;
      gap: 1rem;
    }

    .service-detail-card {
      padding: 1.15rem 1rem 1.25rem;
      border-radius: 16px;
    }

    .service-card-top {
      margin-bottom: 0.55rem;
      min-height: 24px;
    }

    .service-pill {
      font-size: 0.65rem;
      padding: 3px 8px;
    }

    .service-title {
      font-size: 1.1rem;
      margin-bottom: 0.35rem;
    }

    .service-full-desc {
      font-size: 0.8rem;
      line-height: 1.48;
      margin-bottom: 0.85rem;
    }

    .service-tech-wrap {
      margin-bottom: 1rem;
    }

    .tech-header {
      margin-bottom: 0.45rem;
    }

    .tech-label {
      font-size: 0.65rem;
    }

    .tech-chips {
      gap: 4px;
    }

    .chip-tag {
      font-size: 0.66rem;
      padding: 2.5px 7px;
      border-radius: 5px;
    }

    .service-card-actions {
      display: grid;
      grid-template-columns: 1.25fr 1fr;
      gap: 8px;
      width: 100%;
    }

    .service-btn-outline,
    .service-btn-gradient {
      width: 100%;
      padding: 0.48rem 0.5rem;
      font-size: 0.73rem;
      gap: 4px;
      justify-content: center;
    }

    .engage-grid {
      grid-template-columns: 1fr;
      gap: 1rem;
    }

    .engage-card {
      padding: 1.25rem 1rem 1.35rem;
      border-radius: 16px;
    }
  }
</style>
