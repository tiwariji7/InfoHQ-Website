---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import BlogCard from '../components/BlogCard.astro';
import { filterPublishedPosts, sortPostsByDateDesc } from '../utils/blog';
import HeroGraphic from '../components/HeroGraphic.astro';
import ServiceIcon from '../components/ServiceIcon.astro';
import Button from '../components/Button.astro';
import FinalCTA from '../components/FinalCTA.astro';

const meta = {
  title: 'InfoHQ — AI & Software Development Company in India',
  description: 'InfoHQ builds AI systems, websites, mobile apps & SaaS products for startups and enterprises across India. Based in Pune & Prayagraj, serving clients pan-India.',
  keywords: 'AI development company India, software development agency India, custom software development company, software development company Pune, AI development company Prayagraj, SaaS development company India'
};

const serviceCategories = [
  {
    title: 'AI & Software Engineering',
    desc: 'Practical AI agents, RAG systems, and custom-built business software.',
    icon: 'Brain',
    link: '/services#ai-software',
    items: ['Autonomous AI Agents', 'RAG Document Search', 'Custom APIs & SaaS Platforms']
  },
  {
    title: 'Web & Mobile App Development',
    desc: 'High-converting websites and cross-platform mobile apps, built to launch.',
    icon: 'Globe',
    link: '/services#web-mobile',
    items: ['High-Performance Websites', 'Client Portals', 'iOS & Android Mobile Apps']
  },
  {
    title: 'Automation & System Integrations',
    desc: 'Connect your tools, automate your workflows, stop doing things manually.',
    icon: 'Cpu',
    link: '/services#automation',
    items: ['Bi-directional Tool Sync', 'Invoice Pipelines', 'CRM & Payment Integrations']
  },
  {
    title: 'Cloud, DevOps & Security',
    desc: 'Reliable infrastructure, zero-downtime deployments, and real security audits.',
    icon: 'Cloud',
    link: '/services#cloud-security',
    items: ['AWS / GCP / Cloudflare', 'CI/CD Pipelines', 'OWASP Security Audits']
  }
];

const whyReasons = [
  {
    title: 'Dedicated Engineers, Not Ticket Queues',
    desc: 'Business Growth and Technology Partner plans give you direct access to the same engineer(s) every time, not a rotating support desk.'
  },
  {
    title: 'Built to Own, Not Rent',
    desc: '100% code, design, and IP ownership handed to you — always. Everything is delivered into your own repositories.'
  },
  {
    title: 'One Partner, Every Layer',
    desc: 'Website, app, AI, cloud, and marketing — no need to manage five different vendors or coordinate fragmented freelancers.'
  },
  {
    title: 'Pan-India Delivery',
    desc: 'Headquartered in Pune & Prayagraj, serving ambitious startups and enterprise clients anywhere in India.'
  }
];

// Latest published articles for homepage topical authority
const allBlogPosts = await getCollection('blog');
const latestBlogPosts = sortPostsByDateDesc(filterPublishedPosts(allBlogPosts)).slice(0, 3);

const faqs = [
  {
    q: 'Do you only work with startups, or enterprises too?',
    a: 'Both. Our One-Time Project model suits startups and new builds, while our Monthly Retainer plans (especially Technology Partner) are built for growing and enterprise-scale operations.'
  },
  {
    q: 'Do I own the code and IP?',
    a: 'Yes — 100% client ownership on all code, design, and database schemas, always.'
  },
  {
    q: 'Do you work with businesses outside Pune/Prayagraj?',
    a: 'Yes, we deliver pan-India — our physical presence is in Pune and Prayagraj, but our team works with clients anywhere in the country.'
  }
];
---

<BaseLayout 
  title={meta.title}
  description={meta.description}
  keywords={meta.keywords}
  schemaType="home"
  ogImage="/og/home.webp"
>
  <!-- 1. Hero Section -->
  <section class="section hero-section" aria-labelledby="hero-heading">
    <!-- Ambient subtle background glow effects matching design reference -->
    <div class="hero-ambient-glow glow-left" aria-hidden="true"></div>
    <div class="hero-ambient-glow glow-right" aria-hidden="true"></div>

    <div class="container hero-container">
      <div class="hero-content">
        <div class="hero-eyebrow">
          <span>SOFTWARE</span>
          <span class="eyebrow-sep">&bull;</span>
          <span>AI</span>
          <span class="eyebrow-sep">&bull;</span>
          <span>AUTOMATION</span>
        </div>

        <h1 id="hero-heading" class="hero-headline">
          Build better digital experiences. Grow with <span class="hero-brand-gradient">smarter technology.</span>
        </h1>
        
        <p class="hero-subheadline">
          InfoHQ is an AI and software engineering studio helping startups and enterprises across India build, automate, and grow &mdash; from custom AI systems to full-scale digital products.
        </p>

        <div class="hero-ctas">
          <Button
            variant="primary"
            size="lg"
            href="/contact"
            label="Start Your Project"
            icon="arrow"
            id="hero-primary-cta"
          />
          <Button
            variant="secondary"
            tone="light"
            size="lg"
            href="/services"
            label="See Our Services"
            icon="arrow"
            id="hero-secondary-cta"
          />
        </div>

        <div class="hero-highlights">
          <div class="h-item">
            <span class="h-check">&check;</span>
            <span>100% IP Ownership</span>
          </div>
          <div class="h-item">
            <span class="h-check">&check;</span>
            <span>Dedicated Engineers</span>
          </div>
          <div class="h-item">
            <span class="h-check">&check;</span>
            <span>Retainers from ₹9,999/mo</span>
          </div>
        </div>
      </div>

      <div class="hero-visual-col">
        <HeroGraphic />
      </div>
    </div>
  </section>

  <!-- 2. Capability Strip -->
  <section class="capability-strip" aria-label="Core Capabilities">
    <div class="container strip-inner">
      <span class="strip-label">What We Engineer</span>
      <div class="strip-items">
        <span class="strip-item">AI Systems</span>
        <span class="strip-sep">&bull;</span>
        <span class="strip-item">Custom Software</span>
        <span class="strip-sep">&bull;</span>
        <span class="strip-item">Web &amp; Mobile Apps</span>
        <span class="strip-sep">&bull;</span>
        <span class="strip-item">Cloud &amp; DevOps</span>
        <span class="strip-sep">&bull;</span>
        <span class="strip-item">Automation</span>
        <span class="strip-sep">&bull;</span>
        <span class="strip-item">Design</span>
      </div>
    </div>
  </section>

  <!-- 3. Problem -> Solution Section -->
  <section class="section section-alt problem-solution-section" aria-labelledby="ps-heading">
    <div class="container">
      <div class="section-header">
        <h2 id="ps-heading">Engineered for Reliability,<br class="ps-heading-br" /> Not Just <span class="launch-day-gradient">Launch Day</span></h2>
      </div>

      <div class="ps-grid">
        <!-- Problem Card -->
        <article class="card ps-card problem-card">
          <div class="ps-top-bar">
            <div class="ps-badge problem-badge">THE PROBLEM</div>
            <div class="ps-divider problem-divider" aria-hidden="true"></div>
          </div>
          <h3 class="ps-title">Most Businesses Don't Need Another Vendor. They Need an Engineering Partner.</h3>
          <p class="ps-body">
            Scattered freelancers, agencies that disappear post-launch, and in-house teams stretched too thin &mdash; most businesses are stuck patching together their digital growth instead of building it properly.
          </p>
          <ul class="ps-list problem-list">
            <li>
              <div class="ps-icon-circle ps-icon-problem">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <line x1="18" y1="6" x2="6" y2="18"></line>
                  <line x1="6" y1="6" x2="18" y2="18"></line>
                </svg>
              </div>
              <span>Fragmented codebases with zero documentation</span>
            </li>
            <li>
              <div class="ps-icon-circle ps-icon-problem">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <line x1="18" y1="6" x2="6" y2="18"></line>
                  <line x1="6" y1="6" x2="18" y2="18"></line>
                </svg>
              </div>
              <span>Post-launch radio silence and abandoned maintenance</span>
            </li>
            <li>
              <div class="ps-icon-circle ps-icon-problem">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <line x1="18" y1="6" x2="6" y2="18"></line>
                  <line x1="6" y1="6" x2="18" y2="18"></line>
                </svg>
              </div>
              <span>Overpriced agencies outsourcing your work to junior contractors</span>
            </li>
          </ul>
        </article>

        <!-- Solution Card -->
        <article class="card ps-card solution-card">
          <div class="ps-top-bar">
            <div class="ps-badge solution-badge">THE SOLUTION</div>
            <div class="ps-divider solution-divider" aria-hidden="true"></div>
          </div>
          <h3 class="ps-title"><span class="solution-accent">One Team.</span> Every Layer of Your Digital Stack.</h3>
          <p class="ps-body">
            From AI-powered systems to the website your customers see first, InfoHQ builds and maintains it all &mdash; under one roof, with dedicated engineers who actually know your codebase.
          </p>
          <ul class="ps-list solution-list">
            <li>
              <div class="ps-icon-circle ps-icon-solution">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <polyline points="20 6 9 17 4 12"></polyline>
                </svg>
              </div>
              <span>Single point of contact: dedicated engineers, not ticket queues</span>
            </li>
            <li>
              <div class="ps-icon-circle ps-icon-solution">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <polyline points="20 6 9 17 4 12"></polyline>
                </svg>
              </div>
              <span>Continuous maintenance retainers so your systems never decay</span>
            </li>
            <li>
              <div class="ps-icon-circle ps-icon-solution">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <polyline points="20 6 9 17 4 12"></polyline>
                </svg>
              </div>
              <span>100% intellectual property and code ownership in your hands</span>
            </li>
          </ul>
        </article>
      </div>
    </div>
  </section>

  <!-- 4. Services Overview Section -->
  <section class="section services-overview-section" aria-labelledby="services-overview-heading">
    <div class="container">
      <div class="section-header">
        <h2 id="services-overview-heading">Every Layer of <span class="text-gradient">Modern Engineering</span></h2>
        <p>From practical AI systems to scalable cloud architectures, choose individual services or engage our full squad.</p>
      </div>

      <div class="services-cards-grid">
        {serviceCategories.map((svc) => (
          <article class="service-overview-card">
            <div class="service-card-body">
              <h3 class="service-card-title">{svc.title}</h3>
              <p class="service-card-desc">{svc.desc}</p>
              
              <ul class="service-bullets">
                {svc.items.map((it) => (
                  <li>
                    <span class="service-bullet-dot" aria-hidden="true"></span>
                    <span>{it}</span>
                  </li>
                ))}
              </ul>
            </div>

            <a href={svc.link} class="service-learn-more">
              <span>Explore Services</span>
              <span class="service-arrow" aria-hidden="true">&rarr;</span>
            </a>
          </article>
        ))}
      </div>

      <div class="section-cta-wrap">
        <Button
          variant="primary"
          size="lg"
          href="/services"
          label="Explore All Services"
          icon="arrow"
          id="explore-services-cta"
        />
      </div>
    </div>
  </section>

  <!-- 5. Why InfoHQ Section -->
  <section class="section section-wash why-section" aria-labelledby="why-heading">
    <div class="container">
      <div class="section-header">
        <h2 id="why-heading">Why Growing Businesses<br class="why-heading-br" /> Choose <span class="why-infohq-gradient">InfoHQ</span></h2>
        <p>Built for companies that value engineering rigor, direct communication, and long-term partnership.</p>
      </div>

      <div class="grid-2 why-grid">
        {whyReasons.map((reason, idx) => {
          const accentClass = idx === 0 ? 'accent-blue' : idx === 1 ? 'accent-purple' : idx === 2 ? 'accent-pink' : 'accent-blue';
          return (
            <article class={`card why-card ${accentClass}`}>
              <div class="why-card-top">
                <h3 class="why-title">{reason.title}</h3>
                <span class="why-number">0{idx + 1}</span>
              </div>
              <div class="why-accent-bar" aria-hidden="true"></div>
              <p class="why-desc">{reason.desc}</p>
            </article>
          );
        })}
      </div>
    </div>
  </section>

  <!-- 6. Featured Work Section -->
  <section class="section featured-work-section" aria-labelledby="work-heading">
    <div class="container">
      <div class="section-header">
        <h2 id="work-heading">Built, Shipped, and <span class="portfolio-heading-gradient">Running</span></h2>
        <p>Real digital systems engineered with production stability and performance in mind.</p>
      </div>

      <div class="grid-3 portfolio-grid">
        <!-- Alpha Studio Tech -->
        <article class="card portfolio-card">
          <div class="card-top-bar">
            <div class="portfolio-badge live">
              <span class="badge-dot"></span>
              <span>CLIENT PROJECT &bull; DELIVERED</span>
            </div>
            <a href="https://alphastudiotech.online" target="_blank" rel="noopener noreferrer" class="card-ext-btn" aria-label="Open Alpha Studio Tech in new tab">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
                <polyline points="15 3 21 3 21 9"></polyline>
                <line x1="10" y1="14" x2="21" y2="3"></line>
              </svg>
            </a>
          </div>

          <div class="card-preview-media preview-alpha">
            <img src="/projects_images/alpha-studio-mockup.jpg" alt="Alpha Studio Tech client website mockup" class="preview-img" loading="lazy" />
          </div>

          <h3 class="card-project-title">Alpha Studio Tech &mdash; Client Website</h3>
          <p class="card-project-desc">A client website built by InfoHQ.</p>

          <div class="card-tags">
            <span class="chip-tag chip-blue">Web Development</span>
            <span class="chip-tag chip-purple">UI/UX</span>
            <span class="chip-tag chip-orange">SEO</span>
          </div>

          <div class="portfolio-footer">
            <a href="https://alphastudiotech.online" target="_blank" rel="noopener noreferrer" class="card-footer-link">
              alphastudiotech.online &nearr;
            </a>
          </div>
        </article>

        <!-- SeHAT SmartCare AI -->
        <article class="card portfolio-card">
          <div class="card-top-bar">
            <div class="portfolio-badge live">
              <span class="badge-dot"></span>
              <span>INTERNAL PRODUCT &bull; ACTIVE</span>
            </div>
            <a href="/portfolio#sehat" class="card-ext-btn" aria-label="View SeHAT Case Study & Screens">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
                <polyline points="15 3 21 3 21 9"></polyline>
                <line x1="10" y1="14" x2="21" y2="3"></line>
              </svg>
            </a>
          </div>

          <div class="card-preview-media preview-sehat">
            <div class="sehat-left">
              <div class="sehat-icon-box">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#2563EB" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <line x1="12" y1="5" x2="12" y2="19"></line>
                  <line x1="5" y1="12" x2="19" y2="12"></line>
                </svg>
              </div>
              <div class="sehat-brand">
                <span class="sehat-brand-name">SeHAT</span>
                <span class="sehat-brand-name">SmartCare AI</span>
                <span class="sehat-brand-sub">Your Personal<br />AI Health Assistant</span>
              </div>
            </div>
            <div class="sehat-right">
              <img src="/projects_images/SeHAT_SmartCare/homedashboard&aimeicalchatbot.webp" alt="SeHAT SmartCare AI mobile application interface" class="sehat-mockup-img" loading="lazy" />
            </div>
          </div>

          <h3 class="card-project-title">SeHAT SmartCare AI</h3>
          <p class="card-project-desc">
            An intelligent Android healthcare platform combining Medical LLMs, RAG, FAISS semantic search, and OCR report analysis with multilingual Hindi/English voice input.
          </p>

          <div class="card-tags">
            <span class="chip-tag chip-blue">Android &bull; Kotlin</span>
            <span class="chip-tag chip-purple">FastAPI &bull; Python</span>
            <span class="chip-tag chip-green">Medical LLM &bull; RAG</span>
            <span class="chip-tag chip-orange">FAISS &bull; OCR</span>
          </div>

          <div class="portfolio-footer">
            <a href="/portfolio#sehat" class="card-footer-link">
              View Case Study &amp; Screens &nearr;
            </a>
          </div>
        </article>

        <!-- In-Progress SaaS -->
        <article class="card portfolio-card coming-soon-card">
          <div class="card-top-bar">
            <div class="portfolio-badge in-progress">
              <span class="badge-dot"></span>
              <span>IN-PROGRESS SAAS</span>
            </div>
          </div>

          <div class="card-preview-media preview-saas">
            <div class="saas-left">
              <span class="saas-title">SaaS Platform</span>
              <span class="saas-desc">Building the next generation AI-powered platform at InfoHQ.</span>
            </div>
            <div class="saas-right">
              <div class="saas-feature-pill">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#38BDF8" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <rect x="3" y="11" width="18" height="10" rx="2"></rect>
                  <circle cx="12" cy="5" r="2"></circle>
                  <path d="M12 7v4"></path>
                  <line x1="8" y1="16" x2="8" y2="16"></line>
                  <line x1="16" y1="16" x2="16" y2="16"></line>
                </svg>
                <span>AI Agents</span>
              </div>
              <div class="saas-feature-pill">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#38BDF8" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                  <circle cx="9" cy="7" r="4"></circle>
                  <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
                  <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
                </svg>
                <span>Multi-Tenant</span>
              </div>
              <div class="saas-feature-pill">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#38BDF8" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M18 10h-1.26A8 8 0 1 0 9 20h9a5 5 0 0 0 0-10z"></path>
                </svg>
                <span>Edge Computing</span>
              </div>
            </div>
          </div>

          <h3 class="card-project-title">In-House SaaS Platform</h3>
          <p class="card-project-desc">
            InfoHQ is currently building its own SaaS product in-house &mdash; dogfooding modern AI agent architectures, multi-tenancy, and edge computing.
          </p>

          <div class="card-tags">
            <span class="chip-tag chip-blue">AI Systems</span>
            <span class="chip-tag chip-purple">Multi-Tenant SaaS</span>
            <span class="chip-tag chip-orange">Cloudflare Edge</span>
          </div>

          <div class="portfolio-footer">
            <div class="card-footer-status">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#64748B" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="status-icon" aria-hidden="true">
                <path d="m3 11 18-5v12L3 14v-3z"></path>
                <path d="M11.6 16.8a3 3 0 1 1-5.8-1.6"></path>
              </svg>
              <span>Official Announcement Coming Soon</span>
            </div>
          </div>
        </article>
      </div>

      <div class="section-cta-wrap portfolio-cta-wrap">
        <Button
          variant="secondary"
          tone="light"
          size="md"
          href="/portfolio"
          label="View Full Portfolio & Case Studies"
          icon="arrow"
          id="view-portfolio-cta"
        />
      </div>
    </div>
  </section>

  <!-- 7. Engagement Models Teaser -->
  <section class="section section-alt engagement-section" aria-labelledby="engagement-heading">
    <div class="container">
      <div class="section-header">
        <h2 id="engagement-heading">Two Ways to <span class="engagement-heading-gradient">Work With Us</span></h2>
        <p>Whether building something brand new or maintaining live operations, we offer clear, transparent structures.</p>
      </div>

      <div class="grid-2 engagement-grid">
        <!-- Card 1: One-Time Projects -->
        <article class="card engagement-card">
          <div class="eng-card-top">
            <div class="engagement-pill pill-blue">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="m7.5 4.27 9 5.15"></path>
                <path d="M21 8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16Z"></path>
                <path d="m3.3 7 8.7 5 8.7-5"></path>
                <path d="M12 22V12"></path>
              </svg>
              <span>Fixed-Scope Milestones</span>
            </div>
            <span class="eng-number">01</span>
          </div>

          <h3 class="engagement-title">One-Time Projects</h3>
          <p class="engagement-body">
            Need something built from scratch? Website, app, AI solution, or full SaaS MVP &mdash; fixed-scope, fixed price, 100% ownership.
          </p>

          <ul class="engagement-features">
            <li>
              <div class="eng-icon-box eng-icon-blue">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <circle cx="12" cy="12" r="10"></circle>
                  <polyline points="9 12 11.5 14.5 15.5 9.5"></polyline>
                </svg>
              </div>
              <span>Fixed deliverables with milestone delivery</span>
            </li>
            <li>
              <div class="eng-icon-box eng-icon-blue">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M6 3h12"></path>
                  <path d="M6 8h12"></path>
                  <path d="M6 13l8.5 8"></path>
                  <path d="M6 13h3a4 4 0 0 0 0-8"></path>
                </svg>
              </div>
              <span>Starting at ₹14,999 for business websites</span>
            </li>
            <li>
              <div class="eng-icon-box eng-icon-blue">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <polyline points="16 18 22 12 16 6"></polyline>
                  <polyline points="8 6 2 12 8 18"></polyline>
                </svg>
              </div>
