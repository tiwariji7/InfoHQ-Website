    font-size: 2.25rem;
    font-weight: 800;
    line-height: 1;
    color: #E2E8F0;
    letter-spacing: -0.02em;
    user-select: none;
    flex-shrink: 0;
  }

  .why-accent-bar {
    width: 32px;
    height: 2.5px;
    border-radius: 9999px;
    margin-bottom: 0.85rem;
  }

  .why-desc {
    font-size: 0.875rem;
    color: #64748B;
    line-height: 1.55;
    margin: 0;
  }

  /* Accent color variations */
  .why-card.accent-blue .why-accent-bar {
    background: #2563EB;
  }

  .why-card.accent-purple .why-accent-bar {
    background: #7C3AED;
  }

  .why-card.accent-pink .why-accent-bar {
    background: #EC4899;
  }

  /* 6. Featured Work Section */
  .featured-work-section {
    padding-top: clamp(1.75rem, 2.5vw, 2.25rem);
    padding-bottom: clamp(1.75rem, 2.5vw, 2.25rem);
  }

  .featured-work-section .section-header {
    margin-bottom: clamp(1.25rem, 2vw, 1.75rem);
  }

  .portfolio-heading-gradient {
    background: linear-gradient(90deg, #2563EB 0%, #4F46E5 35%, #7C3AED 65%, #E11D48 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .portfolio-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
    align-items: stretch;
  }

  .portfolio-card {
    background: #FFFFFF;
    border: 1px solid #E2E8F0;
    border-radius: 20px;
    padding: 1.25rem 1.25rem 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0;
    box-shadow: 0 4px 20px -2px rgba(15, 23, 42, 0.04);
    transition: transform 0.25s ease, box-shadow 0.25s ease, border-color 0.25s ease;
  }

  .portfolio-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 12px 30px -4px rgba(15, 23, 42, 0.08);
    border-color: #CBD5E1;
  }

  .card-top-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 0.85rem;
    min-height: 32px;
  }

  .portfolio-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    padding: 4px 10px;
    border-radius: 9999px;
  }

  .badge-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    display: inline-block;
  }

  .portfolio-badge.live {
    background: #DCFCE7;
    color: #15803D;
  }

  .portfolio-badge.live .badge-dot {
    background: #16A34A;
  }

  .portfolio-badge.in-progress {
    background: #EFF6FF;
    color: #2563EB;
  }

  .portfolio-badge.in-progress .badge-dot {
    background: #2563EB;
  }

  .card-ext-btn {
    width: 30px;
    height: 30px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 1px solid #E2E8F0;
    border-radius: 8px;
    color: #64748B;
    background: #FFFFFF;
    transition: all 0.2s ease;
    text-decoration: none;
  }

  .card-ext-btn:hover {
    border-color: #94A3B8;
    color: #0F172A;
    background: #F8FAFC;
    transform: translateY(-1px);
  }

  /* Visual Preview Media */
  .card-preview-media {
    height: 170px;
    border-radius: 12px;
    overflow: hidden;
    position: relative;
    margin-bottom: 1.15rem;
    background: #F1F5F9;
  }

  .preview-alpha .preview-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
  }

  /* SeHAT Preview */
  .preview-sehat {
    background: linear-gradient(135deg, #F0F6FD 0%, #E2EDF9 100%);
    display: flex;
    align-items: center;
    position: relative;
    padding: 1rem;
    overflow: hidden;
  }

  .sehat-left {
    display: flex;
    flex-direction: column;
    justify-content: center;
    z-index: 2;
    max-width: 52%;
  }

  .sehat-icon-box {
    width: 34px;
    height: 34px;
    border-radius: 9px;
    background: #DBEAFE;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 0.5rem;
    box-shadow: 0 2px 5px rgba(37, 99, 235, 0.12);
  }

  .sehat-brand {
    display: flex;
    flex-direction: column;
  }

  .sehat-brand-name {
    font-size: 1.05rem;
    font-weight: 800;
    color: #1E293B;
    line-height: 1.15;
    letter-spacing: -0.01em;
  }

  .sehat-brand-sub {
    font-size: 0.7rem;
    color: #64748B;
    line-height: 1.35;
    margin-top: 0.35rem;
  }

  .sehat-right {
    position: absolute;
    right: -10px;
    top: -5px;
    bottom: -15px;
    width: 56%;
    display: flex;
    align-items: center;
    justify-content: flex-end;
  }

  .sehat-mockup-img {
    height: 115%;
    width: auto;
    object-fit: contain;
    object-position: right center;
    filter: drop-shadow(0 6px 14px rgba(15, 23, 42, 0.12));
  }

  /* SaaS Preview */
  .preview-saas {
    background: radial-gradient(circle at 10% 95%, rgba(37, 99, 235, 0.45) 0%, transparent 55%), #0A0D1D;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1.1rem;
    position: relative;
    border: 1px solid rgba(255, 255, 255, 0.05);
    overflow: hidden;
  }

  .saas-left {
    display: flex;
    flex-direction: column;
    max-width: 50%;
    z-index: 2;
  }

  .saas-title {
    font-size: 1.1rem;
    font-weight: 800;
    color: #FFFFFF;
    letter-spacing: -0.01em;
    line-height: 1.2;
    margin-bottom: 0.35rem;
  }

  .saas-desc {
    font-size: 0.7rem;
    color: #94A3B8;
    line-height: 1.4;
  }

  .saas-right {
    display: flex;
    flex-direction: column;
    gap: 7px;
    z-index: 2;
  }

  .saas-feature-pill {
    display: flex;
    align-items: center;
    gap: 7px;
    background: rgba(15, 23, 42, 0.7);
    border: 1px solid rgba(255, 255, 255, 0.12);
    padding: 4px 10px;
    border-radius: 9999px;
    font-size: 0.7rem;
    font-weight: 600;
    color: #F8FAFC;
    backdrop-filter: blur(8px);
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.25);
  }

  /* Card Content */
  .card-project-title {
    font-size: 1.05rem;
    font-weight: 700;
    color: #0F172A;
    line-height: 1.35;
    margin-bottom: 0.4rem;
  }

  .card-project-desc {
    font-size: 0.85rem;
    color: #64748B;
    line-height: 1.55;
    margin-bottom: 1.15rem;
    min-height: 44px;
  }

  /* Tags */
  .card-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: auto;
    margin-bottom: 1.15rem;
  }

  .chip-tag {
    font-size: 0.72rem;
    font-weight: 600;
    padding: 3px 9px;
    border-radius: 9999px;
    display: inline-flex;
    align-items: center;
    white-space: nowrap;
  }

  .chip-blue {
    background: #EFF6FF;
    color: #2563EB;
  }

  .chip-purple {
    background: #F5F3FF;
    color: #7C3AED;
  }

  .chip-orange {
    background: #FFF7ED;
    color: #EA580C;
  }

  .chip-green {
    background: #F0FDF4;
    color: #16A34A;
  }

  /* Card Footer */
  .portfolio-footer {
    padding-top: 0.9rem;
    border-top: 1px solid #F1F5F9;
    display: flex;
    align-items: center;
    min-height: 38px;
  }

  .card-footer-link {
    font-size: 0.85rem;
    font-weight: 600;
    color: #2563EB;
    text-decoration: underline;
    text-decoration-style: dashed;
    text-underline-offset: 4px;
    text-decoration-color: #93C5FD;
    transition: all 0.2s ease;
  }

  .card-footer-link:hover {
    color: #1D4ED8;
    text-decoration-color: #2563EB;
  }

  .card-footer-status {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 0.8rem;
    color: #64748B;
    font-weight: 500;
  }

  .status-icon {
    color: #64748B;
    flex-shrink: 0;
  }

  .portfolio-cta-wrap {
    margin-top: 1.5rem;
  }

  /* 7. Engagement Models */
  .engagement-section {
    padding-top: clamp(1.75rem, 2.5vw, 2.25rem);
    padding-bottom: clamp(1.5rem, 2vw, 2rem);
  }

  .engagement-heading-gradient {
    background: linear-gradient(90deg, #2563EB 0%, #4F46E5 35%, #7C3AED 65%, #E11D48 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .engagement-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
    align-items: stretch;
  }

  .engagement-card {
    background: #FFFFFF;
    border: 1px solid #E2E8F0;
    border-radius: 20px;
    padding: 1.75rem 1.75rem 2rem;
    display: flex;
    flex-direction: column;
    gap: 0;
    box-shadow: 0 4px 20px -2px rgba(15, 23, 42, 0.04);
    transition: transform 0.25s ease, box-shadow 0.25s ease, border-color 0.25s ease;
  }

  .engagement-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 12px 30px -4px rgba(15, 23, 42, 0.08);
    border-color: #CBD5E1;
  }

  .eng-card-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 0.85rem;
    min-height: 36px;
  }

  .engagement-pill {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 0.75rem;
    font-weight: 600;
    padding: 5px 12px;
    border-radius: 9999px;
    line-height: 1;
  }

  .engagement-pill.pill-blue {
    background: #EFF6FF;
    color: #2563EB;
  }

  .engagement-pill.pill-purple {
    background: #F5F3FF;
    color: #7C3AED;
  }

  .eng-number {
    font-size: 2.25rem;
    font-weight: 800;
    line-height: 1;
    color: #E2E8F0;
    letter-spacing: -0.02em;
    user-select: none;
  }

  .engagement-title {
    font-size: clamp(1.45rem, 2vw, 1.75rem);
    font-weight: 800;
    color: #0F172A;
    letter-spacing: -0.02em;
    line-height: 1.25;
    margin-bottom: 0.45rem;
  }

  .engagement-body {
    font-size: 0.875rem;
    color: #64748B;
    line-height: 1.55;
    margin-bottom: 1.35rem;
  }

  .engagement-features {
    list-style: none;
    padding: 0;
    margin: 0 0 1.5rem 0;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .engagement-features li {
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: 0.85rem;
    font-weight: 500;
    color: #334155;
    line-height: 1.45;
  }

  .eng-icon-box {
    width: 26px;
    height: 26px;
    border-radius: 7px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .eng-icon-blue {
    background: #EFF6FF;
    color: #2563EB;
  }

  .eng-icon-purple {
    background: #F5F3FF;
    color: #7C3AED;
  }

  .card-cta-pin {
    margin-top: auto;
    display: flex;
  }

  .eng-btn {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    font-size: 0.875rem;
    font-weight: 700;
    border-radius: 9999px;
    text-decoration: none;
    transition: all 0.2s ease;
    cursor: pointer;
    user-select: none;
  }

  .eng-btn-outline {
    background: #FFFFFF;
    color: #0F172A;
    border: 1px solid #1E293B;
    padding: 0.7rem 1.45rem;
  }

  .eng-btn-outline:hover {
    background: #0F172A;
    color: #FFFFFF;
    transform: translateY(-1px);
    box-shadow: 0 4px 12px rgba(15, 23, 42, 0.12);
  }

  .eng-btn-gradient {
    background: linear-gradient(90deg, #1D4ED8 0%, #2563EB 25%, #7C3AED 55%, #DB2777 85%, #E11D48 100%);
    color: #FFFFFF;
    border: none;
    padding: 0.45rem 0.5rem 0.45rem 1.45rem;
    box-shadow: 0 4px 16px rgba(37, 99, 235, 0.28);
  }

  .eng-btn-gradient:hover {
    box-shadow: 0 6px 20px rgba(219, 39, 119, 0.35);
    transform: translateY(-1px);
  }

  .eng-btn-circle-arrow {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: #FFFFFF;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    transition: transform 0.2s ease;
  }

  .eng-btn-gradient:hover .eng-btn-circle-arrow {
    transform: translateX(2px);
  }


  /* 9. FAQ Accordion */
  .faq-section {
    padding-top: clamp(1.25rem, 2vw, 1.75rem);
    padding-bottom: clamp(1.75rem, 2.5vw, 2.25rem);
  }

  .faq-section .section-header {
    margin-bottom: clamp(1.25rem, 2vw, 1.75rem);
  }

  .faq-container {
    max-width: 860px;
  }

  .faq-accordion {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .faq-item {
    background: #FFFFFF;
    border: 1px solid var(--color-border-card);
    border-radius: var(--radius-lg);
    overflow: hidden;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .faq-item[open] {
    border-color: var(--color-primary);
    box-shadow: var(--shadow-sm);
  }

  .faq-question {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.25rem 1.5rem;
    font-size: var(--text-base);
    font-weight: 600;
    color: var(--color-text-heading);
    cursor: pointer;
    list-style: none;
    user-select: none;
  }

  .faq-question::-webkit-details-marker {
    display: none;
  }

  .faq-icon {
    font-size: 1.5rem;
    line-height: 1;
    color: var(--color-primary);
    transition: transform 0.2s ease;
  }

  .faq-item[open] .faq-icon {
    transform: rotate(45deg);
  }

  .faq-answer {
    padding: 0 1.5rem 1.25rem;
    font-size: var(--text-sm);
    color: var(--color-text-body);
    line-height: 1.6;
  }

  /* 9b. Home Blog Section (Optimized Spacing) */
  .home-blog-section {
    padding-top: clamp(1.25rem, 2vw, 1.75rem);
    padding-bottom: clamp(1.5rem, 2.5vw, 2.25rem);
  }

  .home-blog-section .section-header {
    margin-bottom: clamp(1.25rem, 2vw, 1.75rem);
  }

  .home-blog-cta {
    margin-top: 1.5rem;
    text-align: center;
  }

  /* 10. Final CTA Card */
  .final-cta-card {
    position: relative;
    background: #1A085C;
    border-radius: var(--radius-2xl);
    padding: clamp(2.5rem, 5vw, 4.5rem) clamp(1.5rem, 4vw, 3rem);
    text-align: center;
    color: #FFFFFF;
    overflow: hidden;
    box-shadow: var(--shadow-xl);
  }

  .cta-glow {
    position: absolute;
    top: -50%;
    left: -20%;
    width: 140%;
    height: 200%;
    background: radial-gradient(circle at center, rgba(232, 96, 78, 0.2) 0%, rgba(124, 92, 232, 0.25) 40%, transparent 70%);
    pointer-events: none;
  }

  .cta-content {
    position: relative;
    z-index: 1;
    max-width: 680px;
    margin: 0 auto;
  }

  .cta-title {
    color: #FFFFFF;
    margin: 1rem 0;
    font-size: var(--text-4xl);
  }

  .cta-body {
    color: #D2C9EE;
    font-size: var(--text-lg);
    line-height: 1.6;
    margin-bottom: 2rem;
  }

  .cta-actions {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    flex-wrap: wrap;
  }

  @media (min-width: 1024px) and (max-width: 1280px) {
    .hero-container {
      grid-template-columns: 1fr 1.15fr;
      gap: 1.75rem;
    }
    .hero-content {
      max-width: 530px;
    }
    .hero-headline {
      font-size: clamp(2.1rem, 3.1vw, 2.65rem);
    }
    .hero-subheadline {
      font-size: 1.05rem;
    }
  }

  @media (max-width: 1023px) {
    .hero-section {
      min-height: auto;
      margin-top: calc(-1 * clamp(68px, 8vw, 76px));
      padding-top: calc(clamp(68px, 8vw, 76px) + clamp(0.75rem, 2vw, 1.5rem));
      padding-bottom: clamp(1.5rem, 3vw, 2.25rem);
      align-items: flex-start;
    }

    .hero-container {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }

    .hero-content {
      max-width: 620px;
      margin-left: auto;
      margin-right: auto;
      text-align: center;
      display: flex;
      flex-direction: column;
      align-items: center;
    }

    .hero-eyebrow {
      justify-content: center;
    }

    .hero-subheadline {
      margin-left: auto;
      margin-right: auto;
      text-align: center;
    }

    .hero-ctas {
      justify-content: center;
    }

    .hero-highlights {
      justify-content: center;
    }

    .services-cards-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 1.25rem;
    }

    .portfolio-grid {
      grid-template-columns: repeat(2, 1fr);
      max-width: 100%;
      gap: 1.25rem;
    }

    .portfolio-grid > :nth-child(3) {
      grid-column: 1 / -1;
      max-width: calc(50% - 0.625rem);
      justify-self: center;
      width: 100%;
    }

    .ps-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 1.25rem;
    }

    .why-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 1.25rem;
    }
  }

  @media (max-width: 640px) {
    .hero-section {
      margin-top: -68px;
      padding-top: calc(68px + 0.75rem);
      padding-bottom: 1.5rem;
    }
    .hero-content {
      padding: 0;
    }
    .hero-headline {
      font-size: clamp(1.55rem, 5.5vw, 1.85rem);
      line-height: 1.2;
      margin-bottom: 0.65rem;
    }
    .hero-subheadline {
      font-size: 0.85rem;
      line-height: 1.5;
      margin-bottom: 0.9rem;
    }
    .hero-ctas {
      flex-direction: column;
      width: 100%;
      max-width: 340px;
      margin-left: auto;
      margin-right: auto;
      align-items: stretch;
      gap: 0.75rem;
      margin-bottom: 1.25rem;
    }
    .hero-ctas :global(.infohq-btn) {
      width: 100%;
      justify-content: center;
    }
    .hero-highlights {
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 0.65rem;
    }
    .strip-inner {
      flex-direction: column;
      gap: 0.75rem;
    }
    .strip-items {
      justify-content: center;
      row-gap: 0.5rem;
      column-gap: 0.65rem;
      font-size: 0.8125rem;
    }
    .ps-heading-br {
      display: inline;
    }

    .ps-grid {
      grid-template-columns: 1fr;
      gap: 1.25rem;
    }

    .ps-card {
      padding: 1.25rem 1rem 1.35rem;
      border-radius: 16px;
    }

    .ps-title {
      font-size: 1.15rem;
      margin-bottom: 0.5rem;
    }

    .ps-body {
      font-size: 0.8125rem;
      margin-bottom: 1rem;
    }

    .ps-list {
      gap: 0.65rem;
    }

    .ps-list li {
      font-size: 0.8125rem;
      gap: 10px;
    }

    .services-cards-grid {
      grid-template-columns: 1fr;
    }

    .why-heading-br {
      display: inline;
    }

    .why-grid {
      grid-template-columns: 1fr;
      gap: 1.25rem;
    }

    .why-card {
      padding: 1.25rem 1rem 1.35rem;
      border-radius: 16px;
    }

    .why-title {
      font-size: 1.05rem;
    }

    .why-number {
      font-size: 1.75rem;
    }

    .why-desc {
      font-size: 0.8125rem;
    }

    .portfolio-grid {
      grid-template-columns: 1fr;
      max-width: 100%;
      gap: 1.25rem;
    }

    .portfolio-grid > :nth-child(3) {
      grid-column: auto;
      max-width: 100%;
    }

    .portfolio-card {
      padding: 1.15rem 1rem 1.25rem;
      border-radius: 16px;
    }

    .card-preview-media {
      height: 165px;
      margin-bottom: 1rem;
    }

    .preview-sehat {
      padding: 0.85rem;
    }

    .sehat-left {
      max-width: 48%;
    }

    .sehat-brand-name {
      font-size: 0.95rem;
