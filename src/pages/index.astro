---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroGraphic from '../components/HeroGraphic.astro';
import ServiceIcon from '../components/ServiceIcon.astro';
import Button from '../components/Button.astro';
import FinalCTA from '../components/FinalCTA.astro';

const meta = {
  title: 'InfoHQ — AI & Software Development Company in India',
  description: 'InfoHQ builds AI systems, websites, mobile apps & SaaS products for startups and enterprises across India. Based in Pune & Prayagraj, serving clients pan-India.',
  keywords: 'AI development company India, software development agency India, custom software development company, software development company Pune, AI development company Prayagraj, SaaS development company India'
};

const serviceCategories = [
  {
    title: 'AI & Software Engineering',
    desc: 'Practical AI agents, RAG systems, and custom-built business software.',
    icon: 'Brain',
    link: '/services#ai-software',
    tint: 'var(--color-tint-lavender)',
    items: ['Autonomous AI Agents', 'RAG Document Search', 'Custom APIs & SaaS Platforms']
  },
  {
    title: 'Web & Mobile App Development',
    desc: 'High-converting websites and cross-platform mobile apps, built to launch.',
    icon: 'Globe',
    link: '/services#web-mobile',
    tint: 'var(--color-tint-cyan)',
    items: ['High-Performance Websites', 'Client Portals', 'iOS & Android Mobile Apps']
  },
  {
    title: 'Automation & System Integrations',
    desc: 'Connect your tools, automate your workflows, stop doing things manually.',
    icon: 'Cpu',
    link: '/services#automation',
    tint: 'var(--color-tint-green)',
    items: ['Bi-directional Tool Sync', 'Invoice Pipelines', 'CRM & Payment Integrations']
  },
  {
    title: 'Cloud, DevOps & Security',
    desc: 'Reliable infrastructure, zero-downtime deployments, and real security audits.',
    icon: 'Cloud',
    link: '/services#cloud-security',
    tint: 'var(--color-tint-voice)',
    items: ['AWS / GCP / Cloudflare', 'CI/CD Pipelines', 'OWASP Security Audits']
  },
  {
    title: 'Design & Digital Marketing',
    desc: 'Brand identity, UI/UX, and marketing that\'s built to convert — not just look good.',
    icon: 'Palette',
    link: '/services#design-marketing',
    tint: 'var(--color-tint-rose)',
    items: ['Figma UI/UX Prototypes', 'Brand Style Guidelines', 'Technical SEO & GA4']
  }
];

const whyReasons = [
  {
    title: 'Dedicated Engineers, Not Ticket Queues',
    desc: 'Business Growth and Technology Partner plans give you direct access to the same engineer(s) every time, not a rotating support desk.'
  },
  {
    title: 'Built to Own, Not Rent',
    desc: '100% code, design, and IP ownership handed to you — always. Everything is delivered into your own repositories.'
  },
  {
    title: 'One Partner, Every Layer',
    desc: 'Website, app, AI, cloud, and marketing — no need to manage five different vendors or coordinate fragmented freelancers.'
  },
  {
    title: 'Pan-India Delivery',
    desc: 'Headquartered in Pune & Prayagraj, serving ambitious startups and enterprise clients anywhere in India.'
  }
];

const faqs = [
  {
    q: 'Do you only work with startups, or enterprises too?',
    a: 'Both. Our One-Time Project model suits startups and new builds, while our Monthly Retainer plans (especially Technology Partner) are built for growing and enterprise-scale operations.'
  },
  {
    q: 'Do I own the code and IP?',
    a: 'Yes — 100% client ownership on all code, design, and database schemas, always.'
  },
  {
    q: 'Do you work with businesses outside Pune/Prayagraj?',
    a: 'Yes, we deliver pan-India — our physical presence is in Pune and Prayagraj, but our team works with clients anywhere in the country.'
  }
];
---

<BaseLayout 
  title={meta.title}
  description={meta.description}
  keywords={meta.keywords}
  schemaType="home"
>
  <!-- Top Wash Layer behind Header (Home page only) -->
  <div slot="top-wash" class="hero-top-wash-wrapper" aria-hidden="true">
    <div class="hero-top-wash-layer">
      <div class="hero-top-wash-dots"></div>
    </div>
  </div>

  <!-- 1. Hero Section -->
  <section class="section hero-section" aria-labelledby="hero-heading">
    <!-- Hero Background Layer with responsive picture -->
    <div class="hero-bg-layer" aria-hidden="true">
      <picture class="hero-picture">
        <!-- Desktop (1024px and up): herosectionbg.webp -->
        <source media="(min-width: 1024px)" srcset="/images/herosectionbg.webp" width="1672" height="941" />
        <!-- Tablet (768px to 1023px): tabherobg.webp -->
        <source media="(min-width: 768px)" srcset="/images/tabherobg.webp" width="1448" height="1086" />
        <!-- Mobile (below 768px): mobileherobg.webp -->
        <img
          src="/images/mobileherobg.webp"
          alt=""
          aria-hidden="true"
          width="1122"
          height="1402"
          loading="eager"
          fetchpriority="high"
          decoding="async"
          class="hero-bg-img"
        />
      </picture>
      <!-- Scrim overlay behind text zone to maintain WCAG AA/AAA contrast -->
      <div class="hero-scrim-overlay"></div>
      <!-- Soft bottom edge fade into the next section -->
      <div class="hero-bottom-fade"></div>
    </div>

    <div class="container hero-container">
      <div class="hero-content">
        <div class="hero-pill">
          <span class="pill-dot"></span>
          <span>Pune &bull; Prayagraj &bull; Pan-India Engineering Studio</span>
        </div>
        
        <h1 id="hero-heading" class="hero-headline">
          Engineering AI, Software &amp; Digital Growth &mdash; <span class="text-gradient">Built to Scale With You</span>
        </h1>
        
        <p class="hero-subheadline">
          InfoHQ is a Pune &amp; Prayagraj-based AI and software engineering studio helping startups and enterprises across India build, automate, and grow &mdash; from custom AI systems to full-scale digital products.
        </p>

        <div class="hero-ctas">
          <Button
            variant="primary"
            size="lg"
            href="/contact"
            label="Start Your Project"
            icon="arrow"
            id="hero-primary-cta"
          />
          <Button
            variant="secondary"
            tone="light"
            size="lg"
            href="/services"
            label="See Our Services"
            icon="none"
            id="hero-secondary-cta"
          />
        </div>

        <div class="hero-highlights">
          <div class="h-item">
            <span class="h-check">&check;</span>
            <span>100% IP Ownership</span>
          </div>
          <div class="h-item">
            <span class="h-check">&check;</span>
            <span>Dedicated Engineers</span>
          </div>
          <div class="h-item">
            <span class="h-check">&check;</span>
            <span>Retainers from ₹9,999/mo</span>
          </div>
        </div>
      </div>

      <!-- [RECOVERABLE] Previous HTML/CSS mockup card (HeroGraphic) commented out per user instruction:
           "in home hero section remove infohq.in • AI Agent & Cloud Orchestration Engine Online card.. carefully.."
           The component file `src/components/HeroGraphic.astro` is preserved intact in the codebase. -->
      <!--
      <div class="hero-visual">
        <HeroGraphic />
      </div>
      -->
    </div>
  </section>

  <!-- 2. Capability Strip -->
  <section class="capability-strip" aria-label="Core Capabilities">
    <div class="container strip-inner">
      <span class="strip-label">What We Engineer</span>
      <div class="strip-items">
        <span class="strip-item">AI Systems</span>
        <span class="strip-sep">&bull;</span>
        <span class="strip-item">Custom Software</span>
        <span class="strip-sep">&bull;</span>
        <span class="strip-item">Web &amp; Mobile Apps</span>
        <span class="strip-sep">&bull;</span>
        <span class="strip-item">Cloud &amp; DevOps</span>
        <span class="strip-sep">&bull;</span>
        <span class="strip-item">Automation</span>
        <span class="strip-sep">&bull;</span>
        <span class="strip-item">Design</span>
      </div>
    </div>
  </section>

  <!-- 3. Problem -> Solution Section -->
  <section class="section section-alt problem-solution-section" aria-labelledby="ps-heading">
    <div class="container">
      <div class="section-header">
        <span class="text-eyebrow">The InfoHQ Difference</span>
        <h2 id="ps-heading">Engineered for Reliability, Not Just Launch Day</h2>
      </div>

      <div class="ps-grid">
        <!-- Problem Card -->
        <article class="card ps-card problem-card">
          <div class="ps-eyebrow problem-eyebrow">The Problem</div>
          <h3 class="ps-title">Most Businesses Don't Need Another Vendor. They Need an Engineering Partner.</h3>
          <p class="ps-body">
            Scattered freelancers, agencies that disappear post-launch, and in-house teams stretched too thin &mdash; most businesses are stuck patching together their digital growth instead of building it properly.
          </p>
          <ul class="ps-list">
            <li>Fragmented codebases with zero documentation</li>
            <li>Post-launch radio silence and abandoned maintenance</li>
            <li>Overpriced agencies outsourcing your work to junior contractors</li>
          </ul>
        </article>

        <!-- Solution Card -->
        <article class="card ps-card solution-card">
          <div class="ps-eyebrow solution-eyebrow">The Solution</div>
          <h3 class="ps-title">One Team. Every Layer of Your Digital Stack.</h3>
          <p class="ps-body">
            From AI-powered systems to the website your customers see first, InfoHQ builds and maintains it all &mdash; under one roof, with dedicated engineers who actually know your codebase.
          </p>
          <ul class="ps-list solution-list">
            <li>Single point of contact: dedicated engineers, not ticket queues</li>
            <li>Continuous maintenance retainers so your systems never decay</li>
            <li>100% intellectual property and code ownership in your hands</li>
          </ul>
        </article>
      </div>
    </div>
  </section>

  <!-- 4. Services Overview Section -->
  <section class="section services-overview-section" aria-labelledby="services-overview-heading">
    <div class="container">
      <div class="section-header">
        <span class="text-eyebrow">Services Overview</span>
        <h2 id="services-overview-heading">Every Layer of Modern Engineering</h2>
        <p>From practical AI systems to scalable cloud architectures, choose individual services or engage our full squad.</p>
      </div>

      <div class="services-cards-grid">
        {serviceCategories.map((svc) => (
          <article class="card service-overview-card">
            <div class="icon-box" style={`background-color: ${svc.tint}`}>
              <ServiceIcon name={svc.icon} size={24} />
            </div>
            <h3 class="service-card-title">{svc.title}</h3>
            <p class="service-card-desc">{svc.desc}</p>
            
            <ul class="service-bullets">
              {svc.items.map((it) => (
                <li>{it}</li>
              ))}
            </ul>

            <a href={svc.link} class="service-learn-more">
              Explore Services &rarr;
            </a>
          </article>
        ))}
      </div>

      <div class="section-cta-wrap">
        <Button
          variant="primary"
          size="lg"
          href="/services"
          label="Explore All Services"
          icon="arrow"
          id="explore-services-cta"
        />
      </div>
    </div>
  </section>

  <!-- 5. Why InfoHQ Section -->
  <section class="section section-wash why-section" aria-labelledby="why-heading">
    <div class="container">
      <div class="section-header">
        <span class="text-eyebrow">Why InfoHQ</span>
        <h2 id="why-heading">Why Growing Businesses Choose InfoHQ</h2>
        <p>Built for companies that value engineering rigor, direct communication, and long-term partnership.</p>
      </div>

      <div class="grid-2 why-grid">
        {whyReasons.map((reason, idx) => (
          <article class="card why-card">
            <div class="why-number">0{idx + 1}</div>
            <h3 class="why-title">{reason.title}</h3>
            <p class="why-desc">{reason.desc}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- 6. Featured Work Section -->
  <section class="section featured-work-section" aria-labelledby="work-heading">
    <div class="container">
      <div class="section-header">
        <span class="text-eyebrow">Portfolio &amp; Proof of Work</span>
        <h2 id="work-heading">Built, Shipped, and Running</h2>
        <p>Real digital systems engineered with production stability and performance in mind.</p>
      </div>

      <div class="grid-3 portfolio-grid">
        <!-- Alpha Studio Tech -->
        <article class="card portfolio-card">
          <div class="portfolio-badge live">Client Project &bull; Delivered</div>
          <h3 class="portfolio-title">Alpha Studio Tech</h3>
          <p class="portfolio-desc">
            A full digital website build delivered for a client, showcasing InfoHQ's web design and development capability. Built for responsive speed and conversion.
          </p>
          <div class="portfolio-tags">
            <span class="chip">Web Development</span>
            <span class="chip">UI/UX</span>
            <span class="chip">SEO</span>
          </div>
          <div class="portfolio-footer">
            <a href="https://alphastudiotech.online" target="_blank" rel="noopener noreferrer" class="portfolio-link">
              alphastudiotech.online &nearr;
            </a>
          </div>
        </article>

        <!-- SeHAT SmartCare AI -->
        <article class="card portfolio-card">
          <div class="portfolio-badge live">Internal Product &bull; Active</div>
          <h3 class="portfolio-title">SeHAT SmartCare AI</h3>
          <p class="portfolio-desc">
            An intelligent Android healthcare platform combining Medical LLMs, RAG, FAISS semantic search, and OCR report analysis with multilingual Hindi/English voice input.
          </p>
          <div class="portfolio-tags">
            <span class="chip">Android &bull; Kotlin</span>
            <span class="chip">FastAPI &bull; Python</span>
            <span class="chip">Medical LLM &bull; RAG</span>
            <span class="chip">FAISS &bull; OCR</span>
          </div>
          <div class="portfolio-footer">
            <a href="/portfolio#sehat" class="portfolio-link">
              View Case Study &amp; Screens &nearr;
            </a>
          </div>
        </article>

        <!-- In-Progress SaaS -->
        <article class="card portfolio-card coming-soon-card">
          <div class="portfolio-badge in-progress">In-Progress SaaS</div>
          <h3 class="portfolio-title">In-House SaaS Platform</h3>
          <p class="portfolio-desc">
            InfoHQ is currently building its own SaaS product in-house &mdash; dogfooding modern AI agent architectures, multi-tenancy, and edge computing.
          </p>
          <div class="portfolio-tags">
            <span class="chip">AI Systems</span>
            <span class="chip">Multi-Tenant SaaS</span>
            <span class="chip">Cloudflare Edge</span>
          </div>
          <div class="portfolio-footer">
            <span class="portfolio-status-note">Official Announcement Coming Soon</span>
          </div>
        </article>
      </div>

      <div class="section-cta-wrap">
        <Button
          variant="secondary"
          tone="light"
          size="md"
          href="/portfolio"
          label="View Full Portfolio & Case Studies"
          icon="arrow"
          id="view-portfolio-cta"
        />
      </div>
    </div>
  </section>

  <!-- 7. Engagement Models Teaser -->
  <section class="section section-alt engagement-section" aria-labelledby="engagement-heading">
    <div class="container">
      <div class="section-header">
        <span class="text-eyebrow">Flexible Partnerships</span>
        <h2 id="engagement-heading">Two Ways to Work With Us</h2>
        <p>Whether building something brand new or maintaining live operations, we offer clear, transparent structures.</p>
      </div>

      <div class="grid-2 engagement-grid">
        <article class="card engagement-card">
          <div class="engagement-pill">Fixed-Scope Milestones</div>
          <h3 class="engagement-title">One-Time Projects</h3>
          <p class="engagement-body">
            Need something built from scratch? Website, app, AI solution, or full SaaS MVP &mdash; fixed-scope, fixed price, 100% ownership.
          </p>
          <ul class="engagement-features">
            <li>Fixed deliverables with milestone delivery</li>
            <li>Starting at ₹14,999 for business websites</li>
            <li>Complete code handover &amp; deployment SLA</li>
          </ul>
          <div class="card-cta-pin">
            <Button
              variant="secondary"
              tone="light"
              size="md"
              href="/pricing#one-time"
              label="Explore One-Time Projects"
              icon="arrow"
            />
          </div>
        </article>

        <article class="card engagement-card engagement-card-featured">
          <div class="engagement-pill popular">Continuous Support ★</div>
          <h3 class="engagement-title">Monthly Retainers</h3>
          <p class="engagement-body">
            Already have a digital product? Get a dedicated engineer (or full squad) on standby every month &mdash; starting at ₹9,999/mo.
          </p>
          <ul class="engagement-features">
            <li>Dedicated engineers, direct Slack/chat communication</li>
            <li>Routine health checks, bug fixing &amp; continuous feature development</li>
            <li>No long-term lock-in &bull; Cancel or adjust monthly</li>
          </ul>
          <div class="card-cta-pin">
            <Button
              variant="primary"
              size="md"
              href="/pricing#retainers"
              label="See Full Pricing & Retainers"
              icon="arrow"
            />
          </div>
        </article>
      </div>
    </div>
  </section>

  <!-- 8. Testimonials Section (Coming Soon - strictly no fake content) -->
  <section class="section testimonials-section" aria-labelledby="testimonials-heading">
    <div class="container">
      <div class="section-header">
        <span class="text-eyebrow">Client Feedback</span>
        <h2 id="testimonials-heading">What Our Partners Say</h2>
      </div>

      <div class="card transparent-notice-card">
        <div class="notice-icon">💬</div>
        <h3>Client Testimonials &amp; Detailed Case Notes</h3>
        <p>
          We pride ourselves on transparency: client testimonials and in-depth video walkthroughs from our recent projects are currently being compiled and will be published here with client permissions.
        </p>
        <p class="notice-sub">
          Want references or to speak directly with businesses we've built for? <a href="/contact">Request client references</a> during your initial consultation.
        </p>
      </div>
    </div>
  </section>

  <!-- 9. FAQ Section -->
  <section class="section section-alt faq-section" aria-labelledby="faq-heading">
    <div class="container faq-container">
      <div class="section-header">
        <span class="text-eyebrow">Frequently Asked Questions</span>
        <h2 id="faq-heading">Got Questions? We Have Answers.</h2>
        <p>Common questions about working with InfoHQ. Find the comprehensive list on our Pricing page.</p>
      </div>

      <div class="faq-accordion">
        {faqs.map((faq) => (
          <details class="faq-item">
            <summary class="faq-question">
              <span>{faq.q}</span>
              <span class="faq-icon" aria-hidden="true">+</span>
            </summary>
            <div class="faq-answer">
              <p>{faq.a}</p>
            </div>
          </details>
        ))}
      </div>

      <div class="section-cta-wrap">
        <Button
          variant="secondary"
          tone="light"
          size="md"
          href="/pricing#faqs"
          label="Read All Pricing FAQs"
          icon="arrow"
        />
      </div>
    </div>
  </section>

  <!-- 10. Final CTA Section -->
  <FinalCTA page="home" />
</BaseLayout>

<style>
  /* ==========================================================================
     Top Wash Layer (Home Page Only)
     ========================================================================== */
  .hero-top-wash-wrapper,
  :global(.hero-top-wash-wrapper) {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    width: 100%;
    max-width: 100%;
    overflow: clip;
    pointer-events: none;
    z-index: 2;
    height: clamp(180px, 15.3vw, 240px); /* ~220px on 1440px desktop */
  }

  .hero-top-wash-layer,
  :global(.hero-top-wash-layer) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    /* Soft pastel wash built strictly from brand tokens over base (--color-bg-section: #F4F3F9) */
    background: linear-gradient(
      90deg, 
      color-mix(in srgb, var(--color-grad-coral) 16%, var(--color-bg-section)) 4%, 
      color-mix(in srgb, var(--color-grad-pink) 38%, var(--color-bg-section)) 27%, 
      color-mix(in srgb, color-mix(in srgb, var(--color-grad-pink) 50%, var(--color-grad-purple)) 32%, var(--color-bg-section)) 41%, 
      color-mix(in srgb, var(--color-grad-purple) 28%, var(--color-bg-section)) 57%, 
      color-mix(in srgb, var(--color-grad-blue) 38%, var(--color-bg-section)) 75%, 
      color-mix(in srgb, var(--color-grad-blue) 24%, var(--color-bg-section)) 92%
    );
    opacity: 0.95;
    -webkit-mask-image: linear-gradient(180deg, black 0%, rgb(0 0 0 / 0.5) clamp(90px, 8vw, 120px), transparent clamp(180px, 15.3vw, 230px));
    mask-image: linear-gradient(180deg, black 0%, rgb(0 0 0 / 0.5) clamp(90px, 8vw, 120px), transparent clamp(180px, 15.3vw, 230px));
  }

  .hero-top-wash-dots,
  :global(.hero-top-wash-dots) {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background-image: radial-gradient(circle, rgb(255 255 255 / 0.7) 1.2px, transparent 1.6px);
    background-size: 14px 14px;
    -webkit-mask-image: linear-gradient(180deg, black 0%, rgb(0 0 0 / 0.45) clamp(80px, 7vw, 100px), transparent clamp(160px, 13vw, 200px));
    mask-image: linear-gradient(180deg, black 0%, rgb(0 0 0 / 0.45) clamp(80px, 7vw, 100px), transparent clamp(160px, 13vw, 200px));
  }

  @media (max-width: 767px) {
    .hero-top-wash-wrapper,
    :global(.hero-top-wash-wrapper) {
      height: clamp(160px, 20vw, 200px);
    }

    .hero-top-wash-dots,
    :global(.hero-top-wash-dots) {
      opacity: 0.6;
      background-size: 12px 12px;
    }
  }

  /* 1. Hero */
  .hero-section {
    position: relative;
    margin-top: calc(-1 * clamp(72px, 7vw, 84px)); /* Pull hero bg upside behind floating nav */
    padding-top: calc((clamp(4rem, 7vw, 6.5rem) + clamp(72px, 7vw, 84px)) * 0.95); /* Decreased upper gap by 5% */
    padding-bottom: clamp(4.5rem, 7vw, 7rem);
    background-color: var(--color-bg-page);
    overflow: hidden;
    z-index: 1;
    min-height: clamp(660px, 85vh, 940px);
    display: flex;
    align-items: center;
  }

  .hero-bg-layer {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
    pointer-events: none;
    overflow: hidden;
    mask-image: linear-gradient(to bottom, black 85%, transparent 100%);
    -webkit-mask-image: linear-gradient(to bottom, black 85%, transparent 100%);
  }

  .hero-picture {
    display: block;
    width: 100%;
    height: 100%;
  }

  .hero-bg-img {
    width: 100%;
    height: calc(100% + 50px);
    object-fit: cover;
    object-position: right 65%;
    display: block;
    transform: translateY(-30px) scale(0.95); /* Shift hero bg images up + 5% zoom out */
    transform-origin: right center;
  }

  .hero-scrim-overlay {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: linear-gradient(
      90deg,
      rgba(241, 239, 250, 0.96) 0%,
      rgba(241, 239, 250, 0.91) 40%,
      rgba(241, 239, 250, 0.6) 55%,
      rgba(241, 239, 250, 0.15) 68%,
      transparent 100%
    );
  }

  .hero-bottom-fade {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 80px;
    background: linear-gradient(to bottom, transparent 0%, rgba(241, 239, 250, 0.8) 70%, var(--color-bg-page) 100%);
    pointer-events: none;
  }

  .hero-container {
    position: relative;
    z-index: 1;
    width: 100%;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(1.5rem, 2.5vw, 2.5rem);
    align-items: center;
  }

  .hero-content {
    position: relative;
    z-index: 1;
    max-width: 580px;
  }

  .hero-pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: #FFFFFF;
    border: 1px solid var(--color-border-card);
    padding: 6px 14px;
    border-radius: var(--radius-full);
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--color-text-heading);
    box-shadow: var(--shadow-sm);
    margin-bottom: 1.25rem;
  }

  .hero-pill .pill-dot {
    width: 8px;
    height: 8px;
