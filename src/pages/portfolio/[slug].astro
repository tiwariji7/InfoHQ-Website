---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Button from '../../components/Button.astro';
import FinalCTA from '../../components/FinalCTA.astro';
import { caseStudies, type CaseStudy } from '../../data/caseStudies';

export function getStaticPaths() {
  return caseStudies.map((project) => ({
    params: { slug: project.slug },
    props: { project }
  }));
}

interface Props {
  project: CaseStudy;
}

const { project } = Astro.props;

const meta = {
  title: `${project.shortTitle} — Case Study | InfoHQ`,
  description: project.oneLiner,
  keywords: `${project.shortTitle}, case study, ${project.techStack.join(', ')}, InfoHQ portfolio`
};

const canonicalUrl = `https://infohq.in/portfolio/${project.slug}/`;

const caseStudySchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  '@id': `${canonicalUrl}#article`,
  name: project.title,
  headline: project.title,
  description: project.oneLiner,
  image: `https://infohq.in${project.heroImage}`,
  author: {
    '@type': 'Organization',
    name: 'InfoHQ',
    url: 'https://infohq.in/'
  },
  publisher: {
    '@type': 'Organization',
    name: 'InfoHQ',
    url: 'https://infohq.in/',
    logo: {
      '@type': 'ImageObject',
      url: 'https://infohq.in/images/infohq-brandlogo.webp'
    }
  },
  mainEntityOfPage: canonicalUrl,
  url: canonicalUrl
};

const otherProjects = caseStudies.filter((c) => c.slug !== project.slug);
---

<BaseLayout
  title={meta.title}
  description={meta.description}
  keywords={meta.keywords}
  canonical={canonicalUrl}
  customSchema={caseStudySchema}
  ogImage={project.heroImage}
>
  <!-- 1. Case Study Top Bar & Breadcrumbs -->
  <nav class="cs-breadcrumb-nav" aria-label="Breadcrumb">
    <div class="container cs-breadcrumb-inner">
      <a href="/portfolio" class="cs-back-link">
        <span class="cs-back-arrow" aria-hidden="true">&larr;</span>
        <span>Back to All Projects</span>
      </a>
      <div class="cs-breadcrumb-trail">
        <span>Portfolio</span>
        <span class="cs-trail-sep">/</span>
        <span class="cs-trail-current">{project.shortTitle}</span>
      </div>
    </div>
  </nav>

  <!-- 2. Hero Section: Executive Summary & At-A-Glance -->
  <header class="cs-hero-section">
    <div class="container cs-hero-container">
      <div class="cs-hero-header">
        <div class="cs-badge-row">
          <span class={`cs-status-badge ${project.badgeType}`}>
            <span class="cs-badge-dot"></span>
            {project.badge}
          </span>
          <span class="cs-category-tag">{project.categoryLabel}</span>
        </div>

        <h1 class="cs-headline">{project.title}</h1>

        <p class="cs-one-liner">{project.oneLiner}</p>

        <!-- Hero Actions -->
        <div class="cs-hero-actions">
          {project.liveUrl && (
            <a
              href={project.liveUrl}
              target={project.liveUrl.startsWith('http') ? '_blank' : undefined}
              rel={project.liveUrl.startsWith('http') ? 'noopener noreferrer' : undefined}
              class="cs-btn-primary"
            >
              <span>{project.liveUrlLabel || 'Visit Live Project'}</span>
              <span class="cs-btn-icon" aria-hidden="true">
                {project.liveUrl.startsWith('http') ? '↗' : '↓'}
              </span>
            </a>
          )}
          <a href="/contact" class="cs-btn-secondary">
            <span>Inquire Similar Engineering</span>
            <span class="cs-btn-icon" aria-hidden="true">&rarr;</span>
          </a>
        </div>
      </div>

      <!-- Quick Specs Dashboard Strip -->
      <div class="cs-specs-bar" role="region" aria-label="Project Quick Specifications">
        <div class="cs-spec-item">
          <span class="cs-spec-label">Client / Ownership</span>
          <span class="cs-spec-val">{project.client}</span>
        </div>
        <div class="cs-spec-item">
          <span class="cs-spec-label">Industry</span>
          <span class="cs-spec-val">{project.industry}</span>
        </div>
        <div class="cs-spec-item">
          <span class="cs-spec-label">Timeline</span>
          <span class="cs-spec-val">{project.timeline}</span>
        </div>
        <div class="cs-spec-item">
          <span class="cs-spec-label">Core Platform</span>
          <span class="cs-spec-val">{project.platform}</span>
        </div>
      </div>

      <!-- Hero Visual Banner -->
      <div class="cs-hero-visual-card">
        <img
          src={project.heroImage}
          alt={`${project.shortTitle} hero showcase`}
          class="cs-hero-img"
          width="1400"
          height="768"
          loading="eager"
          decoding="async"
        />
      </div>
    </div>
  </header>

  <!-- 3. Key Metrics & Impact Strip -->
  {project.results && project.results.length > 0 && (
    <section class="section cs-metrics-section" aria-labelledby="metrics-heading">
      <div class="container">
        <h2 id="metrics-heading" class="sr-only">Key Project Results</h2>
        <div class="cs-metrics-grid">
          {project.results.map((res) => (
            <div class="cs-metric-card">
              <span class="cs-metric-num">{res.metric}</span>
              <span class="cs-metric-label">{res.label}</span>
              {res.sublabel && <span class="cs-metric-sub">{res.sublabel}</span>}
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- 4. How It Works in 3 Simple Steps (Instant Comprehension) -->
  {project.workflowWalkthrough && (
    <section class="section section-alt cs-walkthrough-section" aria-labelledby="walkthrough-heading">
      <div class="container">
        <div class="section-header text-center">
          <div class="cs-mini-badge">System Workflow</div>
          <h2 id="walkthrough-heading" class="section-title">
            {project.workflowWalkthrough.headline}
          </h2>
          <p class="section-lead">
            {project.workflowWalkthrough.subheadline}
          </p>
        </div>

        <div class="cs-steps-grid">
          {project.workflowWalkthrough.steps.map((st) => (
            <div class="cs-step-card">
              <div class="cs-step-top">
                <span class="cs-step-badge">{st.step}</span>
                <span class="cs-step-icon" aria-hidden="true">{st.icon}</span>
              </div>
              <h3 class="cs-step-title">{st.title}</h3>
              <p class="cs-step-desc">{st.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- 5. The Real Story: Problem vs Solution -->
  <section class="section cs-narrative-section" aria-labelledby="narrative-heading">
    <div class="container">
      <div class="section-header text-center">
        <div class="cs-mini-badge">The Engineering Story</div>
        <h2 id="narrative-heading" class="section-title">
          From Real-World Friction to <span class="text-gradient">Production System</span>
        </h2>
        <p class="section-lead">
          Why this system had to be built, the technical hurdles encountered, and how InfoHQ solved them.
        </p>
      </div>

      <div class="cs-story-grid">
        <!-- Problem Card -->
        <article class="cs-story-card cs-card-problem">
          <div class="cs-story-header">
            <span class="cs-story-tag tag-problem">
              <span class="cs-story-dot red"></span>
              {project.problem.badge}
            </span>
            <h3 class="cs-story-title">{project.problem.headline}</h3>
            <p class="cs-story-lead">{project.problem.description}</p>
          </div>

          <div class="cs-points-list">
            {project.problem.points.map((pt) => (
              <div class="cs-point-item">
                <span class="cs-point-icon red-cross" aria-hidden="true">&times;</span>
                <div>
                  <h4 class="cs-point-title">{pt.title}</h4>
                  <p class="cs-point-desc">{pt.desc}</p>
                </div>
              </div>
            ))}
          </div>
        </article>

        <!-- Solution Card -->
        <article class="cs-story-card cs-card-solution">
          <div class="cs-story-header">
            <span class="cs-story-tag tag-solution">
              <span class="cs-story-dot green"></span>
              {project.solution.badge}
            </span>
            <h3 class="cs-story-title">{project.solution.headline}</h3>
            <p class="cs-story-lead">{project.solution.description}</p>
          </div>

          <div class="cs-points-list">
            {project.solution.points.map((pt) => (
              <div class="cs-point-item">
                <span class="cs-point-icon green-check" aria-hidden="true">&check;</span>
                <div>
                  <h4 class="cs-point-title">{pt.title}</h4>
                  <p class="cs-point-desc">{pt.desc}</p>
                </div>
              </div>
            ))}
          </div>
        </article>
      </div>
    </div>
  </section>

  <!-- 6. Interactive Production Workflow Screen Stage (For Mobile/AI Apps) -->
  {project.screenshots && project.screenshots.length > 0 && (
    <section class="section section-alt cs-screen-stage-section" id="screens" aria-labelledby="screens-heading">
      <div class="container">
        <div class="section-header text-center">
          <div class="cs-mini-badge">Interactive Production Explorer</div>
          <h2 id="screens-heading" class="section-title">
            Live Application <span class="text-gradient">Screen &amp; Logic Breakdown</span>
          </h2>
          <p class="section-lead">
            Select each workflow tab to inspect the real native interface and review how the underlying AI, OCR, and persistence pipelines operate.
          </p>
        </div>

        <!-- Workflow Tabs Selector -->
        <div class="cs-tab-bar-wrap" role="region" aria-label="Application Workflows">
          <div class="cs-tab-bar" role="tablist">
            {project.screenshots.map((screen, sIdx) => (
              <button
                type="button"
                class={`cs-tab-btn ${sIdx === 0 ? 'active' : ''}`}
                role="tab"
                aria-selected={sIdx === 0 ? 'true' : 'false'}
                data-target={`cs-panel-${sIdx}`}
                id={`cs-tab-${sIdx}`}
              >
                <span class="cs-tab-index">0{sIdx + 1}</span>
                <span class="cs-tab-label">{screen.tabLabel}</span>
              </button>
            ))}
          </div>
        </div>

        <!-- Screen Stage Explorer Panels -->
        <div class="cs-stage-panels">
          {project.screenshots.map((screen, sIdx) => (
            <div
              class={`cs-stage-panel ${sIdx === 0 ? 'active' : ''}`}
              id={`cs-panel-${sIdx}`}
              role="tabpanel"
              aria-labelledby={`cs-tab-${sIdx}`}
            >
              <!-- Left: Phone Device Showcase Frame -->
              <div class="cs-device-col">
                <div class="cs-device-frame">
                  <div class="cs-device-notch" aria-hidden="true"></div>
                  <img
                    src={screen.src}
                    alt={screen.title}
                    class="cs-device-screen-img"
                    loading="lazy"
                    decoding="async"
                  />
                </div>
                <div class="cs-device-caption">
                  <span>Screen 0{sIdx + 1} of 0{project.screenshots?.length} &bull; Native Production UI</span>
                </div>
              </div>

              <!-- Right: Technical Breakdown & Under The Hood -->
              <div class="cs-deep-dive-col">
                <div class="cs-meta-pill">{screen.workflowRole}</div>
                <h3 class="cs-screen-title">{screen.title}</h3>
                <p class="cs-screen-caption">{screen.caption}</p>

                <!-- Under The Hood Developer Breakdown Card -->
                <div class="cs-hood-card">
                  <div class="cs-hood-title">
                    <span class="cs-hood-icon">⚙</span>
                    <strong>Under The Hood &bull; Engineering Architecture:</strong>
                  </div>
                  <ul class="cs-hood-list">
                    {screen.underTheHood.map((pt) => (
                      <li>
                        <span class="cs-hood-bullet">&bull;</span>
                        <span>{pt}</span>
                      </li>
                    ))}
                  </ul>
                </div>

                <!-- Screen Capabilities Tags -->
                {screen.keyCapabilities && (
                  <div class="cs-caps-block">
                    <span class="cs-caps-heading">Key Capabilities Delivered:</span>
                    <div class="cs-caps-pills">
                      {screen.keyCapabilities.map((cap) => (
                        <span class="cs-cap-chip">{cap}</span>
                      ))}
                    </div>
                  </div>
                )}
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- 7. Core System Architecture & Pipelines -->
  {project.techLayers && project.techLayers.length > 0 && (
    <section class="section cs-arch-section" aria-labelledby="arch-heading">
      <div class="container">
        <div class="section-header text-center">
          <div class="cs-mini-badge">System Architecture</div>
          <h2 id="arch-heading" class="section-title">
            Core System <span class="text-gradient">Pipelines &amp; Infrastructure</span>
          </h2>
          <p class="section-lead">
            Engineered for high concurrency, zero-trust data security, and instant response times.
          </p>
        </div>

        <div class="cs-arch-grid">
          {project.techLayers.map((layer, lIdx) => (
            <div class="cs-arch-card">
              <div class="cs-arch-top">
                <span class="cs-arch-num">0{lIdx + 1}</span>
                <span class="cs-arch-tech">{layer.tech}</span>
              </div>
              <h3 class="cs-arch-name">{layer.layer}</h3>
              <p class="cs-arch-desc">{layer.detail}</p>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- 8. Complete Deliverables Checklist -->
  <section class="section section-alt cs-features-section" aria-labelledby="features-heading">
    <div class="container">
      <div class="section-header text-center">
        <div class="cs-mini-badge">Full Scope Delivered</div>
        <h2 id="features-heading" class="section-title">
          Production Capabilities &amp; <span class="text-gradient">Deliverables</span>
        </h2>
        <p class="section-lead">
          Every layer delivered with 100% clean code ownership, zero license hostage, and detailed documentation.
        </p>
      </div>

      <div class="cs-features-grid">
        {project.keyFeatures.map((feat) => (
          <div class="cs-feat-item">
            <span class="cs-feat-check" aria-hidden="true">&check;</span>
            <span class="cs-feat-text">{feat}</span>
          </div>
        ))}
      </div>

      <!-- Tech Stack Badges Strip -->
      <div class="cs-tech-strip">
        <span class="cs-tech-label">Technology Stack:</span>
        <div class="cs-tech-pills">
          {project.techStack.map((tech) => (
            <span class="cs-tech-pill">{tech}</span>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- 9. Other Projects Navigator -->
  {otherProjects.length > 0 && (
    <section class="section cs-next-section" aria-labelledby="next-heading">
      <div class="container">
        <div class="section-header text-center">
          <h2 id="next-heading" class="section-title">Explore Other Projects</h2>
        </div>

        <div class="cs-other-grid">
          {otherProjects.map((op) => (
            <a href={`/portfolio/${op.slug}/`} class="card cs-other-card">
              <div class="cs-other-badge">{op.categoryLabel}</div>
              <h3 class="cs-other-title">{op.shortTitle}</h3>
              <p class="cs-other-desc">{op.oneLiner}</p>
              <span class="cs-other-link">
                <span>Read Case Study</span>
                <span aria-hidden="true">&rarr;</span>
              </span>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- 10. Final Call to Action -->
  <FinalCTA page="portfolio" />
</BaseLayout>

<script>
  // Interactive Screen Stage Tab Switching
  function initCaseStudyTabs() {
    const tabButtons = document.querySelectorAll<HTMLButtonElement>('.cs-tab-btn');
    const stagePanels = document.querySelectorAll<HTMLElement>('.cs-stage-panel');
    const stageContainer = document.querySelector<HTMLElement>('.cs-stage-panels');

    if (!tabButtons.length || !stagePanels.length || !stageContainer) return;

    // Apply interactive tab mode once JS is active
    stageContainer.classList.add('js-tabs-ready');

    tabButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const targetId = btn.getAttribute('data-target');
        if (!targetId) return;

        // Toggle buttons
        tabButtons.forEach((b) => {
          b.classList.remove('active');
          b.setAttribute('aria-selected', 'false');
        });
        btn.classList.add('active');
        btn.setAttribute('aria-selected', 'true');

        // Toggle panels
        stagePanels.forEach((panel) => {
          if (panel.id === targetId) {
            panel.classList.add('active');
          } else {
            panel.classList.remove('active');
          }
        });
      });
    });
  }

  initCaseStudyTabs();
  document.addEventListener('astro:page-load', initCaseStudyTabs);
</script>

<style>
  /* ==========================================================================
     InfoHQ High-End Case Study Design System
     Human-Crafted, High-Density Visual Storytelling
     ========================================================================== */

  /* Breadcrumb Navigation */
  .cs-breadcrumb-nav {
    border-bottom: 1px solid var(--color-border-card);
    background: var(--color-surface-white);
    padding: 0.85rem 0;
    font-size: var(--text-sm);
  }

  .cs-breadcrumb-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .cs-back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--color-text-heading);
    font-weight: 600;
    text-decoration: none;
    transition: color 0.15s ease, transform 0.15s ease;
  }

  .cs-back-link:hover {
    color: var(--color-primary);
    transform: translateX(-2px);
  }

  .cs-back-arrow {
    font-size: 1.1rem;
    line-height: 1;
  }

  .cs-breadcrumb-trail {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--color-text-muted);
  }

  .cs-trail-current {
    color: var(--color-text-heading);
    font-weight: 500;
  }

  /* Hero Section */
  .cs-hero-section {
    padding: clamp(2.5rem, 5vw, 4.5rem) 0 3rem;
    background: linear-gradient(180deg, var(--color-surface-white) 0%, var(--color-bg-page) 100%);
  }

  .cs-hero-header {
    max-width: 920px;
    margin: 0 auto;
    text-align: center;
  }

  .cs-badge-row {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 1.25rem;
    flex-wrap: wrap;
    justify-content: center;
  }

  .cs-status-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.35rem 0.85rem;
    border-radius: var(--radius-full);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .cs-status-badge.ai {
    background: rgba(99, 102, 241, 0.1);
    color: var(--color-primary);
    border: 1px solid rgba(99, 102, 241, 0.25);
  }

  .cs-status-badge.live {
    background: rgba(16, 185, 129, 0.1);
    color: #059669;
    border: 1px solid rgba(16, 185, 129, 0.25);
  }

  .cs-badge-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: currentColor;
    animation: cs-pulse 2s cubic-bezier(0.4, 0, 0.6, 1) infinite;
  }

  @keyframes cs-pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.4; }
  }

  .cs-category-tag {
    font-size: 0.8rem;
    color: var(--color-text-muted);
    font-weight: 500;
  }

  .cs-headline {
    font-size: clamp(2rem, 4.2vw, 3.4rem);
    font-weight: 850;
    line-height: 1.15;
    letter-spacing: -0.03em;
    color: var(--color-text-heading);
    margin-bottom: 1.25rem;
  }

  .cs-one-liner {
    font-size: clamp(1.05rem, 1.8vw, 1.3rem);
    line-height: 1.6;
    color: var(--color-text-body);
    max-width: 820px;
    margin: 0 auto 2rem;
  }

  .cs-hero-actions {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    flex-wrap: wrap;
    margin-bottom: 2.75rem;
  }

  .cs-btn-primary {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    background: var(--color-primary);
    color: #FFFFFF !important;
    padding: 0.85rem 1.6rem;
    border-radius: var(--radius-md);
    font-weight: 600;
    font-size: var(--text-base);
    text-decoration: none;
    box-shadow: 0 4px 14px rgba(99, 102, 241, 0.28);
    transition: transform 0.2s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.2s ease, filter 0.2s ease;
  }

  .cs-btn-primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 22px rgba(99, 102, 241, 0.38);
    filter: brightness(1.05);
  }

  .cs-btn-secondary {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    background: var(--color-surface-white);
    color: var(--color-text-heading) !important;
    border: 1px solid var(--color-border-card);
    padding: 0.85rem 1.6rem;
    border-radius: var(--radius-md);
    font-weight: 600;
    font-size: var(--text-base);
    text-decoration: none;
    transition: transform 0.2s ease, border-color 0.2s ease, background 0.2s ease;
  }

  .cs-btn-secondary:hover {
    transform: translateY(-2px);
    border-color: var(--color-primary);
    background: rgba(99, 102, 241, 0.04);
  }

  .cs-btn-icon {
    font-size: 1.15rem;
    line-height: 1;
  }

  /* Quick Specs Bar */
  .cs-specs-bar {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.25rem;
    background: var(--color-surface-white);
    border: 1px solid var(--color-border-card);
    border-radius: var(--radius-lg);
    padding: 1.25rem 1.75rem;
    margin-bottom: 2.5rem;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.03);
  }

  .cs-spec-item {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .cs-spec-label {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .cs-spec-val {
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--color-text-heading);
    line-height: 1.4;
  }

  /* Hero Visual Card */
  .cs-hero-visual-card {
    background: var(--color-surface-white);
    border: 1px solid var(--color-border-card);
    border-radius: var(--radius-xl);
    overflow: hidden;
    box-shadow: 0 16px 48px -12px rgba(15, 23, 42, 0.09);
    aspect-ratio: 16 / 9;
  }

  .cs-hero-img {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
  }

  /* Metrics Section */
  .cs-metrics-section {
    padding: 2rem 0;
    border-bottom: 1px solid var(--color-border-card);
  }

  .cs-metrics-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.5rem;
  }

  .cs-metric-card {
    background: var(--color-surface-white);
