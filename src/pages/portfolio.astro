---

<BaseLayout
  title={meta.title}
  description={meta.description}
  keywords={meta.keywords}
  schemaType="portfolio"
>
  <!-- 1. Hero Section -->
  <section class="section portfolio-hero" aria-labelledby="portfolio-heading">
    <div class="container text-center">
      <span class="text-eyebrow">Proof of Work &bull; Shipped &amp; Production-Ready</span>

      <h1 id="portfolio-heading" class="portfolio-headline">
        Systems We've Built. <span class="text-gradient">Results We've Shipped.</span>
      </h1>

      <p class="portfolio-subheadline">
        Explore InfoHQ's track record of high-performance web platforms, enterprise AI systems, mobile applications, and automated workflows. Engineered with production discipline, zero templates, and 100% client code ownership.
      </p>

      <!-- Key Performance Metrics Strip -->
      <div class="stats-counter-bar" aria-label="Key Delivery Metrics">
        <div class="stat-counter-item">
          <span class="stat-number">100%</span>
          <span class="stat-label">Code &amp; IP Ownership</span>
        </div>
        <div class="stat-divider" aria-hidden="true"></div>
        <div class="stat-counter-item">
          <span class="stat-number">99.9%</span>
          <span class="stat-label">System Uptime Target</span>
        </div>
        <div class="stat-divider" aria-hidden="true"></div>
        <div class="stat-counter-item">
          <span class="stat-number">&lt; 1.2s</span>
          <span class="stat-label">Average Load Speed</span>
        </div>
        <div class="stat-divider" aria-hidden="true"></div>
        <div class="stat-counter-item">
          <span class="stat-number">15+</span>
          <span class="stat-label">Shipped Systems</span>
        </div>
      </div>

      <!-- Category Filter Tabs -->
      <div class="filter-controls-wrap" role="region" aria-label="Project Category Filter">
        <div class="filter-tabs" role="tablist">
          {categories.map((cat, idx) => (
            <button
              type="button"
              class={`filter-tab-btn ${idx === 0 ? 'active' : ''}`}
              role="tab"
              aria-selected={idx === 0 ? 'true' : 'false'}
              data-filter={cat.id}
              id={`filter-tab-${cat.id}`}
            >
              {cat.label}
            </button>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- 2. Flagship Case Studies Section -->
  <section class="section section-alt case-studies-section" aria-labelledby="case-studies-heading">
    <div class="container">
      <div class="section-header">
        <span class="text-eyebrow">Featured Deep Dives</span>
        <h2 id="case-studies-heading">Production Case Studies</h2>
        <p>In-depth architectural breakdowns of systems engineered, scaled, and maintained by InfoHQ.</p>
      </div>

      <div class="case-studies-list">
        {flagshipCaseStudies.map((cs) => (
          cs.hasShowcase ? (
            /* =================================================================
               1. Flagship Project with Internal Product Showcase (e.g. SeHAT)
               - Outside Card: Hero banner, clean customer summary, key highlights, 
                 metrics, tech chips, and primary showcase trigger button.
               - Inside Modal: 5 live workflow screens, architecture matrix,
                 and deep-dive developer notes.
               ================================================================= */
            <article 
              class="card case-study-card has-showcase-card" 
              data-category={cs.category}
              id={cs.id}
            >
              <!-- Card Header & Metadata -->
              <div class="case-study-top">
                <div class="case-study-meta">
                  <span class={`status-badge badge-${cs.badgeType}`}>
                    <span class="status-indicator"></span>
                    {cs.badge}
                  </span>
                  <span class="case-study-industry">{cs.industry}</span>
                  {cs.platform && <span class="platform-meta-pill">{cs.platform}</span>}
                </div>
                <div class="client-meta-wrap">
                  <span class="client-name">{cs.client}</span>
                  {cs.engagement && <span class="engagement-badge">{cs.engagement}</span>}
                </div>
              </div>

              <!-- Hero Image Banner: Immediate Visual Context for Customers -->
              {cs.heroImage && (
                <div class="cs-hero-banner-wrap">
                  <img 
                    src={cs.heroImage} 
                    alt={`${cs.title} Platform Banner`}
                    class="cs-hero-banner-img"
                    width="1400"
                    height="747"
                    loading="lazy"
                    decoding="async"
                  />
                  <div class="hero-image-overlay-bar">
                    <span class="hero-overlay-tag">✦ Production Healthcare Mobile Platform</span>
                    <button 
                      type="button" 
                      class="hero-overlay-btn open-showcase-btn" 
                      data-target={`showcase-modal-${cs.id}`}
                    >
                      Explore Internal Product Showcase &rarr;
                    </button>
                  </div>
                </div>
              )}

              <!-- Outside Overview Grid -->
              <div class="case-study-grid">
                <!-- Left Column: Story, Highlights & Showcase Callout -->
                <div class="case-study-main">
                  <h3 class="case-study-title">{cs.title}</h3>
                  <p class="case-study-summary">{cs.summary}</p>

                  <!-- 4 Core Customer-Facing Highlights -->
                  <div class="outside-features-list">
                    <span class="outside-features-title">Core Platform Capabilities:</span>
                    <div class="outside-features-grid">
                      <div class="outside-feat-item">
                        <span class="feat-bullet">&check;</span>
                        <div>
                          <strong>AI Symptom Checker &amp; Lab Report OCR:</strong>
                          <span>Parses camera photos and PDFs of blood tests (CBC, Glucose, Platelets) into plain-language summaries.</span>
                        </div>
                      </div>
                      <div class="outside-feat-item">
                        <span class="feat-bullet">&check;</span>
                        <div>
                          <strong>Trilingual Clinical RAG Chatbot:</strong>
                          <span>Medical dialogue in English, Hindi, and colloquial Hinglish with speech-to-text input and verified citations.</span>
                        </div>
                      </div>
                      <div class="outside-feat-item">
                        <span class="feat-bullet">&check;</span>
                        <div>
                          <strong>Smart Medicine Reminders:</strong>
                          <span>Doze-resistant scheduled dosage alerts and 0–100 daily holistic wellness score with adherence tracking.</span>
                        </div>
                      </div>
                      <div class="outside-feat-item">
                        <span class="feat-bullet">&check;</span>
                        <div>
                          <strong>Emergency SOS Assistance:</strong>
                          <span>One-tap live GPS coordinates broadcast to family contacts via SMS and WhatsApp plus direct 112 calling.</span>
                        </div>
                      </div>
                    </div>
                  </div>

                  <!-- Showcase Teaser Callout -->
                  <div class="showcase-teaser-box">
                    <div class="teaser-icon-pulse">✦</div>
                    <div class="teaser-copy">
                      <strong>Interactive Internal Showcase Available:</strong>
                      <span>Examine 5 live production workflow screens, full system architecture layers, and developer implementation notes.</span>
                    </div>
                    <button 
                      type="button" 
                      class="btn-teaser-action open-showcase-btn" 
                      data-target={`showcase-modal-${cs.id}`}
                    >
                      View Showcase &rarr;
                    </button>
                  </div>
                </div>

                <!-- Right Column: Sidebar Metrics, Tech Stack & Action Buttons -->
                <div class="case-study-sidebar">
                  <!-- Measurable Results Box -->
                  <div class="results-box">
                    <span class="results-title">Measurable System Performance</span>
                    <div class="results-grid">
                      {cs.results.map((res) => (
                        <div class="result-item">
                          <span class="result-metric">{res.metric}</span>
                          <span class="result-label">{res.label}</span>
                        </div>
                      ))}
                    </div>
                  </div>

                  <!-- Tech Stack Chips -->
                  <div class="sidebar-tech-wrap">
                    <span class="tech-stack-title">Engineered With</span>
                    <div class="tech-chips">
                      {cs.techStack.map((tech) => (
