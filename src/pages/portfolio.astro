    font-size: var(--text-sm);
    line-height: 1.6;
    color: var(--color-text-body);
    max-width: 820px;
    margin: 0;
  }

  /* Screen Tabs Bar */
  .modal-screen-tabs-bar {
    display: flex;
    align-items: center;
    gap: 8px;
    overflow-x: auto;
    padding: 4px 2px 10px;
    -webkit-overflow-scrolling: touch;
    border-bottom: 1px solid var(--color-border-card);
  }

  .modal-tab-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 16px;
    background: #FFFFFF;
    border: 1px solid rgba(124, 92, 232, 0.2);
    border-radius: var(--radius-full);
    font-size: 12.5px;
    font-weight: 700;
    color: var(--color-text-body);
    cursor: pointer;
    white-space: nowrap;
    transition: all 0.2s ease;
  }

  .modal-tab-btn:hover {
    color: var(--color-primary);
    border-color: var(--color-primary);
    background: rgba(124, 92, 232, 0.05);
  }

  .modal-tab-btn.active {
    background: var(--brand-gradient);
    color: #FFFFFF;
    border-color: transparent;
    box-shadow: 0 4px 12px rgba(124, 92, 232, 0.35);
  }

  .modal-tab-num {
    font-size: 11px;
    opacity: 0.85;
    font-weight: 800;
  }

  /* Screen Stage (Split View) */
  .modal-screen-stage {
    min-height: 480px;
    position: relative;
  }

  .modal-screen-panel {
    display: none;
    grid-template-columns: 380px 1fr;
    gap: clamp(1.75rem, 3vw, 2.75rem);
    align-items: start;
  }

  .modal-screen-panel.active {
    display: grid;
    animation: fadeInPane 0.25s ease forwards;
  }

  /* Phone Mockup Frame */
  .device-mockup-col {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
  }

  .device-mockup-frame {
    width: 100%;
    max-width: 360px;
    background: #0B081F;
    border-radius: 38px;
    padding: 12px;
    border: 3px solid #231E3D;
    box-shadow: 0 20px 50px rgba(12, 6, 40, 0.22);
    position: relative;
    overflow: hidden;
  }

  .device-speaker-notch {
    width: 80px;
    height: 5px;
    background: #252042;
    border-radius: var(--radius-full);
    margin: 4px auto 10px;
  }

  .device-screen-img {
    width: 100%;
    height: auto;
    aspect-ratio: 1100 / 733;
    display: block;
    border-radius: 26px;
    object-fit: contain;
    max-height: 540px;
    transition: transform 0.3s ease;
  }

  .device-mockup-frame:hover .device-screen-img {
    transform: scale(1.02);
  }

  .device-caption-pill {
    font-size: 11px;
    font-weight: 700;
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  /* Device Specs Column (Right) */
  .device-specs-col {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: 0.5rem 0;
  }

  .screen-meta-badge {
    align-self: flex-start;
    font-size: 11px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-primary);
    background: rgba(124, 92, 232, 0.1);
    padding: 4px 12px;
    border-radius: var(--radius-full);
  }

  .device-spec-headline {
    font-size: clamp(1.3rem, 2vw, 1.65rem);
    font-weight: 800;
    color: var(--color-text-heading);
    margin: 0;
    line-height: 1.3;
  }

  .device-spec-summary {
    font-size: var(--text-sm);
    line-height: 1.65;
    color: var(--color-text-body);
    margin: 0;
  }

  .spec-under-hood-card {
    background: #F8F7FD;
    border: 1px solid var(--color-border-card);
    border-radius: var(--radius-lg);
    padding: 1.25rem;
    margin-top: 0.5rem;
  }

  .under-hood-title {
    font-size: 12.5px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-primary);
    margin: 0 0 0.75rem;
  }

  .under-hood-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 9px;
  }

  .under-hood-list li {
    display: flex;
    align-items: baseline;
    gap: 10px;
    font-size: 12.5px;
    line-height: 1.55;
    color: var(--color-text-body);
  }

  .tech-bullet {
    color: var(--color-primary);
    font-size: 14px;
    font-weight: 800;
    flex-shrink: 0;
  }

  .screen-caps-wrap {
    margin-top: 0.5rem;
  }

  .caps-label {
    display: block;
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-text-muted);
    margin-bottom: 0.5rem;
  }

  .caps-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .cap-pill {
    font-size: 11.5px;
    font-weight: 600;
    color: var(--color-text-heading);
    background: #FFFFFF;
    border: 1px solid rgba(124, 92, 232, 0.2);
    padding: 3px 10px;
    border-radius: var(--radius-full);
  }

  /* Full-Stack Architecture Matrix */
  .arch-matrix-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 14px;
  }

  .arch-matrix-card {
    background: #F8F8FC;
    border: 1px solid var(--color-border-card);
    border-radius: var(--radius-lg);
    padding: 1.15rem;
    transition: transform 0.2s ease, border-color 0.2s ease;
  }

  .arch-matrix-card:hover {
    transform: translateY(-2px);
    border-color: rgba(124, 92, 232, 0.35);
  }

  .arch-matrix-top {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 6px;
  }

  .arch-idx {
    font-size: 11px;
    font-weight: 800;
    color: #FFFFFF;
    background: var(--brand-gradient);
    width: 24px;
    height: 24px;
    border-radius: 50%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .arch-name {
    font-size: 13px;
    font-weight: 800;
    color: var(--color-text-heading);
  }

  .arch-desc {
    font-size: 12px;
    line-height: 1.5;
    color: var(--color-text-body);
    margin: 0;
  }

  /* Engineering Retrospective */
  .retrospective-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.25rem;
  }

  .retro-card {
    padding: 1.25rem;
    border-radius: var(--radius-lg);
    font-size: var(--text-sm);
    line-height: 1.6;
  }

  .retro-challenge {
    background: #FFF7F5;
    border-left: 3px solid var(--color-grad-coral);
    color: #5C2A24;
  }

  .retro-approach {
    background: #F6F4FF;
    border-left: 3px solid var(--color-primary);
    color: #2D1A63;
  }

  .retro-solution {
    background: #ECFDF5;
    border-left: 3px solid #10B981;
    color: #064E3B;
  }

  .retro-badge {
    font-size: 11px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 8px;
  }

  .tag-challenge {
    color: var(--color-grad-coral);
  }

  .tag-approach {
    color: var(--color-primary);
  }

  .tag-solution {
    color: #059669;
  }

  .dialog-deliverables-box {
    background: #FFFFFF;
    border: 1px solid var(--color-border-card);
    border-radius: var(--radius-xl);
    padding: 1.5rem;
    margin-top: 0.5rem;
  }

  .dialog-deliv-title {
    font-size: var(--text-sm);
    font-weight: 800;
    color: var(--color-text-heading);
    margin: 0 0 1rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .dialog-deliv-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 10px 20px;
  }

  .dialog-deliv-item {
    display: flex;
    align-items: baseline;
    gap: 10px;
    font-size: 12.5px;
    color: var(--color-text-body);
    line-height: 1.5;
  }

  .deliv-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 17px;
    height: 17px;
    border-radius: 50%;
    background: rgba(16, 185, 129, 0.15);
    color: #059669;
    font-size: 10px;
    font-weight: 800;
    flex-shrink: 0;
  }

  .dialog-impact-banner {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    background: linear-gradient(135deg, rgba(124, 92, 232, 0.08) 0%, rgba(87, 130, 224, 0.08) 100%);
    border: 1px solid rgba(124, 92, 232, 0.25);
    border-radius: var(--radius-xl);
    padding: 1.25rem 1.5rem;
  }

  .impact-icon-col {
    font-size: 2rem;
    line-height: 1;
    flex-shrink: 0;
  }

  .impact-text-col {
    flex: 1;
  }

  .impact-banner-tag {
    display: block;
    font-size: 11px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-primary);
    margin-bottom: 4px;
  }

  .impact-text-col p {
    font-size: var(--text-sm);
    line-height: 1.55;
    color: var(--color-text-heading);
    margin: 0;
    font-weight: 500;
  }

  /* In-Modal FinalCTA Styling */
  .modal-cta-wrapper {
    margin-top: 1rem;
  }

  .modal-cta-wrapper .final-cta-section {
    padding: 1rem 0 0.5rem;
    background: transparent;
  }

  .modal-cta-wrapper .container {
    padding: 0;
    max-width: 100%;
  }

  .modal-cta-wrapper .cta-banner {
    border-radius: var(--radius-2xl);
  }

  .case-study-subsummary {
    font-size: var(--text-sm);
    line-height: 1.6;
    color: var(--color-text-muted);
    margin-top: -1rem;
    margin-bottom: 1.5rem;
  }

  .tech-layers-wrap {
    margin: 1.75rem 0;
  }

  .tech-layers-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 10px;
    margin-top: 0.75rem;
  }

  .tech-layer-card {
    background: #F8F8FC;
    border: 1px solid var(--color-border-card);
    border-radius: var(--radius-md);
    padding: 10px 14px;
  }

  .layer-title {
    display: block;
    font-size: 12.5px;
    font-weight: 700;
    color: var(--color-primary);
    margin-bottom: 3px;
  }

  .layer-detail {
    display: block;
    font-size: 12px;
    color: var(--color-text-body);
    line-height: 1.45;
  }

  .impact-box {
    background: linear-gradient(135deg, rgba(124, 92, 232, 0.06) 0%, rgba(87, 130, 224, 0.06) 100%);
    border-left: 3px solid var(--color-primary);
    border-radius: 0 var(--radius-md) var(--radius-md) 0;
    padding: 1rem 1.25rem;
    margin-top: 1.75rem;
  }

  .impact-tag {
    display: block;
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-primary);
    margin-bottom: 4px;
  }

  .impact-text {
    font-size: var(--text-sm);
    color: var(--color-text-heading);
    line-height: 1.55;
    margin: 0;
    font-weight: 500;
  }

  /* Case Study Grid */
  .case-study-grid {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: clamp(2rem, 3.5vw, 3.5rem);
    align-items: start;
  }

  .case-study-title {
    font-size: clamp(1.35rem, 2vw, 1.75rem);
    font-weight: 800;
    line-height: 1.25;
    background: var(--brand-gradient);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    color: var(--color-text-heading);
    margin-bottom: 1rem;
    letter-spacing: -0.01em;
    display: inline-block;
  }

  .case-study-summary {
    font-size: var(--text-base);
    line-height: 1.65;
    color: var(--color-text-body);
    margin-bottom: 1.75rem;
  }

  /* Problem & Solution Mini Cards */
  .case-study-problem-solution {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.25rem;
    margin-bottom: 1.75rem;
  }

  .problem-box, .solution-box {
    padding: 1.15rem;
    border-radius: var(--radius-lg);
    font-size: var(--text-sm);
    line-height: 1.55;
  }

  .problem-box {
    background: #FFF7F5;
    border-left: 3px solid var(--color-grad-coral);
    color: #5C2A24;
  }

  .solution-box {
    background: #F6F4FF;
    border-left: 3px solid var(--color-primary);
    color: #2D1A63;
  }

  .ps-tag {
    display: block;
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 6px;
  }

  .tag-problem {
    color: var(--color-grad-coral);
  }

  .tag-solution {
    color: var(--color-primary);
  }

  .deliverables-wrap {
    margin-top: 1.5rem;
  }

  .deliverables-heading {
    display: block;
    font-size: var(--text-xs);
    font-weight: 700;
    text-transform: uppercase;
    color: var(--color-text-muted);
    letter-spacing: 0.05em;
    margin-bottom: 0.75rem;
  }

  .deliverables-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .deliverables-list li {
    display: flex;
    align-items: baseline;
    gap: 10px;
    font-size: var(--text-sm);
    color: var(--color-text-body);
    line-height: 1.5;
  }

  .check-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 18px;
    height: 18px;
    border-radius: 50%;
    background: rgba(16, 185, 129, 0.15);
    color: #059669;
    font-size: 11px;
    font-weight: 800;
    flex-shrink: 0;
  }

  /* Right Sidebar of Case Study */
  .case-study-sidebar {
    background: #F9F9FD;
    border: 1px solid var(--color-border-card);
    border-radius: var(--radius-xl);
    padding: clamp(1.25rem, 2vw, 1.75rem);
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .results-box {
    border-bottom: 1px solid var(--color-border-card);
    padding-bottom: 1.25rem;
  }

  .results-title {
    display: block;
    font-size: var(--text-xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-text-heading);
    margin-bottom: 1rem;
  }

  .results-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
  }

  .result-item {
    background: #FFFFFF;
    padding: 0.85rem 1.15rem;
    border-radius: var(--radius-md);
    border: 1px solid rgba(124, 92, 232, 0.1);
    box-shadow: 0 2px 6px rgba(26, 8, 92, 0.03);
  }

  .result-metric {
    display: block;
    font-size: 1.35rem;
    font-weight: 800;
    color: var(--color-primary);
    line-height: 1.2;
    letter-spacing: -0.01em;
  }

  .result-label {
    display: block;
    font-size: 12px;
    font-weight: 500;
    color: var(--color-text-muted);
    margin-top: 2px;
  }

  .tech-stack-title {
    display: block;
    font-size: var(--text-xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-text-heading);
    margin-bottom: 0.75rem;
  }

  .tech-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .tech-chip {
    font-size: 12px;
    padding: 4px 10px;
    background: #FFFFFF;
    border: 1px solid rgba(124, 92, 232, 0.18);
    color: var(--color-text-heading);
    font-weight: 600;
  }

  .case-study-cta-row {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin-top: 0.5rem;
  }

  .btn-live-link {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    padding: 10px 18px;
    background: var(--brand-gradient);
    color: #FFFFFF;
    font-size: var(--text-sm);
    font-weight: 600;
    border-radius: var(--radius-full);
    text-decoration: none;
    box-shadow: 0 4px 14px rgba(124, 92, 232, 0.35);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .btn-live-link:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 18px rgba(124, 92, 232, 0.45);
    color: #FFFFFF;
  }

  .arrow-up-right {
    font-size: 1.1em;
    line-height: 1;
  }

  .client-confidential-pill {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    padding: 8px 14px;
    background: #EEEEF6;
    border-radius: var(--radius-full);
    font-size: 12px;
    font-weight: 600;
    color: var(--color-text-muted);
  }

  .btn-inquire-link {
    text-align: center;
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--color-primary);
    text-decoration: none;
    padding: 6px 0;
    transition: color 0.2s ease;
  }

  .btn-inquire-link:hover {
    color: var(--color-primary-hover);
    text-decoration: underline;
  }

  /* Standards Section */
  .standards-section {
    padding-top: clamp(2.5rem, 4vw, 3.5rem);
    padding-bottom: clamp(2.5rem, 4vw, 3.5rem);
  }

  .standards-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.15rem;
    margin-top: 2rem;
    margin-bottom: 2.25rem;
  }

  .standard-card {
    padding: 1.15rem 1.25rem;
    background: #FFFFFF;
    border-radius: var(--radius-xl, 16px);
    border: 1px solid var(--color-border-card, #E2E8F0);
    box-shadow: 0 2px 10px rgba(15, 23, 42, 0.04);
    display: flex;
    flex-direction: column;
    transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
  }

  .standard-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 22px -3px rgba(15, 23, 42, 0.08);
    border-color: #CBD5E1;
  }

  .standard-card-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 0.75rem;
    margin-bottom: 0.55rem;
  }

  .standard-title {
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--color-text-heading);
    margin: 0;
    line-height: 1.3;
    flex: 1;
  }

  .standard-step {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 0.85rem;
    font-weight: 800;
    color: var(--color-primary);
    background: rgba(124, 92, 232, 0.08);
    border: 1px solid rgba(124, 92, 232, 0.18);
    padding: 3px 8px;
    border-radius: 8px;
    line-height: 1;
    flex-shrink: 0;
    font-variant-numeric: tabular-nums;
  }

  .standard-desc {
    font-size: 0.82rem;
    line-height: 1.5;
    color: var(--color-text-body);
    margin: 0;
  }

  /* Trust Guarantee Box */
  .trust-guarantee-box {
    display: flex;
    align-items: center;
    justify-content: space-around;
    flex-wrap: wrap;
    gap: 1rem 1.75rem;
    padding: 1.15rem 1.75rem;
    background: linear-gradient(135deg, rgba(124, 92, 232, 0.05) 0%, rgba(87, 130, 224, 0.05) 100%);
    border: 1px dashed rgba(124, 92, 232, 0.35);
    border-radius: var(--radius-xl, 16px);
  }

  .trust-badge-item {
    display: flex;
    align-items: center;
    gap: 7px;
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--color-text-heading);
  }

  .trust-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 20px;
    height: 20px;
    border-radius: 50%;
    background: var(--color-primary);
    color: #FFFFFF;
    font-size: 11px;
    font-weight: 800;
    flex-shrink: 0;
  }

  /* Filter Hidden State */
  .is-filtered-out {
    display: none !important;
  }

  /* ==========================================================================
     Responsive Adjustments for Tablet and Mobile
     ========================================================================== */

  /* Tablet (768px - 1023px) */
  @media (max-width: 1023px) {
    .case-study-grid {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .outside-features-grid {
      grid-template-columns: 1fr;
      gap: 10px;
    }

    .showcase-modal-container {
      width: 96%;
      margin: 1.5rem auto;
    }

    .modal-screen-panel.active {
      grid-template-columns: 320px 1fr;
      gap: 1.75rem;
    }

    .arch-matrix-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .retrospective-grid {
      grid-template-columns: 1fr;
      gap: 1rem;
    }

    .dialog-deliv-grid {
      grid-template-columns: 1fr;
    }

    .tech-layers-grid {
      grid-template-columns: 1fr;
    }

    .case-study-sidebar {
      padding: 1.5rem;
    }

    .results-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 0.75rem;
    }

    .standards-grid {
