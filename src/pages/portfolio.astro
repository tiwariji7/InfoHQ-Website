    border: 1px solid var(--color-border-card);
    box-shadow: 0 6px 24px rgba(20, 10, 60, 0.08);
    background: #0B081F;
  }

  .cs-hero-banner-img {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  .cs-hero-banner-wrap:hover .cs-hero-banner-img {
    transform: scale(1.015);
  }

  .hero-image-overlay-bar {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: 1rem 1.5rem;
    background: linear-gradient(180deg, rgba(11, 8, 31, 0) 0%, rgba(11, 8, 31, 0.88) 100%);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .hero-overlay-tag {
    font-size: var(--text-xs);
    font-weight: 700;
    color: #FFFFFF;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    text-shadow: 0 1px 4px rgba(0, 0, 0, 0.6);
  }

  .hero-overlay-btn {
    background: rgba(255, 255, 255, 0.18);
    border: 1px solid rgba(255, 255, 255, 0.4);
    color: #FFFFFF;
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    font-size: 12px;
    font-weight: 700;
    padding: 6px 14px;
    border-radius: var(--radius-full);
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .hero-overlay-btn:hover {
    background: #FFFFFF;
    color: var(--color-text-heading);
    border-color: #FFFFFF;
  }

  /* 4 Core Outside Capabilities */
  .outside-features-list {
    margin: 1.5rem 0 1.75rem;
  }

  .outside-features-title {
    display: block;
    font-size: var(--text-xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-text-muted);
    margin-bottom: 0.85rem;
  }

  .outside-features-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 12px 16px;
  }

  .outside-feat-item {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    font-size: 13px;
    line-height: 1.5;
    color: var(--color-text-body);
    background: #F9F8FD;
    padding: 10px 12px;
    border-radius: var(--radius-md);
    border: 1px solid var(--color-border-card);
  }

  .outside-feat-item strong {
    display: block;
    color: var(--color-text-heading);
    font-size: 13px;
    margin-bottom: 2px;
  }

  .outside-feat-item span {
    font-size: 12px;
    color: var(--color-text-muted);
  }

  .feat-bullet {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 18px;
    height: 18px;
    border-radius: 50%;
    background: rgba(16, 185, 129, 0.15);
    color: #059669;
    font-size: 11px;
    font-weight: 800;
    flex-shrink: 0;
    margin-top: 2px;
  }

  /* Teaser Callout Box */
  .showcase-teaser-box {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1rem 1.25rem;
    background: linear-gradient(135deg, rgba(124, 92, 232, 0.08) 0%, rgba(221, 73, 133, 0.06) 100%);
    border: 1px solid rgba(124, 92, 232, 0.2);
    border-radius: var(--radius-lg);
    margin-top: 1.5rem;
  }

  .teaser-icon-pulse {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: var(--brand-gradient);
    color: #FFFFFF;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 16px;
    font-weight: 800;
    flex-shrink: 0;
    box-shadow: 0 4px 12px rgba(124, 92, 232, 0.3);
  }

  .teaser-copy {
    flex: 1;
    font-size: 12.5px;
    line-height: 1.45;
    color: var(--color-text-heading);
  }

  .teaser-copy strong {
    display: block;
    font-size: 13px;
    color: var(--color-primary);
    margin-bottom: 2px;
  }

  .btn-teaser-action {
    background: #FFFFFF;
    border: 1px solid rgba(124, 92, 232, 0.3);
    color: var(--color-primary);
    font-size: 12px;
    font-weight: 700;
    padding: 6px 14px;
    border-radius: var(--radius-full);
    cursor: pointer;
    white-space: nowrap;
    transition: all 0.2s ease;
    box-shadow: 0 2px 6px rgba(124, 92, 232, 0.08);
  }

  .btn-teaser-action:hover {
    background: var(--color-primary);
    color: #FFFFFF;
    border-color: var(--color-primary);
  }

  /* Primary Action Button (Triggers Modal) */
  .btn-primary-showcase {
    width: 100%;
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px 18px;
    background: var(--brand-gradient);
    color: #FFFFFF;
    border: none;
    border-radius: var(--radius-xl);
    cursor: pointer;
    box-shadow: 0 6px 20px rgba(124, 92, 232, 0.35);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
    text-align: left;
  }

  .btn-primary-showcase:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 26px rgba(124, 92, 232, 0.45);
  }

  .btn-sparkle {
    font-size: 1.4rem;
    line-height: 1;
    flex-shrink: 0;
  }

  .btn-title-wrap {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .btn-main-label {
    font-size: var(--text-sm);
    font-weight: 800;
    line-height: 1.2;
    letter-spacing: 0.01em;
  }

  .btn-sub-label {
    font-size: 11px;
    font-weight: 500;
    opacity: 0.9;
    letter-spacing: 0.02em;
  }

  /* ==========================================================================
     Internal Product Showcase Modal / Dialog
     ========================================================================== */
  .showcase-modal-overlay {
    position: fixed;
    inset: 0;
    z-index: 99999;
    overflow-y: auto;
    overflow-x: hidden;
    -webkit-overflow-scrolling: touch;
    overscroll-behavior: contain;
    display: flex;
    align-items: flex-start;
    justify-content: center;
    padding: clamp(1rem, 2.5vw, 2.5rem);
    background: rgba(10, 6, 30, 0.85);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    opacity: 1;
    transition: opacity 0.25s ease;
  }

  .showcase-modal-overlay::-webkit-scrollbar {
    width: 10px;
  }

  .showcase-modal-overlay::-webkit-scrollbar-track {
    background: rgba(10, 6, 30, 0.88);
  }

  .showcase-modal-overlay::-webkit-scrollbar-thumb {
    background: rgba(124, 92, 232, 0.5);
    border-radius: 6px;
    border: 2px solid rgba(10, 6, 30, 0.88);
  }

  .showcase-modal-overlay::-webkit-scrollbar-thumb:hover {
    background: var(--color-primary);
  }

  .showcase-modal-overlay[hidden] {
    display: none !important;
  }

  .showcase-modal-container {
    position: relative;
    z-index: 2;
    width: 100%;
    max-width: 1240px;
    margin: 2rem auto;
    background: #FFFFFF;
    border-radius: 24px;
    box-shadow: 0 35px 90px rgba(8, 4, 30, 0.55);
    border: 1px solid rgba(124, 92, 232, 0.25);
    display: flex;
    flex-direction: column;
    animation: modalPop 0.3s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  @keyframes modalPop {
    from {
      opacity: 0;
      transform: scale(0.96) translateY(16px);
    }
    to {
      opacity: 1;
      transform: scale(1) translateY(0);
    }
  }

  /* Modal Sticky Header - Pinned at top while scrolling */
  .showcase-modal-header {
    position: sticky;
    top: 0;
    z-index: 30;
    background: rgba(255, 255, 255, 0.98);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--color-border-card);
    padding: 1.15rem clamp(1.25rem, 2.5vw, 2.25rem);
    border-radius: 24px 24px 0 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.25rem;
    flex-wrap: wrap;
    box-shadow: 0 4px 16px rgba(10, 6, 30, 0.05);
  }

  .showcase-header-left {
    display: flex;
    flex-direction: column;
    gap: 4px;
    max-width: 780px;
  }

  .showcase-header-meta {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
  }

  .modal-badge-status {
    font-size: 11px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-primary);
    background: rgba(124, 92, 232, 0.1);
    padding: 3px 10px;
    border-radius: var(--radius-full);
  }

  .modal-badge-tech {
    font-size: 11px;
    font-weight: 600;
    color: var(--color-text-muted);
  }

  .showcase-modal-headline {
    font-size: clamp(1.15rem, 1.8vw, 1.45rem);
    font-weight: 800;
    color: var(--color-text-heading);
    margin: 0;
    line-height: 1.25;
  }

  .showcase-header-actions {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .btn-modal-inquire {
    font-size: var(--text-xs);
    font-weight: 700;
    color: var(--color-primary);
    background: rgba(124, 92, 232, 0.08);
    border: 1px solid rgba(124, 92, 232, 0.25);
    padding: 8px 16px;
    border-radius: var(--radius-full);
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .btn-modal-inquire:hover {
    background: var(--color-primary);
    color: #FFFFFF;
    border-color: var(--color-primary);
  }

  .btn-close-modal {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: #F3F2FA;
    border: 1px solid var(--color-border-card);
    padding: 7px 14px;
    border-radius: var(--radius-full);
    color: var(--color-text-heading);
    font-size: 12px;
    font-weight: 700;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .btn-close-modal:hover {
    background: #E8E5F7;
    color: var(--color-primary);
    border-color: var(--color-primary);
  }

  .close-symbol {
    font-size: 1.25rem;
    line-height: 1;
  }

  /* Modal Content Body */
  .showcase-modal-body {
    flex: 1;
    padding: clamp(1.5rem, 3vw, 2.5rem);
    display: flex;
    flex-direction: column;
    gap: 3rem;
  }

  .showcase-dialog-section {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .dialog-section-header {
    margin-bottom: 0.25rem;
  }

  .dialog-section-title {
    font-size: clamp(1.35rem, 2vw, 1.75rem);
    font-weight: 800;
    color: var(--color-text-heading);
    margin: 4px 0 6px;
    letter-spacing: -0.01em;
  }

  .dialog-section-desc {
    font-size: var(--text-sm);
    line-height: 1.6;
    color: var(--color-text-body);
    max-width: 820px;
    margin: 0;
  }

  /* Screen Tabs Bar */
  .modal-screen-tabs-bar {
    display: flex;
    align-items: center;
    gap: 8px;
    overflow-x: auto;
    padding: 4px 2px 10px;
    -webkit-overflow-scrolling: touch;
    border-bottom: 1px solid var(--color-border-card);
  }

  .modal-tab-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 16px;
    background: #FFFFFF;
    border: 1px solid rgba(124, 92, 232, 0.2);
    border-radius: var(--radius-full);
    font-size: 12.5px;
    font-weight: 700;
    color: var(--color-text-body);
    cursor: pointer;
    white-space: nowrap;
    transition: all 0.2s ease;
  }

  .modal-tab-btn:hover {
    color: var(--color-primary);
    border-color: var(--color-primary);
    background: rgba(124, 92, 232, 0.05);
  }

  .modal-tab-btn.active {
    background: var(--brand-gradient);
    color: #FFFFFF;
    border-color: transparent;
    box-shadow: 0 4px 12px rgba(124, 92, 232, 0.35);
  }

  .modal-tab-num {
    font-size: 11px;
    opacity: 0.85;
    font-weight: 800;
  }

  /* Screen Stage (Split View) */
  .modal-screen-stage {
    min-height: 480px;
    position: relative;
  }

  .modal-screen-panel {
    display: none;
    grid-template-columns: 380px 1fr;
    gap: clamp(1.75rem, 3vw, 2.75rem);
    align-items: start;
  }

  .modal-screen-panel.active {
    display: grid;
    animation: fadeInPane 0.25s ease forwards;
  }

  /* Phone Mockup Frame */
  .device-mockup-col {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
  }

  .device-mockup-frame {
    width: 100%;
    max-width: 360px;
    background: #0B081F;
    border-radius: 38px;
    padding: 12px;
    border: 3px solid #231E3D;
    box-shadow: 0 20px 50px rgba(12, 6, 40, 0.22);
    position: relative;
    overflow: hidden;
  }

  .device-speaker-notch {
    width: 80px;
    height: 5px;
    background: #252042;
    border-radius: var(--radius-full);
    margin: 4px auto 10px;
  }

  .device-screen-img {
    width: 100%;
    height: auto;
    aspect-ratio: 1100 / 733;
    display: block;
    border-radius: 26px;
    object-fit: contain;
    max-height: 540px;
    transition: transform 0.3s ease;
  }

  .device-mockup-frame:hover .device-screen-img {
    transform: scale(1.02);
  }

  .device-caption-pill {
    font-size: 11px;
    font-weight: 700;
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  /* Device Specs Column (Right) */
  .device-specs-col {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: 0.5rem 0;
  }

  .screen-meta-badge {
    align-self: flex-start;
    font-size: 11px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-primary);
    background: rgba(124, 92, 232, 0.1);
    padding: 4px 12px;
    border-radius: var(--radius-full);
  }

  .device-spec-headline {
    font-size: clamp(1.3rem, 2vw, 1.65rem);
    font-weight: 800;
    color: var(--color-text-heading);
    margin: 0;
    line-height: 1.3;
  }

  .device-spec-summary {
    font-size: var(--text-sm);
    line-height: 1.65;
    color: var(--color-text-body);
    margin: 0;
  }

  .spec-under-hood-card {
    background: #F8F7FD;
    border: 1px solid var(--color-border-card);
    border-radius: var(--radius-lg);
    padding: 1.25rem;
    margin-top: 0.5rem;
  }

  .under-hood-title {
    font-size: 12.5px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-primary);
    margin: 0 0 0.75rem;
  }

  .under-hood-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 9px;
  }

  .under-hood-list li {
    display: flex;
    align-items: baseline;
    gap: 10px;
    font-size: 12.5px;
    line-height: 1.55;
    color: var(--color-text-body);
  }

  .tech-bullet {
    color: var(--color-primary);
    font-size: 14px;
    font-weight: 800;
    flex-shrink: 0;
  }

  .screen-caps-wrap {
    margin-top: 0.5rem;
  }

  .caps-label {
    display: block;
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-text-muted);
    margin-bottom: 0.5rem;
  }

  .caps-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .cap-pill {
    font-size: 11.5px;
    font-weight: 600;
    color: var(--color-text-heading);
    background: #FFFFFF;
    border: 1px solid rgba(124, 92, 232, 0.2);
    padding: 3px 10px;
    border-radius: var(--radius-full);
  }

  /* Full-Stack Architecture Matrix */
  .arch-matrix-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 14px;
  }

  .arch-matrix-card {
    background: #F8F8FC;
    border: 1px solid var(--color-border-card);
    border-radius: var(--radius-lg);
    padding: 1.15rem;
    transition: transform 0.2s ease, border-color 0.2s ease;
  }

  .arch-matrix-card:hover {
    transform: translateY(-2px);
    border-color: rgba(124, 92, 232, 0.35);
  }

  .arch-matrix-top {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 6px;
  }

  .arch-idx {
    font-size: 11px;
    font-weight: 800;
    color: #FFFFFF;
    background: var(--brand-gradient);
    width: 24px;
    height: 24px;
    border-radius: 50%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .arch-name {
    font-size: 13px;
    font-weight: 800;
    color: var(--color-text-heading);
  }

  .arch-desc {
    font-size: 12px;
    line-height: 1.5;
    color: var(--color-text-body);
    margin: 0;
  }

  /* Engineering Retrospective */
  .retrospective-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.25rem;
  }

  .retro-card {
    padding: 1.25rem;
    border-radius: var(--radius-lg);
    font-size: var(--text-sm);
    line-height: 1.6;
  }

  .retro-challenge {
    background: #FFF7F5;
    border-left: 3px solid var(--color-grad-coral);
    color: #5C2A24;
  }

  .retro-approach {
    background: #F6F4FF;
    border-left: 3px solid var(--color-primary);
    color: #2D1A63;
  }

  .retro-solution {
    background: #ECFDF5;
    border-left: 3px solid #10B981;
    color: #064E3B;
  }

  .retro-badge {
    font-size: 11px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 8px;
  }

  .tag-challenge {
    color: var(--color-grad-coral);
  }

  .tag-approach {
    color: var(--color-primary);
  }

  .tag-solution {
    color: #059669;
  }

  .dialog-deliverables-box {
    background: #FFFFFF;
    border: 1px solid var(--color-border-card);
    border-radius: var(--radius-xl);
    padding: 1.5rem;
    margin-top: 0.5rem;
  }

  .dialog-deliv-title {
    font-size: var(--text-sm);
    font-weight: 800;
    color: var(--color-text-heading);
    margin: 0 0 1rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .dialog-deliv-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 10px 20px;
  }

  .dialog-deliv-item {
    display: flex;
    align-items: baseline;
    gap: 10px;
    font-size: 12.5px;
    color: var(--color-text-body);
    line-height: 1.5;
  }

  .deliv-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 17px;
    height: 17px;
    border-radius: 50%;
    background: rgba(16, 185, 129, 0.15);
    color: #059669;
    font-size: 10px;
    font-weight: 800;
    flex-shrink: 0;
  }

  .dialog-impact-banner {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    background: linear-gradient(135deg, rgba(124, 92, 232, 0.08) 0%, rgba(87, 130, 224, 0.08) 100%);
    border: 1px solid rgba(124, 92, 232, 0.25);
    border-radius: var(--radius-xl);
    padding: 1.25rem 1.5rem;
  }

  .impact-icon-col {
    font-size: 2rem;
    line-height: 1;
    flex-shrink: 0;
  }

  .impact-text-col {
    flex: 1;
  }

  .impact-banner-tag {
    display: block;
    font-size: 11px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-primary);
    margin-bottom: 4px;
  }

  .impact-text-col p {
    font-size: var(--text-sm);
    line-height: 1.55;
    color: var(--color-text-heading);
    margin: 0;
    font-weight: 500;
  }

  /* In-Modal FinalCTA Styling */
  .modal-cta-wrapper {
    margin-top: 1rem;
  }

  .modal-cta-wrapper .final-cta-section {
    padding: 1rem 0 0.5rem;
    background: transparent;
  }

  .modal-cta-wrapper .container {
    padding: 0;
    max-width: 100%;
  }

  .modal-cta-wrapper .cta-banner {
    border-radius: var(--radius-2xl);
  }

  .case-study-subsummary {
    font-size: var(--text-sm);
    line-height: 1.6;
    color: var(--color-text-muted);
    margin-top: -1rem;
    margin-bottom: 1.5rem;
  }

  .tech-layers-wrap {
    margin: 1.75rem 0;
  }

  .tech-layers-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 10px;
    margin-top: 0.75rem;
  }

  .tech-layer-card {
    background: #F8F8FC;
    border: 1px solid var(--color-border-card);
    border-radius: var(--radius-md);
    padding: 10px 14px;
  }

  .layer-title {
    display: block;
    font-size: 12.5px;
    font-weight: 700;
    color: var(--color-primary);
    margin-bottom: 3px;
  }

  .layer-detail {
    display: block;
    font-size: 12px;
    color: var(--color-text-body);
    line-height: 1.45;
