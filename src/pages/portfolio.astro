---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import FinalCTA from '../components/FinalCTA.astro';

const meta = {
  title: 'Portfolio & Case Studies — Shipped Projects & Real Results | InfoHQ',
  description: 'Explore InfoHQ\'s portfolio of production-grade web platforms, enterprise AI systems, mobile applications, and business automation. Shipped with 100% IP ownership.',
  keywords: 'software engineering portfolio, AI case studies India, web development portfolio Pune, mobile app development case studies, InfoHQ work samples, software proof of work'
};

// Filter categories
const categories = [
  { id: 'all', label: 'All Projects' },
  { id: 'web', label: 'Web Platforms' },
  { id: 'ai', label: 'AI & Intelligent Systems' },
  { id: 'mobile', label: 'Mobile Apps' },
  { id: 'automation', label: 'SaaS & Automation' }
];

// Flagship Case Studies
const flagshipCaseStudies = [
  {
    id: 'sehat',
    category: 'mobile ai',
    hasShowcase: true,
    badge: 'Internal Product • Active Build',
    badgeType: 'ai',
    client: 'Internal Product',
    engagement: 'Product Development',
    industry: 'Healthcare / AI',
    platform: 'Android + AI Backend',
    title: 'SeHAT SmartCare AI — AI-Powered Health Assistance Platform',
    summary: 'SeHAT SmartCare AI is an intelligent Android healthcare assistance platform designed to make health information easier to understand and access. The system combines Artificial Intelligence, Medical Language Models, RAG, semantic search, OCR, and cloud services to provide preliminary health assistance through a mobile application.',
    subSummary: 'The platform allows users to check symptoms, analyze medical reports, ask health-related questions, receive health insights, set medicine reminders, and access an emergency SOS workflow.',
    heroImage: '/projects_images/SeHAT_SmartCare/SeHAT_Hero.webp',
    screenshots: [
      {
        id: 'screen-dashboard',
        tabLabel: '💬 Home & Chatbot',
        title: 'Home Dashboard & Multilingual AI Medical Chatbot',
        workflowRole: 'Central Clinical Hub & Trilingual RAG Interaction',
        caption: 'Central navigation dashboard with instant access to 6 core health workflows, voice input integration, and an interactive RAG-powered clinical chatbot capable of responding in English, Hindi, and Hinglish with verified citations.',
        underTheHood: [
          'Microphone input captured via Android SpeechRecognizer and normalized into clean text queries in English, Hindi, or conversational Hinglish.',
          'FastAPI async backend generates embeddings using SentenceTransformers and executes cosine similarity retrieval against a FAISS vector index of verified clinical literature in <450ms.',
          'Context-grounded medical LLM generates answers constrained by clinical safety guardrails, citing sources and appending standard medical disclaimers.'
        ],
        keyCapabilities: [
          'Direct access to 6 clinical modules',
          'Trilingual speech-to-text input',
          'RAG citations & safety disclaimers',
          'Instant quick-query prompt chips'
        ],
        src: '/projects_images/SeHAT_SmartCare/homedashboard&aimeicalchatbot.webp'
      },
      {
        id: 'screen-checker-ocr',
        tabLabel: '🔬 Symptom & Report OCR',
        title: 'AI Symptom Checker & Medical Report Analyzer',
        workflowRole: 'Differential Clinical Assessment & Vision OCR Document Parsing',
        caption: 'Ranked differential symptom analysis with clinical matching (High, Moderate, Low Match), paired with a document OCR pipeline processing camera photos and PDFs of blood tests (CBC, Glucose, Platelets, Creatinine) into plain-language summaries.',
        underTheHood: [
          'Differential engine evaluates multi-symptom inputs against an indexed clinical association graph to produce probabilistic tiers: High, Moderate, and Low Match.',
          'CameraX captures test documents or user uploads PDFs, passing image buffers to an OCR extraction pipeline that isolates clinical test tokens and numerical values.',
          'Parsers normalize extracted values against standard biological reference intervals (e.g. Platelets: 150,000–450,000 /mcL), generating plain-language explanations of abnormal ranges.'
        ],
        keyCapabilities: [
          'Multi-symptom differential matcher',
          'Camera & PDF lab report OCR',
          'Reference-interval anomaly detection',
          'Jargon-free medical explanation'
        ],
        src: '/projects_images/SeHAT_SmartCare/AISymptomChecker&MedicalReportAnalyzer.webp'
      },
      {
        id: 'screen-insights-reminders',
        tabLabel: '💊 Insights & Reminders',
        title: 'Holistic Health Insights & Smart Medicine Reminders',
        workflowRole: '0–100 Daily Health Score & High-Precision Medication Scheduling',
        caption: 'Daily wellness assessment algorithm calculating a 0–100 health score with hydration and step counters, alongside a scheduled medication tracker with time-stamped dosage status and 92% weekly adherence monitoring.',
        underTheHood: [
          'Holistic health scoring algorithm computes a daily composite score (0–100) based on self-reported hydration, physical step counter integration, sleep hours, and symptom volatility.',
          'Medication alert scheduler utilizes Android AlarmManager with RTC_WAKEUP and WorkManager fallback to guarantee high-reliability alerts even under aggressive battery Doze modes.',
          'Local SQLite persistence tracks taken, snoozed, and missed doses, calculating rolling 7-day adherence rates and syncing records with Cloud Firestore.'
        ],
        keyCapabilities: [
          'Dynamic 0–100 daily wellness score',
          'Doze-resistant AlarmManager scheduling',
          '7-day adherence compliance metrics',
          'Offline-first local cache synchronization'
        ],
        src: '/projects_images/SeHAT_SmartCare/HealthInsights&MedicineReminders.webp'
      },
      {
        id: 'screen-sos-tips',
        tabLabel: '🚨 Emergency SOS & Tips',
        title: 'Instant Emergency SOS & Wellness Knowledge Feed',
        workflowRole: 'One-Tap Emergency Live GPS Dispatch & Offline Preventative Care',
        caption: 'One-tap critical SOS workflow dispatching live GPS coordinates to family contacts via SMS and WhatsApp, quick-dial 112 emergency integration, and an expert-curated lifestyle and preventative care knowledge feed.',
        underTheHood: [
          'SOS workflow requests high-priority satellite & network location fixes using Android FusedLocationProviderClient, assembling an actionable Google Maps coordinates link.',
          'Direct telephony and messaging intents automate dispatch of emergency SMS and WhatsApp notifications to pre-configured trusted emergency contacts in a single user tap.',
          'Direct-dial intent triggers emergency call to 112 without intermediate confirmation screens.',
          'Preventative care articles and lifestyle advisories are pre-cached in an offline database, allowing complete offline reading during remote travel.'
        ],
        keyCapabilities: [
          'One-tap live GPS emergency broadcast',
          'Automated SMS & WhatsApp dispatch',
          'Instant 112 emergency dialer intent',
          'Offline-cached preventative health feed'
        ],
        src: '/projects_images/SeHAT_SmartCare/HealthTips&EmergencySOS.webp'
      },
      {
        id: 'screen-auth',
        tabLabel: '🔐 Login & Security',
        title: 'Authentication & Profile Security',
        workflowRole: 'Zero-Trust Identity, Token Encryption & Isolated Clinical Profiles',
        caption: 'Secure Firebase Authentication supporting phone number verification, email/password credentials, and Google OAuth with encrypted session token handling.',
        underTheHood: [
          'Multi-provider authentication powered by Firebase Auth: Phone SMS OTP, Google OAuth credential exchange, and email/password authentication.',
          'Android Keystore-backed EncryptedSharedPreferences stores JWT session tokens and user state with AES-256 GCM encryption on the client device.',
          'Cloud Firestore security rules enforce strict per-UID authorization barriers, ensuring patient medical records and reports remain inaccessible to other users.'
        ],
        keyCapabilities: [
          'Phone SMS OTP & Google OAuth sign-in',
          'On-device AES-256 token encryption',
          'Cloud Firestore zero-trust security rules',
          'Personalized health record isolation'
        ],
        src: '/projects_images/SeHAT_SmartCare/login&signup.webp'
      }
    ],
    challenge: 'Medical reports and health information can be difficult for non-medical users to understand, especially when information is presented using complex medical terminology, clinical abbreviations, and reference ranges. In addition, language barriers and fragmented apps make it cumbersome for everyday families to get quick preliminary health guidance.',
    approach: 'We designed a mobile-first healthcare platform that combines a native Android application with a Python/FastAPI AI backend, FAISS-based medical knowledge retrieval, OCR processing, and a Medical LLM. We focused on natural human interaction: building trilingual support for English, Hindi, and conversational Hinglish, complete with voice-based input so users can simply speak their symptoms.',
    solution: 'The final system provides multiple AI-assisted healthcare workflows through a single mobile application, backed by FAISS vector search, camera/PDF report interpretation, local caching for offline resilience, and Firebase cloud sync.',
    techLayers: [
      { layer: 'Android Application', detail: 'Native Kotlin & Java client with CameraX, Audio Record, and Material 3 design' },
      { layer: 'AI Microservice Backend', detail: 'Python 3.11 with FastAPI asynchronous REST endpoints' },
      { layer: 'RAG Pipeline & FAISS', detail: 'FAISS vector index + SentenceTransformers embeddings for semantic search' },
      { layer: 'Medical LLM & Hugging Face', detail: 'Context-grounded medical inference and report simplification' },
      { layer: 'Medical OCR Engine', detail: 'Vision processing parsing lab test names, results, and reference ranges' },
      { layer: 'Cloud & Auth', detail: 'Firebase Authentication, Cloud Firestore, and real-time alerts' }
    ],
    keyFeatures: [
      'AI-assisted symptom analysis with ranked differential matches and safety disclaimers',
      'Medical report OCR and interpretation workflow for lab tests and prescriptions',
      'RAG-based medical chatbot grounded in verified clinical knowledge bases',
      'Semantic medical knowledge retrieval using FAISS vector indexing',
      'Trilingual interaction: English, Hindi, and colloquial Hinglish',
      'Voice-based input support for hands-free queries',
      'Cloud-backed user profile and medical report management',
      'Medicine reminder functionality with scheduled adherence tracking',
      'Health insights and wellness guidance with 0–100 daily score',
      'Emergency SOS assistance workflow with one-tap live GPS dispatch via SMS & WhatsApp'
    ],
    results: [
      { metric: '10+ Workflows', label: 'Brought Into One Mobile Platform' },
      { metric: '3 Languages', label: 'English, Hindi & Hinglish with Voice Input' },
      { metric: '< 450ms', label: 'FAISS Semantic Knowledge Search Latency' }
    ],
    techStack: [
      'Android',
      'Kotlin/Java',
      'Python',
      'FastAPI',
      'Medical LLM',
      'RAG',
      'FAISS',
      'SentenceTransformers',
      'OCR',
      'Firebase',
      'Hugging Face'
    ],
    impact: 'The project demonstrates how modern AI technologies can be combined with mobile development to make complex health information more accessible, transparent, and easier to understand for everyday families.',
    liveUrl: null,
    urlLabel: 'Internal Product Showcase'
  },
  {
    id: 'alpha-studio-tech',
    category: 'web',
    badge: 'Delivered • Live in Production',
    badgeType: 'live',
    client: 'Alpha Studio Tech',
    industry: 'Digital Media & Creative Production',
    title: 'High-Converting Digital Agency Web Platform with Sub-Second Page Speeds',
    summary: 'A bespoke modern web platform engineered from the ground up for a digital media production agency. Designed to replace a sluggish legacy site with high-performance responsive architecture, clean typography, and a streamlined client inquiry pipeline.',
    challenge: 'The client\'s previous site suffered from heavy page weights (>6MB), slow mobile load times (>4.2s), and poor conversion rates on commercial inquiry forms across mobile devices.',
    solution: 'InfoHQ engineered a lean, zero-bloat web architecture using modern semantic HTML, fine-tuned fluid typography, optimized responsive media, and Cloudflare edge delivery with instant asset caching.',
    keyFeatures: [
      'Sub-second First Contentful Paint (<1.1s worldwide)',
      'Fully responsive fluid grid with zero layout shift (CLS: 0.00)',
      'Automated inquiry validation with instant email notification webhooks',
      'High-DPI responsive graphics with modern WebP asset pipelines',
      '100% clean semantic markup with complete Schema.org structured data'
    ],
    results: [
      { metric: '98/100', label: 'Lighthouse Performance Score' },
      { metric: '2.4x', label: 'Increase in Qualified Client Leads' },
      { metric: '< 1.1s', label: 'Average Worldwide Load Time' }
    ],
    techStack: ['Astro', 'TypeScript', 'Cloudflare Pages', 'Vanilla CSS', 'Modern SVG'],
    liveUrl: 'https://alphastudiotech.online',
    urlLabel: 'alphastudiotech.online'
  },
  {
    id: 'cogniflow-ai',
    category: 'ai',
    badge: 'Enterprise Production • In-House',
    badgeType: 'ai',
    client: 'CogniFlow AI / Enterprise Deployments',
    industry: 'Enterprise Knowledge & Workflow Automation',
    title: 'Autonomous RAG & Multi-Modal Knowledge Search Intelligence Agent',
    summary: 'An autonomous document intelligence system that ingests enterprise documents, technical manuals, and SOPs to provide instant, hallucination-resistant answers with exact citation references.',
    challenge: 'Operations and customer support teams were spending hours manually sifting through hundreds of dense PDFs and manuals, resulting in delayed resolutions and inconsistent client support.',
    solution: 'Designed and deployed an enterprise RAG (Retrieval-Augmented Generation) pipeline with pgvector semantic vector search, intelligent semantic document chunking, prompt guarding, and sub-second contextual responses.',
    keyFeatures: [
      'Multi-format ingestion pipeline (PDF, DOCX, Markdown, Spreadsheets)',
      'Hybrid semantic vector search + keyword re-ranking for maximum accuracy',
      'Citation-backed responses with highlighted source page coordinates',
      'Autonomous fallback to human engineering queue when confidence is low',
      'End-to-end telemetry, token tracking, and latency monitoring'
    ],
    results: [
      { metric: '82%', label: 'Automated Inquiry Resolution Rate' },
      { metric: '< 380ms', label: 'Vector Search Query Latency' },
      { metric: '70%', label: 'Reduction in Support Ticket Backlog' }
    ],
    techStack: ['Python', 'FastAPI', 'LangChain', 'OpenAI / Claude', 'pgvector', 'Docker'],
    liveUrl: null,
    urlLabel: 'Enterprise Client Architecture'
  },
  {
    id: 'omniflow-b2b',
    category: 'automation',
    badge: 'Production Retainer Client',
    badgeType: 'automation',
    client: 'OmniFlow Distribution',
    industry: 'Supply Chain & B2B Distribution',
    title: 'Automated Multi-Channel B2B Order, Invoicing & WhatsApp Dispatch Pipeline',
    summary: 'A resilient digital backend and merchant portal that orchestrates ordering, payment reconciliation, inventory management, and automated WhatsApp delivery updates for a pan-India distribution network.',
    challenge: 'Manual order entry through spreadsheets was leading to delayed dispatches, inventory stockouts, billing mismatches, and endless customer phone calls regarding delivery status.',
    solution: 'Built an event-driven webhook automation pipeline connecting the retailer ordering portal, Razorpay subscription billing, warehouse inventory databases, and the Meta WhatsApp Business API.',
    keyFeatures: [
      'Automated order capture with instant digital GST-compliant invoice generation',
      'Real-time inventory synchronization preventing overselling across 3 regional depots',
      'Automated WhatsApp dispatch notifications with live delivery tracking links',
      'Direct Razorpay payment gateway integration with auto-reconciled ledger entries',
      'Executive analytics dashboard displaying sales volume and order velocity'
    ],
    results: [
      { metric: '₹1.8 Cr+', label: 'Monthly GMV Processed Automatically' },
      { metric: '45%', label: 'Faster Order-to-Dispatch Turnaround' },
      { metric: 'Zero', label: 'Stockout & Inventory Sync Errors' }
    ],
    techStack: ['Next.js', 'Node.js', 'PostgreSQL', 'Redis Queue', 'Razorpay API', 'WhatsApp API'],
    liveUrl: null,
    urlLabel: 'Confidential Client Pipeline'
  }
];

// Additional Work Samples / Proof of Work Cards
const workSamples = [
  {
