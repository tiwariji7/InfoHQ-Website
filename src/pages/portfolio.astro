// Delivery Standards
const deliveryStandards = [
  {
    step: '01',
    title: 'Architectural Blueprint & Scope',
    desc: 'We map your database schema, system interfaces, and technical roadmap before writing code — eliminating expensive pivots.'
  },
  {
