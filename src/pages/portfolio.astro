---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import FinalCTA from '../components/FinalCTA.astro';

const meta = {
  title: 'Portfolio & Case Studies | InfoHQ',
  description: 'Projects built by InfoHQ: an AI healthcare app, SeHAT SmartCare, and a client website, Alpha Studio Tech.',
  keywords: 'software engineering portfolio, AI case studies India, web development portfolio Pune, mobile app development case studies, SeHAT SmartCare AI, Alpha Studio Tech'
};

// Filter categories
const categories = [
  { id: 'all', label: 'All Projects' },
  { id: 'web', label: 'Web Platforms' },
  { id: 'ai', label: 'AI & Intelligent Systems' },
  { id: 'mobile', label: 'Mobile Apps' },
  { id: 'automation', label: 'SaaS & Automation' }
];

// Flagship Case Studies
const flagshipCaseStudies = [
  {
    id: 'sehat',
    category: 'mobile ai',
    hasShowcase: true,
    badge: 'Internal Product • Active Build',
    badgeType: 'ai',
    client: 'Internal Product',
    engagement: 'Product Development',
    industry: 'Healthcare / AI',
    platform: 'Android + AI Backend',
    title: 'SeHAT SmartCare AI — AI-Powered Health Assistance Platform',
    summary: 'SeHAT SmartCare AI is an intelligent Android healthcare assistance platform designed to make health information easier to understand and access. The system combines Artificial Intelligence, Medical Language Models, RAG, semantic search, OCR, and cloud services to provide preliminary health assistance through a mobile application.',
    subSummary: 'The platform allows users to check symptoms, analyze medical reports, ask health-related questions, receive health insights, set medicine reminders, and access an emergency SOS workflow.',
    heroImage: '/projects_images/SeHAT_SmartCare/SeHAT_Hero.webp',
    screenshots: [
      {
        id: 'screen-dashboard',
        tabLabel: '💬 Home & Chatbot',
        title: 'Home Dashboard & Multilingual AI Medical Chatbot',
        workflowRole: 'Central Clinical Hub & Trilingual RAG Interaction',
        caption: 'Central navigation dashboard with instant access to core health workflows, voice input integration, and an interactive RAG-powered clinical chatbot capable of responding in English, Hindi, and Hinglish with verified citations.',
        underTheHood: [
          'Microphone input captured via Android SpeechRecognizer and normalized into clean text queries in English, Hindi, or conversational Hinglish.',
          'FastAPI async backend generates embeddings using SentenceTransformers and executes cosine similarity retrieval against a FAISS vector index of verified clinical literature.',
          'Context-grounded medical LLM generates answers constrained by clinical safety guardrails, citing sources and appending standard medical disclaimers.'
        ],
        keyCapabilities: [
          'Direct access to clinical modules',
          'Trilingual speech-to-text input',
          'RAG citations & safety disclaimers',
          'Instant quick-query prompt chips'
        ],
        src: '/projects_images/SeHAT_SmartCare/homedashboard&aimeicalchatbot.webp'
      },
      {
        id: 'screen-checker-ocr',
        tabLabel: '🔬 Symptom & Report OCR',
        title: 'AI Symptom Checker & Medical Report Analyzer',
        workflowRole: 'Differential Clinical Assessment & Vision OCR Document Parsing',
        caption: 'Ranked differential symptom analysis with clinical matching (High, Moderate, Low Match), paired with a document OCR pipeline processing camera photos and PDFs of blood tests (CBC, Glucose, Platelets, Creatinine) into plain-language summaries.',
        underTheHood: [
          'Differential engine evaluates multi-symptom inputs against an indexed clinical association graph to produce probabilistic tiers: High, Moderate, and Low Match.',
          'CameraX captures test documents or user uploads PDFs, passing image buffers to an OCR extraction pipeline that isolates clinical test tokens and numerical values.',
          'Parsers normalize extracted values against standard biological reference intervals (e.g. Platelets: 150,000–450,000 /mcL), generating plain-language explanations of abnormal ranges.'
        ],
        keyCapabilities: [
          'Multi-symptom differential matcher',
          'Camera & PDF lab report OCR',
          'Reference-interval anomaly detection',
          'Jargon-free medical explanation'
        ],
        src: '/projects_images/SeHAT_SmartCare/AISymptomChecker&MedicalReportAnalyzer.webp'
      },
      {
        id: 'screen-insights-reminders',
        tabLabel: '💊 Insights & Reminders',
        title: 'Holistic Health Insights & Smart Medicine Reminders',
        workflowRole: '0–100 Daily Health Score & High-Precision Medication Scheduling',
        caption: 'Daily wellness assessment algorithm calculating a 0–100 health score with hydration and step counters, alongside a scheduled medication tracker with time-stamped dosage status and weekly adherence monitoring.',
        underTheHood: [
          'Holistic health scoring algorithm computes a daily composite score (0–100) based on self-reported hydration, physical step counter integration, sleep hours, and symptom volatility.',
          'Medication alert scheduler utilizes Android AlarmManager with RTC_WAKEUP and WorkManager fallback to guarantee high-reliability alerts even under aggressive battery Doze modes.',
          'Local SQLite persistence tracks taken, snoozed, and missed doses, calculating adherence rates and syncing records with Cloud Firestore.'
        ],
        keyCapabilities: [
          'Dynamic 0–100 daily wellness score',
          'Doze-resistant AlarmManager scheduling',
          'Adherence compliance tracking',
          'Offline-first local cache synchronization'
        ],
        src: '/projects_images/SeHAT_SmartCare/HealthInsights&MedicineReminders.webp'
      },
      {
        id: 'screen-sos-tips',
        tabLabel: '🚨 Emergency SOS & Tips',
        title: 'Instant Emergency SOS & Wellness Knowledge Feed',
        workflowRole: 'One-Tap Emergency Live GPS Dispatch & Offline Preventative Care',
        caption: 'One-tap critical SOS workflow dispatching live GPS coordinates to family contacts via SMS and WhatsApp, quick-dial 112 emergency integration, and an expert-curated lifestyle and preventative care knowledge feed.',
        underTheHood: [
          'SOS workflow requests high-priority satellite & network location fixes using Android FusedLocationProviderClient, assembling an actionable Google Maps coordinates link.',
          'Direct telephony and messaging intents automate dispatch of emergency SMS and WhatsApp notifications to pre-configured trusted emergency contacts in a single user tap.',
          'Direct-dial intent triggers emergency call to 112 without intermediate confirmation screens.',
          'Preventative care articles and lifestyle advisories are pre-cached in an offline database, allowing complete offline reading during remote travel.'
        ],
        keyCapabilities: [
          'One-tap live GPS emergency broadcast',
          'Automated SMS & WhatsApp dispatch',
          'Instant 112 emergency dialer intent',
          'Offline-cached preventative health feed'
        ],
        src: '/projects_images/SeHAT_SmartCare/HealthTips&EmergencySOS.webp'
      },
      {
        id: 'screen-auth',
        tabLabel: '🔐 Login & Security',
        title: 'Authentication & Profile Security',
        workflowRole: 'Zero-Trust Identity, Token Encryption & Isolated Clinical Profiles',
        caption: 'Secure Firebase Authentication supporting phone number verification, email/password credentials, and Google OAuth with encrypted session token handling.',
        underTheHood: [
          'Multi-provider authentication powered by Firebase Auth: Phone SMS OTP, Google OAuth credential exchange, and email/password authentication.',
          'Android Keystore-backed EncryptedSharedPreferences stores JWT session tokens and user state with AES-256 GCM encryption on the client device.',
          'Cloud Firestore security rules enforce strict per-UID authorization barriers, ensuring patient medical records and reports remain inaccessible to other users.'
        ],
        keyCapabilities: [
          'Phone SMS OTP & Google OAuth sign-in',
          'On-device AES-256 token encryption',
          'Cloud Firestore zero-trust security rules',
          'Personalized health record isolation'
        ],
        src: '/projects_images/SeHAT_SmartCare/login&signup.webp'
      }
    ],
    challenge: 'Medical reports and health information can be difficult for non-medical users to understand, especially when information is presented using complex medical terminology, clinical abbreviations, and reference ranges. In addition, language barriers and fragmented apps make it cumbersome for everyday families to get quick preliminary health guidance.',
    approach: 'We designed a mobile-first healthcare platform that combines a native Android application with a Python/FastAPI AI backend, FAISS-based medical knowledge retrieval, OCR processing, and a Medical LLM. We focused on natural human interaction: building trilingual support for English, Hindi, and conversational Hinglish, complete with voice-based input so users can simply speak their symptoms.',
    solution: 'The final system provides multiple AI-assisted healthcare workflows through a single mobile application, backed by FAISS vector search, camera/PDF report interpretation, local caching for offline resilience, and Firebase cloud sync.',
    techLayers: [
      { layer: 'Android Application', detail: 'Native Kotlin & Java client with CameraX, Audio Record, and Material 3 design' },
      { layer: 'AI Microservice Backend', detail: 'Python 3.11 with FastAPI asynchronous REST endpoints' },
      { layer: 'RAG Pipeline & FAISS', detail: 'FAISS vector index + SentenceTransformers embeddings for semantic search' },
      { layer: 'Medical LLM & Hugging Face', detail: 'Context-grounded medical inference and report simplification' },
      { layer: 'Medical OCR Engine', detail: 'Vision processing parsing lab test names, results, and reference ranges' },
      { layer: 'Cloud & Auth', detail: 'Firebase Authentication, Cloud Firestore, and real-time alerts' }
    ],
    keyFeatures: [
      'AI-assisted symptom analysis with ranked differential matches and safety disclaimers',
      'Medical report OCR and interpretation workflow for lab tests and prescriptions',
      'RAG-based medical chatbot grounded in verified clinical knowledge bases',
      'Semantic medical knowledge retrieval using FAISS vector indexing',
      'Trilingual interaction: English, Hindi, and colloquial Hinglish',
      'Voice-based input support for hands-free queries',
      'Cloud-backed user profile and medical report management',
      'Medicine reminder functionality with scheduled adherence tracking',
      'Health insights and wellness guidance with 0–100 daily score',
      'Emergency SOS assistance workflow with one-tap live GPS dispatch via SMS & WhatsApp'
    ],
    results: [
      { metric: '10 Workflows', label: 'Brought Into One Mobile Platform' },
      { metric: '3 Languages', label: 'English, Hindi & Hinglish with Voice Input' }
    ],
    techStack: [
      'Android',
      'Kotlin/Java',
      'Python',
      'FastAPI',
      'Medical LLM',
      'RAG',
      'FAISS',
      'SentenceTransformers',
      'OCR',
      'Firebase',
      'Hugging Face'
    ],
    impact: 'The project demonstrates how modern AI technologies can be combined with mobile development to make complex health information more accessible, transparent, and easier to understand for everyday families.',
    liveUrl: null,
    urlLabel: 'Internal Product Showcase'
  },
  {
    id: 'alpha-studio-tech',
    category: 'web',
    badge: 'Delivered • Live in Production',
    badgeType: 'live',
    client: 'Alpha Studio Tech',
    industry: 'Digital Media & Creative Production',
    title: 'Alpha Studio Tech — Client Website',
    summary: 'A client website built by InfoHQ.',
    techStack: ['Astro', 'TypeScript', 'Cloudflare Pages', 'Vanilla CSS', 'Modern SVG'],
    liveUrl: 'https://alphastudiotech.online',
    urlLabel: 'alphastudiotech.online'
  }
];

// Flagship Showcase Reference for Modal
const sehat = flagshipCaseStudies.find(c => c.id === 'sehat') || flagshipCaseStudies[0];

// Delivery Standards
const deliveryStandards = [
  {
    step: '01',
    title: 'Architectural Blueprint & Scope',
    desc: 'We map your database schema, system interfaces, and technical roadmap before writing code — eliminating expensive pivots.'
  },
  {
    step: '02',
    title: 'Milestone Sprints & Live Previews',
    desc: 'Continuous staging deployments let you click, test, and provide feedback on real builds every week, not months later.'
  },
  {
    step: '03',
    title: 'Security, Speed & QA Auditing',
    desc: 'Every endpoint and screen is tested for OWASP security, fluid mobile responsiveness, sub-second latency, and accessibility.'
  },
  {
    step: '04',
    title: '100% IP Handover & Retainer Care',
    desc: 'Clean code is committed straight into your GitHub repository with documentation. Optional retainers ensure ongoing improvements.'
  }
];

---

<BaseLayout
  title={meta.title}
  description={meta.description}
  keywords={meta.keywords}
  schemaType="portfolio"
>
  <!-- 1. Hero Section -->
  <section class="section portfolio-hero" aria-labelledby="portfolio-heading">
    <div class="container text-center">
      <h1 id="portfolio-heading" class="portfolio-headline">
        Systems We've Built. <span class="text-gradient">Results We've Shipped.</span>
      </h1>

      <p class="portfolio-subheadline">
        Explore InfoHQ's track record of high-performance web platforms, enterprise AI systems, mobile applications, and automated workflows. Engineered with production discipline, zero templates, and 100% client code ownership.
      </p>

      <!-- Category Filter Tabs -->
      <div class="filter-controls-wrap" role="region" aria-label="Project Category Filter">
        <div class="filter-tabs" role="tablist">
          {categories.map((cat, idx) => (
            <button
              type="button"
              class={`filter-tab-btn ${idx === 0 ? 'active' : ''}`}
              role="tab"
              aria-selected={idx === 0 ? 'true' : 'false'}
              data-filter={cat.id}
              id={`filter-tab-${cat.id}`}
            >
              {cat.label}
            </button>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- 2. Flagship Case Studies Section -->
  <section class="section section-alt case-studies-section" aria-labelledby="case-studies-heading">
    <div class="container">
      <div class="section-header">
        <h2 id="case-studies-heading">Production <span class="text-gradient">Case Studies &amp; Projects</span></h2>
        <p>Real digital systems engineered with production stability, zero templates, and 100% client code ownership.</p>
      </div>

      <!-- Compact 3-Column Portfolio Cards Grid (Matching Home Page Style) -->
      <div class="portfolio-cards-grid">
        <!-- 1. Alpha Studio Tech -->
        <article class="card portfolio-card case-study-card" data-category="web" id="alpha-studio-tech">
          <div class="card-top-bar">
            <div class="portfolio-badge live">
              <span class="badge-dot"></span>
              <span>CLIENT PROJECT &bull; DELIVERED</span>
            </div>
            <a href="https://alphastudiotech.online" target="_blank" rel="noopener noreferrer" class="card-ext-btn" aria-label="Open Alpha Studio Tech in new tab" title="Open live website">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
                <polyline points="15 3 21 3 21 9"></polyline>
                <line x1="10" y1="14" x2="21" y2="3"></line>
              </svg>
            </a>
          </div>

          <div class="card-preview-media preview-alpha">
            <img src="/projects_images/alpha-studio-mockup.jpg" alt="Alpha Studio Tech client website mockup" class="preview-img" loading="lazy" />
          </div>

          <h3 class="card-project-title">Alpha Studio Tech &mdash; Client Website</h3>
          <p class="card-project-desc">
            A high-performance modern digital agency website engineered for Alpha Studio Tech, with sub-second page loads, SEO optimization, and responsive design.
          </p>

          <div class="card-tags">
            <span class="chip-tag chip-blue">Web Development</span>
            <span class="chip-tag chip-purple">UI/UX</span>
            <span class="chip-tag chip-orange">SEO</span>
            <span class="chip-tag chip-green">Cloudflare Pages</span>
          </div>

          <div class="portfolio-card-actions">
            <a href="https://alphastudiotech.online" target="_blank" rel="noopener noreferrer" class="btn-card-live">
              <span>Visit Live Website</span>
              <span class="arrow-icon">&nearr;</span>
            </a>
            <a href="/contact" class="btn-card-case-study">
              <span>Inquire Similar Build</span>
              <span class="arrow-icon">&rarr;</span>
            </a>
          </div>
        </article>

        <!-- 2. SeHAT SmartCare AI -->
        <article class="card portfolio-card case-study-card" data-category="mobile ai" id="sehat">
          <div class="card-top-bar">
            <div class="portfolio-badge live">
              <span class="badge-dot"></span>
              <span>INTERNAL PRODUCT &bull; ACTIVE</span>
            </div>
            <button
              type="button"
              class="card-ext-btn open-showcase-btn"
              data-target="showcase-modal-sehat"
              aria-label="Open SeHAT Internal Showcase"
              title="Open Showcase"
            >
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
                <polyline points="15 3 21 3 21 9"></polyline>
                <line x1="10" y1="14" x2="21" y2="3"></line>
              </svg>
            </button>
          </div>

          <div class="card-preview-media preview-sehat">
            <div class="sehat-left">
              <div class="sehat-icon-box">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#2563EB" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <line x1="12" y1="5" x2="12" y2="19"></line>
                  <line x1="5" y1="12" x2="19" y2="12"></line>
                </svg>
              </div>
              <div class="sehat-brand">
                <span class="sehat-brand-name">SeHAT</span>
                <span class="sehat-brand-name">SmartCare AI</span>
                <span class="sehat-brand-sub">Your Personal<br />AI Health Assistant</span>
              </div>
            </div>
            <div class="sehat-right">
              <img src="/projects_images/SeHAT_SmartCare/homedashboard&aimeicalchatbot.webp" alt="SeHAT SmartCare AI mobile application interface" class="sehat-mockup-img" loading="lazy" />
            </div>
          </div>

          <h3 class="card-project-title">SeHAT SmartCare AI</h3>
          <p class="card-project-desc">
            An intelligent Android healthcare platform combining Medical LLMs, RAG, FAISS semantic search, and OCR report analysis with multilingual Hindi/English voice input.
          </p>

          <div class="card-tags">
            <span class="chip-tag chip-blue">Android &bull; Kotlin</span>
            <span class="chip-tag chip-purple">FastAPI &bull; Python</span>
            <span class="chip-tag chip-green">Medical LLM &bull; RAG</span>
            <span class="chip-tag chip-orange">FAISS &bull; OCR</span>
          </div>

          <div class="portfolio-card-actions">
            <button
              type="button"
              class="btn-card-showcase open-showcase-btn"
              data-target="showcase-modal-sehat"
            >
              <span>Internal Production Showcase</span>
              <span class="sparkle-icon">✦</span>
            </button>
            <button
              type="button"
              class="btn-card-case-study open-showcase-btn"
              data-target="showcase-modal-sehat"
            >
              <span>View Case Study &amp; Screens</span>
              <span class="arrow-icon">&rarr;</span>
            </button>
          </div>
        </article>

        <!-- 3. In-House SaaS Platform -->
        <article class="card portfolio-card case-study-card coming-soon-card" data-category="ai automation" id="saas-platform">
          <div class="card-top-bar">
            <div class="portfolio-badge in-progress">
              <span class="badge-dot"></span>
              <span>IN-PROGRESS SAAS</span>
            </div>
            <a href="/contact" class="card-ext-btn" aria-label="Inquire about SaaS platform" title="Contact Us">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
                <polyline points="15 3 21 3 21 9"></polyline>
                <line x1="10" y1="14" x2="21" y2="3"></line>
              </svg>
            </a>
          </div>

          <div class="card-preview-media preview-saas">
            <div class="saas-left">
              <span class="saas-title">SaaS Platform</span>
              <span class="saas-desc">Building the next generation AI-powered platform at InfoHQ.</span>
            </div>
            <div class="saas-right">
              <div class="saas-feature-pill">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#38BDF8" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <rect x="3" y="11" width="18" height="10" rx="2"></rect>
                  <circle cx="12" cy="5" r="2"></circle>
                  <path d="M12 7v4"></path>
                  <line x1="8" y1="16" x2="8" y2="16"></line>
                  <line x1="16" y1="16" x2="16" y2="16"></line>
                </svg>
                <span>AI Agents</span>
              </div>
              <div class="saas-feature-pill">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#38BDF8" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                  <circle cx="9" cy="7" r="4"></circle>
                  <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
                  <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
                </svg>
                <span>Multi-Tenant</span>
              </div>
              <div class="saas-feature-pill">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#38BDF8" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M18 10h-1.26A8 8 0 1 0 9 20h9a5 5 0 0 0 0-10z"></path>
                </svg>
                <span>Edge Computing</span>
              </div>
            </div>
          </div>

          <h3 class="card-project-title">In-House SaaS Platform</h3>
          <p class="card-project-desc">
            InfoHQ is currently engineering its own SaaS platform in-house &mdash; dogfooding autonomous AI agent architectures, multi-tenant databases, and edge compute.
          </p>

          <div class="card-tags">
            <span class="chip-tag chip-blue">AI Systems</span>
            <span class="chip-tag chip-purple">Multi-Tenant SaaS</span>
            <span class="chip-tag chip-orange">Cloudflare Edge</span>
            <span class="chip-tag chip-green">FastAPI</span>
          </div>

          <div class="portfolio-card-actions">
            <a href="/contact" class="btn-card-live">
              <span>Inquire Early Access</span>
              <span class="arrow-icon">&rarr;</span>
            </a>
            <div class="card-status-badge">
              <span>Official Announcement Coming Soon</span>
            </div>
          </div>
        </article>
      </div>
      <!-- SeHAT Interactive Production Showcase Modal -->
      <div 
        id="showcase-modal-sehat" 
        class="showcase-modal-overlay" 
        role="dialog" 
        aria-modal="true" 
        aria-labelledby="showcase-title-sehat"
        tabindex="-1"
        hidden
      >
        <div class="showcase-modal-container">
          <!-- Sticky Modal Header -->
          <header class="showcase-modal-header">
            <div class="showcase-header-left">
              <div class="showcase-header-meta">
                <span class="modal-badge-status">Internal Product Showcase</span>
                <span class="modal-badge-tech">Android &bull; FastAPI &bull; RAG &bull; FAISS &bull; OCR</span>
              </div>
              <h3 id="showcase-title-sehat" class="showcase-modal-headline">
                {sehat.title}
              </h3>
            </div>
            
            <div class="showcase-header-actions">
              <a href="/contact" class="btn-modal-inquire">Discuss Custom Build</a>
              <button 
                type="button" 
                class="btn-close-modal" 
                data-close-showcase 
                aria-label="Close product showcase"
              >
                <span class="close-symbol">&times;</span>
                <span class="close-text">Close (Esc)</span>
              </button>
            </div>
          </header>

          <!-- Scrollable Modal Body -->
          <div class="showcase-modal-body">
            
            <!-- 1. Interactive Production Workflow Screen Explorer -->
            <section class="showcase-dialog-section">
              <div class="dialog-section-header">
                <h4 class="dialog-section-title">5 Live Application Workflows</h4>
                <p class="dialog-section-desc">
                  Select any workflow tab below to inspect the actual native Android interface and review how the AI and retrieval pipelines operate under the hood.
                </p>
              </div>

              <!-- Navigation Tabs Bar -->
              <div class="modal-screen-tabs-bar" role="tablist">
                {sehat.screenshots && sehat.screenshots.map((screen, sIdx) => (
                  <button
                    type="button"
                    class={`modal-tab-btn ${sIdx === 0 ? 'active' : ''}`}
                    role="tab"
                    aria-selected={sIdx === 0 ? 'true' : 'false'}
                    data-target={`sehat-modal-screen-${sIdx}`}
                    id={`sehat-tab-${sIdx}`}
                  >
                    <span class="modal-tab-num">0{sIdx + 1}</span>
                    <span class="modal-tab-name">{screen.tabLabel}</span>
                  </button>
                ))}
              </div>

              <!-- Screen Stage (Desktop: 2 columns, Mobile/Tablet: Stacked) -->
              <div class="modal-screen-stage">
                {sehat.screenshots && sehat.screenshots.map((screen, sIdx) => (
                  <div 
                    class={`modal-screen-panel ${sIdx === 0 ? 'active' : ''}`}
                    id={`sehat-modal-screen-${sIdx}`}
                    role="tabpanel"
                    aria-labelledby={`sehat-tab-${sIdx}`}
                  >
                    <!-- Left: Realistic Mobile Phone Device Mockup -->
                    <div class="device-mockup-col">
                      <div class="device-mockup-frame">
                        <div class="device-speaker-notch"></div>
                        <img 
                          src={sIdx === 0 ? screen.src : undefined} 
                          data-src={screen.src}
                          alt={screen.title} 
                          class="device-screen-img"
                          width="1100"
                          height="733"
                          loading="lazy"
                          decoding="async"
                        />
                      </div>
                      <div class="device-caption-pill">
                        <span>Screen 0{sIdx + 1} of 05 &bull; Production Android UI</span>
                      </div>
                    </div>

                    <!-- Right: Developer Deep Dive & Clinical Purpose -->
