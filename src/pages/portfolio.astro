<script>
  let activeModalLenis: any = null;
  let modalRafId: number | null = null;

  // Progressive Enhancement Client-Side Project Filtering
  function setupPortfolioFilter() {
    const filterButtons = document.querySelectorAll('.filter-tab-btn');
    const caseStudies = document.querySelectorAll('.case-study-card');

    if (!filterButtons.length) return;

    filterButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const filter = btn.getAttribute('data-filter') || 'all';

        // Update active tab states
        filterButtons.forEach((b) => {
          b.classList.remove('active');
          b.setAttribute('aria-selected', 'false');
        });
        btn.classList.add('active');
        btn.setAttribute('aria-selected', 'true');

        // Filter Flagship Case Studies (supports multi-tags e.g. "mobile ai")
        caseStudies.forEach((card) => {
          const categoryAttr = card.getAttribute('data-category') || '';
          const categories = categoryAttr.split(' ');
          if (filter === 'all' || categories.includes(filter)) {
            card.classList.remove('is-filtered-out');
          } else {
            card.classList.add('is-filtered-out');
          }
        });
      });
    });
  }

  // Showcase Modal Controls with Identical Lenis Smooth Scroll
  function setupShowcaseModals() {
    const overlays = document.querySelectorAll('.showcase-modal-overlay');
    if (!overlays.length) return;

    function openModal(modal: HTMLElement) {
      modal.removeAttribute('hidden');
      modal.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
      document.documentElement.style.overflow = 'hidden';

      // Progressively load modal screenshots with data-src on open
      const lazyImgs = modal.querySelectorAll('img[data-src]');
      lazyImgs.forEach((img) => {
        if (img instanceof HTMLImageElement && !img.getAttribute('src')) {
          const ds = img.getAttribute('data-src');
          if (ds) img.setAttribute('src', ds);
        }
      });

      // Pause window Lenis smooth scrolling so background page stays fixed
      if ((window as any).lenis?.stop) {
        (window as any).lenis.stop();
      }

      modal.scrollTop = 0;

      // Attach dedicated Lenis smooth scroll to the modal with the exact same easing as the site
      const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const modalContainer = modal.querySelector('.showcase-modal-container') as HTMLElement;
      const LenisClass = (window as any).Lenis || (window as any).lenis?.constructor;
      if (!prefersReducedMotion && modalContainer && LenisClass) {
        if (activeModalLenis) {
          activeModalLenis.destroy();
          activeModalLenis = null;
        }
        if (modalRafId) {
          cancelAnimationFrame(modalRafId);
          modalRafId = null;
        }

        try {
          activeModalLenis = new LenisClass({
            wrapper: modal,
            content: modalContainer,
            duration: 1.1,
            easing: (t: number) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
            orientation: 'vertical',
            smoothWheel: true,
            touchMultiplier: 1.5,
          });

          function stepModalLenis(time: number) {
            if (activeModalLenis) {
              activeModalLenis.raf(time);
              modalRafId = requestAnimationFrame(stepModalLenis);
            }
          }
          modalRafId = requestAnimationFrame(stepModalLenis);
        } catch (e) {
          console.warn('Modal Lenis init fallback:', e);
        }
      }

      // Set focus on close button for screen reader & keyboard accessibility
      const closeBtn = modal.querySelector('.btn-close-modal');
      if (closeBtn instanceof HTMLElement) {
        closeBtn.focus();
      }
    }

    function closeModal(modal: HTMLElement) {
      // Clean up modal Lenis instance
      if (modalRafId) {
        cancelAnimationFrame(modalRafId);
        modalRafId = null;
      }
      if (activeModalLenis) {
        activeModalLenis.destroy();
        activeModalLenis = null;
      }

      modal.setAttribute('hidden', '');
      modal.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
      document.documentElement.style.overflow = '';

      // Resume window Lenis smooth scrolling
      if ((window as any).lenis?.start) {
        (window as any).lenis.start();
      }
    }

    // Reliable event delegation for opening & closing modals
    document.addEventListener('click', (e) => {
      const openBtn = (e.target as HTMLElement)?.closest('.open-showcase-btn');
      if (openBtn) {
        e.preventDefault();
        const targetId = openBtn.getAttribute('data-target');
        if (!targetId) return;
        const targetModal = document.getElementById(targetId);
        if (targetModal instanceof HTMLElement) {
          openModal(targetModal);
        }
        return;
      }

      const closeBtn = (e.target as HTMLElement)?.closest('[data-close-showcase]');
      if (closeBtn) {
        e.preventDefault();
        const parentModal = closeBtn.closest('.showcase-modal-overlay');
        if (parentModal instanceof HTMLElement) {
          closeModal(parentModal);
        }
        return;
      }

      // Close Modal by clicking outside container (on the overlay backdrop)
      if ((e.target as HTMLElement)?.classList.contains('showcase-modal-overlay')) {
        closeModal(e.target as HTMLElement);
      }
    });

    // Close via Escape key
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' || e.key === 'Esc') {
        const activeModal = document.querySelector('.showcase-modal-overlay:not([hidden])');
        if (activeModal instanceof HTMLElement) {
          closeModal(activeModal);
        }
      }
    });
  }

  // Interactive Screen Switcher inside Modal
  function setupModalScreenTabs() {
    const tabBtns = document.querySelectorAll('.modal-tab-btn');
    if (!tabBtns.length) return;

    tabBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const targetId = btn.getAttribute('data-target');
        const modalBody = btn.closest('.showcase-modal-body');
        if (!modalBody || !targetId) return;

        const siblingTabs = modalBody.querySelectorAll('.modal-tab-btn');
        const siblingPanels = modalBody.querySelectorAll('.modal-screen-panel');

        siblingTabs.forEach((t) => {
          t.classList.remove('active');
          t.setAttribute('aria-selected', 'false');
        });
        siblingPanels.forEach((p) => p.classList.remove('active'));

        btn.classList.add('active');
        btn.setAttribute('aria-selected', 'true');

        const targetPanel = document.getElementById(targetId);
        if (targetPanel) {
          targetPanel.classList.add('active');
          const panelImg = targetPanel.querySelector('img[data-src]');
          if (panelImg instanceof HTMLImageElement && !panelImg.getAttribute('src')) {
            const ds = panelImg.getAttribute('data-src');
            if (ds) panelImg.setAttribute('src', ds);
          }
          // Recalculate dimensions in Lenis if active
          if (activeModalLenis) {
            activeModalLenis.resize();
          }
        }
      });
    });
  }

  // Support both direct initial load and Astro View Transitions
  function initPortfolioScripts() {
    setupPortfolioFilter();
    setupShowcaseModals();
    setupModalScreenTabs();
  }

  initPortfolioScripts();
  document.addEventListener('astro:page-load', initPortfolioScripts);
</script>
