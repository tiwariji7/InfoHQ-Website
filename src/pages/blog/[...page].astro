---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import CategoryPills from '../../components/CategoryPills.astro';
import BlogCard from '../../components/BlogCard.astro';
import Pagination from '../../components/Pagination.astro';
import NewsletterForm from '../../components/NewsletterForm.astro';
import FinalCTA from '../../components/FinalCTA.astro';

export async function getStaticPaths({ paginate }: any) {
  const posts = (await getCollection('blog', ({ data }) => !data.draft))
    .sort((a, b) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime());

  // If no posts yet, paginate empty array returns 1 page
  return paginate(posts, { pageSize: 9 });
}

const { page } = Astro.props;
const posts = page.data;
const currentPage = page.currentPage;
const totalPages = page.lastPage;

const meta = {
  title: currentPage > 1
    ? `Blog — Page ${currentPage} | InfoHQ`
    : 'Blog — AI, Software & Engineering Insights | InfoHQ',
  description: 'Practical insights on AI, software engineering, and digital product development from the InfoHQ team.',
  keywords: 'AI blog India, software development blog, tech insights India'
};

const canonicalUrl = currentPage > 1 ? `https://infohq.in/blog/${currentPage}` : 'https://infohq.in/blog';
const prevUrl = page.url.prev ? (page.url.prev === '/blog/1' ? 'https://infohq.in/blog' : `https://infohq.in${page.url.prev}`) : undefined;
const nextUrl = page.url.next ? `https://infohq.in${page.url.next}` : undefined;
---

<BaseLayout
  title={meta.title}
  description={meta.description}
  keywords={meta.keywords}
  schemaType="blogs"
  canonicalUrl={canonicalUrl}
  prevUrl={prevUrl}
  nextUrl={nextUrl}
  blogPosts={posts}
>
  <!-- Hero Section -->
  <section class="section blog-hero" aria-labelledby="blogs-heading">
    <div class="container text-center">
      <span class="text-eyebrow">Engineering Insights</span>
      <h1 id="blogs-heading" class="blogs-headline">
        Insights From the <span class="text-gradient">InfoHQ Engineering Team</span>
      </h1>
      <p class="blogs-subheadline">
        Practical notes on AI, software engineering, and building digital products that last &mdash; from the team actually shipping them.
      </p>

      <!-- Category Filter Pills -->
      <CategoryPills activeCategory={null} />
    </div>
  </section>

  <!-- Blog Listing Grid or Coming Soon State -->
  <section class="section blog-listing-section" aria-label="Articles list">
    <div class="container">
      {posts && posts.length > 0 ? (
        <>
          <div class="blog-grid">
            {posts.map((post: any) => (
              <BlogCard post={post} />
            ))}
          </div>

          <Pagination
            currentPage={currentPage}
            totalPages={totalPages}
            baseUrl="/blog"
          />
        </>
      ) : (
        <div class="card empty-state-card">
          <div class="empty-state-content">
            <span class="empty-badge">Coming Soon</span>
            <h2 class="empty-headline">In-Depth Technical Essays In Progress</h2>
            <p class="empty-desc">
              We do not publish AI-generated fluff or generic listicles. Our senior engineering team is writing detailed, code-first teardowns based on real production deployments.
            </p>
            <p class="empty-sub">
              Subscribe below to receive our technical essays directly in your inbox the moment they are published.
            </p>
            <div class="newsletter-wrap">
              <NewsletterForm />
            </div>
          </div>
        </div>
      )}
    </div>
  </section>

  <!-- Newsletter Signup Section (Shown when posts exist) -->
  {posts && posts.length > 0 && (
    <section class="section newsletter-strip-section" aria-labelledby="newsletter-heading">
      <div class="container">
        <div class="card newsletter-strip-card">
          <div class="newsletter-strip-content">
            <span class="text-eyebrow">Stay Ahead</span>
            <h2 id="newsletter-heading">Engineering Dispatches Directly to Your Inbox</h2>
            <p>Direct production teardowns, architecture patterns, and benchmarks. Zero spam, ever.</p>
            <div class="newsletter-wrap">
              <NewsletterForm />
            </div>
          </div>
        </div>
      </div>
    </section>
  )}

  <!-- Final CTA: Suggest a Topic -->
  <FinalCTA page="blogs" />
</BaseLayout>

<style>
  .blog-hero {
    padding-top: clamp(3rem, 5vw, 4.5rem);
    padding-bottom: 1rem;
    text-align: center;
  }

  .blogs-headline {
    margin: 0.75rem 0 1.25rem;
    font-size: var(--text-5xl);
  }

  .blogs-subheadline {
    font-size: var(--text-lg);
    color: var(--color-text-body);
    max-width: 760px;
    margin: 0 auto;
    line-height: 1.6;
  }

  .blog-listing-section {
    padding-top: 1rem;
    padding-bottom: clamp(3rem, 6vw, 5rem);
  }

  .blog-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(1.5rem, 2.5vw, 2rem);
  }

  /* Empty State Card */
  .empty-state-card {
    max-width: 780px;
    margin: 0 auto;
    padding: clamp(2.5rem, 5vw, 3.5rem);
    text-align: center;
    background: var(--color-bg-card);
    border: 1px solid var(--color-border-card);
  }

  .empty-badge {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    padding: 3px 10px;
    border-radius: var(--radius-sm);
    background: var(--color-primary-light);
    color: var(--color-primary);
    margin-bottom: 1rem;
  }

  .empty-headline {
    font-size: var(--text-3xl);
    margin-bottom: 1rem;
    background: var(--brand-gradient);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    color: var(--color-text-heading);
    display: inline-block;
  }

  .empty-desc {
    font-size: var(--text-base);
    color: var(--color-text-body);
    line-height: 1.6;
    margin-bottom: 0.75rem;
  }

  .empty-sub {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    margin-bottom: 2rem;
  }

  .newsletter-wrap {
    max-width: 440px;
    margin: 0 auto;
  }

  /* Newsletter Strip Card */
  .newsletter-strip-section {
    padding-top: 0;
  }

  .newsletter-strip-card {
    max-width: 820px;
    margin: 0 auto;
    padding: clamp(2.5rem, 4vw, 3.5rem);
    text-align: center;
    background: linear-gradient(135deg, rgba(124, 92, 232, 0.06) 0%, rgba(243, 84, 151, 0.04) 100%), var(--color-bg-card);
    border: 1px solid rgba(124, 92, 232, 0.2);
  }

  .newsletter-strip-card h2 {
    font-size: var(--text-3xl);
    margin: 0.5rem 0 0.75rem;
  }

  .newsletter-strip-card p {
    font-size: var(--text-base);
    color: var(--color-text-body);
    margin-bottom: 1.75rem;
  }

  @media (max-width: 1023px) {
    .blog-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 767px) {
    .blog-grid {
      grid-template-columns: 1fr;
    }
    .blogs-headline {
      font-size: clamp(2rem, 7vw, 2.75rem);
    }
    .empty-state-card {
      padding: 2rem 1.25rem;
    }
  }
</style>
