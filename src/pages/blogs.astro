---
import BaseLayout from '../layouts/BaseLayout.astro';
import NewsletterForm from '../components/NewsletterForm.astro';
import FinalCTA from '../components/FinalCTA.astro';

const meta = {
  title: 'Blog — AI, Software & Engineering Insights | InfoHQ',
  description: 'Practical insights on AI, software engineering, and digital product development from the InfoHQ team.',
  keywords: 'AI blog India, software development blog, tech insights India'
};

const categories = [
  {
    name: 'AI & Automation',
    desc: 'Deep dives into RAG architectures, autonomous agent workflows, and LLM telemetry.',
    topics: ['Building Production RAG with pgvector', 'Autonomous Workflow Triggers via Webhooks']
  },
  {
    name: 'Web & App Development',
    desc: 'Modern front-end engineering, sub-second latency, offline-first mobile apps, and Next.js.',
    topics: ['Passing Core Web Vitals with Zero Layout Shift', 'Offline Database Caching in React Native']
  },
  {
    name: 'Case Studies',
    desc: 'Behind-the-scenes teardowns of systems engineered, scaled, and maintained by InfoHQ.',
    topics: ['Alpha Studio Tech Performance Optimization', 'Architecting Multi-Tenant Cloudflare Workflows']
  },
  {
    name: 'Engineering Practices',
    desc: 'Zero-downtime CI/CD pipelines, containerization, test suites, and database migration.',
    topics: ['Zero-Downtime Deployment with GitHub Actions', 'OWASP Security Audits for Indian Startups']
  },
  {
    name: 'Industry Insights',
    desc: 'Perspectives on India\'s digital growth, DPDP Act 2023 compliance, and enterprise tech adoption.',
    topics: ['Navigating India\'s DPDP Act for B2B Apps', 'Fixed-Scope Milestones vs. Retainer Squads']
  }
];
---

<BaseLayout
  title={meta.title}
  description={meta.description}
  keywords={meta.keywords}
  schemaType="blogs"
>
  <!-- Hero Section -->
  <section class="section blogs-hero" aria-labelledby="blogs-heading">
    <div class="container text-center">
      <span class="text-eyebrow">Engineering Insights</span>
      <h1 id="blogs-heading" class="blogs-headline">
        Insights From the <span class="text-gradient">InfoHQ Engineering Team</span>
      </h1>
      <p class="blogs-subheadline">
        Practical notes on AI, software engineering, and building digital products that last &mdash; from the team actually shipping them.
      </p>
    </div>
  </section>

  <!-- Categories & Editorial Blueprint -->
  <section class="section section-alt categories-section" aria-labelledby="categories-heading">
    <div class="container">
      <div class="section-header">
        <span class="text-eyebrow">Editorial Architecture</span>
        <h2 id="categories-heading">Engineering Categories</h2>
        <p>Curated technical tracks covering every layer of the modern digital stack.</p>
      </div>

      <div class="categories-grid">
        {categories.map((cat, idx) => (
          <article class="card category-blueprint-card">
            <div class="cat-badge">Track 0{idx + 1}</div>
            <h3 class="cat-name">{cat.name}</h3>
            <p class="cat-desc">{cat.desc}</p>
            
            <div class="upcoming-topics">
              <span class="upcoming-label">Upcoming Articles:</span>
              <ul class="topic-list">
                {cat.topics.map((t) => (
                  <li>
                    <span class="topic-dot"></span>
                    <span>{t}</span>
                  </li>
                ))}
              </ul>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Publication Notice & Newsletter Section -->
  <section class="section publication-section" aria-labelledby="pub-heading">
    <div class="container">
      <div class="card pub-card">
        <div class="pub-content">
          <span class="text-eyebrow">Zero Fluff Guarantee</span>
          <h2 id="pub-heading">In-Depth Technical Essays Coming Soon</h2>
          <p>
            We do not publish AI-generated fluff or generic listicles. Our senior engineering team is writing detailed, code-first teardowns based on real production deployments.
          </p>
          <p class="pub-sub">
            Subscribe below to receive our technical essays directly in your inbox the moment they are published.
          </p>
          <div class="pub-form-wrap">
            <NewsletterForm />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Final CTA: Suggest a Topic -->
  <FinalCTA page="blogs" />
</BaseLayout>

<style>
  .blogs-hero {
    padding-top: clamp(3rem, 5vw, 4.5rem);
    padding-bottom: clamp(2.5rem, 4vw, 3.5rem);
    text-align: center;
  }

  .blogs-headline {
    margin: 0.75rem 0 1.25rem;
    font-size: var(--text-5xl);
  }

  .blogs-subheadline {
    font-size: var(--text-lg);
    color: var(--color-text-body);
    max-width: 760px;
    margin: 0 auto;
    line-height: 1.6;
  }

  .categories-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr));
    gap: clamp(1.25rem, 2vw, 1.75rem);
  }

  .category-blueprint-card {
    padding: clamp(1.75rem, 3vw, 2.25rem);
    display: flex;
    flex-direction: column;
  }

  .cat-badge {
    align-self: flex-start;
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    padding: 3px 8px;
    border-radius: var(--radius-sm);
    background: var(--color-primary-light);
    color: var(--color-primary);
    margin-bottom: 1rem;
  }

  .cat-name {
    font-size: var(--text-xl);
    margin-bottom: 0.75rem;
  }

  .cat-desc {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    line-height: 1.5;
    margin-bottom: 1.5rem;
  }

  .upcoming-topics {
    margin-top: auto;
    padding-top: 1rem;
    border-top: 1px solid var(--color-border-card);
  }

  .upcoming-label {
    display: block;
    font-size: var(--text-xs);
    font-weight: 700;
    color: var(--color-text-heading);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 0.5rem;
  }

  .topic-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    font-size: var(--text-xs);
    color: var(--color-text-body);
  }

  .topic-list li {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .topic-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background-color: var(--color-grad-pink);
    flex-shrink: 0;
  }

  /* Pub Card */
  .pub-card {
    max-width: 780px;
    margin: 0 auto;
    padding: clamp(2.5rem, 4vw, 3.5rem);
    text-align: center;
  }

  .pub-card h2 {
    font-size: var(--text-3xl);
    margin: 0.75rem 0 1rem;
    background: var(--brand-gradient);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    color: var(--color-text-heading);
    display: inline-block;
  }

  .pub-card p {
    font-size: var(--text-base);
    color: var(--color-text-body);
    line-height: 1.6;
    margin-bottom: 0.75rem;
  }

  .pub-sub {
    font-size: var(--text-sm) !important;
    color: var(--color-text-muted) !important;
    margin-bottom: 1.75rem !important;
  }

  .pub-form-wrap {
    max-width: 440px;
    margin: 0 auto;
  }

  /* Topic Box */
  .topic-box {
    max-width: 700px;
    margin: 0 auto;
  }

  @media (max-width: 767px) {
    .categories-grid {
      grid-template-columns: 1fr;
    }
    .pub-card {
      padding: 1.75rem 1.25rem;
    }
    .blogs-headline {
      font-size: clamp(2rem, 7vw, 2.75rem);
    }
  }
</style>
