---
import BaseLayout from '../layouts/BaseLayout.astro';
import FinalCTA from '../components/FinalCTA.astro';

const meta = {
  title: 'About InfoHQ — AI & Software Engineering Studio',
  description: 'InfoHQ is an AI and software engineering studio based in Pune & Prayagraj, building digital products for businesses across India.',
  keywords: 'InfoHQ, about InfoHQ, software company Pune, AI company Prayagraj, IT company India'
};

const values = [
  {
    title: 'Ownership-first',
    desc: 'Clients own 100% of their code, design, and data. Always. Everything is delivered into your own GitHub repositories and cloud accounts.'
  },
  {
    title: 'Engineering over templates',
    desc: 'We build real, scalable systems — not drag-and-drop shortcuts, unmaintained plugins, or fragile low-code workarounds.'
  },
  {
    title: 'Long-term partnership',
    desc: 'We\'re built for retainers and enduring relationships, not quick one-off invoices followed by post-launch disappearance.'
  }
];

const differentiators = [
  {
    title: 'Hybrid Agency & SaaS Model',
    desc: 'We build client software and our own in-house AI/SaaS products simultaneously — meaning we are actively testing and shipping with cutting-edge tools every day.'
  },
  {
    title: 'Dedicated Engineers, Not Support Queues',
    desc: 'When you work with us on retainer, you get direct communication with a senior technical engineer who intimately knows your codebase.'
  },
  {
    title: 'Pan-India Delivery, Dual Hubs',
    desc: 'Headquartered in Pune, Maharashtra and Prayagraj, Uttar Pradesh, providing high-touch remote-first engineering delivery across India.'
  }
];
---

<BaseLayout
  title={meta.title}
  description={meta.description}
  keywords={meta.keywords}
  schemaType="company"
>
  <!-- Hero Section -->
  <section class="section company-hero" aria-labelledby="company-heading">
    <div class="container text-center">
      <span class="text-eyebrow">About InfoHQ</span>
      <h1 id="company-heading" class="company-headline">
        Built by Engineers Who'd <span class="text-gradient">Rather Ship Than Talk</span>
      </h1>
      <p class="company-subheadline">
        InfoHQ (Alpha AI Services) is an AI and software engineering studio based in Pune and Prayagraj, building and running digital products for businesses across India.
      </p>
    </div>
  </section>

  <!-- Our Story Section -->
  <section class="section section-alt story-section" aria-labelledby="story-heading">
    <div class="container">
      <div class="story-grid">
        <div class="story-content">
          <span class="text-eyebrow">Our Story</span>
          <h2 id="story-heading">Why InfoHQ Exists</h2>
          <div class="story-body">
            <p>
              InfoHQ started with a simple observation: most businesses don't fail at building their first website or app &mdash; they fail at maintaining and growing it afterward. Freelancers disappear. Agencies move to the next client. In-house hiring is slow and expensive.
            </p>
            <p>
              We built InfoHQ to fix that gap &mdash; as both a project-based engineering agency and a long-term technology partner, so the same team that builds your product is the one that keeps improving it.
            </p>
          </div>
        </div>

        <div class="story-card-wrap">
          <div class="card highlight-statement-card">
            <h3>"One Team. Every Layer of Your Digital Stack."</h3>
            <p>
              We eliminate the friction of juggling five different freelancers for AI, web, mobile, cloud, and maintenance. Your code remains cohesive, well-documented, and production-ready.
            </p>
            <div class="stat-pill">100% Client Code &amp; IP Ownership</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Mission & Values Section -->
  <section class="section mission-values-section" aria-labelledby="mission-heading">
    <div class="container">
      <div class="mission-box text-center">
        <span class="text-eyebrow">Our Mission</span>
        <h2 id="mission-heading" class="mission-title">
          To give every growing business in India access to engineering-grade AI, software, and digital infrastructure &mdash; without needing an in-house tech team.
        </h2>
      </div>

      <div class="section-header" style="margin-top: 4rem; margin-bottom: 2.5rem;">
        <span class="text-eyebrow">Operating Principles</span>
        <h3>Our Core Values</h3>
      </div>

      <div class="grid-3 values-grid">
        {values.map((val, idx) => (
          <article class="card value-card">
            <div class="value-index">0{idx + 1}</div>
            <h4 class="value-title">{val.title}</h4>
            <p class="value-desc">{val.desc}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- What Makes Us Different -->
  <section class="section section-wash diff-section" aria-labelledby="diff-heading">
    <div class="container">
      <div class="section-header">
        <span class="text-eyebrow">Differentiation</span>
        <h2 id="diff-heading">What Makes Us Different</h2>
        <p>Why ambitious tech founders and enterprise leaders choose to partner with InfoHQ.</p>
      </div>

      <div class="grid-3 diff-grid">
        {differentiators.map((diff) => (
          <article class="card diff-card">
            <div class="diff-check">&check;</div>
            <h4 class="diff-title">{diff.title}</h4>
            <p class="diff-desc">{diff.desc}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Where We Work -->
  <section class="section location-section" aria-labelledby="locations-heading">
    <div class="container">
      <div class="card location-card">
        <div class="location-info">
          <span class="text-eyebrow">Presence &amp; Reach</span>
          <h2 id="locations-heading">Where We Work</h2>
          <div class="loc-item">
            <strong>Dual Engineering Headquarters:</strong>
            <p>Pune, Maharashtra &bull; Prayagraj, Uttar Pradesh, India</p>
          </div>
          <div class="loc-item">
            <strong>Service Area:</strong>
            <p>Pan-India &mdash; remote-first delivery for clients anywhere in the country.</p>
          </div>
        </div>
        <div class="location-badge-box">
          <div class="loc-stat">
            <span class="loc-num">2</span>
            <span class="loc-lbl">Tech Hubs</span>
          </div>
          <div class="loc-stat">
            <span class="loc-num">Pan-India</span>
            <span class="loc-lbl">Client Coverage</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Final CTA -->
  <FinalCTA page="company" />
</BaseLayout>

<style>
  .company-hero {
    padding-top: clamp(3rem, 5vw, 4.5rem);
    padding-bottom: clamp(2.5rem, 4vw, 3.5rem);
    text-align: center;
  }

  .company-headline {
    margin: 0.75rem 0 1.25rem;
    font-size: var(--text-5xl);
  }

  .company-subheadline {
    font-size: var(--text-lg);
    color: var(--color-text-body);
    max-width: 760px;
    margin: 0 auto;
    line-height: 1.6;
  }

  /* Story Grid */
  .story-grid {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: clamp(1.75rem, 3vw, 3rem);
    align-items: center;
  }

  .story-content h2 {
    font-size: var(--text-3xl);
    margin: 0.5rem 0 1.5rem;
  }

  .story-body {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    font-size: var(--text-base);
    color: var(--color-text-body);
    line-height: 1.7;
  }

  .highlight-statement-card {
    padding: clamp(2rem, 3.5vw, 2.75rem);
  }

  .highlight-statement-card h3 {
    font-size: var(--text-2xl);
    background: var(--brand-gradient);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    color: var(--color-text-heading);
    margin-bottom: 1rem;
    line-height: 1.3;
    display: inline-block;
  }

  .highlight-statement-card p {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    line-height: 1.6;
    margin-bottom: 1.5rem;
  }

  .stat-pill {
    display: inline-block;
    font-size: var(--text-xs);
    font-weight: 700;
    color: var(--color-primary);
    background: var(--color-primary-light);
    padding: 6px 14px;
    border-radius: var(--radius-full);
  }

  /* Mission Box */
  .mission-box {
    max-width: 880px;
    margin: 0 auto;
    background: #FFFFFF;
    border: 1px solid var(--color-border-card);
    border-radius: var(--radius-2xl);
    padding: clamp(2.5rem, 5vw, 4rem) clamp(1.5rem, 4vw, 3rem);
    box-shadow: var(--shadow-lg);
  }

  .mission-title {
    font-size: clamp(1.5rem, 3vw, 2.25rem);
    line-height: 1.35;
    color: var(--color-text-heading);
    margin-top: 1rem;
  }

  /* Values */
  .value-card {
    padding: clamp(1.75rem, 3vw, 2.25rem);
    display: flex;
    flex-direction: column;
  }

  .value-index {
    font-size: 2.25rem;
    font-weight: 800;
    color: rgba(124, 92, 232, 0.25);
    margin-bottom: 0.75rem;
  }

  .value-title {
    font-size: var(--text-xl);
    margin-bottom: 0.75rem;
  }

  .value-desc {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    line-height: 1.6;
  }

  /* Differentiators */
  .diff-card {
    padding: clamp(1.75rem, 3vw, 2.25rem);
    display: flex;
    flex-direction: column;
  }

  .diff-check {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: #DCFCE7;
    color: #15803D;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 800;
    margin-bottom: 1.25rem;
  }

  .diff-title {
    font-size: var(--text-xl);
    margin-bottom: 0.75rem;
  }

  .diff-desc {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    line-height: 1.6;
  }

  /* Locations */
  .location-card {
    display: grid;
    grid-template-columns: 1.5fr 1fr;
    gap: 2rem;
    padding: clamp(2rem, 4vw, 3rem);
    align-items: center;
  }

  .location-info h2 {
    font-size: var(--text-3xl);
    margin: 0.5rem 0 1.5rem;
  }

  .loc-item {
    margin-bottom: 1rem;
  }

  .loc-item strong {
    display: block;
    font-size: var(--text-sm);
    color: var(--color-text-heading);
    margin-bottom: 0.25rem;
  }

  .loc-item p {
    font-size: var(--text-base);
    color: var(--color-text-muted);
  }

  .location-badge-box {
    display: flex;
    gap: 1.5rem;
    justify-content: center;
    background: #FAF9FE;
    padding: 2rem;
    border-radius: var(--radius-xl);
    border: 1px solid var(--color-border-card);
  }

  .loc-stat {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .loc-num {
    font-size: 2rem;
    font-weight: 800;
    color: var(--color-primary);
    line-height: 1.2;
  }

  .loc-lbl {
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--color-text-muted);
  }

  @media (max-width: 1023px) {
    .story-grid {
      grid-template-columns: 1fr;
    }
    .location-card {
      grid-template-columns: 1fr;
    }
    .values-grid, .diff-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 767px) {
    .location-badge-box {
      flex-wrap: wrap;
      padding: 1.25rem 1rem;
      gap: 1rem;
    }
    .mission-box {
      padding: 2rem 1.25rem;
    }
  }
</style>
