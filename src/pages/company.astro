---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import FinalCTA from '../components/FinalCTA.astro';
import { contactConfig } from '../data/contactConfig';
import {
  ArrowRight,
  MapPin,
  Building2
} from 'lucide-astro';
import IndiaMapGraphic from '../components/IndiaMapGraphic.astro';

const meta = {
  title: 'About InfoHQ — AI & Software Engineering Studio | Pune & Prayagraj',
  description: 'Founded in 2025 by Shivam Tiwari, InfoHQ is an Indian AI & software engineering studio based in Pune and Prayagraj. We build production AI systems, web & mobile apps, and automations with built-in SEO and lifetime technical partnership.',
  keywords: 'About InfoHQ, Shivam Tiwari InfoHQ, AI engineering studio India, software development company Pune, software company Prayagraj, custom software development India, InfoHQ founder, AI agents India',
  canonical: 'https://infohq.in/company/'
};

const differentiators = [
  {
    title: 'Dedicated engineers, not ticket queues.',
    body: 'On our Business Growth and Technology Partner plans you work with the same engineer or team every time, not a rotating support desk.'
  },
  {
    title: 'You own everything.',
    body: '100% of your code, design, database schemas and assets are handed over to your own repositories.'
  },
  {
    title: 'Built to be found.',
    body: 'SEO, AEO, GEO, metadata and your Google Business Profile are part of how we think about a site, not an afterthought.'
  },
  {
    title: 'One partner, every layer.',
    body: 'Website, app, AI, cloud and marketing, without managing five different vendors.'
  },
  {
    title: 'Pan-India delivery from a Pune and Prayagraj base.',
    body: 'Remote-first engineering execution for startups and growing enterprises across the country.'
  }
];

const values = [
  {
    title: 'Ownership first',
    desc: 'You own your code, design and data. Always.'
  },
  {
    title: 'Engineering over templates',
    desc: 'We build real systems, not drag-and-drop shortcuts.'
  },
  {
    title: 'Long-term partnership',
    desc: 'We are built for ongoing relationships, not one-off invoices.'
  },
  {
    title: 'Transparent pricing',
    desc: 'Starting prices are published on our pricing page, and the scope is agreed before work begins.'
  },
  {
    title: 'Accountable engineers',
    desc: 'The people who build your product know your codebase and stay on to improve it.'
  }
];

const faqs = [
  {
    q: 'What is InfoHQ?',
    a: 'InfoHQ is an Indian AI and software engineering studio founded in 2025 by Shivam Tiwari. Operating from Pune, Maharashtra and Prayagraj, Uttar Pradesh, InfoHQ designs, engineers, and operates production-grade AI systems, custom SaaS platforms, modern web and mobile applications, and enterprise automations for businesses across India.'
  },
  {
    q: 'Who founded InfoHQ and who leads engineering?',
    a: 'InfoHQ was founded in 2025 by Shivam Tiwari, who acts as Founder and Lead Engineer. Shivam oversees every layer of product architecture — frontend, backend, databases, security, and AI integrations — working hands-on with the InfoHQ engineering team.'
  },
  {
    q: 'What services does InfoHQ provide?',
    a: 'InfoHQ provides end-to-end technology solutions: Autonomous AI Agents & RAG Knowledge Systems, Custom Software & SaaS Platforms, Web & Mobile App Development (Next.js, Astro, React Native), Business Process Automation (n8n, Make, Custom APIs), Cloud DevOps & Cybersecurity, and SEO/AEO/GEO optimization.'
  },
  {
    q: 'Does InfoHQ develop AI agents and business automations?',
    a: 'Yes. InfoHQ develops conversational AI voice agents, autonomous lead qualification bots, RAG document search pipelines, and multi-step CRM/ERP workflow automations built for real-world enterprise operations.'
  },
  {
    q: 'Does InfoHQ build custom CRM and internal software?',
    a: 'Yes. InfoHQ engineers bespoke CRM software, client portals, billing platforms, inventory management tools, and internal dashboards tailored specifically to each business workflow, without template limitations.'
  },
  {
    q: 'Where is InfoHQ located?',
    a: 'InfoHQ is dual-headquartered in Pune, Maharashtra and Prayagraj, Uttar Pradesh, delivering remote-first engineering and on-ground technical support to startups and enterprises pan-India.'
  },
  {
    q: 'Who owns the code, design, and intellectual property?',
    a: 'You do. 100% of all source code, Figma design systems, database architectures, and API keys are handed over directly to your own repositories and cloud accounts — zero lock-in.'
  },
  {
    q: 'How does InfoHQ optimize for SEO, AEO, and GEO?',
    a: 'Every digital product built by InfoHQ incorporates technical SEO, Answer Engine Optimization (AEO for Google AI Overviews and Perplexity), and Generative Engine Optimization (GEO for ChatGPT, Claude, and Gemini) with clean JSON-LD structured data and verified Google Business Profile setup.'
  },
  {
    q: 'How can I work with InfoHQ?',
    a: 'Businesses can engage InfoHQ via fixed-scope project sprints (built from scratch to launch) or ongoing monthly engineering retainers with dedicated engineers who know your codebase.'
  },
  {
    q: 'How do I contact InfoHQ?',
    a: `You can email ${contactConfig.businessEmail}, message on WhatsApp at +91 8381835420, or submit a request directly via the contact form on https://infohq.in/contact/.`
  }
];
---

<BaseLayout
  title={meta.title}
  description={meta.description}
  keywords={meta.keywords}
  canonical={meta.canonical}
  schemaType="company"
  ogImage="/og/company.webp"
>
  <!-- 1. HERO -->
  <section class="section company-hero" aria-labelledby="company-heading">
    <div class="container text-center">
      <h1 id="company-heading" class="company-headline">
        Built by Engineers Who'd <span class="text-gradient">Rather Ship Than Talk</span>
      </h1>
      <p class="company-subheadline">
        InfoHQ is an AI and software engineering studio based in Pune and Prayagraj, building and running digital products for businesses across India.
      </p>
      <div class="hero-actions">
        <Button
          variant="primary"
          size="lg"
          href="/contact/"
          label="Get in Touch"
          icon="arrow"
          id="company-hero-primary-cta"
        />
        <Button
          variant="secondary"
          tone="light"
          size="lg"
          href="/services/"
          label="See Our Services"
          icon="arrow"
          id="company-hero-secondary-cta"
        />
      </div>
    </div>
  </section>

  <!-- 2. WHO WE ARE & OUR STORY (Integrated Side-by-Side Narrative) -->
  <section class="section section-alt narrative-section" aria-labelledby="who-heading">
    <div class="container">
      <div class="narrative-grid">
        <!-- Left Column: Who We Are -->
        <article class="narrative-col who-box">
          <div class="col-header">
            <h2 id="who-heading">Who <span class="text-gradient">we are</span></h2>
          </div>
          <div class="body-copy">
            <p>
              <strong>InfoHQ</strong> is a modern AI systems and full-stack software engineering studio dual-headquartered in <strong>Pune, Maharashtra</strong> and <strong>Prayagraj, Uttar Pradesh</strong>. Founded in 2025 by <strong>Shivam Tiwari (Founder & Lead Engineer)</strong>, InfoHQ was built to bridge the gap between high-level architectural craft and measurable business revenue.
            </p>
            <p>
              Unlike traditional agencies layered with non-technical middlemen, account managers, and offshore subcontracting, InfoHQ is powered by active builders. Shivam personally leads system architecture and oversees every layer of product development &mdash; from fluid frontend user interfaces and high-concurrency backend microservices to relational database architectures, vector search pipelines, and cloud security hardening &mdash; working hands-on alongside the InfoHQ engineering team.
            </p>
            <p>
              We engineer production-grade digital infrastructure: autonomous AI voice and workflow agents, enterprise RAG knowledge retrieval systems, custom SaaS platforms, modern web applications, and cross-platform mobile apps. We partner with clients either on fixed-scope project sprints or as a dedicated monthly engineering squad that functions as their in-house technical department.
            </p>
          </div>
        </article>

        <!-- Right Column: Our Story (Why InfoHQ Exists) -->
        <article class="narrative-col story-box" aria-labelledby="story-heading">
          <div class="col-header">
            <h2 id="story-heading">Why <span class="text-gradient">InfoHQ exists</span></h2>
          </div>
          <div class="body-copy story-copy">
            <p>
              The traditional agency model is fundamentally broken. Most digital agencies operate like transactional factories: they rush a website or app out of a generic template, send the final invoice, and vanish. But software only creates commercial value when it stays fast, secure, continuously optimized, and discoverable where modern buyers actually search.
            </p>
            <p>
              <strong>Shivam Tiwari</strong> started InfoHQ after noticing this exact market failure: countless Indian businesses were paying for websites that were built once and then completely abandoned &mdash; launched without technical SEO, without Answer Engine Optimization (AEO for Google AI Overviews and Perplexity), without Generative Engine Optimization (GEO for ChatGPT and Gemini), and without verified Google Business Profiles. The sites existed in name, but brought zero real inquiries.
            </p>
            <p>
              InfoHQ was founded to provide an engineering partner that <strong>stays with clients post-launch</strong>. We engineer digital platforms with built-in discoverability, deep schema architecture, and bank-grade security &mdash; and then keep dedicated engineers on retainer to continuously deploy features, scale databases, and protect uptime.
            </p>
            <div class="story-stand-statement">
              <span class="statement-bar" aria-hidden="true"></span>
              <p class="statement-text">&ldquo;We don't build software and disappear. We engineer real systems and stand with our clients through every stage of growth.&rdquo;</p>
            </div>
          </div>
        </article>
      </div>
    </div>
  </section>

  <!-- 2.5 OFFICIAL CHANNELS & SOCIAL HUBS (LinkedIn, Instagram, YouTube) -->
  <section class="section studio-channels-section" aria-labelledby="channels-heading">
    <div class="container">
      <div class="section-header channels-header">
        <h2 id="channels-heading">Connect with <span class="text-gradient">InfoHQ</span></h2>
        <p class="channels-subheadline">
          Explore our real-world builds, technical breakdowns, engineering teardowns, and behind-the-scenes culture across our official channels.
        </p>
      </div>

      <div class="channels-grid">
        <!-- LinkedIn -->
        <a 
          href="https://www.linkedin.com/company/infohq/" 
          target="_blank" 
          rel="noopener noreferrer" 
          class="channel-card linkedin-card"
          aria-label="Connect with InfoHQ on LinkedIn (opens in new tab)"
        >
          <div class="channel-top">
            <div class="channel-icon-wrap linkedin-icon-wrap">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.46 10.9v8.37H9.2V10.9H6.46M7.83 6.25c-.95 0-1.72.78-1.72 1.73s.77 1.73 1.72 1.73 1.73-.78 1.73-1.73-.78-1.73-1.73-1.73z"/>
              </svg>
            </div>
            <div class="channel-meta">
              <span class="channel-platform">LinkedIn</span>
              <span class="channel-handle">company/infohq</span>
            </div>
          </div>
          <p class="channel-desc">
            Technical teardowns, architecture case studies, studio milestones, and engineering insights for CTOs and founders.
          </p>
          <div class="channel-link">
            <span>Connect on LinkedIn</span>
            <span class="channel-arrow" aria-hidden="true">&rarr;</span>
          </div>
        </a>

        <!-- Instagram -->
        <a 
          href="https://www.instagram.com/infohq.in/" 
          target="_blank" 
          rel="noopener noreferrer" 
          class="channel-card instagram-card"
          aria-label="Follow InfoHQ on Instagram @infohq.in (opens in new tab)"
        >
          <div class="channel-top">
            <div class="channel-icon-wrap instagram-icon-wrap">
              <svg width="22" height="22" viewBox="0 0 24 24" aria-hidden="true">
                <defs>
                  <linearGradient id="ig-ch-grad" x1="0%" y1="100%" x2="100%" y2="0%">
                    <stop offset="0%" stop-color="#FFD521"/>
                    <stop offset="25%" stop-color="#F50000"/>
                    <stop offset="50%" stop-color="#B900B4"/>
                    <stop offset="100%" stop-color="#7200FF"/>
                  </linearGradient>
                </defs>
                <path fill="url(#ig-ch-grad)" d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
              </svg>
            </div>
            <div class="channel-meta">
              <span class="channel-platform">Instagram</span>
              <span class="channel-handle">@infohq.in</span>
            </div>
          </div>
          <p class="channel-desc">
            Studio life across Pune & Prayagraj, interactive UI prototypes, motion design demos, and builder reels.
          </p>
          <div class="channel-link">
            <span>Follow @infohq.in</span>
            <span class="channel-arrow" aria-hidden="true">&rarr;</span>
          </div>
        </a>

        <!-- YouTube -->
        <a 
          href="https://www.youtube.com/@infohq28" 
          target="_blank" 
          rel="noopener noreferrer" 
          class="channel-card youtube-card"
          aria-label="Subscribe to InfoHQ on YouTube @infohq28 (opens in new tab)"
        >
          <div class="channel-top">
            <div class="channel-icon-wrap youtube-icon-wrap">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
              </svg>
            </div>
            <div class="channel-meta">
              <span class="channel-platform">YouTube</span>
              <span class="channel-handle">@infohq28</span>
            </div>
          </div>
          <p class="channel-desc">
            Deep-dive system breakdowns, autonomous AI tutorials, production deployment walkthroughs, and code sessions.
          </p>
          <div class="channel-link">
            <span>Watch on YouTube</span>
            <span class="channel-arrow" aria-hidden="true">&rarr;</span>
          </div>
        </a>
      </div>
    </div>
  </section>

  <!-- 3. MISSION AND VISION -->
  <section class="section mission-vision-section" aria-labelledby="mv-heading">
    <div class="container">
      <div class="section-header mv-header">
        <h2 id="mv-heading">Mission and <span class="text-gradient">vision</span></h2>
        <p class="mv-subheadline">
          The principles that guide everything we build, every decision we make, and the impact we strive to create.
        </p>
      </div>
      <div class="mv-grid">
        <article class="card mv-card">
          <div class="mv-card-top">
            <span class="mv-accent-bar" aria-hidden="true"></span>
            <span class="mv-num">01</span>
          </div>
          <span class="mv-card-eyebrow">Mission</span>
          <h3>To empower every growing business <span class="text-gradient">in India</span></h3>
          <p>
            To give every growing business in India access to engineering-grade AI, software and digital infrastructure, without needing an in-house tech team.
          </p>
        </article>

        <article class="card mv-card">
          <div class="mv-card-top">
            <span class="mv-accent-bar" aria-hidden="true"></span>
            <span class="mv-num">02</span>
          </div>
          <span class="mv-card-eyebrow">Vision</span>
          <h3>A future where any business <span class="text-gradient">in India</span> thrives</h3>
          <p>
            A future where any business in India, whatever its size, runs on well-built, secure and maintainable technology that it fully owns &mdash; and is easily discoverable through SEO, AEO and GEO.
          </p>
        </article>
      </div>
    </div>
  </section>

  <!-- 4. WHAT MAKES US DIFFERENT & HOW WE WORK -->
  <section class="section section-alt diff-values-section" aria-labelledby="diff-heading">
    <div class="container">
      <!-- What Makes Us Different -->
      <div class="section-header diff-header">
        <h2 id="diff-heading">What makes us <span class="text-gradient">different</span></h2>
        <p class="diff-subheadline">
          We're not just another development studio. Here's what sets InfoHQ apart and helps our clients grow with confidence.
        </p>
      </div>
      <div class="diff-grid">
        {differentiators.map((diff, idx) => (
          <article class="card diff-card">
            <div class="diff-card-header">
              <span class="diff-accent-bar" aria-hidden="true"></span>
              <span class="diff-num">0{idx + 1}</span>
            </div>
            <h3>{diff.title}</h3>
            {diff.body && <p>{diff.body}</p>}
          </article>
        ))}
      </div>

      <!-- Values / How We Work -->
      <div class="values-wrapper">
        <div class="section-header values-header">
          <h2 id="values-heading">How we <span class="text-gradient">work</span></h2>
          <p class="values-subheadline">
            The principles that guide every project, every decision, and every long-term partnership we build.
          </p>
        </div>
        <div class="values-grid">
          {values.map((val, idx) => (
            <article class="card value-card">
              <div class="value-card-header">
                <span class="value-accent-bar" aria-hidden="true"></span>
                <span class="value-num">0{idx + 1}</span>
              </div>
              <h3>{val.title}</h3>
              <p>{val.desc}</p>
            </article>
          ))}
        </div>
        <div class="section-action text-center">
          <Button
            variant="secondary"
            tone="light"
            size="md"
            href="/pricing/"
            label="See our pricing"
            icon="arrow"
            id="values-pricing-link"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- 5. WHERE WE WORK (Presence with 100% Survey of India Vector Map) -->
  <section class="section operations-section" aria-labelledby="locations-heading">
    <div class="container">
      <div class="presence-grid">
        <!-- Left Column: Header + 2 Cards -->
        <div class="presence-left">
          <div class="presence-header">
            <h2 id="locations-heading" class="presence-title">
              Where we <span class="text-gradient">work</span>
            </h2>
            <p class="presence-subheadline">
              Headquartered in Prayagraj, InfoHQ partners with ambitious businesses across India &mdash; engineering high-performance software, modern web platforms, and intelligent AI systems built for measurable growth and long-term partnership.
            </p>
          </div>

          <div class="presence-cards">
            <!-- Card 1: Headquarters -->
            <article class="card presence-card hq-card">
              <div class="card-top-meta">
                <span class="card-accent-bar accent-purple" aria-hidden="true"></span>
                <span class="card-tag">HEADQUARTERS</span>
                <h3>Prayagraj,<br />Uttar Pradesh</h3>
              </div>
              <div class="hq-image-wrap">
                <img
                  src="/images/prayagraj-bridge.jpg"
                  alt="New Yamuna Cable-Stayed Bridge in Prayagraj, Uttar Pradesh"
                  class="hq-img"
                  loading="lazy"
                  width="400"
                  height="225"
                />
                <span class="hq-img-badge">
                  <MapPin size={13} stroke-width={2.5} />
                  <span>Prayagraj, Uttar Pradesh</span>
                </span>
              </div>
            </article>

            <!-- Card 2: Service Area -->
            <article class="card presence-card delivery-card">
              <div class="card-top-meta">
                <span class="card-accent-bar accent-blue" aria-hidden="true"></span>
                <span class="card-tag">SERVICE AREA</span>
                <h3>Pan-India delivery</h3>
                <p>
                  We deliver remotely to clients anywhere in India, with the same dedicated team and consistent support.
                </p>
              </div>

              <div class="stats-row">
                <div class="stat-box">
                  <span class="stat-number stat-purple">28+</span>
                  <span class="stat-label">States</span>
                </div>
                <div class="stat-box">
                  <span class="stat-number stat-blue">100+</span>
                  <span class="stat-label">Cities</span>
                </div>
                <div class="stat-box">
                  <span class="stat-number stat-dark">Remote<br />First</span>
                  <span class="stat-label stat-delivery">
                    <span class="green-dot" aria-hidden="true"></span>
                    <span>Delivery</span>
                  </span>
                </div>
              </div>
            </article>
          </div>
        </div>

        <!-- Right Column: Official Survey of India Map with continuous flying lines -->
        <div class="presence-right">
          <IndiaMapGraphic />
        </div>
      </div>
    </div>
  </section>

  <!-- 6. FAQ -->
  <section class="section section-alt faq-section" aria-labelledby="faq-heading">
    <div class="container faq-container">
      <div class="section-header">
        <h2 id="faq-heading">Frequently Asked Questions</h2>
      </div>
      <div class="faq-accordion">
        {faqs.map((faq) => (
          <details class="faq-item">
            <summary class="faq-question">
              <strong>{faq.q}</strong>
              <span class="faq-icon" aria-hidden="true">+</span>
            </summary>
            <div class="faq-answer">
              <p>{faq.a}</p>
            </div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- 9. FINAL CTA -->
  <FinalCTA page="company" />
</BaseLayout>

<style>
  /* Section Spacing & Headers (tightened to match site-wide baseline) */
  .section {
    padding-top: clamp(1.75rem, 2.5vw, 2.25rem);
    padding-bottom: clamp(1.75rem, 2.5vw, 2.25rem);
  }

  .section-header {
    text-align: center;
    max-width: 780px;
    margin: 0 auto clamp(1.25rem, 2vw, 1.75rem);
  }

  .section-header h2 {
    font-size: var(--text-4xl);
    font-weight: 800;
    letter-spacing: -0.025em;
    margin: 0.25rem 0 0.5rem;
  }

  .section-header p {
    font-size: var(--text-base);
    color: var(--color-text-muted);
    margin: 0;
  }

  /* 1. Hero */
  .company-hero {
    padding-top: clamp(2.25rem, 3.5vw, 3rem);
    padding-bottom: clamp(1.5rem, 2.5vw, 2rem);
    text-align: center;
  }

  .company-headline {
    margin: 0.5rem auto 1rem;
    font-size: var(--text-5xl);
    max-width: 960px;
    line-height: 1.15;
  }

  .company-subheadline {
    font-size: var(--text-lg);
    color: var(--color-text-body);
    max-width: 760px;
    margin: 0 auto clamp(1.25rem, 2.2vw, 1.75rem);
    line-height: 1.6;
  }

  .hero-actions {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    flex-wrap: wrap;
  }

  /* 2. Narrative Grid: Who We Are & Story (Spans full container width) */
  .narrative-section {
    padding-bottom: clamp(1rem, 1.6vw, 1.5rem);
  }

  .narrative-grid {
    display: grid;
    grid-template-columns: 1fr 1.15fr;
    gap: clamp(1.25rem, 2.2vw, 1.85rem);
    width: 100%;
    margin: 0 auto;
    align-items: stretch;
  }

  .narrative-col {
    position: relative;
    background-color: var(--color-surface-white);
    border: 1px solid var(--color-border-card);
    border-radius: clamp(1.25rem, 2vw, 1.65rem);
    padding: clamp(1.5rem, 3vw, 2.25rem);
    box-shadow: 0 10px 30px rgba(124, 92, 232, 0.05), 0 2px 8px rgba(26, 8, 92, 0.02);
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    overflow: hidden;
    isolation: isolate;
    transition: transform 0.25s ease, box-shadow 0.25s ease, border-color 0.25s ease;
  }

  .narrative-col:hover {
    transform: translateY(-3px);
    box-shadow: 0 16px 36px rgba(124, 92, 232, 0.09);
    border-color: rgba(124, 92, 232, 0.28);
  }

  .who-box {
    background: linear-gradient(155deg, #FFFFFF 0%, #FAF8FE 100%);
  }

  .story-box {
    background: linear-gradient(155deg, #FFFFFF 0%, #FDF9FB 100%);
  }

  .col-header h2 {
    margin: 0 0 1rem;
    font-size: clamp(1.85rem, 2.8vw, 2.35rem);
    font-weight: 800;
    letter-spacing: -0.025em;
    line-height: 1.18;
    color: var(--color-text-heading);
  }

  .body-copy {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    font-size: 0.95rem;
    color: var(--color-text-body);
    line-height: 1.65;
  }

  .body-copy strong {
    color: var(--color-text-heading);
    font-weight: 700;
  }

  .story-stand-statement {
    display: flex;
    align-items: stretch;
    gap: 1rem;
    margin-top: 0.85rem;
    background: linear-gradient(135deg, rgba(124, 92, 232, 0.08) 0%, rgba(221, 73, 133, 0.05) 100%);
    padding: 1rem 1.25rem;
    border-radius: var(--radius-xl);
    border: 1px solid rgba(124, 92, 232, 0.18);
    box-shadow: 0 4px 16px rgba(124, 92, 232, 0.04);
  }

  .statement-bar {
    width: 4px;
    border-radius: var(--radius-full);
    background: var(--brand-gradient);
    flex-shrink: 0;
  }

  .statement-text {
    font-size: 1rem;
    font-weight: 700;
    color: var(--color-text-heading);
    margin: 0;
    line-height: 1.5;
    letter-spacing: -0.01em;
  }

  .text-link {
    color: var(--color-primary);
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 3px;
    transition: color 0.2s ease;
  }

  .text-link:hover {
    color: var(--color-primary-hover);
  }

  /* 3. Mission & Vision Grid (Spans full container width) */
  .mv-header {
    text-align: center;
    max-width: 800px;
    margin: 0 auto clamp(1.25rem, 2.2vw, 1.85rem);
  }

  .mv-header h2 {
    font-size: clamp(2rem, 3.2vw, 2.5rem);
    font-weight: 800;
    color: var(--color-text-heading);
    letter-spacing: -0.025em;
    margin: 0.25rem 0 0.5rem;
  }

  .mv-subheadline {
    font-size: clamp(0.95rem, 1.25vw, 1.02rem);
    color: var(--color-text-body);
    line-height: 1.6;
    max-width: 680px;
    margin: 0 auto;
  }

  .mv-grid {
    width: 100%;
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: clamp(1rem, 1.8vw, 1.5rem);
  }

  .mv-card {
    position: relative;
    padding: clamp(1.25rem, 2vw, 1.65rem);
    background-color: var(--color-surface-white);
    border: 1px solid rgba(124, 92, 232, 0.12);
    border-radius: 18px;
    box-shadow: 0 8px 22px rgba(124, 92, 232, 0.04), 0 1px 3px rgba(26, 8, 92, 0.02);
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    transition: transform 0.22s ease, box-shadow 0.22s ease, border-color 0.22s ease;
  }

  .mv-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 14px 30px rgba(124, 92, 232, 0.09);
    border-color: rgba(124, 92, 232, 0.3);
  }

  .mv-card-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 0.75rem;
  }

  .mv-accent-bar {
    width: 36px;
    height: 3px;
    border-radius: var(--radius-full);
    background: var(--brand-gradient);
    display: inline-block;
  }

  .mv-num {
    font-size: 1.5rem;
    font-weight: 800;
    color: #8CA8F8;
    line-height: 1;
    letter-spacing: -0.02em;
  }

  .mv-card-eyebrow {
    font-size: 0.78rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-primary);
    margin-bottom: 0.4rem;
    display: inline-block;
  }

  .mv-card h3 {
    font-size: clamp(1.15rem, 1.6vw, 1.38rem);
    font-weight: 800;
    margin: 0 0 0.55rem;
    color: var(--color-text-heading);
    letter-spacing: -0.02em;
    line-height: 1.25;
  }

  .mv-card p {
    font-size: 0.92rem;
    line-height: 1.6;
    color: var(--color-text-body);
    margin: 0;
  }

  /* 4. What Makes Us Different */
  .diff-header {
    text-align: center;
    max-width: 800px;
    margin: 0 auto clamp(1.25rem, 2.2vw, 1.85rem);
  }

  .diff-header h2 {
    font-size: clamp(2rem, 3.2vw, 2.5rem);
    font-weight: 800;
    color: var(--color-text-heading);
    letter-spacing: -0.025em;
    margin: 0.25rem 0 0.5rem;
  }

  .diff-subheadline {
    font-size: clamp(0.95rem, 1.25vw, 1.02rem);
    color: var(--color-text-body);
    line-height: 1.6;
    max-width: 680px;
    margin: 0 auto;
  }

  .diff-grid {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: clamp(0.85rem, 1.4vw, 1.25rem);
    width: 100%;
    margin: 0 auto;
  }

  .diff-card {
    flex: 0 0 calc((100% - 2 * clamp(0.85rem, 1.4vw, 1.25rem)) / 3);
    max-width: calc((100% - 2 * clamp(0.85rem, 1.4vw, 1.25rem)) / 3);
    background-color: var(--color-surface-white);
    border: 1px solid rgba(124, 92, 232, 0.12);
    border-radius: 16px;
    padding: clamp(1.15rem, 1.6vw, 1.45rem);
    box-shadow: 0 8px 22px rgba(124, 92, 232, 0.04), 0 1px 3px rgba(26, 8, 92, 0.02);
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    transition: transform 0.22s ease, box-shadow 0.22s ease, border-color 0.22s ease;
  }

  .diff-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 14px 30px rgba(124, 92, 232, 0.09);
    border-color: rgba(124, 92, 232, 0.3);
  }

  .diff-card-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 0.75rem;
  }

  .diff-accent-bar {
    width: 36px;
    height: 3px;
    border-radius: var(--radius-full);
    background: var(--brand-gradient);
    display: inline-block;
  }

  .diff-num {
    font-size: 1.45rem;
    font-weight: 800;
    color: #8CA8F8;
    line-height: 1;
    letter-spacing: -0.02em;
  }

  .diff-card h3 {
    font-size: 1.06rem;
    font-weight: 800;
    margin: 0 0 0.35rem;
    color: var(--color-text-heading);
    letter-spacing: -0.015em;
    line-height: 1.3;
  }

  .diff-card p {
    font-size: 0.88rem;
    color: var(--color-text-body);
    line-height: 1.5;
    margin: 0;
  }

  /* 5. Values (How We Work) */
  .values-wrapper {
    margin-top: clamp(2rem, 3.2vw, 2.75rem);
  }

  .values-header {
    text-align: center;
    max-width: 800px;
    margin: 0 auto clamp(1.25rem, 2.2vw, 1.85rem);
  }

  .values-header h2 {
    font-size: clamp(2rem, 3.2vw, 2.5rem);
    font-weight: 800;
    color: var(--color-text-heading);
    letter-spacing: -0.025em;
    margin: 0.25rem 0 0.5rem;
  }

  .values-subheadline {
    font-size: clamp(0.95rem, 1.25vw, 1.02rem);
    color: var(--color-text-body);
    line-height: 1.6;
    max-width: 680px;
    margin: 0 auto;
  }

  .values-grid {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: clamp(0.85rem, 1.4vw, 1.25rem);
    width: 100%;
    margin: 0 auto clamp(1.5rem, 2.5vw, 2rem);
  }

  .value-card {
    flex: 0 0 calc((100% - 2 * clamp(0.85rem, 1.4vw, 1.25rem)) / 3);
    max-width: calc((100% - 2 * clamp(0.85rem, 1.4vw, 1.25rem)) / 3);
    background-color: var(--color-surface-white);
    border: 1px solid rgba(124, 92, 232, 0.12);
    border-radius: 16px;
    padding: clamp(1.15rem, 1.6vw, 1.45rem);
    box-shadow: 0 8px 22px rgba(124, 92, 232, 0.04), 0 1px 3px rgba(26, 8, 92, 0.02);
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    transition: transform 0.22s ease, box-shadow 0.22s ease, border-color 0.22s ease;
  }

  .value-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 14px 30px rgba(124, 92, 232, 0.09);
    border-color: rgba(124, 92, 232, 0.3);
  }

  .value-card-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 0.75rem;
  }

  .value-accent-bar {
    width: 36px;
    height: 3px;
    border-radius: var(--radius-full);
    background: var(--brand-gradient);
    display: inline-block;
  }

  .value-num {
    font-size: 1.45rem;
    font-weight: 800;
    color: #8CA8F8;
    line-height: 1;
    letter-spacing: -0.02em;
  }

  .value-card h3 {
    font-size: 1.06rem;
    font-weight: 800;
    margin: 0 0 0.35rem;
    color: var(--color-text-heading);
    letter-spacing: -0.015em;
    line-height: 1.3;
  }

  .value-card p {
    font-size: 0.88rem;
    color: var(--color-text-body);
    line-height: 1.5;
    margin: 0;
  }

  .section-action {
    display: flex;
    justify-content: center;
  }

  #values-pricing-link {
    border-radius: var(--radius-full);
    padding: 0.65rem 1.75rem;
    border: 1.5px solid rgba(124, 92, 232, 0.35);
    background: #FFFFFF;
    color: var(--color-text-heading);
    font-weight: 600;
    transition: all 0.22s ease;
  }

  #values-pricing-link:hover {
    border-color: var(--color-primary);
    background: var(--color-primary-subtle);
    transform: translateY(-2px);
    box-shadow: 0 8px 22px rgba(124, 92, 232, 0.12);
  }

  /* 6. Where We Work (Presence Section with 2-Card Grid & Vector India Map) */
  .operations-section {
    position: relative;
    overflow: hidden;
  }

  .presence-grid {
    display: grid;
    grid-template-columns: 1.12fr 1fr;
    gap: clamp(1.75rem, 3.5vw, 3.25rem);
    align-items: center;
    width: 100%;
  }

  .presence-left {
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .presence-title {
    font-size: clamp(2.2rem, 3.8vw, 3rem);
    font-weight: 800;
    color: var(--color-text-heading);
    letter-spacing: -0.025em;
    line-height: 1.15;
    margin: 0 0 1rem;
  }

  .presence-subheadline {
    font-size: clamp(0.96rem, 1.3vw, 1.05rem);
    color: var(--color-text-body);
    line-height: 1.65;
    margin: 0 0 clamp(1.5rem, 2.5vw, 2.25rem);
    max-width: 580px;
  }

  .presence-cards {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: clamp(1rem, 1.8vw, 1.35rem);
    align-items: stretch;
  }

  .presence-card {
    background-color: var(--color-surface-white);
    border: 1px solid var(--color-border-card);
    border-radius: 20px;
    padding: clamp(1.2rem, 1.8vw, 1.55rem);
    box-shadow: 0 10px 28px rgba(124, 92, 232, 0.05), 0 2px 6px rgba(26, 8, 92, 0.02);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    transition: transform 0.22s ease, box-shadow 0.22s ease, border-color 0.22s ease;
  }

  .presence-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 16px 36px rgba(124, 92, 232, 0.09);
    border-color: rgba(124, 92, 232, 0.3);
  }

  .card-accent-bar {
    width: 38px;
    height: 3.5px;
    border-radius: var(--radius-full);
    margin-bottom: 0.85rem;
    display: block;
  }

  .accent-purple {
    background: linear-gradient(90deg, #7C5CE8, #DD4985);
  }

  .accent-blue {
    background: linear-gradient(90deg, #5782E0, #7C5CE8);
  }

  .card-tag {
    font-size: 0.72rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-text-muted);
    margin-bottom: 0.45rem;
    display: block;
  }

  .presence-card h3 {
    font-size: clamp(1.15rem, 1.6vw, 1.35rem);
    font-weight: 800;
    color: var(--color-text-heading);
    letter-spacing: -0.015em;
    line-height: 1.25;
    margin: 0 0 0.85rem;
  }

  .presence-card p {
    font-size: 0.88rem;
    color: var(--color-text-body);
    line-height: 1.55;
    margin: 0 0 1.25rem;
    flex-grow: 1;
  }

  .hq-image-wrap {
    position: relative;
    width: 100%;
    height: 135px;
    border-radius: 14px;
    overflow: hidden;
    margin-top: auto;
    box-shadow: 0 4px 12px rgba(26, 8, 92, 0.08);
  }

  .hq-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.3s ease;
  }

  .presence-card:hover .hq-img {
    transform: scale(1.04);
  }

  .hq-img-badge {
    position: absolute;
    bottom: 8px;
    left: 8px;
    display: inline-flex;
    align-items: center;
    gap: 5px;
    background: rgba(26, 8, 92, 0.78);
    backdrop-filter: blur(8px);
    color: #FFFFFF;
    font-size: 0.72rem;
    font-weight: 600;
    padding: 3px 9px;
    border-radius: var(--radius-full);
    border: 1px solid rgba(255, 255, 255, 0.2);
  }

  .stats-row {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.45rem;
    margin-top: auto;
  }

  .stat-box {
    background: #F8F7FD;
    border: 1px solid rgba(124, 92, 232, 0.1);
    border-radius: 12px;
    padding: 0.65rem 0.4rem;
    text-align: center;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    transition: background-color 0.2s ease, border-color 0.2s ease;
  }

  .stat-box:hover {
    background: #F1EFFE;
    border-color: rgba(124, 92, 232, 0.25);
  }

  .stat-number {
    font-size: 1.25rem;
    font-weight: 800;
    line-height: 1.15;
    letter-spacing: -0.02em;
    margin-bottom: 0.15rem;
  }

  .stat-purple {
    color: #7C5CE8;
  }

  .stat-blue {
    color: #5782E0;
  }

  .stat-dark {
    color: var(--color-text-heading);
    font-size: 0.85rem;
    line-height: 1.1;
    font-weight: 800;
  }

  .stat-label {
    font-size: 0.72rem;
    font-weight: 600;
    color: var(--color-text-muted);
  }

  .stat-delivery {
    display: inline-flex;
    align-items: center;
    gap: 4px;
  }

  .green-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #10B981;
    display: inline-block;
    box-shadow: 0 0 6px rgba(16, 185, 129, 0.6);
  }

  .presence-right {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  /* 7. FAQ */
  .faq-container {
    max-width: 840px;
    margin: 0 auto;
  }

  .faq-accordion {
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }

  .faq-item {
    background: #FFFFFF;
    border: 1px solid var(--color-border-card);
    border-radius: var(--radius-lg);
    overflow: hidden;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .faq-item[open] {
    border-color: rgba(124, 92, 232, 0.35);
    box-shadow: 0 4px 16px rgba(124, 92, 232, 0.06);
  }

  .faq-question {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.95rem 1.25rem;
    font-size: 0.93rem;
    color: var(--color-text-heading);
    cursor: pointer;
    list-style: none;
    user-select: none;
  }

  .faq-question strong {
    font-weight: 700;
    line-height: 1.4;
  }

  .faq-question::-webkit-details-marker {
    display: none;
  }

  .faq-icon {
    font-size: 1.25rem;
    line-height: 1;
    color: var(--color-primary);
    transition: transform 0.2s ease;
    font-weight: 500;
    flex-shrink: 0;
  }

  .faq-item[open] .faq-icon {
    transform: rotate(45deg);
  }

  .faq-answer {
    padding: 0 1.25rem 1rem;
    font-size: 0.88rem;
    color: var(--color-text-body);
    line-height: 1.6;
  }

  .faq-answer p {
    margin: 0;
  }

  /* Responsive Adjustments */
  @media (max-width: 1023px) {
    .narrative-grid {
      grid-template-columns: 1fr;
    }

    .diff-grid,
    .values-grid {
      gap: 1.15rem;
    }

    .diff-card,
    .value-card {
      flex: 0 0 calc((100% - 1.15rem) / 2);
      max-width: calc((100% - 1.15rem) / 2);
      padding: 1.25rem 1.35rem;
    }

    .presence-grid {
      grid-template-columns: 1fr;
      gap: clamp(1.75rem, 3vw, 2.5rem);
    }

    .presence-right {
      order: 2;
    }
  }

  @media (max-width: 767px) {
    .company-headline {
      font-size: clamp(1.75rem, 6.5vw, 2.25rem);
    }

    .hero-actions {
      flex-direction: column;
      width: 100%;
    }

    .hero-actions :global(.infohq-btn) {
      width: 100%;
    }

    .mv-grid {
      grid-template-columns: 1fr;
      gap: 0.85rem;
    }

    .mv-card {
      padding: 1.15rem 1.25rem;
      border-radius: 14px;
    }

    .mv-num {
      font-size: 1.35rem;
    }

    .mv-card h3 {
      font-size: 1.18rem;
    }

    .mv-card p {
      font-size: 0.88rem;
    }

    .diff-grid,
    .values-grid {
      gap: 0.85rem;
      margin-bottom: 1.75rem;
    }

    .diff-card,
    .value-card {
      flex: 0 0 100%;
      max-width: 100%;
      width: 100%;
      padding: 1.1rem 1.25rem;
      border-radius: 14px;
    }

    .diff-num,
    .value-num {
      font-size: 1.35rem;
    }

    .diff-card h3,
    .value-card h3 {
      font-size: 1.05rem;
    }

    .diff-card p,
    .value-card p {
      font-size: 0.88rem;
    }

    .presence-cards {
      grid-template-columns: 1fr;
      gap: 1.15rem;
    }

    .presence-subheadline {
      margin-bottom: 1.5rem;
    }
  }

  /* 2.5 Official Studio Social Channels Grid (Clean & Responsive) */
  .studio-channels-section {
    padding-top: 0;
    padding-bottom: clamp(1.75rem, 2.5vw, 2.25rem);
  }

  .channels-header {
    margin-bottom: clamp(1.25rem, 2vw, 1.75rem);
  }

  .channels-subheadline {
    font-size: var(--text-base);
    color: var(--color-text-body);
    max-width: 680px;
    margin: 0.35rem auto 0;
    line-height: 1.6;
  }

  .channels-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(1rem, 1.8vw, 1.4rem);
  }

  .channel-card {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: clamp(1.25rem, 1.8vw, 1.6rem);
    background: var(--color-surface-white, #FFFFFF);
    border: 1px solid var(--color-border-card, #EDE8F5);
    border-radius: var(--radius-2xl, 1.25rem);
    text-decoration: none;
    box-shadow: 0 4px 16px rgba(124, 92, 232, 0.04), 0 1px 3px rgba(15, 9, 38, 0.02);
    transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.25s ease, border-color 0.25s ease;
  }

  .channel-card:hover {
