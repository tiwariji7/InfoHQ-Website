---
import type { Page } from 'astro';
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import BlogCard from '../../components/BlogCard.astro';
import NewsletterForm from '../../components/NewsletterForm.astro';
import Button from '../../components/Button.astro';
import { 
  BLOG_CATEGORIES, 
  CATEGORY_KEYS, 
  filterPublishedPosts, 
  sortPostsByDateDesc, 
  formatDate,
  calculateReadingTime,
  getPostUrl,
  POSTS_PER_PAGE,
  type BlogCategory 
} from '../../utils/blog';
import { 
  Brain, 
  Globe, 
  Workflow, 
  Cloud, 
  PenTool, 
  Search, 
  ArrowRight, 
  ChevronLeft, 
  ChevronRight,
  Sparkles 
} from 'lucide-astro';

export async function getStaticPaths({ paginate }: any) {
  const allPosts = await getCollection('blog');
  const published = sortPostsByDateDesc(filterPublishedPosts(allPosts));
  return paginate(published, { pageSize: POSTS_PER_PAGE });
}

interface Props {
  page: Page<CollectionEntry<'blog'>>;
}

const { page } = Astro.props;

// Published posts collection
const allPosts = await getCollection('blog');
const publishedPosts = sortPostsByDateDesc(filterPublishedPosts(allPosts));
const totalPublished = publishedPosts.length;

// Category counts
const categoryCounts: Record<BlogCategory, number> = {
  ai: 0,
  web: 0,
  automation: 0,
  cloud: 0,
  design: 0
};
publishedPosts.forEach((post) => {
  const cat = post.data.category as BlogCategory;
  if (categoryCounts[cat] !== undefined) {
    categoryCounts[cat]++;
  }
});

// Featured post condition: false so all articles display in the consistent 2-card + sidebar grid layout
const showFeatured = false;
const featuredPost = null;

// Grid posts: all articles on current page
const gridPosts = page.data;

// Build search index for zero-dependency client search filter
const searchIndex = publishedPosts.map((p) => {
  const catKey = p.data.category as BlogCategory;
  const catInfo = BLOG_CATEGORIES[catKey];
  return {
    id: p.id,
    title: p.data.title,
    description: p.data.description,
    category: catKey,
    categoryName: catInfo ? catInfo.name : catKey,
    url: getPostUrl(p.data.category, p.id),
    pubDate: formatDate(p.data.pubDate),
    rawDate: new Date(p.data.pubDate).toISOString(),
    readingTime: calculateReadingTime(p.body || ''),
    author: p.data.author || 'InfoHQ Team',
    heroImage: p.data.heroImage || ''
  };
});

const meta = {
  title: 'Blog — Practical AI, Automation & Web Engineering | InfoHQ',
  description: 'In-depth articles, technical notes, and architectural teardowns on AI systems, RAG pipelines, workflow automation, and modern web engineering.'
};
---

<BaseLayout
  title={meta.title}
  description={meta.description}
  schemaType="blogs"
  ogImage="/og/blogs.webp"
  postData={{
    items: publishedPosts.map((p) => ({
      title: p.data.title,
      url: `https://infohq.in${getPostUrl(p.data.category, p.id)}`
    }))
  }}
>
  <!-- 1. Hero Section -->
  <section class="section blogs-hero" aria-labelledby="blogs-heading">
    <div class="container text-center blogs-hero-container">
      <h1 id="blogs-heading" class="blogs-headline">
        Practical Guides to <span class="text-gradient">AI, Software Systems</span> &amp; Automation
      </h1>
      <p class="blogs-subheadline">
        In-depth architectural breakdowns, production notes, and hands-on tutorials from the InfoHQ engineering team in Pune &amp; Prayagraj. Learn how we build, automate, and scale real digital products.
      </p>

      <!-- Client-side search box -->
      <div class="blogs-search-wrapper">
        <form class="blogs-search-form" onsubmit="return false;" role="search" aria-label="Search articles">
          <label for="blog-search-input" class="sr-only">Search articles</label>
          <Search size={18} class="search-input-icon" aria-hidden="true" />
          <input 
            type="search" 
            id="blog-search-input" 
            class="blogs-search-input" 
            placeholder="Search articles by title, topic, or keyword..." 
            autocomplete="off"
          />
          <button type="button" id="search-clear-btn" class="search-clear-btn" aria-label="Clear search" style="display: none;">
            &times;
          </button>
        </form>
      </div>
    </div>
  </section>

  <!-- 2. Category Row (6 Tiles: All posts + 5 categories) -->
  <section class="section category-tiles-section" aria-label="Article categories">
    <div class="container">
      <div class="category-tiles-grid">
        <!-- Tile 1: All Posts (Active) -->
        <a href="/blogs/" class="category-tile active" aria-current="page">
          <div class="tile-text">
            <span class="tile-name">All posts</span>
          </div>
        </a>

        {CATEGORY_KEYS.map((catKey) => {
          const catInfo = BLOG_CATEGORIES[catKey];
          return (
            <a href={`/blogs/${catKey}/`} class="category-tile">
              <div class="tile-text">
                <span class="tile-name">{catInfo.name}</span>
              </div>
            </a>
          );
        })}
      </div>
    </div>
  </section>

  <!-- Live Search Results Container (Hidden until search input has text) -->
  <section id="search-results-section" class="section search-results-section" style="display: none;" aria-label="Search Results">
    <div class="container">
      <div class="search-results-header">
        <h2 class="search-results-title">
          Search Results for <span id="search-query-text" class="text-gradient"></span>
        </h2>
        <p id="search-count-text" class="search-count-text"></p>
      </div>
      <div id="search-results-grid" class="search-results-grid"></div>
      <div id="search-no-results" class="empty-search-state" style="display: none;">
        <p>No articles found matching your query. Try a different keyword or category.</p>
      </div>
    </div>
  </section>

  <!-- Main Content Wrapper (SSR) -->
  <div id="main-blog-content" class="main-blog-content">
    <!-- 3. Featured Block (Only rendered if total published posts >= 3) -->
    {showFeatured && featuredPost && (
      <section class="section featured-post-section" aria-labelledby="featured-heading">
        <div class="container">
          <div class="featured-section-header">
            <span class="text-eyebrow">Featured Story</span>
            <h2 id="featured-heading" class="sr-only">Featured Article</h2>
          </div>
          <BlogCard post={featuredPost} featured={true} />
        </div>
      </section>
    )}

    <!-- 4. Latest Articles Grid + Right Sidebar -->
    <section class="section latest-articles-section" aria-labelledby="latest-articles-heading">
      <div class="container">
        <div class="blog-two-col-layout">
          <!-- Left Column: Articles Grid -->
          <div class="articles-main-col">
            <div class="articles-col-header">
              <h2 id="latest-articles-heading" class="section-title">
                Latest <span class="text-gradient">Articles</span>
              </h2>
            </div>

            <div class="articles-grid">
              {gridPosts.map((post) => (
                <BlogCard post={post} />
              ))}
            </div>

            <!-- Numbered Pagination (only rendered if page.lastPage > 1) -->
            {page.lastPage > 1 && (
              <nav class="pagination-bar" aria-label="Pagination Navigation">
                {page.url.prev ? (
                  <a href={page.url.prev} rel="prev" class="pagination-btn pagination-prev">
                    <ChevronLeft size={16} /> Previous
                  </a>
                ) : (
                  <span class="pagination-btn disabled">
                    <ChevronLeft size={16} /> Previous
                  </span>
                )}

                <div class="pagination-numbers">
                  {Array.from({ length: page.lastPage }, (_, i) => i + 1).map((num) => {
                    const isCurrent = num === page.currentPage;
                    const pageUrl = num === 1 ? '/blogs/' : `/blogs/${num}/`;
                    return isCurrent ? (
                      <span class="page-num active" aria-current="page">{num}</span>
                    ) : (
                      <a href={pageUrl} class="page-num">{num}</a>
                    );
                  })}
                </div>

                {page.url.next ? (
                  <a href={page.url.next} rel="next" class="pagination-btn pagination-next">
                    Next <ChevronRight size={16} />
                  </a>
                ) : (
                  <span class="pagination-btn disabled">
                    Next <ChevronRight size={16} />
                  </span>
                )}
              </nav>
            )}
          </div>

          <!-- Right Sidebar -->
          <aside class="blog-sidebar" aria-label="Blog Sidebar">
            <!-- Sidebar Card A: Categories with real post counts -->
            <div class="card sidebar-card categories-card">
              <h3 class="sidebar-card-title">Categories</h3>
              <ul class="categories-list">
                {CATEGORY_KEYS.map((catKey) => {
                  const catInfo = BLOG_CATEGORIES[catKey];
                  const count = categoryCounts[catKey] || 0;
                  return (
                    <li>
                      <a href={`/blogs/${catKey}/`} class="category-item-link">
                        <span class="cat-link-left">
                          {catKey === 'ai' && <Brain size={16} class="cat-link-icon" />}
                          {catKey === 'web' && <Globe size={16} class="cat-link-icon" />}
                          {catKey === 'automation' && <Workflow size={16} class="cat-link-icon" />}
                          {catKey === 'cloud' && <Cloud size={16} class="cat-link-icon" />}
                          {catKey === 'design' && <PenTool size={16} class="cat-link-icon" />}
                          <span class="cat-link-name">{catInfo.name}</span>
                        </span>
                        <span class={`cat-badge ${count === 0 ? 'badge-soon' : 'badge-count'}`}>
                          {count === 0 ? 'Soon' : count}
                        </span>
                      </a>
                    </li>
                  );
                })}
              </ul>
            </div>

            <!-- Sidebar Card B: Newsletter Card (Reusing existing NewsletterForm) -->
            <div class="card sidebar-card newsletter-sidebar-card">
              <div class="newsletter-card-glow" aria-hidden="true"></div>
              <h3 class="newsletter-sidebar-title">Engineering Notes in <span class="text-gradient">Your Inbox</span></h3>
              <p class="newsletter-sidebar-desc">
                Architecture teardowns, automation playbooks, and production AI notes. No spam.
              </p>
              <div class="sidebar-newsletter-form-wrap">
                <NewsletterForm />
              </div>
            </div>

            <!-- Sidebar Card C: Project Scoping CTA -->
            <div class="card sidebar-card cta-sidebar-card">
              <h3 class="cta-sidebar-title">
                Have a Project That Needs <span class="text-gradient">Real Engineering?</span>
              </h3>
              <p class="cta-sidebar-desc">
                From fast MVPs to enterprise AI systems and continuous retainers — let's build your next success story.
              </p>
              <div class="cta-sidebar-action">
                <Button
                  variant="primary"
                  size="md"
                  href="/contact"
                  label="Discuss Your Project"
                  icon="arrow"
                  fullWidth={true}
                />
              </div>
            </div>
          </aside>
        </div>
      </div>
    </section>
  </div>


  <!-- Search index data for lightweight vanilla JS search -->
  <script id="blog-search-data" type="application/json" set:html={JSON.stringify(searchIndex)} />
</BaseLayout>

<script>
  function initBlogSearch() {
    const input = document.getElementById('blog-search-input') as HTMLInputElement | null;
    const clearBtn = document.getElementById('search-clear-btn');
    const resultsSection = document.getElementById('search-results-section');
    const mainContent = document.getElementById('main-blog-content');
    const resultsGrid = document.getElementById('search-results-grid');
    const queryText = document.getElementById('search-query-text');
    const countText = document.getElementById('search-count-text');
    const noResults = document.getElementById('search-no-results');
    const dataScript = document.getElementById('blog-search-data');

    if (!input || !resultsSection || !mainContent || !resultsGrid || !dataScript) return;

    let searchData: any[] = [];
    try {
      searchData = JSON.parse(dataScript.textContent || '[]');
    } catch (e) {
      searchData = [];
    }

    function runSearch() {
      const q = (input?.value || '').trim().toLowerCase();

      if (!q) {
        resultsSection.style.display = 'none';
        mainContent.style.display = 'block';
        if (clearBtn) clearBtn.style.display = 'none';
        return;
      }

      if (clearBtn) clearBtn.style.display = 'block';
      resultsSection.style.display = 'block';
      mainContent.style.display = 'none';

      if (queryText) queryText.textContent = `"${input?.value.trim()}"`;

      const matches = searchData.filter((item) => {
        return (
          item.title.toLowerCase().includes(q) ||
          item.description.toLowerCase().includes(q) ||
          item.category.toLowerCase().includes(q) ||
          item.categoryName.toLowerCase().includes(q)
        );
      });

      if (countText) {
        countText.textContent = `${matches.length} article${matches.length === 1 ? '' : 's'} found`;
      }

      if (matches.length === 0) {
        resultsGrid.innerHTML = '';
        if (noResults) noResults.style.display = 'block';
      } else {
        if (noResults) noResults.style.display = 'none';
        resultsGrid.innerHTML = matches
          .map((m) => `
            <article class="blog-card">
              <a href="${m.url}" class="card-link-overlay" aria-label="Read ${m.title}"></a>
              <div class="card-cover-wrap">
                ${m.heroImage ? `
                  <img src="${m.heroImage}" alt="${m.title}" class="card-cover-image" loading="lazy" decoding="async" />
                ` : `
                  <div class="card-cover-fallback cat-${m.category}">
                    <div class="fallback-glow" aria-hidden="true"></div>
                    <div class="fallback-icon-wrap" aria-hidden="true" style="font-size: 1.5rem; font-weight: 700; color: var(--color-primary);">
                      ${m.categoryName}
                    </div>
                  </div>
                `}
              </div>
              <div class="card-content">
                <div class="card-header-meta">
                  <span class="card-date-badge">
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="date-icon" aria-hidden="true">
                      <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                      <line x1="16" y1="2" x2="16" y2="6"></line>
                      <line x1="8" y1="2" x2="8" y2="6"></line>
                      <line x1="3" y1="10" x2="21" y2="10"></line>
                    </svg>
                    <time datetime="${m.rawDate}">${m.pubDate}</time>
                  </span>
                </div>
                <h3 class="card-title">
                  <a href="${m.url}">${m.title}</a>
                </h3>
                <p class="card-description">${m.description}</p>
                <div class="card-footer">
                  <div class="card-footer-meta">
                    <img src="/images/favicon.webp" alt="InfoHQ" class="meta-author-avatar" width="20" height="20" loading="lazy" />
                    <span class="meta-author">${m.author}</span>
                    <span class="meta-sep" aria-hidden="true">•</span>
                    <span class="meta-read-time">${m.readingTime}</span>
                  </div>
                  <div class="card-read-action" aria-hidden="true">
                    <span class="read-article-text">Read Article</span>
                    <span class="read-arrow-badge">
                      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="read-svg-arrow">
                        <line x1="5" y1="12" x2="19" y2="12"></line>
                        <polyline points="12 5 19 12 12 19"></polyline>
                      </svg>
                    </span>
                  </div>
                </div>
              </div>
            </article>
          `)
          .join('');
      }
    }

    input.addEventListener('input', runSearch);

    if (clearBtn) {
      clearBtn.addEventListener('click', () => {
        input.value = '';
        runSearch();
        input.focus();
      });
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initBlogSearch);
  } else {
    initBlogSearch();
  }
</script>

<style>
  :global(.meta-author-avatar) {
    border-radius: 50% !important;
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .blogs-hero {
    background: radial-gradient(circle at 80% 20%, rgba(221, 73, 133, 0.08) 0%, transparent 50%),
                radial-gradient(circle at 20% 50%, rgba(124, 92, 232, 0.08) 0%, transparent 50%);
    margin-top: calc(-1 * clamp(72px, 7vw, 84px));
    padding-top: calc(clamp(3rem, 5vw, 4.5rem) + clamp(72px, 7vw, 84px));
    padding-bottom: clamp(2.5rem, 4vw, 3.5rem);
    text-align: center;
    position: relative;
  }

  @media (max-width: 1023px) {
    .blogs-hero {
      margin-top: calc(-1 * clamp(68px, 8vw, 76px));
      padding-top: calc(clamp(2.5rem, 4.5vw, 3.5rem) + clamp(68px, 8vw, 76px));
    }
  }

  @media (max-width: 640px) {
    .blogs-hero {
      margin-top: -68px;
      padding-top: calc(2rem + 68px);
    }

    .blogs-headline {
      font-size: clamp(1.75rem, 6.5vw, 2.25rem);
    }
  }

  .blogs-hero-container {
    max-width: 860px;
    margin: 0 auto;
  }

  .blogs-headline {
    margin: 0.75rem auto 1.25rem;
    font-size: var(--text-5xl);
    font-weight: 800;
    line-height: 1.15;
    letter-spacing: -0.02em;
    color: var(--color-text-heading);
    max-width: 840px;
  }

  .blogs-subheadline {
    font-size: var(--text-lg);
    line-height: 1.65;
    color: var(--color-text-body);
    max-width: 760px;
    margin: 0 auto 2.25rem;
  }

  /* Search Box */
  .blogs-search-wrapper {
    max-width: 540px;
    margin: 0 auto;
  }

  .blogs-search-form {
    position: relative;
    display: flex;
    align-items: center;
    background: var(--color-surface-white);
    border: 1px solid var(--color-border-card);
    border-radius: var(--radius-full);
    padding: 6px 16px 6px 44px;
    box-shadow: var(--shadow-sm);
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .blogs-search-form:focus-within {
    border-color: var(--color-primary);
    box-shadow: 0 0 0 3px rgba(124, 92, 232, 0.12);
  }

  .search-input-icon {
    position: absolute;
    left: 18px;
    color: #8C80B5;
    pointer-events: none;
  }

  .blogs-search-input {
    width: 100%;
    border: none;
    background: transparent;
    font-size: 0.9375rem;
    color: var(--color-text-heading);
    outline: none;
    padding: 6px 0;
  }

  .blogs-search-input::placeholder {
    color: #8C80B5;
  }

  .search-clear-btn {
    border: none;
    background: transparent;
    color: #8C80B5;
    font-size: 1.25rem;
    cursor: pointer;
    line-height: 1;
    padding: 0 4px;
  }

  .search-clear-btn:hover {
    color: var(--color-text-heading);
  }

  /* 2. Category Row (6 Tiles) */
  .category-tiles-section {
    padding-top: 0.5rem;
    padding-bottom: 2rem;
  }

  .category-tiles-grid {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 10px;
  }

  .category-tile {
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 10px 12px;
    min-height: 52px;
    background: var(--color-surface-white);
    border: 1px solid var(--color-border-card);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-sm);
    text-decoration: none;
    transition: transform 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .category-tile:hover {
    transform: translateY(-2px);
    border-color: rgba(124, 92, 232, 0.4);
    box-shadow: var(--shadow-md);
  }

  .category-tile.active {
    border-color: var(--color-primary);
    background: linear-gradient(180deg, #FAF8FD 0%, #FFFFFF 100%);
  }

  .tile-icon-wrap {
    width: 32px;
    height: 32px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: var(--radius-sm);
    background: linear-gradient(135deg, rgba(124, 92, 232, 0.12) 0%, rgba(145, 79, 187, 0.18) 100%);
    color: var(--color-primary);
    margin-bottom: 8px;
  }

  .tile-text {
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    width: 100%;
  }

  .tile-name {
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--color-text-heading);
    line-height: 1.3;
  }

  .tile-desc {
    font-size: 0.75rem;
    color: #6E6888;
    line-height: 1.35;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* Search Results Section */
  .search-results-section {
    padding-top: 2rem;
    padding-bottom: 4rem;
  }

  .search-results-header {
    margin-bottom: 2rem;
  }

  .search-results-title {
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--color-text-heading);
    margin: 0 0 0.5rem 0;
  }

  .search-count-text {
    font-size: 0.9375rem;
    color: #6E6888;
    margin: 0;
  }

  .search-results-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }

  .search-results-grid :global(.card-date-badge) {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 4px 10px;
    border-radius: 9999px;
    font-size: 0.75rem;
    font-weight: 600;
    line-height: 1;
    background: #F4F0FA;
    color: #5B4A80;
    border: 1px solid rgba(124, 92, 232, 0.15);
  }

  .search-results-grid :global(.date-icon) {
    flex-shrink: 0;
    color: var(--color-primary, #7C5CE8);
  }

  .search-results-grid :global(.card-read-action) {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    white-space: nowrap;
    flex-shrink: 0;
  }

  .search-results-grid :global(.read-article-text) {
    font-size: 0.84rem;
    font-weight: 700;
    color: var(--color-primary, #7C5CE8);
    background: linear-gradient(135deg, #7C5CE8 0%, #B845ED 50%, #DD4985 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    transition: opacity 0.2s ease;
  }

  .search-results-grid :global(.read-arrow-badge) {
    width: 26px;
    height: 26px;
    border-radius: 50%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: rgba(124, 92, 232, 0.08);
    border: 1px solid rgba(124, 92, 232, 0.2);
    color: var(--color-primary, #7C5CE8);
    transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .search-results-grid :global(.read-svg-arrow) {
    transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .search-results-grid :global(.blog-card:hover .read-article-text) {
    opacity: 0.85;
  }

  .search-results-grid :global(.blog-card:hover .read-arrow-badge) {
    background: var(--brand-gradient, linear-gradient(135deg, #7C5CE8 0%, #2563EB 100%));
    border-color: transparent;
    color: #FFFFFF;
    transform: translateX(3px);
    box-shadow: 0 4px 12px rgba(124, 92, 232, 0.35);
  }

  .search-results-grid :global(.blog-card:hover .read-svg-arrow) {
    transform: translateX(1px);
