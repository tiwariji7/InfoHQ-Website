---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import MidCTA from '../../../components/MidCTA.astro';
import BlogCard from '../../../components/BlogCard.astro';
import Button from '../../../components/Button.astro';
import NewsletterForm from '../../../components/NewsletterForm.astro';
import { 
  BLOG_CATEGORIES, 
  CATEGORY_KEYS,
  calculateReadingTime, 
  formatDate, 
  filterPublishedPosts, 
  sortPostsByDateDesc,
  getPostUrl,
  extractFaqsFromBody,
  type BlogCategory 
} from '../../../utils/blog';
import { Brain, Globe, Workflow, Cloud, PenTool } from 'lucide-astro';

export async function getStaticPaths() {
  const allPosts = await getCollection('blog');
  const published = filterPublishedPosts(allPosts);

  return published.map((post) => ({
    params: {
      category: post.data.category,
      slug: post.id
    },
    props: { post }
  }));
}

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { Content } = await render(post);

// Category Info
const categoryKey = post.data.category as BlogCategory;
const categoryInfo = BLOG_CATEGORIES[categoryKey] || {
  id: categoryKey,
  name: categoryKey,
  tagline: '',
  title: '',
  description: '',
  icon: 'LayoutGrid'
};

const readingTime = calculateReadingTime(post.body || '');
const formattedDate = formatDate(post.data.pubDate);
const authorName = post.data.author || 'InfoHQ Team';
const canonicalUrl = `https://infohq.in${getPostUrl(post.data.category, post.id)}`;

// Related posts: Same category first, excluding current post. If not enough, fill with latest.
const allPosts = await getCollection('blog');
const published = sortPostsByDateDesc(filterPublishedPosts(allPosts));
const otherPosts = published.filter((p) => p.id !== post.id);

let relatedPosts = otherPosts.filter((p) => p.data.category === post.data.category);
if (relatedPosts.length < 3) {
  const remaining = otherPosts.filter((p) => !relatedPosts.some((rp) => rp.id === p.id));
  relatedPosts = [...relatedPosts, ...remaining].slice(0, 3);
} else {
  relatedPosts = relatedPosts.slice(0, 3);
}

const categoryCounts = allPosts.reduce((acc, p) => {
  acc[p.data.category] = (acc[p.data.category] || 0) + 1;
  return acc;
}, {} as Record<string, number>);

const faqs = extractFaqsFromBody(post.body || '');

const toDateOnlyISO = (d: Date | string) => new Date(d).toISOString().split('T')[0];
const datePublished = toDateOnlyISO(post.data.pubDate);
const dateModified = post.data.updatedDate ? toDateOnlyISO(post.data.updatedDate) : datePublished;

const postImage = post.data.heroImage || `/og/blogs/${post.id}.jpg`;
const fullPostImageUrl = post.data.heroImage 
  ? `https://infohq.in${post.data.heroImage}`
  : `https://infohq.in/og/blogs/${post.id}.jpg`;

const postSchemaData = {
  headline: post.data.title,
  description: post.data.description,
  authorName: authorName,
  datePublished,
  dateModified,
  url: canonicalUrl,
  image: fullPostImageUrl,
  category: post.data.category,
  categoryName: categoryInfo.name,
  faqs
};

const meta = {
  title: `${post.data.title} | InfoHQ Blog`,
  description: post.data.description,
  keywords: post.data.keywords ? post.data.keywords.join(', ') : undefined,
  canonical: canonicalUrl,
  ogType: 'article' as const,
  ogImage: postImage
};
---

<BaseLayout
  title={meta.title}
  description={meta.description}
  keywords={meta.keywords}
  canonical={meta.canonical}
  ogType={meta.ogType}
  ogImage={meta.ogImage}
  schemaType="blog-post"
  postData={postSchemaData}
>
  <article class="single-post-article">
    <!-- Post Header Header Section -->
    <header class="post-hero-header">
      <div class="container post-header-container">
        <!-- Breadcrumb / Category Pill -->
        <div class="post-pill-nav">
          <a href="/blogs/" class="back-link">&larr; All Articles</a>
          <span class="pill-divider" aria-hidden="true">/</span>
          <a href={`/blogs/${categoryKey}/`} class="category-pill-link">
            {categoryInfo.name}
          </a>
        </div>

        <h1 class="post-main-title">{post.data.title}</h1>

        <p class="post-main-description">{post.data.description}</p>

        <div class="post-meta-bar">
          <span class="meta-item meta-author">{authorName}</span>
          <span class="meta-dot" aria-hidden="true">•</span>
          <time datetime={new Date(post.data.pubDate).toISOString()} class="meta-item meta-date">
            {formattedDate}
          </time>
          <span class="meta-dot" aria-hidden="true">•</span>
          <span class="meta-item meta-reading-time">{readingTime}</span>
        </div>
      </div>
    </header>

    <!-- Post Body Content with full-width container & sidebar matching other pages -->
    <div class="container post-body-container">
      <div class="post-layout-grid">
        <!-- Main Column: Hero Image & Article Prose -->
        <main class="post-main-column">
          {post.data.heroImage && (
            <div class="post-hero-banner">
              <img 
                src={post.data.heroImage} 
                alt={post.data.title} 
                class="post-banner-img" 
                loading="eager"
                decoding="async"
              />
            </div>
          )}
          <div class="prose-body">
            <Content components={{ MidCTA }} />
          </div>
        </main>

        <!-- Sticky Sidebar -->
        <aside class="post-sidebar" aria-label="Article Sidebar">
          <!-- Card 1: Project Scoping CTA -->
          <div class="card sidebar-card cta-sidebar-card">
            <h3 class="sidebar-card-title">
              Have a Project in Mind?
            </h3>
            <p class="cta-sidebar-desc">
              Book a direct conversation with our engineering team in Pune &amp; Prayagraj. No sales pitch, just practical guidance.
            </p>
            <div class="cta-sidebar-action">
              <Button
                variant="gradient"
                size="md"
                href="/contact/"
                label="Book Free Consultation"
                icon="arrow"
                id="blog-post-sidebar-cta"
                fullWidth={true}
              />
            </div>
          </div>

          <!-- Card 2: Categories -->
          <div class="card sidebar-card categories-card">
            <h3 class="sidebar-card-title">Explore Categories</h3>
            <ul class="categories-list">
              {CATEGORY_KEYS.map((catKey) => {
                const catInfo = BLOG_CATEGORIES[catKey];
                const count = categoryCounts[catKey] || 0;
                const isCurrentCat = catKey === categoryKey;
                return (
                  <li>
                    <a href={`/blogs/${catKey}/`} class={`category-item-link ${isCurrentCat ? 'active' : ''}`}>
                      <span class="cat-link-left">
                        {catKey === 'ai' && <Brain size={16} class="cat-link-icon" />}
                        {catKey === 'web' && <Globe size={16} class="cat-link-icon" />}
                        {catKey === 'automation' && <Workflow size={16} class="cat-link-icon" />}
                        {catKey === 'cloud' && <Cloud size={16} class="cat-link-icon" />}
                        {catKey === 'design' && <PenTool size={16} class="cat-link-icon" />}
                        <span class="cat-link-name">{catInfo.name}</span>
                      </span>
                      <span class={`cat-badge ${count === 0 ? 'badge-soon' : 'badge-count'}`}>
                        {count === 0 ? 'Soon' : count}
                      </span>
                    </a>
                  </li>
                );
              })}
            </ul>
          </div>

          <!-- Card 3: Newsletter -->
          <div class="card sidebar-card newsletter-sidebar-card">
            <h3 class="newsletter-sidebar-title">Engineering Notes</h3>
            <p class="newsletter-sidebar-desc">
              Architecture breakdowns, automation playbooks, and production AI notes in your inbox. No spam.
            </p>
            <div class="sidebar-newsletter-form-wrap">
              <NewsletterForm />
            </div>
          </div>
        </aside>
      </div>
    </div>
  </article>

  <!-- Related Posts Section (if any exist) -->
  {relatedPosts.length > 0 && (
    <section class="section related-posts-section" aria-labelledby="related-heading">
      <div class="container">
        <div class="related-section-header">
          <span class="text-eyebrow">Continue Reading</span>
          <h2 id="related-heading" class="related-title">Related <span class="text-gradient">Articles</span></h2>
        </div>
        <div class="related-grid">
          {relatedPosts.map((rPost) => (
            <BlogCard post={rPost} />
          ))}
        </div>
      </div>
    </section>
  )}

</BaseLayout>

<style>
  .single-post-article {
    margin-top: calc(-1 * clamp(72px, 7vw, 84px));
    padding-top: 0;
    padding-bottom: clamp(3rem, 5vw, 5rem);
  }

  .post-hero-header {
    padding-top: calc(clamp(2rem, 4vw, 3.5rem) + clamp(72px, 7vw, 84px));
    padding-bottom: clamp(2rem, 3.5vw, 3rem);
    border-bottom: 1px solid var(--color-border-card);
    background: linear-gradient(180deg, rgba(250, 248, 253, 0.7) 0%, rgba(255, 255, 255, 0) 100%);
  }

  @media (max-width: 1023px) {
    .single-post-article {
      margin-top: calc(-1 * clamp(68px, 8vw, 76px));
    }
    .post-hero-header {
      padding-top: calc(clamp(1.75rem, 3.5vw, 3rem) + clamp(68px, 8vw, 76px));
    }
  }

  @media (max-width: 640px) {
    .single-post-article {
      margin-top: -68px;
    }
    .post-hero-header {
      padding-top: calc(1.5rem + 68px);
    }
    .post-main-title {
      font-size: clamp(1.65rem, 6vw, 2.15rem);
    }
  }

  .post-header-container {
    width: 100%;
    text-align: left;
  }

  .post-pill-nav {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 1.25rem;
    font-size: 0.875rem;
  }

  .back-link {
    color: #6E6888;
    text-decoration: none;
    font-weight: 500;
    transition: color 0.2s ease;
  }

  .back-link:hover {
    color: var(--color-primary);
  }

  .pill-divider {
    color: #BDB7D4;
  }

  .category-pill-link {
    display: inline-block;
    padding: 4px 12px;
    border-radius: var(--radius-full);
    background-color: #F1EDFA;
    color: var(--color-primary);
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    text-decoration: none;
    transition: background-color 0.2s ease;
  }

  .category-pill-link:hover {
    background-color: #E6DEF7;
  }

  .post-main-title {
    font-size: var(--text-5xl);
    font-weight: 800;
    line-height: 1.18;
    letter-spacing: -0.025em;
    color: var(--color-text-heading);
    margin: 0 0 1rem 0;
    max-width: 1050px;
  }

  .post-main-description {
    font-size: clamp(1.05rem, 1.6vw, 1.22rem);
    line-height: 1.6;
    color: var(--color-text-body);
    margin: 0 0 1.5rem 0;
    max-width: 920px;
  }

  .post-meta-bar {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 0.875rem;
    color: #6E6888;
  }

  .meta-author {
    font-weight: 600;
    color: var(--color-text-heading);
  }

  .meta-dot {
    opacity: 0.5;
  }

  /* Full-width Post Body Layout Grid with Sidebar */
  .post-body-container {
    padding-top: clamp(2rem, 3.5vw, 3rem);
    width: 100%;
  }

  .post-layout-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 340px;
    gap: clamp(2rem, 3.5vw, 3.5rem);
    align-items: start;
    width: 100%;
  }

  .post-main-column {
    min-width: 0;
    width: 100%;
  }

  /* Sticky Sidebar */
  .post-sidebar {
    position: sticky;
    top: calc(clamp(72px, 7vw, 84px) + 24px);
    display: flex;
    flex-direction: column;
    gap: 24px;
    min-width: 0;
  }

  .sidebar-card {
    padding: 22px;
    background: #FFFFFF;
    border: 1px solid var(--color-border-card);
    border-radius: var(--radius-xl);
    box-shadow: 0 8px 24px rgba(124, 92, 232, 0.04);
  }

  .sidebar-card-title {
    font-size: 1.1rem;
    font-weight: 800;
    color: var(--color-text-heading);
    margin: 0 0 0.85rem 0;
    line-height: 1.3;
  }

  .cta-sidebar-card .sidebar-card-title {
    font-size: 1.18rem;
  }

  .cta-sidebar-desc,
  .newsletter-sidebar-desc {
    font-size: 0.875rem;
    color: var(--color-text-body);
    line-height: 1.55;
    margin: 0 0 1.25rem 0;
  }

  .categories-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .category-item-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    padding: 8px 12px;
    border-radius: var(--radius-md);
    text-decoration: none;
    color: var(--color-text-heading);
    font-size: 0.875rem;
    font-weight: 600;
    background: #FAF9FE;
    border: 1px solid transparent;
    transition: all 0.2s ease;
  }

  .category-item-link:hover,
  .category-item-link.active {
    background: #F1EDFA;
    border-color: rgba(124, 92, 232, 0.2);
    color: var(--color-primary);
  }

  .cat-link-left {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .cat-link-icon {
    color: var(--color-primary);
    flex-shrink: 0;
  }

  .cat-badge {
    font-size: 0.72rem;
    font-weight: 700;
    padding: 2px 7px;
    border-radius: var(--radius-full);
  }

  .badge-count {
    background: #FFFFFF;
    color: var(--color-primary);
    border: 1px solid rgba(124, 92, 232, 0.2);
  }

  .badge-soon {
    background: #F3F4F6;
    color: #9CA3AF;
  }

  @media (max-width: 1023px) {
    .post-layout-grid {
      grid-template-columns: 1fr;
      gap: 3rem;
    }

    .post-sidebar {
      position: static;
    }
  }

  /* Featured Hero Banner inside Post */
  .post-hero-banner {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    border-radius: var(--radius-xl);
    overflow: hidden;
    margin-bottom: clamp(2rem, 3.5vw, 3rem);
    border: 1px solid var(--color-border-card);
    box-shadow: var(--shadow-md);
    background: #FAF8FD;
  }

  .post-banner-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
  }

  /* Prose Typography - Human, clean, clear hierarchy */
  .prose-body {
    font-size: 1.125rem;
    line-height: 1.8;
    color: #2D274A;
  }

  .prose-body :global(p) {
    margin-top: 0;
    margin-bottom: 1.5rem;
  }

  .prose-body :global(h2) {
    font-size: 1.65rem;
    font-weight: 700;
    line-height: 1.3;
    letter-spacing: -0.015em;
    color: var(--color-text-heading);
    margin-top: 2.75rem;
    margin-bottom: 1rem;
    padding-top: 0.5rem;
  }

  .prose-body :global(h3) {
    font-size: 1.3rem;
    font-weight: 700;
    line-height: 1.35;
    color: var(--color-text-heading);
    margin-top: 2rem;
    margin-bottom: 0.75rem;
  }

  .prose-body :global(ul),
  .prose-body :global(ol) {
    margin-top: 0;
    margin-bottom: 1.5rem;
    padding-left: 1.5rem;
  }

  .prose-body :global(li) {
    margin-bottom: 0.65rem;
    line-height: 1.7;
  }

  .prose-body :global(strong) {
    font-weight: 700;
    color: var(--color-text-heading);
  }

  .prose-body :global(a:not(.infohq-btn)) {
    color: var(--color-primary);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .prose-body :global(a:not(.infohq-btn):hover) {
    color: var(--color-primary-dark);
  }

  .prose-body :global(code) {
    font-family: monospace;
    font-size: 0.9em;
    background: #F1EDFA;
    padding: 2px 6px;
    border-radius: var(--radius-sm);
    color: var(--color-primary-dark);
  }

  .prose-body :global(blockquote) {
    border-left: 4px solid var(--color-primary);
    padding: 12px 20px;
    margin: 1.75rem 0;
    background: #FAF8FD;
    border-radius: 0 var(--radius-md) var(--radius-md) 0;
    font-style: italic;
    color: #4A4268;
  }

  .prose-body :global(blockquote > :last-child) {
    margin-bottom: 0;
  }

  .prose-body :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin: 2rem 0;
    font-size: 0.95rem;
    display: block;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
  }

  .prose-body :global(th),
  .prose-body :global(td) {
    padding: 0.75rem 1rem;
    text-align: left;
    border: 1px solid var(--color-border-card);
    vertical-align: top;
  }

  .prose-body :global(th) {
    background: #FAF8FD;
    font-weight: 700;
    color: var(--color-text-heading);
    white-space: nowrap;
  }

  .prose-body :global(tbody tr:nth-child(even)) {
    background: #FCFBFD;
  }

  /* Related Posts Section */
  .related-posts-section {
    padding-top: 3.5rem;
    padding-bottom: 2rem;
    border-top: 1px solid var(--color-border-card);
    background: #FAF8FD;
  }

  .related-section-header {
    text-align: center;
    margin-bottom: 2.5rem;
  }

  .related-title {
    font-size: clamp(1.75rem, 3vw, 2.25rem);
    font-weight: 800;
    margin: 0.5rem 0 0 0;
    color: var(--color-text-heading);
  }

  .related-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }

  @media (max-width: 991px) {
    .related-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 640px) {
    .related-grid {
      grid-template-columns: 1fr;
    }

    .prose-body {
      font-size: 1.05rem;
      line-height: 1.75;
    }

    .post-main-title {
      font-size: 1.85rem;
    }
  }
</style>
