# InfoHQ Environment Variables Example
# Duplicate this file as .env and fill in your keys

# Meta (Facebook & Instagram) Retargeting Pixel ID
# Find in Meta Events Manager: https://adsmanager.facebook.com/events_manager2
PUBLIC_META_PIXEL_ID=

# Google Analytics 4 Measurement ID
# Find in Google Analytics > Admin > Data Streams
PUBLIC_GA_MEASUREMENT_ID=

# LinkedIn Insight Tag (Optional for B2B Retargeting)
PUBLIC_LINKEDIN_PARTNER_ID=
